{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@workspace/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@designali/logos": [
        "../../packages/logos/src/generated/index.tsx"
      ],
      "@designali/icons": [
        "../../packages/icons/src/generated/index.tsx"
      ],
      "@designali/vectors": [
        "../../packages/vectors/src/generated/index.tsx"
      ],
      "@designali/icons/all": [
        "../../packages/icons/dist/all.mjs"
      ],
      "@designali/logos/all": [
        "../../packages/logos/dist/all.mjs"
      ],
      "@designali/vectors/all": [
        "../../packages/vectors/dist/all.mjs"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.mjs",
    "**/*.mdx",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
