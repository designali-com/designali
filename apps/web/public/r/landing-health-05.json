      "path": "registry/designali/pages/health/landing-health-05/page.tsx",
      "content": "import {\n  Activity,\n  ArrowRight,\n  ArrowUpRight,\n  CalendarCheck,\n  Check,\n  FlaskConical,\n  Pill,\n  Plus,\n  ShieldCheck,\n  Sparkles,\n  Video,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Services\", \"Process\", \"Pricing\", \"Work\", \"FAQ\"]\n\nconst features = [\n  {\n    icon: FlaskConical,\n    title: \"Design systems\",\n    description:\n      \"Tokens, components and documentation so your website, app and patient portal stay consistent as you grow.\",\n  },\n  {\n    icon: ShieldCheck,\n    title: \"Accessible by default\",\n    description:\n      \"Readable type, strong contrast and keyboard-friendly components are part of every interface Designali ships.\",\n  },\n  {\n    icon: CalendarCheck,\n    title: \"Clear booking pages\",\n    description:\n      \"Show real-time availability, services and prices in a layout that patients understand at a glance.\",\n  },\n  {\n    icon: Activity,\n    title: \"Data-friendly dashboards\",\n    description:\n      \"Charts and trends designed so care teams and patients can read health data quickly.\",\n  },\n  {\n    icon: Video,\n    title: \"Patient-friendly websites\",\n    description:\n      \"Calm, accessible Next.js sites that explain your services clearly and help people book without friction.\",\n  },\n  {\n    icon: Pill,\n    title: \"Booking & intake flows\",\n    description:\n      \"Appointment, intake and onboarding flows designed to be short, clear and easy to complete on any phone.\",\n  },\n]\n\nconst stats = [\n  { value: \"2300+\", label: \"Pages and templates shipped\" },\n  { value: \"92%\", label: \"Projects delivered on schedule\" },\n  { value: \"120+\", label: \"Screens designed for care teams\" },\n  { value: \"48 hr\", label: \"Average reply to a new brief\" },\n]\n\nconst steps = [\n  {\n    title: \"Tell us about your practice\",\n    description:\n      \"Share your services, audience and goals in a short brief. It takes about ten minutes.\",\n  },\n  {\n    title: \"Meet Ali Imam\",\n    description:\n      \"A discovery call to understand your patients, your team and what the project needs to achieve.\",\n  },\n  {\n    title: \"Get your design plan\",\n    description:\n      \"Receive a scope, timeline and fixed price, with clear deliverables for brand, UI and code.\",\n  },\n  {\n    title: \"Launch and grow\",\n    description:\n      \"We ship in Next.js, hand over Figma files and stay available for updates after launch.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Clinic websites\",\n    meta: \"Services, team pages, booking\",\n    tag: \"24/7\",\n    price: \"$2,400\",\n  },\n  {\n    name: \"Wellness studios\",\n    meta: \"Brand, class schedules, memberships\",\n    tag: \"Popular\",\n    price: \"$4,800\",\n  },\n  {\n    name: \"Health startups\",\n    meta: \"MVP app UI, landing page\",\n    tag: \"Fast\",\n    price: \"$1,200\",\n  },\n  {\n    name: \"Patient portals\",\n    meta: \"Dashboards, records, messaging\",\n    tag: \"Ongoing\",\n    price: \"From $900\",\n  },\n  {\n    name: \"Dental & eye care\",\n    meta: \"Brand refresh, booking site\",\n    tag: \"Refresh\",\n    price: \"$1,800\",\n  },\n  {\n    name: \"Nutrition & fitness\",\n    meta: \"Programs, onboarding, app UI\",\n    tag: \"New\",\n    price: \"From $2,400\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"The quote was clear and the final invoice matched it exactly. That alone made working with Designali easy.\",\n    name: \"Nina\",\n    role: \"Director, wellness clinic\",\n  },\n  {\n    quote:\n      \"Our new site and booking flow made a real difference for our front desk. Calls dropped and online bookings went up.\",\n    name: \"Michael\",\n    role: \"Operations lead\",\n  },\n  {\n    quote:\n      \"Ali turned our cluttered clinic site into something calm and clear. Patients now book online instead of calling us.\",\n    name: \"Jasmine\",\n    role: \"Owner, family clinic\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Website Sprint\",\n    price: \"$2,400\",\n    period: \"/project\",\n    description: \"For practices that need a clear, modern site.\",\n    features: [\n      \"24/7 urgent care\",\n      \"Next.js site, up to 6 pages\",\n      \"Booking and contact flow\",\n      \"Accessible components\",\n    ],\n    cta: \"Start a project\",\n  },\n  {\n    name: \"Care Brand\",\n    price: \"$900\",\n    period: \"/month\",\n    description: \"For clinics and studios that want a full brand and site.\",\n    features: [\n      \"Brand identity and guidelines\",\n      \"Website with booking flow\",\n      \"App or portal UI concepts\",\n      \"Figma source files\",\n      \"Monthly design support\",\n    ],\n    cta: \"Book Care Brand\",\n  },\n  {\n    name: \"Product Team\",\n    price: \"$1,200\",\n    period: \"/month\",\n    description: \"For health startups building an app or platform.\",\n    features: [\n      \"Everything in Care Brand\",\n      \"Full app UI design\",\n      \"Design system and docs\",\n      \"Up to 3 product areas\",\n      \"Priority support\",\n    ],\n    cta: \"Book Product Team\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"What about patient data and compliance?\",\n    a: \"We design the experience. Data handling and compliance stay with your own technical and legal advisers.\",\n  },\n  {\n    q: \"Do you offer ongoing support?\",\n    a: \"Yes. Monthly design support covers new pages, campaign graphics and small UI updates after launch.\",\n  },\n  {\n    q: \"Do you work with clinics and health startups?\",\n    a: \"Yes. Designali designs for clinics, wellness studios and health startups. We focus on design and code, not medical advice.\",\n  },\n  {\n    q: \"Can you build the website as well as design it?\",\n    a: \"Yes. Ali Imam designs in Figma and builds with Next.js, React, TypeScript and Tailwind CSS, deployed on Vercel.\",\n  },\n  {\n    q: \"Do you handle accessibility?\",\n    a: \"Accessibility is part of every project, with readable type, strong contrast and keyboard-friendly components.\",\n  },\n]\n\nconst footer = [\n  {\n    title: \"Studio\",\n    links: [\"Clinic websites\", \"Wellness studios\", \"Patient portals\", \"Templates\"],\n  },\n  { title: \"Designali\", links: [\"About\", \"Work\", \"Work\", \"Blog\"] },\n  {\n    title: \"Support\",\n    links: [\"Docs\", \"Contact\", \"Licensing\", \"Contact\"],\n  },\n]\n\nexport default function LandingHealth05() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <div className=\"border-b border-background/10 bg-foreground text-background/80 px-4 py-2 text-center text-xs sm:text-sm\">\n        <a\n          href=\"#\"\n          className=\"inline-flex items-center gap-1.5 hover:underline\"\n        >\n          New: design packages for lab and diagnostics startups\n          <ArrowRight className=\"size-3.5\" />\n        </a>\n      </div>\n      <header className=\"bg-foreground text-background sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-background text-foreground text-sm\">\n              V\n            </span>\n            <span className=\"\">designali</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-background/70 hover:text-background transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex text-background hover:bg-background/10 hover:text-background\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Client login\n            </Button>\n            <Button\n              size=\"sm\"\n              className=\"bg-background text-foreground hover:bg-background/90\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              See packages\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"relative overflow-hidden bg-foreground text-background\">\n        <div className=\"pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,currentColor_1px,transparent_1px),linear-gradient(to_bottom,currentColor_1px,transparent_1px)] bg-[size:64px_64px] opacity-[0.04]\" />\n        <div className=\"relative mx-auto max-w-7xl px-6 pt-16 pb-20 md:pt-28\">\n          <div className=\"max-w-4xl space-y-7\">\n            <span className=\"inline-flex items-center gap-2 rounded-full border border-background/20 text-background/80 px-3 py-1 text-xs font-medium\">\n              <Sparkles className=\"size-3.5 \" />\n              Design for diagnostics\n            </span>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-7xl \">\n              {\"Make results \"}\n              <span className=\"text-background/60\">easy to understand</span>\n            </h1>\n            <p className=\"max-w-2xl text-lg leading-8 text-background/65\">\n              Designali designs results pages, ordering flows and dashboards that\n              explain complex information in plain, friendly language.\n            </p>\n            <div className=\"flex flex-wrap gap-3 \">\n              <Button\n                size=\"lg\"\n                className=\"bg-background text-foreground hover:bg-background/90\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                See packages\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                className=\"border-background/25 bg-transparent text-background hover:bg-background/10 hover:text-background\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                How it works\n              </Button>\n            </div>\n          </div>\n          <div className=\"mt-16\">\n            <HeroVisual />\n          </div>\n        </div>\n      </section>\n      <section className=\"bg-foreground text-background\">\n        <div className=\"mx-auto grid max-w-7xl grid-cols-2 px-6 lg:grid-cols-4\">\n          {stats.slice(0, 4).map((stat, i) => (\n            <div\n              key={stat.label}\n              className={`py-12 ${i > 0 ? \"lg:border-l lg:pl-8\" : \"\"} ${i % 2 === 1 ? \"border-l pl-6 lg:pl-8\" : \"\"} border-background/10`}\n            >\n              <div className=\"text-4xl font-semibold tracking-tight md:text-5xl \">\n                {stat.value}\n              </div>\n              <div className=\"mt-2 text-sm text-background/60\">\n                {stat.label}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"max-w-2xl\">\n            <p className=\"text-sm font-medium text-primary dark:text-primary\">\n              Care\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              Design that fits around your patients\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Clear interfaces, simple booking and accessible components,\n              all designed and built by one studio.\n            </p>\n          </div>\n          <div className=\"mt-14 grid overflow-hidden rounded-2xl border sm:grid-cols-2 lg:grid-cols-3\">\n            {features.map((feature) => (\n              <div\n                key={feature.title}\n                className=\"-mt-px -ml-px border-t border-l p-8\"\n              >\n                <feature.icon className=\"size-6 text-primary dark:text-primary\" />\n                <h3 className=\"mt-5 font-semibold\">{feature.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Who we design for\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                From neighbourhood clinics to health startups, Designali designs\n                brands, sites and apps that people trust.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all work\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a\n                key={item.name}\n                href=\"#\"\n                className=\"group flex flex-col rounded-xl border p-6 transition-colors hover:bg-muted/40\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"flex size-10 items-center justify-center rounded-lg border bg-muted/50 font-semibold \">\n                    {item.name.charAt(0)}\n                  </span>\n                  <span className=\"rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary dark:text-primary\">\n                    {item.tag}\n                  </span>\n                </div>\n                <h3 className=\"mt-6 font-semibold \">{item.name}</h3>\n                <p className=\"mt-1 flex-1 text-sm text-muted-foreground\">\n                  {item.meta}\n                </p>\n                <div className=\"mt-6 flex items-center justify-between border-t pt-4 text-sm\">\n                  <span className=\"font-medium\">{item.price}</span>\n                  <ArrowUpRight className=\"size-4 text-muted-foreground transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5\" />\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              How a project works\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-primary dark:text-primary\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Clients who feel heard\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-6 md:grid-cols-3\">\n            {testimonials.map((t) => (\n              <figure\n                key={t.name}\n                className=\"flex flex-col rounded-2xl border p-6\"\n              >\n                <blockquote className=\"flex-1 leading-7\">\n                  &ldquo;{t.quote}&rdquo;\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 border-t pt-6 text-sm\">\n                  <span className=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Clear pricing for every stage\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Fixed prices for brand, website and product design, listed\n              upfront, with no surprise invoices.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"bg-foreground text-background border-foreground\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-background text-foreground px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p\n                    className={\n                      featured\n                        ? \"mt-2 text-sm text-background/65\"\n                        : \"mt-2 text-sm text-muted-foreground\"\n                    }\n                  >\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span\n                      className={\n                        featured\n                          ? \"text-sm text-background/65\"\n                          : \"text-sm text-muted-foreground\"\n                      }\n                    >\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check\n                          className={\n                            featured\n                              ? \"mt-0.5 size-4 shrink-0\"\n                              : \"mt-0.5 size-4 shrink-0 text-primary dark:text-primary\"\n                          }\n                        />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className={\n                      featured\n                        ? \"mt-8 w-full bg-background text-foreground hover:bg-background/90\"\n                        : \"mt-8 w-full\"\n                    }\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Common questions\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Contact us\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"bg-foreground text-background\">\n        <div className=\"mx-auto flex max-w-7xl flex-col gap-10 px-6 py-20 md:flex-row md:items-end md:justify-between md:py-28\">\n          <div className=\"max-w-2xl\">\n            <h2 className=\"text-4xl font-semibold tracking-tight text-balance md:text-6xl \">\n              Your product, clearly designed\n            </h2>\n            <p className=\"mt-5 text-lg text-background/65\">\n              Figma files, a component library and a Next.js build where needed.\n            </p>\n          </div>\n          <div className=\"flex flex-wrap gap-3 \">\n            <Button\n              size=\"lg\"\n              className=\"bg-background text-foreground hover:bg-background/90\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              See packages\n              <ArrowRight />\n            </Button>\n            <Button\n              size=\"lg\"\n              variant=\"outline\"\n              className=\"border-background/25 bg-transparent text-background hover:bg-background/10 hover:text-background\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              How it works\n            </Button>\n          </div>\n        </div>\n      </section>\n      <footer className=\"border-t border-background/10 bg-foreground text-background\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-background text-foreground text-sm\">\n                V\n              </span>\n              <span className=\"\">designali</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-background/60\">\n              Lab-grade clarity, by design.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-background/60 transition-colors hover:text-background\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t border-background/10\">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-background/60 sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} designali. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-background\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-background\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-background\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  const bars = [38, 52, 44, 63, 58, 71, 66, 80, 74, 88, 83, 95]\n  return (\n    <div className=\"overflow-hidden rounded-xl border bg-card text-left text-card-foreground shadow-2xl/10\">\n      <div className=\"flex items-center gap-2 border-b px-4 py-3\">\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"ml-3 hidden rounded-md bg-muted px-3 py-0.5 text-[11px] text-muted-foreground sm:inline\">\n          designali.com/work/diagnostics\n        </span>\n      </div>\n      <div className=\"grid md:grid-cols-[180px_1fr]\">\n        <aside className=\"hidden space-y-1 border-r p-3 text-sm md:block\">\n          {navLinks.map((link, i) => (\n            <div\n              key={link}\n              className={`rounded-md px-3 py-1.5 ${i === 0 ? \"bg-muted font-medium\" : \"text-muted-foreground\"}`}\n            >\n              {link}\n            </div>\n          ))}\n        </aside>\n        <div className=\"space-y-4 p-4 md:p-6\">\n          <div className=\"grid grid-cols-2 gap-3 lg:grid-cols-4\">\n            {stats.slice(0, 4).map((stat) => (\n              <div key={stat.label} className=\"rounded-lg border p-3\">\n                <div className=\"truncate text-[11px] text-muted-foreground\">\n                  {stat.label}\n                </div>\n                <div className=\"mt-1 text-lg font-semibold tracking-tight\">\n                  {stat.value}\n                </div>\n              </div>\n            ))}\n          </div>\n          <div className=\"rounded-lg border p-4\">\n            <div className=\"mb-4 flex items-center justify-between text-xs\">\n              <span classN