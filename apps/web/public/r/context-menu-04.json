{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "context-menu-04",
  "type": "registry:example",
  "description": "A file tile with open, rename, share submenu, download, and delete actions.",
  "files": [
    {
      "path": "registry/designali/examples/context-menu/context-menu-04.tsx",
      "content": "import {\n  Download as DownloadIcon,\n  ExternalLink as ExternalLinkIcon,\n  FileText as FileTextIcon,\n  Link as LinkIcon,\n  Mail as MailIcon,\n  Pencil as PencilIcon,\n  Share2 as Share2Icon,\n  Trash as TrashIcon,\n  UserPlus as UserPlusIcon,\n} from \"@designali/icons\"\n\nimport {\n  ContextMenu,\n  ContextMenuContent,\n  ContextMenuGroup,\n  ContextMenuItem,\n  ContextMenuSeparator,\n  ContextMenuShortcut,\n  ContextMenuSub,\n  ContextMenuSubContent,\n  ContextMenuSubTrigger,\n  ContextMenuTrigger,\n} from \"@workspace/ui/components/context-menu\"\n\nexport default function FileTileMenu() {\n  return (\n    <ContextMenu>\n      <ContextMenuTrigger className=\"flex w-40 flex-col items-center gap-2 border p-4 text-center hover:bg-muted/50 data-popup-open:bg-muted\">\n        <FileTextIcon className=\"size-10 text-primary\" />\n        <span className=\"text-xs font-medium\">designali-brand-guide.fig</span>\n        <span className=\"text-[11px] text-muted-foreground\">\n          284 KB · Edited today\n        </span>\n      </ContextMenuTrigger>\n      <ContextMenuContent className=\"w-52\">\n        <ContextMenuGroup>\n          <ContextMenuItem>\n            <ExternalLinkIcon />\n            Open\n            <ContextMenuShortcut>↵</ContextMenuShortcut>\n          </ContextMenuItem>\n          <ContextMenuItem>\n            <PencilIcon />\n            Rename\n            <ContextMenuShortcut>F2</ContextMenuShortcut>\n          </ContextMenuItem>\n          <ContextMenuSub>\n            <ContextMenuSubTrigger>\n              <Share2Icon />\n              Share\n            </ContextMenuSubTrigger>\n            <ContextMenuSubContent className=\"w-44\">\n              <ContextMenuGroup>\n                <ContextMenuItem>\n                  <LinkIcon />\n                  Copy link\n                </ContextMenuItem>\n                <ContextMenuItem>\n                  <MailIcon />\n                  Email file\n                </ContextMenuItem>\n                <ContextMenuItem>\n                  <UserPlusIcon />\n                  Invite people...\n                </ContextMenuItem>\n              </ContextMenuGroup>\n            </ContextMenuSubContent>\n          </ContextMenuSub>\n          <ContextMenuItem>\n            <DownloadIcon />\n            Download\n          </ContextMenuItem>\n        </ContextMenuGroup>\n        <ContextMenuSeparator />\n        <ContextMenuGroup>\n          <ContextMenuItem variant=\"destructive\">\n            <TrashIcon />\n            Move to trash\n            <ContextMenuShortcut>⌫</ContextMenuShortcut>\n          </ContextMenuItem>\n        </ContextMenuGroup>\n      </ContextMenuContent>\n    </ContextMenu>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}