{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "alert-dialog-45",
  "type": "registry:example",
  "description": "Chat message delete dialog offering 'for me' and 'for everyone' options.",
  "files": [
    {
      "path": "registry/designali/examples/alert-dialog/alert-dialog-45.tsx",
      "content": "import { Trash2Icon } from \"lucide-react\"\n\nimport {\n  AlertDialog,\n  AlertDialogAction,\n  AlertDialogCancel,\n  AlertDialogContent,\n  AlertDialogDescription,\n  AlertDialogFooter,\n  AlertDialogHeader,\n  AlertDialogTitle,\n  AlertDialogTrigger,\n} from \"@workspace/ui/components/alert-dialog\"\nimport { Button } from \"@workspace/ui/components/button\"\n\nexport default function ChatDeleteMessageScope() {\n  return (\n    <div className=\"flex w-full max-w-sm flex-col items-end gap-1\">\n      <div className=\"group flex items-center gap-1\">\n        <AlertDialog>\n          <AlertDialogTrigger\n            render={\n              <Button\n                variant=\"ghost\"\n                size=\"icon-xs\"\n                aria-label=\"Delete message\"\n                className=\"opacity-60 group-hover:opacity-100\"\n              />\n            }\n          >\n            <Trash2Icon />\n          </AlertDialogTrigger>\n          <AlertDialogContent>\n            <AlertDialogHeader>\n              <AlertDialogTitle>Delete message?</AlertDialogTitle>\n              <AlertDialogDescription>\n                Deleting for everyone removes it from Jonah&apos;s chat too.\n              </AlertDialogDescription>\n            </AlertDialogHeader>\n            <AlertDialogFooter>\n              <AlertDialogCancel>Cancel</AlertDialogCancel>\n              <AlertDialogAction variant=\"outline\">\n                Delete for me\n              </AlertDialogAction>\n              <AlertDialogAction variant=\"destructive\">\n                Delete for everyone\n              </AlertDialogAction>\n            </AlertDialogFooter>\n          </AlertDialogContent>\n        </AlertDialog>\n        <div className=\"max-w-60 bg-primary px-3 py-2 text-sm text-primary-foreground\">\n          Sending the venue deposit now, can you double-check the date?\n        </div>\n      </div>\n      <span className=\"text-[10px] text-muted-foreground\">\n        Delivered - 9:41 AM\n      </span>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}