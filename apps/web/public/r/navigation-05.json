{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "navigation-05",
  "type": "registry:block",
  "description": "A floating dock navigation beside a mobile bottom tab bar.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "registry/designali/blocks/navigation/navigation-05.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\nimport {\n  Bell,\n  Compass,\n  House,\n  Plus,\n  User,\n} from \"@designali/icons\"\n\nimport { cn } from \"@workspace/ui/lib/utils\"\n\nimport { IPhone } from \"@/registry/designali/ui/apple/iphone\"\n\nconst items = [\n  { icon: House, label: \"Home\" },\n  { icon: Compass, label: \"Explore\" },\n  { icon: Plus, label: \"Create\", primary: true },\n  { icon: Bell, label: \"Activity\" },\n  { icon: User, label: \"Profile\" },\n]\n\nconst dock = [\"Work\", \"About\", \"Blog\", \"Contact\"]\n\nexport default function Navigation05() {\n  const [active, setActive] = useState(\"Home\")\n  const [section, setSection] = useState(\"Work\")\n\n  return (\n    <section className=\"w-full bg-background py-20 md:py-28\">\n      <div className=\"mx-auto grid max-w-5xl items-center gap-16 px-6 md:grid-cols-2\">\n        <div className=\"space-y-6\">\n          <p className=\"text-xs tracking-widest text-muted-foreground uppercase\">\n            Floating dock\n          </p>\n          <nav className=\"inline-flex border bg-background/80 p-1 backdrop-blur\">\n            {dock.map((link) => (\n              <button\n                key={link}\n                type=\"button\"\n                onClick={() => setSection(link)}\n                className={cn(\n                  \"h-9 px-4 text-sm transition-colors\",\n                  section === link\n                    ? \"bg-foreground text-background\"\n                    : \"text-muted-foreground hover:text-foreground\"\n                )}\n              >\n                {link}\n              </button>\n            ))}\n          </nav>\n          <p className=\"max-w-sm text-sm text-muted-foreground\">\n            A compact pill navigation from Designali that sits above content,\n            ideal for portfolios like Ali Imam&apos;s and single-page sites.\n          </p>\n        </div>\n\n        <div className=\"flex justify-center\">\n          <IPhone variant=\"18-pro\" color=\"black\" size=\"md\">\n          <div className=\"flex h-full flex-col justify-end bg-muted/40\">\n            <div className=\"m-4 space-y-2\">\n              <div className=\"h-3 w-2/3 bg-muted\" />\n              <div className=\"h-3 w-1/2 bg-muted\" />\n            </div>\n            <nav className=\"grid grid-cols-5 border-t bg-background pb-4\">\n              {items.map((item) => (\n                <button\n                  key={item.label}\n                  type=\"button\"\n                  onClick={() => setActive(item.label)}\n                  className={cn(\n                    \"flex flex-col items-center gap-1 py-3 text-[10px] transition-colors\",\n                    active === item.label ? \"text-foreground\" : \"text-muted-foreground\"\n                  )}\n                >\n                  {item.primary ? (\n                    <span className=\"flex size-9 -translate-y-1 items-center justify-center bg-primary text-primary-foreground\">\n                      <item.icon className=\"size-4\" />\n                    </span>\n                  ) : (\n                    <>\n                      <item.icon className=\"size-5\" />\n                      {item.label}\n                    </>\n                  )}\n                </button>\n              ))}\n            </nav>\n          </div>\n          </IPhone>\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "600px"
  },
  "categories": [
    "navigation"
  ]
}