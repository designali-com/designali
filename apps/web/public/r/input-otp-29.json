      "content": "import {\n  BadgeCheck as BadgeCheckIcon,\n} from \"@designali/icons\"\n\nimport {\n  InputOTP,\n  InputOTPGroup,\n  InputOTPSlot,\n} from \"@workspace/ui/components/input-otp\"\n\nexport default function VerifiedSuccessState() {\n  return (\n    <div className=\"flex flex-col items-center gap-3\">\n      <InputOTP\n        maxLength={6}\n        value=\"305918\"\n        disabled\n        containerClassName=\"has-disabled:opacity-100\"\n      >\n        <InputOTPGroup>\n          <InputOTPSlot\n            index={0}\n            className=\"border-primary/60 bg-primary/10 text-chart-3 dark:text-chart-1\"\n          />\n          <InputOTPSlot\n            index={1}\n            className=\"border-primary/60 bg-primary/10 text-chart-3 dark:text-chart-1\"\n          />\n          <InputOTPSlot\n            index={2}\n            className=\"border-primary/60 bg-primary/10 text-chart-3 dark:text-chart-1\"\n          />\n          <InputOTPSlot\n            index={3}\n            className=\"border-primary/60 bg-primary/10 text-chart-3 dark:text-chart-1\"\n          />\n          <InputOTPSlot\n            index={4}\n            className=\"border-primary/60 bg-primary/10 text-chart-3 dark:text-chart-1\"\n          />\n          <InputOTPSlot\n            index={5}\n            className=\"border-primary/60 bg-primary/10 text-chart-3 dark:text-chart-1\"\n          />\n        </InputOTPGroup>\n      </InputOTP>\n      <p className=\"flex items-center gap-1.5 text-xs font-medium text-chart-3 dark:text-primary\">\n        <BadgeCheckIcon className=\"size-4\" />\n        Email verified\n      </p>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
