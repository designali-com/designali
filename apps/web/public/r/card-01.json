{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "card-01",
  "type": "registry:example",
  "description": "Compact workspace management card with checklist and action buttons.",
  "registryDependencies": [
    "button",
    "card"
  ],
  "files": [
    {
      "path": "registry/designali/examples/card/card-01.tsx",
      "content": "import { Building2, ChevronRight } from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardFooter,\n  CardHeader,\n  CardTitle,\n} from \"@workspace/ui/components/card\"\n\nexport function CardSmall() {\n  const workspaceName = \"Designali Team\"\n\n  return (\n    <Card size=\"sm\" className=\"mx-auto w-full max-w-xs\">\n      <CardHeader>\n        <CardTitle className=\"flex items-center gap-2\">\n          <Building2 className=\"size-4 text-muted-foreground\" />\n          {workspaceName}\n        </CardTitle>\n        <CardDescription>\n          Manage members, projects, and permissions.\n        </CardDescription>\n      </CardHeader>\n      <CardContent>\n        <ul className=\"grid gap-2 py-2 text-sm\">\n          <li className=\"flex gap-2\">\n            <ChevronRight className=\"mt-0.5 size-4 shrink-0 text-muted-foreground\" />\n            <span>Switch between active team workspaces.</span>\n          </li>\n          <li className=\"flex gap-2\">\n            <ChevronRight className=\"mt-0.5 size-4 shrink-0 text-muted-foreground\" />\n            <span>Invite teammates and assign roles.</span>\n          </li>\n          <li className=\"flex gap-2\">\n            <ChevronRight className=\"mt-0.5 size-4 shrink-0 text-muted-foreground\" />\n            <span>Access shared components and assets.</span>\n          </li>\n        </ul>\n      </CardContent>\n      <CardFooter className=\"flex-col gap-2\">\n        <Button size=\"sm\" className=\"w-full\">\n          Switch workspace\n        </Button>\n        <Button variant=\"outline\" size=\"sm\" className=\"w-full\">\n          Create new workspace\n        </Button>\n      </CardFooter>\n    </Card>\n  )\n}",
      "type": "registry:example"
    }
  ]
}