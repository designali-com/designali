{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "resizable-33",
  "type": "registry:example",
  "description": "Commerce admin with a product list and a resizable edit form.",
  "files": [
    {
      "path": "registry/designali/examples/resizable/resizable-33.tsx",
      "content": "import { Badge } from \"@workspace/ui/components/badge\"\nimport { Button } from \"@workspace/ui/components/button\"\nimport { Field, FieldLabel } from \"@workspace/ui/components/field\"\nimport { Input } from \"@workspace/ui/components/input\"\nimport {\n  ResizableHandle,\n  ResizablePanel,\n  ResizablePanelGroup,\n} from \"@workspace/ui/components/resizable\"\nimport { cn } from \"@workspace/ui/lib/utils\"\n\nconst products = [\n  {\n    name: \"Linen Shirt\",\n    sku: \"LS-001\",\n    stock: 42,\n    tone: \"from-stone-300 to-stone-500\",\n  },\n  {\n    name: \"Canvas Tote\",\n    sku: \"CT-014\",\n    stock: 8,\n    tone: \"from-amber-200 to-orange-400\",\n  },\n  {\n    name: \"Wool Beanie\",\n    sku: \"WB-220\",\n    stock: 0,\n    tone: \"from-slate-400 to-slate-700\",\n  },\n]\n\nexport default function ProductEditorSplit() {\n  return (\n    <ResizablePanelGroup\n      orientation=\"horizontal\"\n      className=\"h-80 w-full max-w-2xl border\"\n    >\n      <ResizablePanel defaultSize=\"40%\" minSize=\"30%\">\n        <div className=\"flex h-full flex-col divide-y\">\n          {products.map((p, i) => (\n            <div\n              key={p.sku}\n              className={cn(\n                \"flex items-center gap-2 p-2\",\n                i === 0 && \"bg-muted/60\"\n              )}\n            >\n              <div\n                className={cn(\"size-9 shrink-0 bg-gradient-to-br\", p.tone)}\n              />\n              <div className=\"flex min-w-0 flex-1 flex-col\">\n                <span className=\"truncate text-xs font-medium\">{p.name}</span>\n                <span className=\"font-mono text-[10px] text-muted-foreground\">\n                  {p.sku}\n                </span>\n              </div>\n              <Badge variant={p.stock === 0 ? \"destructive\" : \"outline\"}>\n                {p.stock === 0 ? \"Sold out\" : p.stock}\n              </Badge>\n            </div>\n          ))}\n        </div>\n      </ResizablePanel>\n      <ResizableHandle withHandle />\n      <ResizablePanel defaultSize=\"60%\" minSize=\"40%\">\n        <form className=\"flex h-full flex-col gap-3 p-4\">\n          <Field>\n            <FieldLabel htmlFor=\"product-name\">Name</FieldLabel>\n            <Input id=\"product-name\" defaultValue=\"Linen Shirt\" />\n          </Field>\n          <div className=\"grid grid-cols-2 gap-2\">\n            <Field>\n              <FieldLabel htmlFor=\"product-price\">Price</FieldLabel>\n              <Input id=\"product-price\" defaultValue=\"68.00\" />\n            </Field>\n            <Field>\n              <FieldLabel htmlFor=\"product-stock\">Stock</FieldLabel>\n              <Input id=\"product-stock\" defaultValue=\"42\" />\n            </Field>\n          </div>\n          <Button size=\"sm\" className=\"mt-auto self-end\">\n            Save product\n          </Button>\n        </form>\n      </ResizablePanel>\n    </ResizablePanelGroup>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}