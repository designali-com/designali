{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sections-15",
  "type": "registry:block",
  "description": "Office locations as gradient map cards with timezone tags and headcount.",
  "dependencies": [
    "lucide-react"
