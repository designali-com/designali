      "path": "registry/designali/pages/portfolio/landing-portfolio-04/page.tsx",
      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  Check,\n  Gauge,\n  LayoutTemplate,\n  Plus,\n  Presentation,\n  Quote,\n  Search,\n  Sparkles,\n  Wand,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Work\", \"About\", \"Services\", \"Writing\", \"Contact\"]\n\nconst logos = [\n  \"designali.com\",\n  \"Dalim UI\",\n  \"Dalim Fonts\",\n  \"Dalim Icons\",\n  \"Dalim Visuals\",\n  \"Dalim Tools\",\n  \"Dalim Agency\",\n  \"Dalim Works\",\n]\n\nconst features = [\n  {\n    icon: LayoutTemplate,\n    title: \"Design systems\",\n    description:\n      \"Reusable component libraries in Figma and code, like the blocks and UI on designali.com.\",\n  },\n  {\n    icon: Search,\n    title: \"CGI, 3D & motion\",\n    description:\n      \"Product renders, motion loops and visuals that make launches and landing pages stand out.\",\n  },\n  {\n    icon: Wand,\n    title: \"Prototyping\",\n    description:\n      \"Interactive prototypes that let you test ideas with customers before building.\",\n  },\n  {\n    icon: Presentation,\n    title: \"Workshops\",\n    description:\n      \"Focused sessions to align teams on vision, priorities and the problems worth solving.\",\n  },\n  {\n    icon: Gauge,\n    title: \"Performance audits\",\n    description:\n      \"Reviews of speed, accessibility and SEO with a prioritised list of fixes you can ship this week.\",\n  },\n]\n\nconst stats = [\n  { value: \"4\", label: \"Icon and logo libraries\" },\n  { value: \"100%\", label: \"Projects delivered on time\" },\n  { value: \"1M+\", label: \"People using my resources\" },\n  { value: \"9\", label: \"Years designing and coding\" },\n]\n\nconst steps = [\n  {\n    title: \"Intro call\",\n    description:\n      \"A free 30-minute call to understand your goals, timeline and whether we are a good fit.\",\n  },\n  {\n    title: \"Proposal\",\n    description:\n      \"A short written proposal with scope, milestones and a fixed price, usually within three days.\",\n  },\n  {\n    title: \"Design and build\",\n    description:\n      \"Weekly check-ins and shared progress in Figma and a staging link, so there are no surprises.\",\n  },\n  {\n    title: \"Handover\",\n    description:\n      \"Clean files, documentation and a recorded walkthrough so your team can take it from there.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"designali.com\",\n    meta: \"Templates, blocks, UI and icons\",\n    tag: \"Product\",\n    price: \"2025\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n    image: \"/images/templates/design-agency.jpg\",\n  },\n  {\n    name: \"Dalim UI\",\n    meta: \"Component library for React\",\n    tag: \"UI\",\n    price: \"2025\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n    image: \"/images/templates/dalim-ui-old.jpg\",\n  },\n  {\n    name: \"Dalim Fonts\",\n    meta: \"Type and lettering experiments\",\n    tag: \"Type\",\n    price: \"2024\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n    image: \"/images/templates/dalim-fonts-old.jpg\",\n  },\n  {\n    name: \"Dalim Icons\",\n    meta: \"Icon system for products\",\n    tag: \"Icons\",\n    price: \"2024\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-chart-1 dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n    image: \"/images/templates/dalim-icons-old.jpg\",\n  },\n  {\n    name: \"Dalim Works\",\n    meta: \"Portfolio and studio site\",\n    tag: \"Web\",\n    price: \"2023\",\n    tile: \"bg-gradient-to-br from-muted via-border to-muted-foreground dark:from-muted dark:via-card dark:to-card\",\n    image: \"/images/templates/dalim-works-old.jpg\",\n  },\n  {\n    name: \"Dalim Visuals\",\n    meta: \"CGI and 3D visual series\",\n    tag: \"CGI\",\n    price: \"2023\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-chart-1 dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n    image: \"/images/templates/dalim-visuals-old.jpg\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"The design system Ali built is still the backbone of our product. Every new teammate picks it up in a day.\",\n    name: \"Pedro\",\n    role: \"Engineering manager, Designali client\",\n  },\n  {\n    quote:\n      \"Rare to find someone with this much taste who also writes clean, production-ready code.\",\n    name: \"Hana\",\n    role: \"CTO, Designali client\",\n  },\n  {\n    quote:\n      \"Ali ran a workshop that finally got our founders aligned. The roadmap we left with is still the one we follow.\",\n    name: \"Michael\",\n    role: \"COO, Designali client\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Audit\",\n    price: \"$1,800\",\n    period: \"one-time\",\n    description: \"A deep review of your existing product.\",\n    features: [\n      \"UX and accessibility review\",\n      \"Performance check\",\n      \"Prioritised fix list\",\n      \"60-minute walkthrough\",\n    ],\n    cta: \"Book an audit\",\n  },\n  {\n    name: \"Launch\",\n    price: \"$9,500\",\n    period: \"per project\",\n    description: \"Design and build a marketing site or MVP.\",\n    features: [\n      \"Discovery and strategy\",\n      \"Full visual design\",\n      \"Next.js front-end code\",\n      \"Two rounds of revisions\",\n      \"30 days of support\",\n    ],\n    cta: \"Start a project\",\n  },\n  {\n    name: \"Retainer\",\n    price: \"$6,000\",\n    period: \"/month\",\n    description: \"An ongoing design partner for your team.\",\n    features: [\n      \"Two days per week\",\n      \"Design and code\",\n      \"Shared Slack channel\",\n      \"Pause or cancel any time\",\n    ],\n    cta: \"Check availability\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"Which tools do you use?\",\n    a: \"Figma for design, Next.js, React, TypeScript and Tailwind CSS for code, and Vercel for deployment.\",\n  },\n  {\n    q: \"Can you work in my time zone?\",\n    a: \"I work remotely with clients across time zones and schedule calls at hours that suit both sides.\",\n  },\n  {\n    q: \"How do payments work?\",\n    a: \"Projects are split into 50% upfront and 50% on delivery. Retainers are billed monthly in advance.\",\n  },\n  {\n    q: \"Are you available for full-time roles?\",\n    a: \"Not at the moment. I run Designali and work with a small number of clients so each project gets my full attention.\",\n  },\n  {\n    q: \"How far in advance should I book?\",\n    a: \"I usually book three to four weeks ahead. Audits can often start within a week.\",\n  },\n]\n\nconst footer = [\n  { title: \"Sitemap\", links: [\"Work\", \"About\", \"Services\", \"Writing\"] },\n  { title: \"Elsewhere\", links: [\"Instagram\", \"X\", \"LinkedIn\", \"21st.dev\"] },\n  {\n    title: \"Contact\",\n    links: [\"Email me\", \"Book a call\", \"Newsletter\", \"Resume\"],\n  },\n]\n\nexport default function LandingPortfolio04() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-chart-2 text-white text-sm\">\n              L\n            </span>\n            <span className=\"\">Ali Imam</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Resume\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Book an intro call\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-16 md:py-24\">\n          <div className=\"mx-auto max-w-3xl space-y-6 text-center\">\n            <span className=\"inline-flex items-center gap-2 rounded-full border bg-background text-muted-foreground px-3 py-1 text-xs font-medium\">\n              <Sparkles className=\"size-3.5 text-primary dark:text-primary\" />\n              UX strategy and design\n            </span>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-6xl \">\n              {\"Clarity for \"}\n              <span className=\"text-primary dark:text-primary\">\n                every product decision\n              </span>\n            </h1>\n            <p className=\"mx-auto max-w-2xl text-lg leading-8 text-muted-foreground\">\n              I am Ali, a design engineer who helps product teams understand their\n              users and design what to build next.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Book an intro call\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Read case studies\n              </Button>\n            </div>\n          </div>\n          <div className=\"mt-14 grid gap-3 lg:grid-cols-[2fr_1fr]\">\n            <HeroVisual />\n            <div className=\"grid grid-cols-2 gap-3 lg:grid-cols-1\">\n              {stats.slice(0, 3).map((stat, i) => (\n                <div\n                  key={stat.label}\n                  className={`flex flex-col justify-between rounded-2xl border p-5 ${i === 0 ? \"bg-primary/10\" : \"bg-muted/40\"} ${i === 2 ? \"col-span-2 lg:col-span-1\" : \"\"}`}\n                >\n                  <div className=\"text-xs text-muted-foreground\">\n                    {stat.label}\n                  </div>\n                  <div className=\"mt-6 text-3xl font-semibold tracking-tight\">\n                    {stat.value}\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-12\">\n          <p className=\"text-center text-sm text-muted-foreground\">\n            Projects I have built\n          </p>\n          <div className=\"mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-6 sm:grid-cols-4 lg:grid-cols-8\">\n            {logos.map((logo) => (\n              <div\n                key={logo}\n                className=\"text-center text-base font-semibold tracking-tight text-muted-foreground/70 \"\n              >\n                {logo}\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <p className=\"text-sm font-medium text-primary dark:text-primary\">\n              What I do\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              Design and code from first sketch to shipped product\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              I design and build digital experiences that look great, feel intuitive\n              and work beautifully, handling everything from brand to production code.\n            </p>\n          </div>\n          <div className=\"mt-14 grid gap-3 md:grid-cols-3\">\n            {features.map((feature, i) => (\n              <div\n                key={feature.title}\n                className={`group rounded-2xl border p-6 transition-colors hover:bg-muted/40 ${i === 0 ? \"bg-primary/10 md:col-span-2 md:row-span-2 md:p-10\" : \"\"} ${i === 3 ? \"md:col-span-2\" : \"\"}`}\n              >\n                <feature.icon\n                  className={`${i === 0 ? \"size-8\" : \"size-5\"} text-primary dark:text-primary`}\n                />\n                <h3\n                  className={`mt-6 font-semibold tracking-tight ${i === 0 ? \"text-2xl md:text-3xl\" : \"text-lg\"}`}\n                >\n                  {feature.title}\n                </h3>\n                <p\n                  className={`mt-2 leading-7 text-muted-foreground ${i === 0 ? \"max-w-md text-lg\" : \"text-sm\"}`}\n                >\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Selected projects\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                From designali.com to the Dalim projects that came before it. Full case studies\n                are available on request.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a key={item.name} href=\"#\" className=\"group\">\n                <div\n                  className={`relative aspect-[4/3] overflow-hidden rounded-2xl ${item.tile}`}\n                >\n                  <img src={item.image} alt={item.name} className=\"absolute inset-0 size-full object-cover\" />\n                  <div className=\"absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10\" />\n                  <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-foreground backdrop-blur\">\n                    {item.tag}\n                  </span>\n                </div>\n                <div className=\"mt-4 flex items-start justify-between gap-4\">\n                  <div className=\"min-w-0\">\n                    <h3 className=\"font-medium \">{item.name}</h3>\n                    <p className=\"mt-1 text-sm text-muted-foreground\">\n                      {item.meta}\n                    </p>\n                  </div>\n                  <span className=\"shrink-0 text-sm font-semibold\">\n                    {item.price}\n                  </span>\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b bg-muted/30\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Kind words from collaborators\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-4 md:grid-cols-3\">\n            {testimonials.map((t, i) => (\n              <figure\n                key={t.name}\n                className={`flex flex-col justify-between rounded-2xl border bg-background p-6 ${i === 0 ? \"md:col-span-2 md:p-10\" : \"\"}`}\n              >\n                <Quote className=\"size-6 text-primary dark:text-primary\" />\n                <blockquote\n                  className={`mt-4 leading-relaxed ${i === 0 ? \"text-xl md:text-2xl\" : \"text-muted-foreground\"}`}\n                >\n                  {t.quote}\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 text-sm\">\n                  <span className=\"flex size-9 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              How a project with me runs\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-primary dark:text-primary\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Ways to work together\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Fixed-scope packages for common needs, or a monthly retainer if\n              you need an ongoing design partner.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-primary shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-chart-2 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-primary dark:text-primary\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Good to know\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Get in touch\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"px-6 py-20 md:py-28\">\n        <div className=\"relative mx-auto max-w-6xl overflow-hidden rounded-3xl border bg-primary/10 px-6 py-16 text-center md:py-24\">\n          <div className=\"pointer-events-none absolute -top-24 left-1/2 size-96 -translate-x-1/2 rounded-full bg-gradient-to-b from-primary/25 via-primary/10 to-transparent blur-3xl\" />\n          <div className=\"relative mx-auto max-w-2xl space-y-6\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Stop guessing what your users want\n            </h2>\n            <p className=\"text-lg text-muted-foreground\">\n              A two-week design sprint is often all it takes. Let us find out\n              together.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Book an intro call\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Read case studies\n              </Button>\n            </div>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-chart-2 text-white text-sm\">\n                L\n              </span>\n              <span className=\"\">Ali Imam</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              Design that changes roadmaps.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Ali Imam. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  return (\n    <div className=\"grid grid-cols-2 gap-3 md:grid-cols-4 md:grid-rows-2\">\n      {showcase.slice(0, 5).map((item, i) => (\n        <div\n          key={item.name}\n          className={`relative overflow-hidden rounded-2xl ${item.tile} ${i === 0 ? \"col-span-2 row-span-2 aspect-square md:aspect-auto\" : \"aspect-[4/3]\"}`}\n        >\n          <img src={item.image} alt={item.name} className=\"absolute inset-0 size-full object-cover\" />\n          <div className=\"absolute inset-0 bg-gradient-to-t from-black/50 via-black/0 to-black/0\" />\n          <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-foreground backdrop-blur\">\n            {item.tag}\n          </span>\n          <div className=\"absolute inset-x-3 bottom-3 flex items-end justify-between gap-2 text-white\">\n            <div className=\"min-w-0\">\n              <div className=\"truncate text-sm font-medium\">{item.name}</div>\n              <div className=\"truncate text-xs text-white/75\">{item.meta}</div>\n            </div>\n            <div className=\"shrink-0 text-sm font-semibold\">{item.price}</div>\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n",
