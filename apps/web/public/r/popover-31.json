{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "popover-31",
  "type": "registry:example",
  "description": "Store locator map built from SVG with pins that open location details.",
  "files": [
    {
      "path": "registry/designali/examples/popover/popover-31.tsx",
      "content": "import { MapPinIcon, NavigationIcon } from \"lucide-react\"\n\nimport { Badge } from \"@workspace/ui/components/badge\"\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  Popover,\n  PopoverContent,\n  PopoverDescription,\n  PopoverHeader,\n  PopoverTitle,\n  PopoverTrigger,\n} from \"@workspace/ui/components/popover\"\n\nconst stores = [\n  {\n    id: \"north\",\n    name: \"North Pier\",\n    x: 28,\n    y: 30,\n    hours: \"8 AM - 8 PM\",\n    open: true,\n  },\n  {\n    id: \"market\",\n    name: \"Market Square\",\n    x: 62,\n    y: 52,\n    hours: \"9 AM - 6 PM\",\n    open: true,\n  },\n  {\n    id: \"hill\",\n    name: \"Cedar Hill\",\n    x: 44,\n    y: 78,\n    hours: \"Closed today\",\n    open: false,\n  },\n]\n\nexport default function MapPinPopover() {\n  return (\n    <div className=\"relative aspect-[4/3] w-full max-w-sm overflow-hidden border bg-muted/40\">\n      <svg className=\"absolute inset-0 size-full text-border\" aria-hidden>\n        <defs>\n          <pattern\n            id=\"map-grid\"\n            width=\"24\"\n            height=\"24\"\n            patternUnits=\"userSpaceOnUse\"\n          >\n            <path d=\"M24 0H0V24\" fill=\"none\" stroke=\"currentColor\" />\n          </pattern>\n        </defs>\n        <rect width=\"100%\" height=\"100%\" fill=\"url(#map-grid)\" />\n        <path\n          d=\"M0 120 C80 90 160 170 400 110\"\n          stroke=\"currentColor\"\n          strokeWidth=\"10\"\n          fill=\"none\"\n        />\n      </svg>\n      {stores.map((store) => (\n        <Popover key={store.id}>\n          <PopoverTrigger\n            render={\n              <button\n                type=\"button\"\n                aria-label={store.name}\n                className=\"absolute -translate-x-1/2 -translate-y-full text-primary\"\n                style={{ left: store.x + \"%\", top: store.y + \"%\" }}\n              />\n            }\n          >\n            <MapPinIcon className=\"size-6 fill-background\" />\n          </PopoverTrigger>\n          <PopoverContent side=\"top\" className=\"w-52\">\n            <PopoverHeader>\n              <PopoverTitle>{store.name}</PopoverTitle>\n              <PopoverDescription>{store.hours}</PopoverDescription>\n            </PopoverHeader>\n            <Badge variant={store.open ? \"secondary\" : \"outline\"}>\n              {store.open ? \"Open now\" : \"Closed\"}\n            </Badge>\n            <Button size=\"sm\" variant=\"outline\">\n              <NavigationIcon data-icon=\"inline-start\" /> Directions\n            </Button>\n          </PopoverContent>\n        </Popover>\n      ))}\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}