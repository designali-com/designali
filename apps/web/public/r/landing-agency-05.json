      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  ChartNoAxesCombined,\n  Check,\n  Compass,\n  Megaphone,\n  Package,\n  Palette,\n  PenTool,\n  Plus,\n  Sparkles,\n} from \"@designali/icons\"\n\nimport { Logo } from \"@/src/components/logo\"\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Work\", \"Services\", \"Studio\", \"Blog\", \"Docs\"]\n\nconst features = [\n  {\n    icon: Megaphone,\n    title: \"AI workflows\",\n    description:\n      \"AI-assisted exploration and content drafts that speed up the work without replacing craft.\",\n  },\n  {\n    icon: PenTool,\n    title: \"Design systems\",\n    description:\n      \"Component libraries, tokens and guidelines built on shadcn-style UI and Tailwind CSS.\",\n  },\n  {\n    icon: ChartNoAxesCombined,\n    title: \"Creative development\",\n    description:\n      \"Interactive details, animation and micro-interactions that make a site feel alive.\",\n  },\n  {\n    icon: Package,\n    title: \"Type\",\n    description:\n      \"Social templates, illustrations and vectors that keep every channel on-brand.\",\n  },\n  {\n    icon: Compass,\n    title: \"Brand strategy\",\n    description:\n      \"Positioning, naming and messaging shaped with you before a single pixel is drawn.\",\n  },\n  {\n    icon: Palette,\n    title: \"Brand identity\",\n    description:\n      \"Logos, type, colour and motion systems built to flex from a favicon to a launch film.\",\n  },\n]\n\nconst stats = [\n  { value: \"1\", label: \"Founder who designs and codes\" },\n  { value: \"8+\", label: \"Brands and product lines by Ali\" },\n  { value: \"460+\", label: \"Blocks on designali.com\" },\n  { value: \"240+\", label: \"Landing pages published\" },\n]\n\nconst steps = [\n  {\n    title: \"Discover\",\n    description:\n      \"A discovery call and a short audit to understand your business, audience and goals.\",\n  },\n  {\n    title: \"Define\",\n    description:\n      \"A clear direction, scope and timeline that you sign off before design begins.\",\n  },\n  {\n    title: \"Design and build\",\n    description:\n      \"Weekly reviews in Figma and a live preview on Vercel, so you steer the work throughout.\",\n  },\n  {\n    title: \"Launch and grow\",\n    description:\n      \"We launch together, measure results and keep refining the experience over time.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Dalim UI\",\n    meta: \"Component library and docs site\",\n    tag: \"UI\",\n    price: \"2025\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Dalim Agency\",\n    meta: \"Studio website and brand\",\n    tag: \"Web\",\n    price: \"2025\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Dalim Fonts\",\n    meta: \"Type foundry identity and store\",\n    tag: \"Type\",\n    price: \"2024\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Dalim Icons\",\n    meta: \"Icon library and search experience\",\n    tag: \"Product\",\n    price: \"2024\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-chart-1 dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Dalim Visuals\",\n    meta: \"CGI, 3D and motion work\",\n    tag: \"Motion\",\n    price: \"2024\",\n    tile: \"bg-gradient-to-br from-muted via-border to-muted-foreground dark:from-muted dark:via-card dark:to-card\",\n  },\n  {\n    name: \"Dalim Works\",\n    meta: \"Portfolio and case-study site\",\n    tag: \"Web\",\n    price: \"2023\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-chart-1 dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"Designali built us a design system our engineers actually use. Shipping new pages now takes days, not weeks.\",\n    name: \"Chloe B.\",\n    role: \"Product lead, Designali client\",\n  },\n  {\n    quote:\n      \"The 3D launch loop Designali made did more for awareness than a year of paid social. Phenomenal craft.\",\n    name: \"Ravi K.\",\n    role: \"Founder, Designali client\",\n  },\n  {\n    quote:\n      \"Designali challenged our brief in the best possible way. The new brand gave our team something they are proud to show.\",\n    name: \"Isabelle G.\",\n    role: \"Marketing lead, Designali client\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Sprint\",\n    price: \"$2,400\",\n    period: \"fixed\",\n    description: \"A focused two-week engagement for one landing page or feature.\",\n    features: [\n      \"Discovery call with Ali\",\n      \"One designed and coded page\",\n      \"Two review rounds\",\n      \"Figma files and source code\",\n    ],\n    cta: \"Book a sprint\",\n  },\n  {\n    name: \"Project\",\n    price: \"From $6k\",\n    period: \"per project\",\n    description: \"End-to-end brand identity and website launches.\",\n    features: [\n      \"Strategy and creative direction\",\n      \"Ali Imam as your lead\",\n      \"Design and Next.js development\",\n      \"Weekly reviews\",\n      \"30 days of post-launch support\",\n    ],\n    cta: \"Start a project\",\n  },\n  {\n    name: \"Studio plan\",\n    price: \"$4,500\",\n    period: \"/month\",\n    description: \"Ongoing design and development, month to month.\",\n    features: [\n      \"Design and code in one person\",\n      \"Monthly strategy session\",\n      \"Unlimited requests in scope\",\n      \"Pause or cancel any time\",\n    ],\n    cta: \"Let us talk\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"Who owns the work?\",\n    a: \"You do. Figma files and source code transfer to you on final payment.\",\n  },\n  {\n    q: \"What does a typical project cost?\",\n    a: \"Sprints start at $2,400 and full brand plus website projects from $6k, depending on scope. See /pricing for details.\",\n  },\n  {\n    q: \"Who does Designali work with?\",\n    a: \"Founders, startups and growing brands who want thoughtful design and production-ready code from one studio.\",\n  },\n  {\n    q: \"How soon can you start?\",\n    a: \"Projects are usually booked a few weeks ahead. Sprints can often start within two weeks.\",\n  },\n  {\n    q: \"Do you work with in-house teams?\",\n    a: \"Often. Ali is happy to lead, collaborate or hand off a design system your team can carry forward.\",\n  },\n]\n\nconst footer = [\n  { title: \"Studio\", links: [\"About\", \"Ali Imam\", \"Docs\", \"Pricing\"] },\n  { title: \"Services\", links: [\"UI\", \"Resources\", \"Motion\", \"AI workflows\"] },\n  {\n    title: \"Connect\",\n    links: [\"Instagram\", \"LinkedIn\", \"X\", \"21st.dev\"],\n  },\n]\n\nexport default function LandingAgency05() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <div className=\"border-b border-background/10 bg-foreground text-background/80 px-4 py-2 text-center text-xs sm:text-sm\">\n        <a\n          href=\"#\"\n          className=\"inline-flex items-center gap-1.5 hover:underline\"\n        >\n          New: 240+ landing pages on designali.com\n          <ArrowRight className=\"size-3.5\" />\n        </a>\n      </div>\n      <header className=\"bg-foreground text-background sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <Logo className=\"h-5 w-auto\" />\n            <span className=\"\">designali</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-background/70 hover:text-background transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex text-background hover:bg-background/10 hover:text-background\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Contact\n            </Button>\n            <Button\n              size=\"sm\"\n              className=\"bg-background text-foreground hover:bg-background/90\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Get a free review\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"relative overflow-hidden bg-foreground text-background\">\n        <div className=\"pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,currentColor_1px,transparent_1px),linear-gradient(to_bottom,currentColor_1px,transparent_1px)] bg-[size:64px_64px] opacity-[0.04]\" />\n        <div className=\"relative mx-auto max-w-7xl px-6 pt-16 pb-20 md:pt-28\">\n          <div className=\"max-w-4xl space-y-7\">\n            <span className=\"inline-flex items-center gap-2 rounded-full border border-background/20 text-background/80 px-3 py-1 text-xs font-medium\">\n              <Sparkles className=\"size-3.5 \" />\n              Designali landing pages\n            </span>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-7xl \">\n              {\"Launch pages that \"}\n              <span className=\"text-background/60\">convert from day one</span>\n            </h1>\n            <p className=\"max-w-2xl text-lg leading-8 text-background/65\">\n              Designali designs and codes high-converting launch and campaign pages for DTC and SaaS brands, built on Next.js and Tailwind CSS.\n            </p>\n            <div className=\"flex flex-wrap gap-3 \">\n              <Button\n                size=\"lg\"\n                className=\"bg-background text-foreground hover:bg-background/90\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Get a free review\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                className=\"border-background/25 bg-transparent text-background hover:bg-background/10 hover:text-background\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                See pages\n              </Button>\n            </div>\n          </div>\n          <div className=\"mt-16\">\n            <HeroVisual />\n          </div>\n        </div>\n      </section>\n      <section className=\"bg-foreground text-background\">\n        <div className=\"mx-auto grid max-w-7xl grid-cols-2 px-6 lg:grid-cols-4\">\n          {stats.slice(0, 4).map((stat, i) => (\n            <div\n              key={stat.label}\n              className={`py-12 ${i > 0 ? \"lg:border-l lg:pl-8\" : \"\"} ${i % 2 === 1 ? \"border-l pl-6 lg:pl-8\" : \"\"} border-background/10`}\n            >\n              <div className=\"text-4xl font-semibold tracking-tight md:text-5xl \">\n                {stat.value}\n              </div>\n              <div className=\"mt-2 text-sm text-background/60\">\n                {stat.label}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"max-w-2xl\">\n            <p className=\"text-sm font-medium text-primary dark:text-primary\">\n              Services\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              Strategy, design and code under one roof\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Where thoughtful design meets production-ready code. Ali Imam designs and builds every project, from first call to launch day.\n            </p>\n          </div>\n          <div className=\"mt-14 grid overflow-hidden rounded-2xl border sm:grid-cols-2 lg:grid-cols-3\">\n            {features.map((feature) => (\n              <div\n                key={feature.title}\n                className=\"-mt-px -ml-px border-t border-l p-8\"\n              >\n                <feature.icon className=\"size-6 text-primary dark:text-primary\" />\n                <h3 className=\"mt-5 font-semibold\">{feature.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Selected work\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                A few projects from the Designali and Dalim archive, designed and coded in-house.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a key={item.name} href=\"#\" className=\"group\">\n                <div\n                  className={`relative aspect-[4/3] overflow-hidden rounded-2xl ${item.tile}`}\n                >\n                  <div className=\"absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10\" />\n                  <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-foreground backdrop-blur\">\n                    {item.tag}\n                  </span>\n                </div>\n                <div className=\"mt-4 flex items-start justify-between gap-4\">\n                  <div className=\"min-w-0\">\n                    <h3 className=\"font-medium \">{item.name}</h3>\n                    <p className=\"mt-1 text-sm text-muted-foreground\">\n                      {item.meta}\n                    </p>\n                  </div>\n                  <span className=\"shrink-0 text-sm font-semibold\">\n                    {item.price}\n                  </span>\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              How we work together\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-primary dark:text-primary\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              What clients say\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-6 md:grid-cols-3\">\n            {testimonials.map((t) => (\n              <figure\n                key={t.name}\n                className=\"flex flex-col rounded-2xl border p-6\"\n              >\n                <blockquote className=\"flex-1 leading-7\">\n                  &ldquo;{t.quote}&rdquo;\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 border-t pt-6 text-sm\">\n                  <span className=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Ways to work with Designali\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Fixed-scope projects or a monthly studio plan. No surprise invoices, ever.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"bg-foreground text-background border-foreground\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-background text-foreground px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p\n                    className={\n                      featured\n                        ? \"mt-2 text-sm text-background/65\"\n                        : \"mt-2 text-sm text-muted-foreground\"\n                    }\n                  >\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span\n                      className={\n                        featured\n                          ? \"text-sm text-background/65\"\n                          : \"text-sm text-muted-foreground\"\n                      }\n                    >\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check\n                          className={\n                            featured\n                              ? \"mt-0.5 size-4 shrink-0\"\n                              : \"mt-0.5 size-4 shrink-0 text-primary dark:text-primary\"\n                          }\n                        />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className={\n                      featured\n                        ? \"mt-8 w-full bg-background text-foreground hover:bg-background/90\"\n                        : \"mt-8 w-full\"\n                    }\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Before you get in touch\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Email hello@designali.com\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"bg-foreground text-background\">\n        <div className=\"mx-auto flex max-w-7xl flex-col gap-10 px-6 py-20 md:flex-row md:items-end md:justify-between md:py-28\">\n          <div className=\"max-w-2xl\">\n            <h2 className=\"text-4xl font-semibold tracking-tight text-balance md:text-6xl \">\n              Find out where your landing page is leaking\n            </h2>\n            <p className=\"mt-5 text-lg text-background/65\">\n              Get a free page review with three quick wins within five days.\n            </p>\n          </div>\n          <div className=\"flex flex-wrap gap-3 \">\n            <Button\n              size=\"lg\"\n              className=\"bg-background text-foreground hover:bg-background/90\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Get a free review\n              <ArrowRight />\n            </Button>\n            <Button\n              size=\"lg\"\n              variant=\"outline\"\n              className=\"border-background/25 bg-transparent text-background hover:bg-background/10 hover:text-background\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              See pages\n            </Button>\n          </div>\n        </div>\n      </section>\n      <footer className=\"border-t border-background/10 bg-foreground text-background\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <Logo className=\"h-5 w-auto\" />\n              <span className=\"\">designali</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-background/60\">\n              design se code tak\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-background/60 transition-colors hover:text-background\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t border-background/10\">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-background/60 sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Designali. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-background\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-background\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-background\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  return (\n    <div className=\"grid grid-cols-2 gap-3 md:grid-cols-3\">\n      {showcase.slice(0, 3).map((item, i) => (\n        <div\n          key={item.name}\n          className={`relative overflow-hidden rounded-2xl ${item.tile} ${i === 0 ? \"col-span-2 aspect-[16/10] md:col-span-1 md:aspect-[3/4]\" : \"aspect-[3/4]\"}`}\n        >\n          <div className=\"absolute inset-0 bg-gradient-to-t from-black/50 via-black/0 to-black/0\" />\n          <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-foreground backdrop-blur\">\n            {item.tag}\n          </span>\n          <div className=\"absolute inset-x-3 bottom-3 flex items-end justify-between gap-2 text-white\">\n            <div className=\"min-w-0\">\n              <div className=\"truncate text-sm font-medium\">{item.name}</div>\n              <div className=\"truncate text-xs text-white/75\">{item.meta}</div>\n            </div>\n            <div className=\"shrink-0 text-sm font-semibold\">{item.price}</div>\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n",
