{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "popover-30",
  "type": "registry:example",
  "description": "Week view event chip that opens event details with time, location, and attendees.",
  "files": [
    {
      "path": "registry/designali/examples/popover/popover-30.tsx",
      "content": "import * as React from \"react\"\nimport { MapPinIcon, VideoIcon } from \"lucide-react\"\n\nimport {\n  Avatar,\n  AvatarFallback,\n  AvatarGroup,\n} from \"@workspace/ui/components/avatar\"\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  Popover,\n  PopoverContent,\n  PopoverDescription,\n  PopoverHeader,\n  PopoverTitle,\n  PopoverTrigger,\n} from \"@workspace/ui/components/popover\"\n\nconst attendees = [\"Rhea Kapoor\", \"Leo Varga\", \"Aiko Mori\", \"Sam Whitfield\"]\n\nexport default function CalendarEventPopover() {\n  return (\n    <div className=\"grid w-full max-w-sm grid-cols-[3rem_1fr] border text-[11px]\">\n      {[\"9 AM\", \"10 AM\", \"11 AM\"].map((hour) => (\n        <React.Fragment key={hour}>\n          <span className=\"border-e border-b p-1 text-muted-foreground\">\n            {hour}\n          </span>\n          <div className=\"relative h-12 border-b\">\n            {hour === \"10 AM\" && (\n              <Popover>\n                <PopoverTrigger\n                  render={\n                    <button\n                      type=\"button\"\n                      className=\"absolute inset-x-1 top-1 bottom-1 border-s-2 border-primary bg-primary/10 px-2 text-start text-xs font-medium\"\n                    />\n                  }\n                >\n                  Design review\n                </PopoverTrigger>\n                <PopoverContent side=\"right\" align=\"start\" className=\"w-64\">\n                  <PopoverHeader>\n                    <PopoverTitle>Design review</PopoverTitle>\n                    <PopoverDescription>\n                      Tuesday, Nov 17 · 10:00 - 10:45 AM\n                    </PopoverDescription>\n                  </PopoverHeader>\n                  <div className=\"flex flex-col gap-1.5 text-xs\">\n                    <span className=\"flex items-center gap-2\">\n                      <MapPinIcon className=\"size-3.5 text-muted-foreground\" />{\" \"}\n                      Room 4B · Juniper\n                    </span>\n                    <span className=\"flex items-center gap-2\">\n                      <VideoIcon className=\"size-3.5 text-muted-foreground\" />{\" \"}\n                      meet.example.com/drv-421\n                    </span>\n                  </div>\n                  <AvatarGroup>\n                    {attendees.map((name) => (\n                      <Avatar key={name} size=\"sm\">\n                        <AvatarFallback>\n                          {name\n                            .split(\" \")\n                            .map((p) => p[0])\n                            .join(\"\")}\n                        </AvatarFallback>\n                      </Avatar>\n                    ))}\n                  </AvatarGroup>\n                  <div className=\"flex gap-2\">\n                    <Button size=\"sm\" className=\"flex-1\">\n                      Join\n                    </Button>\n                    <Button size=\"sm\" variant=\"outline\" className=\"flex-1\">\n                      Reschedule\n                    </Button>\n                  </div>\n                </PopoverContent>\n              </Popover>\n            )}\n          </div>\n        </React.Fragment>\n      ))}\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}