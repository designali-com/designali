{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "hover-card-28",
  "type": "registry:example",
  "description": "A kanban card that previews assignee, due date, priority, and subtask progress.",
  "files": [
    {
      "path": "registry/designali/examples/hover-card/hover-card-28.tsx",
      "content": "import { CalendarIcon } from \"lucide-react\"\n\nimport { Avatar, AvatarFallback } from \"@workspace/ui/components/avatar\"\nimport { Badge } from \"@workspace/ui/components/badge\"\nimport {\n  HoverCard,\n  HoverCardContent,\n  HoverCardTrigger,\n} from \"@workspace/ui/components/hover-card\"\n\nexport default function KanbanTaskHoverCard() {\n  const done = 3\n  const total = 5\n\n  return (\n    <div className=\"w-full max-w-[16rem] bg-muted/50 p-2\">\n      <p className=\"mb-2 px-1 text-xs font-medium text-muted-foreground\">\n        IN PROGRESS · 1\n      </p>\n      <HoverCard>\n        <HoverCardTrigger\n          render={\n            <div className=\"cursor-grab border bg-background p-3 text-sm shadow-xs\" />\n          }\n        >\n          <p className=\"font-medium\">Migrate invoices to new PDF engine</p>\n          <p className=\"mt-1 text-xs text-muted-foreground\">FIN-218</p>\n        </HoverCardTrigger>\n        <HoverCardContent\n          side=\"right\"\n          align=\"start\"\n          className=\"flex w-60 flex-col gap-2\"\n        >\n          <div className=\"flex items-center justify-between\">\n            <span className=\"font-medium\">FIN-218</span>\n            <Badge variant=\"destructive\">High</Badge>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <Avatar size=\"sm\">\n              <AvatarFallback>CL</AvatarFallback>\n            </Avatar>\n            Chloé Laurent\n          </div>\n          <div className=\"flex items-center gap-2 text-muted-foreground\">\n            <CalendarIcon className=\"size-3.5\" />\n            Due Friday, Apr 11\n          </div>\n          <div className=\"flex flex-col gap-1\">\n            <div className=\"flex justify-between text-muted-foreground\">\n              <span>Subtasks</span>\n              <span>\n                {done}/{total}\n              </span>\n            </div>\n            <div className=\"h-1.5 bg-muted\">\n              <div\n                className=\"h-full bg-primary\"\n                style={{ width: (done / total) * 100 + \"%\" }}\n              />\n            </div>\n          </div>\n        </HoverCardContent>\n      </HoverCard>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}