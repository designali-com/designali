{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dropdown-menu-22",
  "type": "registry:example",
  "description": "Chat bubble with a hover-revealed menu containing quick reactions, reply, pin, and delete.",
  "files": [
    {
      "path": "registry/designali/examples/dropdown-menu/dropdown-menu-22.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  CopyIcon,\n  MoreHorizontalIcon,\n  PinIcon,\n  ReplyIcon,\n  Trash2Icon,\n} from \"lucide-react\"\n\nimport { Avatar, AvatarFallback } from \"@workspace/ui/components/avatar\"\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from \"@workspace/ui/components/dropdown-menu\"\n\nconst reactions = [\"👍\", \"❤️\", \"😂\", \"🎉\", \"👀\"]\n\nexport default function ChatMessageActions() {\n  const [reaction, setReaction] = React.useState<string | null>(null)\n\n  return (\n    <div className=\"group flex w-full max-w-sm items-start gap-2\">\n      <Avatar size=\"sm\">\n        <AvatarFallback>TM</AvatarFallback>\n      </Avatar>\n      <div className=\"flex-1\">\n        <div className=\"flex items-center gap-2 text-xs\">\n          <span className=\"font-medium\">Tomás Medina</span>\n          <span className=\"text-muted-foreground\">10:42</span>\n        </div>\n        <p className=\"mt-1 bg-muted px-3 py-2 text-xs\">\n          The new onboarding flow is live on staging. Can someone run through it\n          before lunch?\n        </p>\n        {reaction && (\n          <span className=\"mt-1 inline-flex border px-1.5 text-xs\">\n            {reaction} 1\n          </span>\n        )}\n      </div>\n      <DropdownMenu>\n        <DropdownMenuTrigger\n          render={\n            <Button\n              variant=\"ghost\"\n              size=\"icon-xs\"\n              aria-label=\"Message actions\"\n              className=\"opacity-0 group-hover:opacity-100 data-popup-open:opacity-100\"\n            />\n          }\n        >\n          <MoreHorizontalIcon />\n        </DropdownMenuTrigger>\n        <DropdownMenuContent align=\"end\" className=\"w-48\">\n          <div className=\"flex justify-between px-1 py-1\">\n            {reactions.map((emoji) => (\n              <DropdownMenuItem\n                key={emoji}\n                className=\"size-8 justify-center p-0 text-base\"\n                onClick={() => setReaction(emoji)}\n              >\n                {emoji}\n              </DropdownMenuItem>\n            ))}\n          </div>\n          <DropdownMenuSeparator />\n          <DropdownMenuItem>\n            <ReplyIcon />\n            Reply in thread\n          </DropdownMenuItem>\n          <DropdownMenuItem>\n            <CopyIcon />\n            Copy text\n          </DropdownMenuItem>\n          <DropdownMenuItem>\n            <PinIcon />\n            Pin to channel\n          </DropdownMenuItem>\n          <DropdownMenuSeparator />\n          <DropdownMenuItem variant=\"destructive\">\n            <Trash2Icon />\n            Delete message\n          </DropdownMenuItem>\n        </DropdownMenuContent>\n      </DropdownMenu>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}