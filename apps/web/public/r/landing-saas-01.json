    {
      "path": "registry/designali/pages/saas/landing-saas-01/page.tsx",
      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  ChartLine,\n  Check,\n  LayoutDashboard,\n  Plug,\n  Plus,\n  ShieldCheck,\n  Sparkles,\n  Users,\n  Workflow,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Product\", \"Solutions\", \"Pricing\", \"Customers\", \"Docs\"]\n\nconst logos = [\n  \"Northwind\",\n  \"Lumen Labs\",\n  \"Arcadia\",\n  \"Brightline\",\n  \"Kestrel\",\n  \"Oakridge\",\n  \"Vantage\",\n  \"Halcyon\",\n]\n\nconst features = [\n  {\n    icon: LayoutDashboard,\n    title: \"Live dashboards\",\n    description:\n      \"Build views for every stakeholder in minutes, with widgets that update the moment work changes.\",\n  },\n  {\n    icon: Workflow,\n    title: \"No-code automations\",\n    description:\n      \"Route requests, assign owners and nudge reviewers with rules anyone on the team can set up.\",\n  },\n  {\n    icon: ShieldCheck,\n    title: \"Enterprise-grade security\",\n    description:\n      \"SOC 2 Type II, SSO with SAML, audit logs and data residency in the US, EU or APAC.\",\n  },\n  {\n    icon: Users,\n    title: \"Built for collaboration\",\n    description:\n      \"Comments, mentions and approvals live next to the work, so decisions never get lost in chat.\",\n  },\n  {\n    icon: ChartLine,\n    title: \"Forecasting\",\n    description:\n      \"Predict delivery dates from historical velocity and spot slipping milestones weeks earlier.\",\n  },\n  {\n    icon: Plug,\n    title: \"Open API\",\n    description:\n      \"A documented REST and GraphQL API, webhooks and SDKs for TypeScript, Python and Go.\",\n  },\n]\n\nconst stats = [\n  { value: \"12,400+\", label: \"Teams onboarded\" },\n  { value: \"38%\", label: \"Faster delivery cycles\" },\n  { value: \"99.99%\", label: \"Uptime over 24 months\" },\n  { value: \"4.8/5\", label: \"Average G2 rating\" },\n]\n\nconst steps = [\n  {\n    title: \"Import your work\",\n    description:\n      \"Bring projects over from Jira, Asana or spreadsheets with a guided importer that maps every field.\",\n  },\n  {\n    title: \"Invite your team\",\n    description:\n      \"Add teammates with SSO or a link. Roles and permissions are configured automatically.\",\n  },\n  {\n    title: \"Automate the busywork\",\n    description:\n      \"Pick from 60+ templates for intake, approvals and reporting, or build your own rules.\",\n  },\n  {\n    title: \"Report with confidence\",\n    description:\n      \"Share live dashboards with leadership instead of rebuilding slide decks every Friday.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Slack\",\n    meta: \"Notifications and slash commands\",\n    tag: \"Popular\",\n    price: \"Free\",\n  },\n  {\n    name: \"GitHub\",\n    meta: \"Link pull requests to tasks\",\n    tag: \"Two-way\",\n    price: \"Free\",\n  },\n  {\n    name: \"Salesforce\",\n    meta: \"Sync accounts and opportunities\",\n    tag: \"Business\",\n    price: \"Pro\",\n  },\n  {\n    name: \"Google Drive\",\n    meta: \"Attach and preview files\",\n    tag: \"Popular\",\n    price: \"Free\",\n  },\n  {\n    name: \"Figma\",\n    meta: \"Embed live design frames\",\n    tag: \"New\",\n    price: \"Free\",\n  },\n  {\n    name: \"Snowflake\",\n    meta: \"Stream data to your warehouse\",\n    tag: \"Enterprise\",\n    price: \"Scale\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"We retired three tools and a pile of spreadsheets in the first month. Our weekly status meeting went from an hour to fifteen minutes.\",\n    name: \"Priya Raman\",\n    role: \"VP Operations, Brightline\",\n  },\n  {\n    quote:\n      \"Automations alone save my team about a day a week. The onboarding was so smooth that nobody needed training.\",\n    name: \"Marcus Lee\",\n    role: \"Head of Delivery, Kestrel\",\n  },\n  {\n    quote:\n      \"Security review took two days instead of two months. SSO, audit logs and residency were all there out of the box.\",\n    name: \"Elena Fischer\",\n    role: \"CISO, Oakridge\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Starter\",\n    price: \"$0\",\n    period: \"/month\",\n    description: \"For small teams getting organised.\",\n    features: [\n      \"Up to 10 members\",\n      \"Unlimited projects\",\n      \"Basic automations\",\n      \"7-day history\",\n    ],\n    cta: \"Start for free\",\n  },\n  {\n    name: \"Pro\",\n    price: \"$12\",\n    period: \"/user/month\",\n    description: \"For growing teams that need more control.\",\n    features: [\n      \"Unlimited members\",\n      \"Advanced automations\",\n      \"Dashboards and forecasting\",\n      \"Unlimited history\",\n      \"Priority support\",\n    ],\n    cta: \"Start 14-day trial\",\n  },\n  {\n    name: \"Enterprise\",\n    price: \"Custom\",\n    period: \"\",\n    description: \"For organisations with advanced security needs.\",\n    features: [\n      \"SAML SSO and SCIM\",\n      \"Audit logs\",\n      \"Data residency\",\n      \"Dedicated success manager\",\n      \"99.99% uptime SLA\",\n    ],\n    cta: \"Talk to sales\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"Is there a free plan?\",\n    a: \"Yes. The Starter plan is free forever for up to 10 members, with unlimited projects and basic automations.\",\n  },\n  {\n    q: \"How long does migration take?\",\n    a: \"Most teams import their existing work in under an hour. Our importer supports Jira, Asana, Trello, Monday and CSV.\",\n  },\n  {\n    q: \"Do you offer discounts for non-profits and startups?\",\n    a: \"We offer 50% off Pro for registered non-profits and early-stage startups with under $5M in funding.\",\n  },\n  {\n    q: \"Where is my data stored?\",\n    a: \"You can choose US, EU or APAC hosting. All data is encrypted at rest with AES-256 and in transit with TLS 1.3.\",\n  },\n  {\n    q: \"Can I cancel at any time?\",\n    a: \"Yes. Monthly plans can be cancelled at any time and annual plans are refunded pro rata for unused months.\",\n  },\n]\n\nconst footer = [\n  {\n    title: \"Product\",\n    links: [\"Features\", \"Integrations\", \"Pricing\", \"Changelog\"],\n  },\n  { title: \"Company\", links: [\"About\", \"Careers\", \"Press\", \"Contact\"] },\n  {\n    title: \"Resources\",\n    links: [\"Docs\", \"API reference\", \"Status\", \"Security\"],\n  },\n]\n\nexport default function LandingSaas01() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <div className=\"border-b bg-muted/50 text-muted-foreground px-4 py-2 text-center text-xs sm:text-sm\">\n        <a\n          href=\"#\"\n          className=\"inline-flex items-center gap-1.5 hover:underline\"\n        >\n          Taskline 4.0 is here with AI-written status reports\n          <ArrowRight className=\"size-3.5\" />\n        </a>\n      </div>\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-sky-600 text-white text-sm\">\n              T\n            </span>\n            <span className=\"\">Taskline</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Sign in\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Start free trial\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"relative overflow-hidden border-b\">\n        <div className=\"pointer-events-none absolute inset-x-0 top-0 -z-10 h-96 bg-gradient-to-b from-sky-500/25 to-transparent opacity-50\" />\n        <div className=\"mx-auto max-w-7xl px-6 pt-16 pb-16 md:pt-28\">\n          <div className=\"mx-auto max-w-4xl space-y-7 text-center\">\n            <span className=\"inline-flex items-center gap-2 rounded-full border bg-background text-muted-foreground px-3 py-1 text-xs font-medium\">\n              <Sparkles className=\"size-3.5 text-sky-600 dark:text-sky-400\" />\n              New: AI status reports\n            </span>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-7xl \">\n              {\"Plan, track and ship work in \"}\n              <span className=\"text-sky-600 dark:text-sky-400\">one place</span>\n            </h1>\n            <p className=\"mx-auto max-w-2xl text-lg leading-8 text-muted-foreground\">\n              Taskline brings projects, docs and reporting together so your team\n              spends less time updating tools and more time doing the work.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Start free trial\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Book a demo\n              </Button>\n            </div>\n          </div>\n          <div className=\"mx-auto mt-16 max-w-6xl\">\n            <HeroVisual />\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-12\">\n          <p className=\"text-center text-sm text-muted-foreground\">\n            Trusted by operations teams at\n          </p>\n          <div className=\"mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-6 sm:grid-cols-4 lg:grid-cols-8\">\n            {logos.map((logo) => (\n              <div\n                key={logo}\n                className=\"text-center text-base font-semibold tracking-tight text-muted-foreground/70 \"\n              >\n                {logo}\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <p className=\"text-sm font-medium text-sky-600 dark:text-sky-400\">\n              Platform\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              Everything your team needs to ship on schedule\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              One workspace for planning, tracking and reporting, built to\n              replace the five tools you are juggling today.\n            </p>\n          </div>\n          <div className=\"mt-14 grid overflow-hidden rounded-2xl border sm:grid-cols-2 lg:grid-cols-3\">\n            {features.map((feature) => (\n              <div\n                key={feature.title}\n                className=\"-mt-px -ml-px border-t border-l p-8\"\n              >\n                <feature.icon className=\"size-6 text-sky-600 dark:text-sky-400\" />\n                <h3 className=\"mt-5 font-semibold\">{feature.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Integrations that fit your stack\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                Connect the tools you already pay for. Two-way sync keeps every\n                system in step without a single CSV export.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a\n                key={item.name}\n                href=\"#\"\n                className=\"group flex flex-col rounded-xl border p-6 transition-colors hover:bg-muted/40\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"flex size-10 items-center justify-center rounded-lg border bg-muted/50 font-semibold \">\n                    {item.name.charAt(0)}\n                  </span>\n                  <span className=\"rounded-full bg-sky-500/10 px-2.5 py-0.5 text-xs font-medium text-sky-600 dark:text-sky-400\">\n                    {item.tag}\n                  </span>\n                </div>\n                <h3 className=\"mt-6 font-semibold \">{item.name}</h3>\n                <p className=\"mt-1 flex-1 text-sm text-muted-foreground\">\n                  {item.meta}\n                </p>\n                <div className=\"mt-6 flex items-center justify-between border-t pt-4 text-sm\">\n                  <span className=\"font-medium\">{item.price}</span>\n                  <ArrowUpRight className=\"size-4 text-muted-foreground transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5\" />\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Up and running in an afternoon\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-sky-600 dark:text-sky-400\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl grid-cols-2 px-6 lg:grid-cols-4\">\n          {stats.slice(0, 4).map((stat, i) => (\n            <div\n              key={stat.label}\n              className={`py-12 ${i > 0 ? \"lg:border-l lg:pl-8\" : \"\"} ${i % 2 === 1 ? \"border-l pl-6 lg:pl-8\" : \"\"} `}\n            >\n              <div className=\"text-4xl font-semibold tracking-tight md:text-5xl \">\n                {stat.value}\n              </div>\n              <div className=\"mt-2 text-sm text-muted-foreground\">\n                {stat.label}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Teams that switched never looked back\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-6 md:grid-cols-3\">\n            {testimonials.map((t) => (\n              <figure\n                key={t.name}\n                className=\"flex flex-col rounded-2xl border p-6\"\n              >\n                <blockquote className=\"flex-1 leading-7\">\n                  &ldquo;{t.quote}&rdquo;\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 border-t pt-6 text-sm\">\n                  <span className=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Simple pricing that scales with you\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Start free, upgrade when your team grows. Every plan includes\n              unlimited projects and guests.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-sky-500 shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-sky-600 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-sky-600 dark:text-sky-400\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Questions, answered\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Get in touch\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"px-6 py-20 md:py-28\">\n        <div className=\"relative mx-auto max-w-6xl overflow-hidden rounded-3xl border bg-sky-500/10 px-6 py-16 text-center md:py-24\">\n          <div className=\"pointer-events-none absolute -top-24 left-1/2 size-96 -translate-x-1/2 rounded-full bg-gradient-to-b from-sky-500/25 via-cyan-500/10 to-transparent blur-3xl\" />\n          <div className=\"relative mx-auto max-w-2xl space-y-6\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Ready to bring your team together?\n            </h2>\n            <p className=\"text-lg text-muted-foreground\">\n              Start free in under a minute. No credit card required.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Start free trial\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Book a demo\n              </Button>\n            </div>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-sky-600 text-white text-sm\">\n                T\n              </span>\n              <span className=\"\">Taskline</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              Work management for teams that ship.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Taskline. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  const bars = [38, 52, 44, 63, 58, 71, 66, 80, 74, 88, 83, 95]\n  return (\n    <div className=\"overflow-hidden rounded-xl border bg-card text-left text-card-foreground shadow-2xl/10\">\n      <div className=\"flex items-center gap-2 border-b px-4 py-3\">\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"ml-3 hidden rounded-md bg-muted px-3 py-0.5 text-[11px] text-muted-foreground sm:inline\">\n          app.taskline.com\n        </span>\n      </div>