{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "resizable-38",
  "type": "registry:example",
  "description": "Focusable handle with instructions for resizing via keyboard arrows.",
  "files": [
    {
      "path": "registry/designali/examples/resizable/resizable-38.tsx",
      "content": "import { Kbd, KbdGroup } from \"@workspace/ui/components/kbd\"\nimport {\n  ResizableHandle,\n  ResizablePanel,\n  ResizablePanelGroup,\n} from \"@workspace/ui/components/resizable\"\n\nexport default function KeyboardResizeHint() {\n  return (\n    <div className=\"flex w-full max-w-md flex-col gap-2\">\n      <ResizablePanelGroup orientation=\"horizontal\" className=\"h-36 border\">\n        <ResizablePanel defaultSize=\"50%\" minSize=\"20%\">\n          <div className=\"flex h-full items-center justify-center text-xs\">\n            Outline\n          </div>\n        </ResizablePanel>\n        <ResizableHandle\n          withHandle\n          aria-label=\"Resize outline\"\n          className=\"focus-visible:ring-2\"\n        />\n        <ResizablePanel defaultSize=\"50%\" minSize=\"20%\">\n          <div className=\"flex h-full items-center justify-center text-xs\">\n            Document\n          </div>\n        </ResizablePanel>\n      </ResizablePanelGroup>\n      <p className=\"flex flex-wrap items-center gap-1 text-xs text-muted-foreground\">\n        Tab to the handle, then press\n        <KbdGroup>\n          <Kbd>&larr;</Kbd>\n          <Kbd>&rarr;</Kbd>\n        </KbdGroup>\n        to resize or\n        <Kbd>Enter</Kbd>\n        to toggle.\n      </p>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}