      "path": "registry/designali/pages/gaming/landing-gaming-05/page.tsx",
      "content": "import {\n  Accessibility,\n  ArrowRight,\n  ArrowUpRight,\n  Check,\n  Cpu,\n  Headphones,\n  Map,\n  Plus,\n  RefreshCw,\n  Sparkles,\n  Swords,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Services\", \"Packages\", \"Process\", \"Work\", \"Contact\"]\n\nconst features = [\n  {\n    icon: Cpu,\n    title: \"CGI, 3D & motion\",\n    description:\n      \"3D renders, logo stingers and motion loops for trailers, socials and devlogs, made in the same style as your game.\",\n  },\n  {\n    icon: RefreshCw,\n    title: \"Design systems\",\n    description:\n      \"Tokens, components and docs that keep your site, launcher and in-game UI consistent as the team and the roadmap grow.\",\n  },\n  {\n    icon: Headphones,\n    title: \"Devlogs & socials\",\n    description:\n      \"Templates and motion assets for devlogs, patch notes and social posts, so your community updates always look on brand.\",\n  },\n  {\n    icon: Accessibility,\n    title: \"Accessible by design\",\n    description:\n      \"Readable type, colour-blind friendly palettes and clear UI states are built into every interface we design.\",\n  },\n  {\n    icon: Swords,\n    title: \"Game UI & HUD design\",\n    description:\n      \"Menus, inventories and HUDs designed in Figma and handed off as a clean, documented UI kit your engine team can build from.\",\n  },\n  {\n    icon: Map,\n    title: \"Studio brand identity\",\n    description:\n      \"Logo, wordmark, colour and type systems for your studio and your title, built to work on a store capsule and a 4K splash screen.\",\n  },\n]\n\nconst stats = [\n  { value: \"4 wks\", label: \"Average brand sprint\" },\n  { value: \"2300+\", label: \"UI examples to start from\" },\n  { value: \"50+\", label: \"Game screens designed per project\" },\n  { value: \"4000+\", label: \"Icons ready to use via @designali/icons\" },\n]\n\nconst steps = [\n  {\n    title: \"Share your game\",\n    description:\n      \"Send a build, a pitch deck or a few screenshots. Ali Imam reviews it and replies with ideas and a scope.\",\n  },\n  {\n    title: \"Discovery call\",\n    description:\n      \"A short call to understand your genre, audience, launch date and what the studio needs most.\",\n  },\n  {\n    title: \"Design sprint\",\n    description:\n      \"Brand, key art direction and UI concepts are explored in Figma with weekly reviews.\",\n  },\n  {\n    title: \"Build & launch\",\n    description:\n      \"The approved designs ship as a Next.js site and an engine-ready UI kit, tested before launch.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Indie action RPG\",\n    meta: \"Brand identity · Launch site\",\n    tag: \"Case study\",\n    price: \"6 wks\",\n    tile: \"bg-gradient-to-br from-muted via-border to-muted-foreground dark:from-muted dark:via-card dark:to-card\",\n  },\n  {\n    name: \"Cosy farming sim\",\n    meta: \"Key art · Store capsules\",\n    tag: \"Case study\",\n    price: \"3 wks\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-chart-1 dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Co-op horror\",\n    meta: \"Trailer motion · Socials\",\n    tag: \"Case study\",\n    price: \"5 wks\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Tactics game HUD\",\n    meta: \"Game UI · 4 weeks\",\n    tag: \"UI kit\",\n    price: \"4 wks\",\n    tile: \"bg-gradient-to-br from-primary/10 via-primary/20 to-chart-1 dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Esports team rebrand\",\n    meta: \"Brand system · Merch graphics\",\n    tag: \"Brand\",\n    price: \"Free\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Studio design system\",\n    meta: \"Tokens · Components · Docs\",\n    tag: \"System\",\n    price: \"Ongoing\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"Designali gave our small team a brand that sits comfortably next to much bigger games on the store.\",\n    name: \"Omar\",\n    role: \"Creative director, indie studio\",\n  },\n  {\n    quote:\n      \"Accessibility was part of the design from day one. Our menus are clearer and more players can enjoy the game.\",\n    name: \"Hana\",\n    role: \"Designali client\",\n  },\n  {\n    quote:\n      \"Ali understood our game in one call. The brand, the store art and the launch site all felt like they came from the same world.\",\n    name: \"Sam\",\n    role: \"Founder, indie game studio\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Launch Kit\",\n    price: \"$1,900\",\n    period: \"per project\",\n    description: \"Brand and launch site for a single title.\",\n    features: [\n      \"Logo and wordmark\",\n      \"Next.js launch site\",\n      \"Key art & store assets\",\n      \"Press kit page\",\n    ],\n    cta: \"Book Launch Kit\",\n  },\n  {\n    name: \"Studio\",\n    price: \"$4,900\",\n    period: \"per project\",\n    description: \"Brand, key art and site for a full launch.\",\n    features: [\n      \"Everything in Launch Kit\",\n      \"Key art and store capsules\",\n      \"Trailer logo stinger\",\n      \"Social media templates\",\n      \"72-hour early access\",\n    ],\n    cta: \"Book Studio\",\n  },\n  {\n    name: \"Full Production\",\n    price: \"$9,800\",\n    period: \"per project\",\n    description: \"For studios that want design end to end.\",\n    features: [\n      \"Everything in Studio\",\n      \"Motion trailer package\",\n      \"Game UI and HUD kit\",\n      \"CGI and 3D renders\",\n      \"Design system and docs\",\n    ],\n    cta: \"Start a project\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"What does the website stack look like?\",\n    a: \"Next.js, React, TypeScript and Tailwind CSS, deployed on Vercel, so the site is fast and easy for your team to update.\",\n  },\n  {\n    q: \"How long does a typical project take?\",\n    a: \"A Launch Kit usually takes three to four weeks. Studio and Full Production projects run six to ten weeks.\",\n  },\n  {\n    q: \"Which kinds of game studios does Designali work with?\",\n    a: \"Mostly indie and small studios, from solo developers to teams of a few dozen, across PC, console and mobile games.\",\n  },\n  {\n    q: \"Can you design in-game UI as well as the website?\",\n    a: \"Yes. Ali Imam designs both, so the store page, the launch site and the HUD share one visual language.\",\n  },\n  {\n    q: \"What do I receive at the end?\",\n    a: \"Figma source files, exported assets, a Next.js codebase where included, and documentation for your team.\",\n  },\n]\n\nconst footer = [\n  {\n    title: \"Services\",\n    links: [\"Packages\", \"Process\", \"UI kits\", \"Templates\"],\n  },\n  {\n    title: \"Work\",\n    links: [\"Instagram\", \"X\", \"LinkedIn\", \"Blog\"],\n  },\n  { title: \"Studio\", links: [\"About\", \"Pricing\", \"Docs\", \"Support\"] },\n]\n\nexport default function LandingGaming05() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <div className=\"border-b border-background/10 bg-foreground text-background/80 px-4 py-2 text-center text-xs sm:text-sm\">\n        <a\n          href=\"#\"\n          className=\"inline-flex items-center gap-1.5 hover:underline\"\n        >\n          Now booking platform and storefront design projects\n          <ArrowRight className=\"size-3.5\" />\n        </a>\n      </div>\n      <header className=\"bg-foreground text-background sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-background text-foreground text-sm\">\n              A\n            </span>\n            <span className=\"\">designali</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-background/70 hover:text-background transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex text-background hover:bg-background/10 hover:text-background\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Book a call\n            </Button>\n            <Button\n              size=\"sm\"\n              className=\"bg-background text-foreground hover:bg-background/90\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Start a project\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"relative overflow-hidden bg-foreground text-background\">\n        <div className=\"pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,currentColor_1px,transparent_1px),linear-gradient(to_bottom,currentColor_1px,transparent_1px)] bg-[size:64px_64px] opacity-[0.04]\" />\n        <div className=\"relative mx-auto max-w-7xl px-6 pt-16 pb-20 md:pt-28\">\n          <div className=\"max-w-4xl space-y-7\">\n            <span className=\"inline-flex items-center gap-2 rounded-full border border-background/20 text-background/80 px-3 py-1 text-xs font-medium\">\n              <Sparkles className=\"size-3.5 \" />\n              Design for game platforms\n            </span>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-7xl \">\n              {\"Design that works on \"}\n              <span className=\"text-background/60\">any screen</span>\n            </h1>\n            <p className=\"max-w-2xl text-lg leading-8 text-background/65\">\n              Designali designs responsive storefronts, launchers and libraries for TV, laptop and phone.\n              Built with Next.js, tested on every device and easy for your team to grow.\n            </p>\n            <div className=\"flex flex-wrap gap-3 \">\n              <Button\n                size=\"lg\"\n                className=\"bg-background text-foreground hover:bg-background/90\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Start a project\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                className=\"border-background/25 bg-transparent text-background hover:bg-background/10 hover:text-background\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                View packages\n              </Button>\n            </div>\n          </div>\n          <div className=\"mt-16\">\n            <HeroVisual />\n          </div>\n        </div>\n      </section>\n      <section className=\"bg-foreground text-background\">\n        <div className=\"mx-auto grid max-w-7xl grid-cols-2 px-6 lg:grid-cols-4\">\n          {stats.slice(0, 4).map((stat, i) => (\n            <div\n              key={stat.label}\n              className={`py-12 ${i > 0 ? \"lg:border-l lg:pl-8\" : \"\"} ${i % 2 === 1 ? \"border-l pl-6 lg:pl-8\" : \"\"} border-background/10`}\n            >\n              <div className=\"text-4xl font-semibold tracking-tight md:text-5xl \">\n                {stat.value}\n              </div>\n              <div className=\"mt-2 text-sm text-background/60\">\n                {stat.label}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"max-w-2xl\">\n            <p className=\"text-sm font-medium text-primary dark:text-primary\">\n              Gameplay\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              Built for game launches\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Brand, UI, art and code from one studio, so every touchpoint of\n              your game looks and feels like the same world.\n            </p>\n          </div>\n          <div className=\"mt-14 grid overflow-hidden rounded-2xl border sm:grid-cols-2 lg:grid-cols-3\">\n            {features.map((feature) => (\n              <div\n                key={feature.title}\n                className=\"-mt-px -ml-px border-t border-l p-8\"\n              >\n                <feature.icon className=\"size-6 text-primary dark:text-primary\" />\n                <h3 className=\"mt-5 font-semibold\">{feature.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Recent game projects\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                A few of the studios, genres and launches Designali has designed\n                for, from cosy sims to competitive tactics.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all work\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a key={item.name} href=\"#\" className=\"group\">\n                <div\n                  className={`relative aspect-[4/3] overflow-hidden rounded-2xl ${item.tile}`}\n                >\n                  <div className=\"absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10\" />\n                  <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-foreground backdrop-blur\">\n                    {item.tag}\n                  </span>\n                </div>\n                <div className=\"mt-4 flex items-start justify-between gap-4\">\n                  <div className=\"min-w-0\">\n                    <h3 className=\"font-medium \">{item.name}</h3>\n                    <p className=\"mt-1 text-sm text-muted-foreground\">\n                      {item.meta}\n                    </p>\n                  </div>\n                  <span className=\"shrink-0 text-sm font-semibold\">\n                    {item.price}\n                  </span>\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              How a project with Designali runs\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-primary dark:text-primary\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              What game studios say about Designali\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-6 md:grid-cols-3\">\n            {testimonials.map((t) => (\n              <figure\n                key={t.name}\n                className=\"flex flex-col rounded-2xl border p-6\"\n              >\n                <blockquote className=\"flex-1 leading-7\">\n                  &ldquo;{t.quote}&rdquo;\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 border-t pt-6 text-sm\">\n                  <span className=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Choose a package\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Every package includes Figma source files, a clear handoff and\n              support from Ali Imam through launch day.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"bg-foreground text-background border-foreground\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-background text-foreground px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p\n                    className={\n                      featured\n                        ? \"mt-2 text-sm text-background/65\"\n                        : \"mt-2 text-sm text-muted-foreground\"\n                    }\n                  >\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span\n                      className={\n                        featured\n                          ? \"text-sm text-background/65\"\n                          : \"text-sm text-muted-foreground\"\n                      }\n                    >\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check\n                          className={\n                            featured\n                              ? \"mt-0.5 size-4 shrink-0\"\n                              : \"mt-0.5 size-4 shrink-0 text-primary dark:text-primary\"\n                          }\n                        />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className={\n                      featured\n                        ? \"mt-8 w-full bg-background text-foreground hover:bg-background/90\"\n                        : \"mt-8 w-full\"\n                    }\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Frequently asked questions\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Contact us\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"bg-foreground text-background\">\n        <div className=\"mx-auto flex max-w-7xl flex-col gap-10 px-6 py-20 md:flex-row md:items-end md:justify-between md:py-28\">\n          <div className=\"max-w-2xl\">\n            <h2 className=\"text-4xl font-semibold tracking-tight text-balance md:text-6xl \">\n              Start a project in under a week\n            </h2>\n            <p className=\"mt-5 text-lg text-background/65\">\n              Book a free discovery call. No commitment, just ideas for your platform.\n            </p>\n          </div>\n          <div className=\"flex flex-wrap gap-3 \">\n            <Button\n              size=\"lg\"\n              className=\"bg-background text-foreground hover:bg-background/90\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Start a project\n              <ArrowRight />\n            </Button>\n            <Button\n              size=\"lg\"\n              variant=\"outline\"\n              className=\"border-background/25 bg-transparent text-background hover:bg-background/10 hover:text-background\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View packages\n            </Button>\n          </div>\n        </div>\n      </section>\n      <footer className=\"border-t border-background/10 bg-foreground text-background\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-background text-foreground text-sm\">\n                A\n              </span>\n              <span className=\"\">designali</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-background/60\">\n              Your platform, designed and built.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-background/60 transition-colors hover:text-background\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>