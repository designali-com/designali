{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "input-otp-33",
  "type": "registry:example",
  "description": "Confirm an email change by showing old and new addresses above the code input.",
  "files": [
    {
      "path": "registry/designali/examples/input-otp/input-otp-33.tsx",
      "content": "\"use client\"\n\nimport { REGEXP_ONLY_DIGITS } from \"input-otp\"\nimport {\n  ArrowRight as ArrowRightIcon,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport { Field, FieldLabel } from \"@workspace/ui/components/field\"\nimport {\n  InputOTP,\n  InputOTPGroup,\n  InputOTPSlot,\n} from \"@workspace/ui/components/input-otp\"\n\nexport default function ChangeEmailConfirmation() {\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-4\">\n      <div className=\"flex items-center gap-2 border bg-muted/40 p-3 text-xs\">\n        <span className=\"truncate text-muted-foreground line-through\">\n          ali@example.com\n        </span>\n        <ArrowRightIcon className=\"size-3.5 shrink-0\" />\n        <span className=\"truncate font-medium\">ali@designali.com</span>\n      </div>\n      <Field>\n        <FieldLabel htmlFor=\"change-email-otp\">\n          Code sent to your new address\n        </FieldLabel>\n        <InputOTP\n          id=\"change-email-otp\"\n          maxLength={6}\n          pattern={REGEXP_ONLY_DIGITS}\n        >\n          <InputOTPGroup>\n            <InputOTPSlot index={0} />\n            <InputOTPSlot index={1} />\n            <InputOTPSlot index={2} />\n            <InputOTPSlot index={3} />\n            <InputOTPSlot index={4} />\n            <InputOTPSlot index={5} />\n          </InputOTPGroup>\n        </InputOTP>\n      </Field>\n      <div className=\"flex gap-2\">\n        <Button variant=\"outline\" size=\"sm\">\n          Cancel change\n        </Button>\n        <Button size=\"sm\">Confirm email</Button>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}