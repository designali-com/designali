      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  Award,\n  Check,\n  Leaf,\n  Plus,\n  Recycle,\n  RotateCcw,\n  Sparkles,\n  Tag,\n  Truck,\n} from \"@designali/icons\"\n\nimport { Logo } from \"@/src/components/logo\"\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Store\", \"Templates\", \"Blocks\", \"Work\", \"Blog\"]\n\nconst logos = [\n  \"Next.js\",\n  \"React\",\n  \"TypeScript\",\n  \"Tailwind CSS\",\n  \"Figma\",\n  \"Vercel\",\n  \"Stripe\",\n  \"shadcn/ui\",\n]\n\nconst features = [\n  {\n    icon: Truck,\n    title: \"Store design and build\",\n    description:\n      \"Designali designs and codes fast Next.js storefronts with product pages, carts and checkout flows that convert.\",\n  },\n  {\n    icon: RotateCcw,\n    title: \"Own every file\",\n    description:\n      \"You get the Figma files and the full codebase, with no platform lock-in and no monthly theme fees.\",\n  },\n  {\n    icon: Leaf,\n    title: \"Brand identity\",\n    description:\n      \"Logos, packaging graphics, colour and type that make a product brand feel premium from the first click.\",\n  },\n  {\n    icon: Award,\n    title: \"Lifetime updates\",\n    description:\n      \"Templates and blocks bought on designali.com get free updates whenever Ali ships improvements.\",\n  },\n  {\n    icon: Recycle,\n    title: \"CGI product renders\",\n    description:\n      \"3D renders and motion loops of your products for hero banners, ads and product pages.\",\n  },\n  {\n    icon: Tag,\n    title: \"Fair, transparent prices\",\n    description:\n      \"Fixed project quotes and simple one-time prices in the Designali store. No hidden fees.\",\n  },\n]\n\nconst stats = [\n  { value: \"460+\", label: \"Blocks in the store\" },\n  { value: \"4.9/5\", label: \"Average customer rating\" },\n  { value: \"48h\", label: \"Typical project reply time\" },\n  { value: \"100%\", label: \"CGI product renders\" },\n]\n\nconst steps = [\n  {\n    title: \"Designed in Figma\",\n    description:\n      \"Every template, block and store starts as a carefully considered design by Ali Imam.\",\n  },\n  {\n    title: \"Coded in Next.js\",\n    description:\n      \"Designs become typed React and Tailwind CSS code, using semantic tokens and accessible components.\",\n  },\n  {\n    title: \"Checked by hand\",\n    description:\n      \"Every page is reviewed on real devices in light and dark mode before it ships.\",\n  },\n  {\n    title: \"Delivered to you\",\n    description:\n      \"Download from designali.com or receive your finished store, ready to deploy on Vercel.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Portfolio Template\",\n    meta: \"Next.js · Light and dark\",\n    tag: \"Bestseller\",\n    price: \"$49\",\n    tile: \"bg-gradient-to-br from-primary/10 via-primary/20 to-chart-1 dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Design Agency Template\",\n    meta: \"Next.js · Figma file included\",\n    tag: \"New\",\n    price: \"$79\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Pro Blocks Bundle\",\n    meta: \"460+ copy-paste sections\",\n    tag: \"Bundle\",\n    price: \"$99\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"AI Startup Template\",\n    meta: \"Next.js · Tailwind CSS\",\n    tag: \"Bestseller\",\n    price: \"$69\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Apple Device Mockups\",\n    meta: \"iPhone, iPad, MacBook and iMac\",\n    tag: \"Component\",\n    price: \"$29\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-chart-1 dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Resort Template\",\n    meta: \"Hospitality landing page\",\n    tag: \"Updated\",\n    price: \"$59\",\n    tile: \"bg-gradient-to-br from-muted via-border to-muted-foreground dark:from-muted dark:via-card dark:to-card\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"The quality is unreal for the price. I bought one template and came back a week later for the full blocks bundle.\",\n    name: \"Emily W.\",\n    role: \"Verified designali.com customer\",\n  },\n  {\n    quote:\n      \"Designali rebuilt our online store in Next.js. Pages load instantly and the checkout finally feels like our brand.\",\n    name: \"Carlos M.\",\n    role: \"Verified designali.com customer\",\n  },\n  {\n    quote:\n      \"I had a question about a template at midnight and Ali answered before I woke up. Support that actually cares.\",\n    name: \"Yuki T.\",\n    role: \"Verified designali.com customer\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Free\",\n    price: \"$0\",\n    period: \"\",\n    description: \"Free blocks and UI examples, no account needed.\",\n    features: [\n      \"Store design and build\",\n      \"Own every file\",\n      \"Free blocks and icons\",\n      \"Email support\",\n    ],\n    cta: \"Browse free\",\n  },\n  {\n    name: \"Pro\",\n    price: \"$149\",\n    period: \"/one-time\",\n    description: \"The full Designali library for your own and client projects.\",\n    features: [\n      \"All 460+ blocks\",\n      \"All premium templates\",\n      \"Early access to new drops\",\n      \"Lifetime updates\",\n      \"Figma source files\",\n    ],\n    cta: \"Get Pro\",\n  },\n  {\n    name: \"Store build\",\n    price: \"Custom\",\n    period: \"\",\n    description: \"A custom online store designed and built by Designali.\",\n    features: [\n      \"Brand identity and UI/UX\",\n      \"Next.js storefront\",\n      \"Work directly with Ali Imam\",\n      \"Launch support on Vercel\",\n    ],\n    cta: \"Start a project\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"How fast do I get my files?\",\n    a: \"Store purchases are instant. A custom store build usually takes six to ten weeks from kickoff to launch.\",\n  },\n  {\n    q: \"What is your refund policy?\",\n    a: \"Digital products are covered by the terms at designali.com/docs/legal/terms. If something is broken, we fix it.\",\n  },\n  {\n    q: \"Do you work with brands worldwide?\",\n    a: \"Yes. Designali works remotely with product brands anywhere, with calls scheduled around your time zone.\",\n  },\n  {\n    q: \"How do I customise a template?\",\n    a: \"Every template includes docs, and detailed guides for theming and components are on designali.com/docs.\",\n  },\n  {\n    q: \"Can I change the scope of a project?\",\n    a: \"Yes. Scope is agreed up front and any changes are priced clearly before work continues.\",\n  },\n]\n\nconst footer = [\n  {\n    title: \"Store\",\n    links: [\"Templates\", \"Blocks\", \"Pages\", \"Icons\"],\n  },\n  { title: \"Help\", links: [\"Docs\", \"Licensing\", \"Pricing\", \"Contact us\"] },\n  {\n    title: \"About\",\n    links: [\"Work\", \"Ali Imam\", \"Instagram\", \"Blog\"],\n  },\n]\n\nexport default function LandingEcommerce01() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <div className=\"border-b bg-muted/50 text-muted-foreground px-4 py-2 text-center text-xs sm:text-sm\">\n        <a\n          href=\"#\"\n          className=\"inline-flex items-center gap-1.5 hover:underline\"\n        >\n          New: Pro Blocks Bundle in the Designali store\n          <ArrowRight className=\"size-3.5\" />\n        </a>\n      </div>\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <Logo className=\"h-5 w-auto\" />\n            <span className=\"\">{\"Designali\"}</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Cart (0)\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Start a project\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"relative overflow-hidden border-b\">\n        <div className=\"pointer-events-none absolute inset-x-0 top-0 -z-10 h-96 bg-gradient-to-b from-primary/25 to-transparent opacity-50\" />\n        <div className=\"mx-auto max-w-7xl px-6 pt-16 pb-16 md:pt-28\">\n          <div className=\"mx-auto max-w-4xl space-y-7 text-center\">\n            <span className=\"inline-flex items-center gap-2 rounded-full border bg-background text-muted-foreground px-3 py-1 text-xs font-medium\">\n              <Sparkles className=\"size-3.5 text-primary dark:text-primary\" />\n              Designali for home brands\n            </span>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-7xl \">\n              {\"Online stores for a \"}\n              <span className=\"text-primary dark:text-primary\">\n                slower kind of shopping\n              </span>\n            </h1>\n            <p className=\"mx-auto max-w-2xl text-lg leading-8 text-muted-foreground\">\n              {\n                \"Designali designs and builds online stores for home and textile brands, with calm product pages, rich imagery and a checkout that feels considered.\"\n              }\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Start a project\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Visit the store\n              </Button>\n            </div>\n          </div>\n          <div className=\"mx-auto mt-16 max-w-6xl\">\n            <HeroVisual />\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-12\">\n          <p className=\"text-center text-sm text-muted-foreground\">\n            Designed in Figma, built with\n          </p>\n          <div className=\"mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-6 sm:grid-cols-4 lg:grid-cols-8\">\n            {logos.map((logo) => (\n              <div\n                key={logo}\n                className=\"text-center text-base font-semibold tracking-tight text-muted-foreground/70 \"\n              >\n                {logo}\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <p className=\"text-sm font-medium text-primary dark:text-primary\">\n              Why work with Designali\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              Designed better, shipped faster\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Where thoughtful design meets production-ready code. One studio from brand to checkout, without hand-off gaps.\n            </p>\n          </div>\n          <div className=\"mt-14 grid overflow-hidden rounded-2xl border sm:grid-cols-2 lg:grid-cols-3\">\n            {features.map((feature) => (\n              <div\n                key={feature.title}\n                className=\"-mt-px -ml-px border-t border-l p-8\"\n              >\n                <feature.icon className=\"size-6 text-primary dark:text-primary\" />\n                <h3 className=\"mt-5 font-semibold\">{feature.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Bestsellers in the Designali store\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                The templates and bundles developers and founders keep coming back for. Instant download.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a key={item.name} href=\"#\" className=\"group\">\n                <div\n                  className={`relative aspect-[4/3] overflow-hidden rounded-2xl ${item.tile}`}\n                >\n                  <div className=\"absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10\" />\n                  <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-foreground backdrop-blur\">\n                    {item.tag}\n                  </span>\n                </div>\n                <div className=\"mt-4 flex items-start justify-between gap-4\">\n                  <div className=\"min-w-0\">\n                    <h3 className=\"font-medium \">{item.name}</h3>\n                    <p className=\"mt-1 text-sm text-muted-foreground\">\n                      {item.meta}\n                    </p>\n                  </div>\n                  <span className=\"shrink-0 text-sm font-semibold\">\n                    {item.price}\n                  </span>\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              From Figma to your storefront\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-primary dark:text-primary\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl grid-cols-2 px-6 lg:grid-cols-4\">\n          {stats.slice(0, 4).map((stat, i) => (\n            <div\n              key={stat.label}\n              className={`py-12 ${i > 0 ? \"lg:border-l lg:pl-8\" : \"\"} ${i % 2 === 1 ? \"border-l pl-6 lg:pl-8\" : \"\"} `}\n            >\n              <div className=\"text-4xl font-semibold tracking-tight md:text-5xl \">\n                {stat.value}\n              </div>\n              <div className=\"mt-2 text-sm text-muted-foreground\">\n                {stat.label}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              What customers and clients say\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-6 md:grid-cols-3\">\n            {testimonials.map((t) => (\n              <figure\n                key={t.name}\n                className=\"flex flex-col rounded-2xl border p-6\"\n              >\n                <blockquote className=\"flex-1 leading-7\">\n                  &ldquo;{t.quote}&rdquo;\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 border-t pt-6 text-sm\">\n                  <span className=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Pick your plan\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Start with free blocks, unlock the full library with Pro or have Designali build your store.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-primary shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-chart-2 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-primary dark:text-primary\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Downloads, licensing and projects\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Email hello@designali.com\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"px-6 py-20 md:py-28\">\n        <div className=\"relative mx-auto max-w-6xl overflow-hidden rounded-3xl border bg-primary/10 px-6 py-16 text-center md:py-24\">\n          <div className=\"pointer-events-none absolute -top-24 left-1/2 size-96 -translate-x-1/2 rounded-full bg-gradient-to-b from-primary/25 via-primary/10 to-transparent blur-3xl\" />\n          <div className=\"relative mx-auto max-w-2xl space-y-6\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Make your store a little softer\n            </h2>\n            <p className=\"text-lg text-muted-foreground\">\n              Book a free call with Ali and get a plan for your new online store.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Start a project\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Visit the store\n              </Button>\n            </div>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <Logo className=\"h-5 w-auto\" />\n              <span className=\"\">{\"Designali\"}</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              design se code tak\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} {\"Designali\"}. All rights\n              reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  return (\n    <div className=\"grid grid-cols-2 gap-3 md:grid-cols-3\">\n      {showcase.slice(0, 3).map((item, i) => (\n        <div\n          key={item.name}\n          classNa