{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "navigation-07",
  "type": "registry:block",
  "description": "Dismissible live event announcement bar above a nav with dropdown links, language picker, log in and CTA.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "button"
  ],
  "files": [
    {
      "path": "registry/designali/blocks/navigation/navigation-07.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\nimport { ArrowRight, ChevronDown, Globe, X } from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst links = [\"Platform\", \"Solutions\", \"Developers\", \"Pricing\", \"Company\"]\n\nexport default function Navigation07() {\n  const [banner, setBanner] = useState(true)\n\n  return (\n    <section className=\"w-full bg-background\">\n      {banner && (\n        <div className=\"bg-foreground text-background\">\n          <div className=\"mx-auto flex max-w-7xl items-center gap-4 px-6 py-2.5\">\n            <p className=\"flex-1 text-center text-xs sm:text-sm\">\n              <span className=\"me-2 border border-background/30 px-1.5 py-0.5 text-[10px] tracking-widest uppercase\">\n                Live\n              </span>\n              Relay Summit keynote starts Thursday 10:00 PT.{\" \"}\n              <a\n                href=\"#\"\n                className=\"inline-flex items-center gap-1 font-medium underline underline-offset-4\"\n              >\n                Save your seat\n                <ArrowRight className=\"size-3\" />\n              </a>\n            </p>\n            <button\n              type=\"button\"\n              aria-label=\"Dismiss announcement\"\n              onClick={() => setBanner(false)}\n              className=\"flex size-6 shrink-0 items-center justify-center text-background/70 hover:text-background\"\n            >\n              <X className=\"size-4\" />\n            </button>\n          </div>\n        </div>\n      )}\n\n      <div className=\"hidden border-b bg-muted/40 md:block\">\n        <div className=\"mx-auto flex h-9 max-w-7xl items-center justify-end gap-6 px-6 text-xs text-muted-foreground\">\n          <a href=\"#\" className=\"hover:text-foreground\">Status: all systems normal</a>\n          <a href=\"#\" className=\"hover:text-foreground\">Support</a>\n          <a href=\"#\" className=\"hover:text-foreground\">Contact sales</a>\n          <button type=\"button\" className=\"flex items-center gap-1 hover:text-foreground\">\n            <Globe className=\"size-3.5\" />\n            English\n            <ChevronDown className=\"size-3\" />\n          </button>\n        </div>\n      </div>\n\n      <nav className=\"border-b\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center gap-10 px-6\">\n          <a href=\"#\" className=\"flex items-center gap-2 font-semibold tracking-tight\">\n            <span className=\"grid size-6 grid-cols-2 gap-0.5\">\n              <span className=\"bg-foreground\" />\n              <span className=\"bg-foreground/40\" />\n              <span className=\"bg-foreground/40\" />\n              <span className=\"bg-foreground\" />\n            </span>\n            Relay\n          </a>\n          <ul className=\"hidden flex-1 items-center gap-6 lg:flex\">\n            {links.map((link) => (\n              <li key={link}>\n                <a\n                  href=\"#\"\n                  className=\"text-sm text-muted-foreground transition-colors hover:text-foreground\"\n                >\n                  {link}\n                </a>\n              </li>\n            ))}\n          </ul>\n          <div className=\"ms-auto flex items-center gap-2\">\n            <Button variant=\"ghost\" className=\"hidden sm:inline-flex\" nativeButton={false} render={<a href=\"#\" />}>\n              Log in\n            </Button>\n            <Button nativeButton={false} render={<a href=\"#\" />}>\n              Start building\n            </Button>\n          </div>\n        </div>\n      </nav>\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "300px"
  },
  "categories": [
    "navigation"
  ]
}