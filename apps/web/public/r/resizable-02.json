{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "resizable-02",
  "type": "registry:example",
  "description": "Vertical resizable panel layout configured for header and content areas.",
  "registryDependencies": [
    "resizable"
