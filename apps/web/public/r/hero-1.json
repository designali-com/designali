{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "hero-1",
  "type": "registry:block",
  "description": "A split-screen hero section with branding, theme toggle, video, work, and contact cards.",
  "files": [
    {
      "path": "registry/designali/blocks/hero/hero-1.tsx",
      "content": "\"use client\";\n\nimport Link from \"next/link\";\n\nimport {\n  ArrowDown,\n  ArrowRight,\n  Moon,\n  Sun,\n} from \"lucide-react\";\n\nimport { Button } from \"@workspace/ui/components/button\";\nimport { Card } from \"@workspace/ui/components/card\";\nimport { useTheme } from \"next-themes\";\nimport { useEffect, useState } from \"react\";\nimport { Logo } from \"@workspace/ui/designali/logo\";\n\nexport function HeroSection() {\n  const { theme, setTheme } = useTheme();\n  const [mounted, setMounted] = useState(false);\n\n  useEffect(() => {\n    setMounted(true);\n  }, []);\n\n  return (\n    <section className=\"min-h-screen w-full bg-background text-foreground\">\n      <div className=\"grid min-h-screen grid-cols-1 lg:grid-cols-2\">\n\n        <div className=\"relative flex min-h-screen flex-col border-r border-border\">\n\n          <div className=\"relative flex h-[150px] items-center overflow-hidden border-b border-border px-8 sm:px-12 lg:px-16\">\n\n            <div\n              className=\"\n                pointer-events-none\n                absolute\n                inset-0\n                opacity-40\n                dark:opacity-20\n              \"\n              style={{\n                backgroundImage:\n                  \"radial-gradient(circle, currentColor 1.5px, transparent 1.5px)\",\n                backgroundSize: \"22px 22px\",\n              }}\n            />\n\n\n            <div className=\"pointer-events-none absolute inset-0 bg-gradient-to-r from-background/90 via-background/80 to-background\" />\n\n            {/* Logo */}\n            <div className=\"relative z-10\">\n              <Link\n                href=\"/\"\n                className=\"uppercase\n                  text-4xl \n                  font-medium\n                  flex gap-4\n                  items-center\n                \"\n              >\n                <Logo className=\"h-8 w-full\" />\n                designali\n              </Link>\n            </div>\n\n            {/* Theme Button */}\n            <div className=\"relative z-10 ml-auto\">\n              {mounted && (\n                <Button\n                  variant=\"outline\"\n                  size=\"icon\"\n                  className=\"rounded-full\"\n                  onClick={() =>\n                    setTheme(theme === \"dark\" ? \"light\" : \"dark\")\n                  }\n                >\n                  {theme === \"dark\" ? (\n                    <Sun className=\"size-4\" />\n                  ) : (\n                    <Moon className=\"size-4\" />\n                  )}\n\n                  <span className=\"sr-only\">\n                    Toggle theme\n                  </span>\n                </Button>\n              )}\n            </div>\n          </div>\n\n          {/* --------------------------------------------- */}\n          {/* CONTENT */}\n          {/* --------------------------------------------- */}\n\n          <div className=\"flex flex-1 flex-col justify-end px-8 py-12 sm:px-12 lg:px-16 lg:pb-14\">\n\n            <div className=\"max-w-[760px]\">\n\n              {/* Heading */}\n              <h1\n                className=\"\n                  text-3xl\n                  md:text-4xl\n                  xl:text-5xl\n                  font-medium  \n                \"\n              >\n                We are a study of production creative\n                for CGI, 3D, motion and development web.\n              </h1>\n\n              {/* Description */}\n              <p\n                className=\"\n                  mt-8  \n                  text-muted-foreground \n                \"\n              >\n                Designali combines art direction, CGI, motion\n                design, web development, and integrated AI\n                workflows with ongoing R&D, experimentation,\n                and production-ready execution for brands\n                and agencies.\n              </p>\n\n              {/* Scroll */}\n              <Button\n                variant=\"outline\"\n                className=\"\n                  mt-7 \n                  gap-3  \n                  text-xs\n                  uppercase  \n                \"\n              >\n                Scroll to explore\n                <ArrowDown className=\"size-4\" />\n              </Button>\n            </div>\n          </div>\n        </div>\n\n\n        <div className=\"grid min-h-screen grid-rows-[1fr_auto]\">\n\n          <div className=\"relative min-h-[500px] overflow-hidden bg-muted\">\n            <video\n              className=\"absolute inset-0 h-full w-full object-cover\"\n              src=\"/vid/colorful-spheres.mp4\"\n              autoPlay\n              muted\n              loop\n              playsInline\n            />\n          </div>\n\n          <div className=\"grid grid-cols-2\">\n\n            {/* WORK */}\n            <Card\n              className=\"\n                group\n                min-h-[280px]\n                rounded-none\n                border-0\n                border-t \n                p-7 \n                bg-background  \n                text-foreground\n              \"\n            >\n              <Link\n                href=\"/work\"\n                className=\"\n                  flex\n                  h-full\n                  flex-col\n                  justify-between\n                \"\n              >\n\n                <div className=\"flex justify-end\">\n                  <ArrowRight\n                    className=\"\n                      size-5\n                      text-muted-foreground\n                      transition-transform\n                      duration-300\n                      group-hover:translate-x-2\n                      group-hover:text-foreground\n                    \"\n                  />\n                </div>\n\n                <div>\n                  <h2\n                    className=\"\n                       text-xl\n                      md:text-3xl\n                    \"\n                  >\n                    Work\n                  </h2>\n\n                  <p className=\"mt-2 text-sm text-muted-foreground sm:text-base\">\n                    Explore the portfolio\n                  </p>\n                </div>\n\n              </Link>\n            </Card>\n\n            {/* CONTACT */}\n            <Card\n              className=\"\n                group\n                min-h-[280px]\n                rounded-none\n                border-0\n                border-l\n                border-t\n                border-border\n                bg-foreground\n                p-7\n                text-background \n              \"\n            >\n              <Link\n                href=\"/contact\"\n                className=\"\n                  flex\n                  h-full\n                  flex-col\n                  justify-between\n                \"\n              >\n\n                <div className=\"flex justify-end\">\n                  <ArrowRight\n                    className=\"\n                      size-5\n                      opacity-60\n                      transition-transform\n                      duration-300\n                      group-hover:translate-x-2\n                    \"\n                  />\n                </div>\n\n                <div>\n                  <h2\n                    className=\"\n                    text-xl\n                      md:text-3xl\n                      font-medium\n                    \"\n                  >\n                    Contact us\n                  </h2>\n\n                  <p className=\"mt-2 text-sm opacity-60 sm:text-base\">\n                    Start your project\n                  </p>\n                </div>\n\n              </Link>\n            </Card>\n\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}",
      "type": "registry:block"
    }
  ],
  "meta": {
    "iframeHeight": "800px",
    "container": "",
    "mobile": "component"
  },
  "categories": [
    "hero"
  ]
}