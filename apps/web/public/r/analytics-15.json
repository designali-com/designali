{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "analytics-15",
  "type": "registry:block",
  "description": "Sticky device-mix summary beside 100% stacked horizontal bars per month with in-bar labels.",
  "dependencies": [],
  "registryDependencies": [],
  "files": [
    {
      "path": "registry/designali/blocks/analytics/analytics-15.tsx",
      "content": "import { IPhone } from \"@/registry/designali/ui/apple/iphone\"\nimport { Macbook } from \"@/registry/designali/ui/apple/macbook\"\n\nconst devices = [\n  { key: \"desktop\", label: \"Desktop\", color: \"var(--chart-1)\" },\n  { key: \"mobile\", label: \"Mobile\", color: \"var(--chart-2)\" },\n  { key: \"tablet\", label: \"Tablet\", color: \"var(--chart-3)\" },\n  { key: \"app\", label: \"Native app\", color: \"var(--chart-4)\" },\n] as const\n\nconst months: { month: string; desktop: number; mobile: number; tablet: number; app: number }[] = [\n  { month: \"June\", desktop: 48, mobile: 37, tablet: 9, app: 6 },\n  { month: \"July\", desktop: 45, mobile: 39, tablet: 9, app: 7 },\n  { month: \"August\", desktop: 43, mobile: 40, tablet: 8, app: 9 },\n  { month: \"September\", desktop: 41, mobile: 41, tablet: 8, app: 10 },\n  { month: \"October\", desktop: 38, mobile: 43, tablet: 7, app: 12 },\n  { month: \"November\", desktop: 35, mobile: 44, tablet: 7, app: 14 },\n]\n\nexport default function Analytics15() {\n  return (\n    <section className=\"w-full bg-muted/40 py-16 text-foreground md:py-24\">\n      <div className=\"mx-auto max-w-7xl px-6\">\n        <div className=\"grid gap-12 lg:grid-cols-[1fr_2fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <p className=\"text-xs tracking-widest text-muted-foreground uppercase\">Device mix</p>\n            <h2 className=\"mt-2 text-3xl font-medium tracking-tight\">\n              Mobile overtook desktop in September\n            </h2>\n            <p className=\"mt-4 text-sm leading-6 text-muted-foreground\">\n              Share of sessions on designali.com by device. The native app has\n              more than doubled since the June release of the Designali Icons app.\n            </p>\n            <ul className=\"mt-8 space-y-3\">\n              {devices.map((d) => {\n                const first = months[0]?.[d.key] ?? 0\n                const last = months[months.length - 1]?.[d.key] ?? 0\n                const delta = last - first\n                return (\n                  <li key={d.key} className=\"flex items-center gap-3 text-sm\">\n                    <span className=\"size-3\" style={{ background: d.color }} />\n                    <span className=\"flex-1\">{d.label}</span>\n                    <span className=\"font-sans\">{last}%</span>\n                    <span\n                      className={\n                        delta >= 0\n                          ? \"w-12 text-right font-sans text-xs text-primary dark:text-primary\"\n                          : \"w-12 text-right font-sans text-xs text-primary dark:text-primary\"\n                      }\n                    >\n                      {delta > 0 ? \"+\" : \"\"}\n                      {delta}\n                    </span>\n                  </li>\n                )\n              })}\n            </ul>\n            <div className=\"relative mt-10 flex max-w-full items-end\">\n              <Macbook variant=\"macbook-air\" color=\"silver\" size=\"sm\" className=\"max-w-full\">\n                <img\n                  src=\"/img/dashboard-1-light.jpg\"\n                  alt=\"Designali dashboard on desktop\"\n                  className=\"size-full object-cover object-top dark:hidden\"\n                />\n                <img\n                  src=\"/img/dashboard-1-dark.jpg\"\n                  alt=\"Designali dashboard on desktop\"\n                  className=\"hidden size-full object-cover object-top dark:block\"\n                />\n              </Macbook>\n              <IPhone size=\"sm\" color=\"silver\" className=\"absolute right-0 -bottom-4 h-48!\">\n                <img\n                  src=\"/img/chat-1-light.jpg\"\n                  alt=\"Designali on mobile\"\n                  className=\"size-full object-cover dark:hidden\"\n                />\n                <img\n                  src=\"/img/chat-1-dark.jpg\"\n                  alt=\"Designali on mobile\"\n                  className=\"hidden size-full object-cover dark:block\"\n                />\n              </IPhone>\n            </div>\n          </div>\n\n          <div className=\"space-y-5 border bg-background p-6 md:p-8\">\n            {months.map((m) => (\n              <div key={m.month} className=\"grid grid-cols-[5.5rem_1fr] items-center gap-4\">\n                <span className=\"text-sm text-muted-foreground\">{m.month}</span>\n                <div className=\"flex h-9 w-full overflow-hidden\">\n                  {devices.map((d) => (\n                    <div\n                      key={d.key}\n                      className=\"flex items-center justify-center text-[10px] font-medium text-background\"\n                      style={{ width: `${m[d.key]}%`, background: d.color }}\n                      title={`${d.label}: ${m[d.key]}%`}\n                    >\n                      {m[d.key] >= 10 ? `${m[d.key]}%` : \"\"}\n                    </div>\n                  ))}\n                </div>\n              </div>\n            ))}\n            <div className=\"grid grid-cols-[5.5rem_1fr] gap-4 pt-2\">\n              <span />\n              <div className=\"flex justify-between font-sans text-[10px] text-muted-foreground\">\n                <span>0%</span>\n                <span>50%</span>\n                <span>100%</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "700px"
  },
  "categories": [
    "analytics"
  ]
}