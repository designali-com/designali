{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "menubar-20",
  "type": "registry:example",
  "description": "Chat conversation menubar with a mute duration radio submenu, pin toggle and leave action.",
  "files": [
    {
      "path": "registry/designali/examples/menubar/menubar-20.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  BellOff as BellOffIcon,\n  LogOut as LogOutIcon,\n  Search as SearchIcon,\n} from \"@designali/icons\"\n\nimport { Avatar, AvatarFallback } from \"@workspace/ui/components/avatar\"\nimport {\n  Menubar,\n  MenubarCheckboxItem,\n  MenubarContent,\n  MenubarGroup,\n  MenubarItem,\n  MenubarMenu,\n  MenubarRadioGroup,\n  MenubarRadioItem,\n  MenubarSeparator,\n  MenubarSub,\n  MenubarSubContent,\n  MenubarSubTrigger,\n  MenubarTrigger,\n} from \"@workspace/ui/components/menubar\"\n\nexport default function ChatConversationMenubar() {\n  const [mute, setMute] = React.useState(\"off\")\n  const [pinned, setPinned] = React.useState(false)\n\n  return (\n    <div className=\"w-full max-w-sm border\">\n      <div className=\"flex items-center gap-2 border-b p-2\">\n        <Avatar className=\"size-7\">\n          <AvatarFallback>DS</AvatarFallback>\n        </Avatar>\n        <div className=\"min-w-0 flex-1\">\n          <p className=\"truncate text-sm font-medium\">#design-systems</p>\n          <p className=\"text-[11px] text-muted-foreground\">\n            {mute === \"off\" ? \"Notifications on\" : \"Muted \" + mute}\n            {pinned && \" · Pinned\"}\n          </p>\n        </div>\n        <Menubar className=\"border-0 p-0\">\n          <MenubarMenu>\n            <MenubarTrigger>Conversation</MenubarTrigger>\n            <MenubarContent align=\"end\" alignOffset={0}>\n              <MenubarGroup>\n                <MenubarSub>\n                  <MenubarSubTrigger>\n                    <BellOffIcon /> Mute\n                  </MenubarSubTrigger>\n                  <MenubarSubContent>\n                    <MenubarRadioGroup value={mute} onValueChange={setMute}>\n                      <MenubarRadioItem value=\"off\">\n                        Don&apos;t mute\n                      </MenubarRadioItem>\n                      <MenubarRadioItem value=\"for 1 hour\">\n                        For 1 hour\n                      </MenubarRadioItem>\n                      <MenubarRadioItem value=\"until tomorrow\">\n                        Until tomorrow\n                      </MenubarRadioItem>\n                      <MenubarRadioItem value=\"forever\">\n                        Until I turn it back on\n                      </MenubarRadioItem>\n                    </MenubarRadioGroup>\n                  </MenubarSubContent>\n                </MenubarSub>\n                <MenubarCheckboxItem\n                  checked={pinned}\n                  onCheckedChange={setPinned}\n                >\n                  Pin to top\n                </MenubarCheckboxItem>\n                <MenubarItem>\n                  <SearchIcon /> Search in conversation\n                </MenubarItem>\n              </MenubarGroup>\n              <MenubarSeparator />\n              <MenubarGroup>\n                <MenubarItem variant=\"destructive\">\n                  <LogOutIcon /> Leave channel\n                </MenubarItem>\n              </MenubarGroup>\n            </MenubarContent>\n          </MenubarMenu>\n        </Menubar>\n      </div>\n      <div className=\"space-y-2 p-3 text-xs\">\n        <p>\n          <span className=\"font-medium\">Ali:</span> Designali tokens are merged, please\n          review the spacing scale.\n        </p>\n        <p>\n          <span className=\"font-medium\">Designer:</span> On it after standup.\n        </p>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}