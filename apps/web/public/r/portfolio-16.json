{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "portfolio-16",
  "type": "registry:block",
  "description": "Awards list with year column beside sidebars for press mentions and speaking engagements.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "registry/designali/blocks/portfolio/portfolio-16.tsx",
      "content": "import { Award, Mic, Newspaper } from \"@designali/icons\"\n\nconst awards = [\n  {\n    year: \"Now\",\n    name: \"460+ blocks\",\n    detail: \"Live on designali.com\",\n    project: \"Designali\",\n  },\n  {\n    year: \"Now\",\n    name: \"4000+ icons\",\n    detail: \"Published as @designali/icons\",\n    project: \"Designali\",\n  },\n  {\n    year: \"Live\",\n    name: \"240+ landing pages\",\n    detail: \"Templates for Next.js\",\n    project: \"Designali\",\n  },\n  {\n    year: \"Live\",\n    name: \"2300+ UI designs\",\n    detail: \"UI examples to remix\",\n    project: \"Designali\",\n  },\n  {\n    year: \"Archive\",\n    name: \"Dalim UI\",\n    detail: \"Became the Designali block library\",\n    project: \"Dalim\",\n  },\n]\n\nconst press = [\n  {\n    outlet: \"Designali Blog\",\n    title: \"Design se code tak: why I design and code\",\n  },\n  {\n    outlet: \"Designali Blog\",\n    title: \"Building 460+ blocks with Next.js and Tailwind\",\n  },\n  { outlet: \"Designali Blog\", title: \"From Dalim to Designali\" },\n]\n\nconst talks = [\n  {\n    event: \"Designali Live\",\n    city: \"Online\",\n    topic: \"Design systems that ship as code\",\n  },\n  {\n    event: \"Designali Live\",\n    city: \"Online\",\n    topic: \"Icons on one grid, one stroke\",\n  },\n]\n\nexport default function Portfolio16() {\n  return (\n    <section className=\"w-full bg-background py-16 text-foreground md:py-24\">\n      <div className=\"mx-auto max-w-6xl px-6\">\n        <div className=\"grid gap-12 lg:grid-cols-[2fr_1fr]\">\n          <div>\n            <div className=\"flex items-center gap-3\">\n              <Award className=\"size-5\" />\n              <h2 className=\"text-2xl font-medium tracking-tight md:text-3xl\">\n                Milestones\n              </h2>\n              <span className=\"ml-auto font-sans text-xs text-muted-foreground\">\n                {awards.length} of 31\n              </span>\n            </div>\n            <ul className=\"mt-6 border-t border-border\">\n              {awards.map((award) => (\n                <li\n                  key={award.name + award.year}\n                  className=\"grid grid-cols-[3.5rem_1fr] gap-x-4 gap-y-1 border-b border-border py-5 sm:grid-cols-[4rem_1fr_1fr_auto] sm:items-center\"\n                >\n                  <span className=\"row-span-2 font-sans text-sm text-muted-foreground sm:row-span-1\">\n                    {award.year}\n                  </span>\n                  <span className=\"font-medium\">{award.name}</span>\n                  <span className=\"text-sm text-muted-foreground\">\n                    {award.detail}\n                  </span>\n                  <span className=\"col-start-2 text-xs text-muted-foreground sm:col-start-auto sm:text-right\">\n                    {award.project}\n                  </span>\n                </li>\n              ))}\n            </ul>\n          </div>\n\n          <div className=\"space-y-10\">\n            <div>\n              <div className=\"flex items-center gap-3\">\n                <Newspaper className=\"size-4\" />\n                <h3 className=\"text-sm font-medium\">On the blog</h3>\n              </div>\n              <ul className=\"mt-4 space-y-4\">\n                {press.map((item) => (\n                  <li key={item.title}>\n                    <a\n                      href=\"#\"\n                      className=\"group block border-l-2 border-border pl-4 transition-colors hover:border-foreground\"\n                    >\n                      <p className=\"text-xs text-muted-foreground\">\n                        {item.outlet}\n                      </p>\n                      <p className=\"mt-1 text-sm font-medium group-hover:underline\">\n                        &ldquo;{item.title}&rdquo;\n                      </p>\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n            <div>\n              <div className=\"flex items-center gap-3\">\n                <Mic className=\"size-4\" />\n                <h3 className=\"text-sm font-medium\">Speaking</h3>\n              </div>\n              <ul className=\"mt-4 space-y-3\">\n                {talks.map((talk) => (\n                  <li key={talk.topic} className=\"bg-muted p-4\">\n                    <p className=\"text-sm font-medium\">{talk.topic}</p>\n                    <p className=\"mt-1 text-xs text-muted-foreground\">\n                      {talk.event}, {talk.city}\n                    </p>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "700px"
  },
  "categories": [
    "portfolio"
  ]
}