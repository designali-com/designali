  "files": [
    {
      "path": "registry/designali/pages/portfolio/landing-portfolio-10/page.tsx",
      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  Check,\n  Code,\n  LayoutTemplate,\n  Plus,\n  Search,\n  Shapes,\n  Wand,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Work\", \"About\", \"Services\", \"Writing\", \"Contact\"]\n\nconst features = [\n  {\n    icon: Code,\n    title: \"Front-end development\",\n    description:\n      \"Production-ready React and TypeScript, with accessible components and smooth interactions.\",\n  },\n  {\n    icon: Shapes,\n    title: \"Brand identity\",\n    description:\n      \"Logos, typography and colour systems for early-stage companies finding their voice.\",\n  },\n  {\n    icon: LayoutTemplate,\n    title: \"Design systems\",\n    description:\n      \"Reusable component libraries in Figma and code that keep products consistent as they grow.\",\n  },\n  {\n    icon: Search,\n    title: \"User research\",\n    description:\n      \"Interviews, usability tests and analytics reviews that ground design decisions in evidence.\",\n  },\n  {\n    icon: Wand,\n    title: \"Prototyping\",\n    description:\n      \"Interactive prototypes that let you test ideas with customers and investors before building.\",\n  },\n]\n\nconst stats = [\n  { value: \"4\", label: \"Design awards\" },\n  { value: \"100%\", label: \"Projects delivered on time\" },\n  { value: \"2M+\", label: \"People using my work\" },\n  { value: \"9\", label: \"Years of experience\" },\n]\n\nconst steps = [\n  {\n    title: \"Intro call\",\n    description:\n      \"A free 30-minute call to understand your goals, timeline and whether we are a good fit.\",\n  },\n  {\n    title: \"Proposal\",\n    description:\n      \"A short written proposal with scope, milestones and a fixed price, usually within three days.\",\n  },\n  {\n    title: \"Design and build\",\n    description:\n      \"Weekly check-ins and shared progress in Figma and a staging link, so there are no surprises.\",\n  },\n  {\n    title: \"Handover\",\n    description:\n      \"Clean files, documentation and a recorded walkthrough so your team can take it from there.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Kindred\",\n    meta: \"Mobile app for family caregivers\",\n    tag: \"Product\",\n    price: \"2025\",\n    tile: \"bg-gradient-to-br from-stone-200 via-neutral-300 to-zinc-400 dark:from-stone-700 dark:via-neutral-800 dark:to-zinc-900\",\n  },\n  {\n    name: \"Lumen Bank\",\n    meta: \"Onboarding redesign for a neobank\",\n    tag: \"UX\",\n    price: \"2025\",\n    tile: \"bg-gradient-to-br from-rose-200 via-pink-300 to-purple-300 dark:from-rose-700 dark:via-pink-800 dark:to-purple-900\",\n  },\n  {\n    name: \"Studio Kiln\",\n    meta: \"Identity and site for a ceramics studio\",\n    tag: \"Brand\",\n    price: \"2024\",\n    tile: \"bg-gradient-to-br from-blue-200 via-indigo-300 to-violet-400 dark:from-blue-700 dark:via-indigo-800 dark:to-violet-900\",\n  },\n  {\n    name: \"Parcel\",\n    meta: \"Design system for a logistics platform\",\n    tag: \"System\",\n    price: \"2024\",\n    tile: \"bg-gradient-to-br from-yellow-100 via-amber-200 to-orange-300 dark:from-yellow-700 dark:via-amber-800 dark:to-orange-900\",\n  },\n  {\n    name: \"Waypoint\",\n    meta: \"Trip planning web app\",\n    tag: \"Web\",\n    price: \"2023\",\n    tile: \"bg-gradient-to-br from-amber-200 via-orange-300 to-rose-400 dark:from-amber-700 dark:via-orange-800 dark:to-rose-900\",\n  },\n  {\n    name: \"Moonrise\",\n    meta: \"Sleep tracking dashboard\",\n    tag: \"Data\",\n    price: \"2023\",\n    tile: \"bg-gradient-to-br from-sky-200 via-cyan-300 to-teal-400 dark:from-sky-700 dark:via-cyan-800 dark:to-teal-900\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"The design system they built is still the backbone of our app two years later. Every new hire loves it.\",\n    name: \"Pedro Alves\",\n    role: \"Engineering Manager, Parcel\",\n  },\n  {\n    quote:\n      \"Rare to find someone with this much taste who also writes clean, well-tested code.\",\n    name: \"Hana Sato\",\n    role: \"CTO, Orchard\",\n  },\n  {\n    quote:\n      \"They ran a workshop that finally got our founders aligned. The roadmap we left with is still the one we follow.\",\n    name: \"Michael Duarte\",\n    role: \"COO, Moonrise\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Audit\",\n    price: \"$1,800\",\n    period: \"one-time\",\n    description: \"A deep review of your existing product.\",\n    features: [\n      \"UX and accessibility review\",\n      \"Performance check\",\n      \"Prioritised fix list\",\n      \"60-minute walkthrough\",\n    ],\n    cta: \"Book an audit\",\n  },\n  {\n    name: \"Launch\",\n    price: \"$9,500\",\n    period: \"per project\",\n    description: \"Design and build a marketing site or MVP.\",\n    features: [\n      \"Discovery and strategy\",\n      \"Full visual design\",\n      \"Production front-end code\",\n      \"Two rounds of revisions\",\n      \"30 days of support\",\n    ],\n    cta: \"Start a project\",\n  },\n  {\n    name: \"Retainer\",\n    price: \"$6,000\",\n    period: \"/month\",\n    description: \"An ongoing design partner for your team.\",\n    features: [\n      \"Two days per week\",\n      \"Design and code\",\n      \"Slack access\",\n      \"Pause or cancel any time\",\n    ],\n    cta: \"Check availability\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"Which tools do you use?\",\n    a: \"Figma for design, React, Next.js and Tailwind CSS for code, and Linear or Notion to keep projects organised.\",\n  },\n  {\n    q: \"Can you work in my time zone?\",\n    a: \"I am based in Lisbon and overlap comfortably with both European and US East Coast working hours.\",\n  },\n  {\n    q: \"How do payments work?\",\n    a: \"Projects are split into 50% upfront and 50% on delivery. Retainers are billed monthly in advance.\",\n  },\n  {\n    q: \"Are you available for full-time roles?\",\n    a: \"Not at the moment. I work independently with a small number of clients so I can give each project my full attention.\",\n  },\n  {\n    q: \"How far in advance should I book?\",\n    a: \"I usually book three to four weeks ahead. Audits can often start within a week.\",\n  },\n]\n\nconst footer = [\n  { title: \"Sitemap\", links: [\"Work\", \"About\", \"Services\", \"Writing\"] },\n  { title: \"Elsewhere\", links: [\"Dribbble\", \"GitHub\", \"LinkedIn\", \"Read.cv\"] },\n  {\n    title: \"Contact\",\n    links: [\"Email me\", \"Book a call\", \"Newsletter\", \"Resume\"],\n  },\n]\n\nexport default function LandingPortfolio10() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-amber-600 text-white text-sm\">\n              S\n            </span>\n            <span className=\"font-serif text-lg font-normal\">Sana Ito</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Resume\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              License a font\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 pt-16 pb-12 md:pt-28\">\n          <div className=\"flex items-center justify-between border-b pb-4 text-xs tracking-widest text-muted-foreground uppercase\">\n            <span>Type design and lettering</span>\n            <span className=\"hidden sm:inline\">Letters, carefully drawn.</span>\n          </div>\n          <h1 className=\"mt-12 max-w-5xl text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-8xl font-serif font-normal\">\n            {\"Typefaces drawn for \"}\n            <span className=\"text-amber-600 dark:text-amber-400\">\n              long reading\n            </span>\n          </h1>\n          <div className=\"mt-12 grid gap-8 md:grid-cols-2 md:items-end\">\n            <p className=\"max-w-lg text-lg leading-8 text-muted-foreground\">\n              I am Sana, a type designer drawing retail fonts and custom\n              typefaces for publishers, apps and cultural institutions.\n            </p>\n            <div className=\"md:justify-self-end\">\n              <div className=\"flex flex-wrap gap-3 \">\n                <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                  License a font\n                  <ArrowRight />\n                </Button>\n                <Button\n                  size=\"lg\"\n                  variant=\"outline\"\n                  nativeButton={false}\n                  render={<a href=\"#\" />}\n                >\n                  See type specimens\n                </Button>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div className=\"mx-auto max-w-7xl px-6 pb-16\">\n          <HeroVisual />\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl grid-cols-2 px-6 lg:grid-cols-4\">\n          {stats.slice(0, 4).map((stat, i) => (\n            <div\n              key={stat.label}\n              className={`py-12 ${i > 0 ? \"lg:border-l lg:pl-8\" : \"\"} ${i % 2 === 1 ? \"border-l pl-6 lg:pl-8\" : \"\"} `}\n            >\n              <div className=\"text-4xl font-semibold tracking-tight md:text-5xl font-serif font-normal\">\n                {stat.value}\n              </div>\n              <div className=\"mt-2 text-sm text-muted-foreground\">\n                {stat.label}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.4fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <div className=\"max-w-2xl\">\n              <p className=\"text-sm font-medium text-amber-600 dark:text-amber-400\">\n                What I do\n              </p>\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal mt-3\">\n                Design and code from first sketch to shipped product\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                I help founders and teams turn fuzzy ideas into products people\n                enjoy using, handling everything from research to production\n                code.\n              </p>\n            </div>\n          </div>\n          <div className=\"divide-y border-y\">\n            {features.map((feature, i) => (\n              <div\n                key={feature.title}\n                className=\"grid gap-4 py-8 sm:grid-cols-[4rem_1fr]\"\n              >\n                <span className=\"font-mono text-sm text-muted-foreground\">\n                  {String(i + 1).padStart(2, \"0\")}\n                </span>\n                <div>\n                  <h3 className=\"font-serif text-2xl\">{feature.title}</h3>\n                  <p className=\"mt-2 leading-7 text-muted-foreground\">\n                    {feature.description}\n                  </p>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal\">\n                Selected projects\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                A handful of recent projects I am proud of. Full case studies\n                are available on request.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a key={item.name} href=\"#\" className=\"group\">\n                <div\n                  className={`relative aspect-[4/3] overflow-hidden rounded-2xl ${item.tile}`}\n                >\n                  <div className=\"absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10\" />\n                  <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-zinc-900 backdrop-blur\">\n                    {item.tag}\n                  </span>\n                </div>\n                <div className=\"mt-4 flex items-start justify-between gap-4\">\n                  <div className=\"min-w-0\">\n                    <h3 className=\"font-medium font-serif text-lg\">\n                      {item.name}\n                    </h3>\n                    <p className=\"mt-1 text-sm text-muted-foreground\">\n                      {item.meta}\n                    </p>\n                  </div>\n                  <span className=\"shrink-0 text-sm font-semibold\">\n                    {item.price}\n                  </span>\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-5xl px-6 py-20 text-center md:py-28\">\n          <p className=\"text-sm tracking-widest text-muted-foreground uppercase\">\n            Kind words from collaborators\n          </p>\n          {testimonials.slice(0, 1).map((t) => (\n            <figure key={t.name} className=\"mt-10\">\n              <blockquote className=\"font-serif text-3xl leading-snug text-balance md:text-5xl\">\n                &ldquo;{t.quote}&rdquo;\n              </blockquote>\n              <figcaption className=\"mt-10 text-sm\">\n                <span className=\"font-medium\">{t.name}</span>\n                <span className=\"text-muted-foreground\"> · {t.role}</span>\n              </figcaption>\n            </figure>\n          ))}\n          <div className=\"mt-16 grid gap-6 border-t pt-12 text-left md:grid-cols-2\">\n            {testimonials.slice(1).map((t) => (\n              <figure key={t.name}>\n                <blockquote className=\"leading-7 text-muted-foreground\">\n                  &ldquo;{t.quote}&rdquo;\n                </blockquote>\n                <figcaption className=\"mt-4 text-sm font-medium\">\n                  {t.name}{\" \"}\n                  <span className=\"font-normal text-muted-foreground\">\n                    · {t.role}\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"max-w-2xl\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal\">\n              How a project with me runs\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-foreground pt-6\"\n              >\n                <span className=\"text-sm font-medium text-amber-600 dark:text-amber-400\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal\">\n              Ways to work together\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Fixed-scope packages for common needs, or a monthly retainer if\n              you need an ongoing design partner.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-amber-500 shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-amber-600 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-amber-600 dark:text-amber-400\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal\">\n              Good to know\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Get in touch\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"bg-foreground text-background\">\n        <div className=\"mx-auto flex max-w-7xl flex-col gap-10 px-6 py-20 md:flex-row md:items-end md:justify-between md:py-28\">\n          <div className=\"max-w-2xl\">\n            <h2 className=\"text-4xl font-semibold tracking-tight text-balance md:text-6xl font-serif font-normal\">\n              Need a typeface nobody else has?\n            </h2>\n            <p className=\"mt-5 text-lg text-background/65\">\n              Custom type projects start with a short call about your voice,\n              languages and where the letters will live.\n            </p>\n          </div>\n          <div className=\"flex flex-wrap gap-3 \">\n            <Button\n              size=\"lg\"\n              className=\"bg-background text-foreground hover:bg-background/90\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              License a font\n              <ArrowRight />\n            </Button>\n            <Button\n              size=\"lg\"\n              variant=\"outline\"\n              className=\"border-background/25 bg-transparent text-background hover:bg-background/10 hover:text-background\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              See type specimens\n            </Button>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-amber-600 text-white text-sm\">\n                S\n              </span>\n              <span className=\"font-serif text-lg font-normal\">Sana Ito</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              Letters, carefully drawn.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Sana Ito. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  return (\n    <div className=\"grid grid-cols-2 gap-3 md:grid-cols-3\">\n      {showcase.slice(0, 3).map((item, i) => (\n        <div\n          key={item.name}\n          className={`relative overflow-hidden rounded-2xl ${item.tile} ${i === 0 ? \"col-span-2 aspect-[16/10] md:col-span-1 md:aspect-[3/4]\" : \"aspect-[3/4]\"}`}\n        >\n          <div className=\"absolute inset-0 bg-gradient-to-t from-black/50 via-black/0 to-black/0\" />\n          <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-zinc-900 backdrop-blur\">\n            {item.tag}\n          </span>\n          <div className=\"absolute inset-x-3 bottom-3 flex items-end justify-between gap-2 text-white\">\n            <div className=\"min-w-0\">\n              <div className=\"truncate text-sm font-medium\">{item.name}</div>\n              <div className=\"truncate text-xs text-white/75\">{item.meta}</div>\n            </div>\n            <div className=\"shrink-0 text-sm font-semibold\">{item.price}</div>\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n",
      "type": "registry:page",
      "target": "app/landing-portfolio-10/page.tsx"
    }
  ],
