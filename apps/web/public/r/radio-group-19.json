{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "radio-group-19",
  "type": "registry:example",
  "description": "Sign-up step for choosing a personal or business account with icons.",
  "files": [
    {
      "path": "registry/designali/examples/radio-group/radio-group-19.tsx",
      "content": "import {\n  Briefcase as BriefcaseIcon,\n  User as UserIcon,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  Field,\n  FieldContent,\n  FieldDescription,\n  FieldLabel,\n  FieldTitle,\n} from \"@workspace/ui/components/field\"\nimport {\n  RadioGroup,\n  RadioGroupItem,\n} from \"@workspace/ui/components/radio-group\"\n\nexport default function SignupAccountType() {\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-4\">\n      <div>\n        <p className=\"text-base font-semibold\">How will you use Designali?</p>\n        <p className=\"text-sm text-muted-foreground\">\n          You can change this later in settings.\n        </p>\n      </div>\n      <RadioGroup defaultValue=\"personal\" className=\"grid grid-cols-2 gap-3\">\n        <FieldLabel htmlFor=\"acct-personal\">\n          <Field>\n            <UserIcon className=\"size-5\" />\n            <FieldContent>\n              <FieldTitle>Personal</FieldTitle>\n              <FieldDescription>\n                For side projects and portfolios.\n              </FieldDescription>\n            </FieldContent>\n            <RadioGroupItem\n              value=\"personal\"\n              id=\"acct-personal\"\n              className=\"sr-only\"\n            />\n          </Field>\n        </FieldLabel>\n        <FieldLabel htmlFor=\"acct-business\">\n          <Field>\n            <BriefcaseIcon className=\"size-5\" />\n            <FieldContent>\n              <FieldTitle>Business</FieldTitle>\n              <FieldDescription>\n                For client work and team licenses.\n              </FieldDescription>\n            </FieldContent>\n            <RadioGroupItem\n              value=\"business\"\n              id=\"acct-business\"\n              className=\"sr-only\"\n            />\n          </Field>\n        </FieldLabel>\n      </RadioGroup>\n      <Button>Continue</Button>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}