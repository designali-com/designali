{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "aspect-ratio-17",
  "type": "registry:example",
  "description": "A music player with a square generative album cover and playback controls.",
  "files": [
    {
      "path": "registry/designali/examples/aspect-ratio/aspect-ratio-17.tsx",
      "content": "import {\n  Pause as PauseIcon,\n  SkipBack as SkipBackIcon,\n  SkipForward as SkipForwardIcon,\n} from \"@designali/icons\"\n\nimport { AspectRatio } from \"@workspace/ui/components/aspect-ratio\"\nimport { Button } from \"@workspace/ui/components/button\"\nimport { Progress } from \"@workspace/ui/components/progress\"\n\nexport default function AlbumCoverPlayer() {\n  return (\n    <div className=\"w-full max-w-60 border p-3\">\n      <AspectRatio\n        ratio={1}\n        className=\"overflow-hidden bg-linear-to-br from-primary to-primary\"\n      >\n        <svg\n          viewBox=\"0 0 100 100\"\n          className=\"absolute inset-0 size-full\"\n          aria-hidden=\"true\"\n        >\n          {[40, 30, 20, 10].map((r) => (\n            <circle\n              key={r}\n              cx=\"50\"\n              cy=\"50\"\n              r={r}\n              fill=\"none\"\n              stroke=\"white\"\n              strokeOpacity=\"0.35\"\n              strokeWidth=\"1.5\"\n            />\n          ))}\n          <circle cx=\"50\" cy=\"50\" r=\"4\" fill=\"white\" />\n        </svg>\n      </AspectRatio>\n      <div className=\"mt-3\">\n        <p className=\"truncate text-sm font-medium\">Design se code tak</p>\n        <p className=\"truncate text-xs text-muted-foreground\">\n          Designali studio playlist\n        </p>\n      </div>\n      <Progress value={38} className=\"mt-3\" />\n      <div className=\"mt-2 flex items-center justify-center gap-1\">\n        <Button variant=\"ghost\" size=\"icon-sm\" aria-label=\"Previous\">\n          <SkipBackIcon />\n        </Button>\n        <Button size=\"icon\" aria-label=\"Pause\" className=\"rounded-full\">\n          <PauseIcon />\n        </Button>\n        <Button variant=\"ghost\" size=\"icon-sm\" aria-label=\"Next\">\n          <SkipForwardIcon />\n        </Button>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}