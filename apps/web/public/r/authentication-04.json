{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "authentication-04",
  "type": "registry:block",
  "description": "A passwordless magic-link sign-in with a split layout.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "button",
    "input"
  ],
  "files": [
    {
      "path": "registry/designali/blocks/authentication/authentication-04.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\nimport { ArrowLeft, Fingerprint, Mail } from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport { Input } from \"@workspace/ui/components/input\"\n\nexport default function Authentication04() {\n  const [sent, setSent] = useState(false)\n  const [email, setEmail] = useState(\"\")\n\n  return (\n    <section className=\"w-full bg-background py-20 md:py-28\">\n      <div className=\"mx-auto grid max-w-5xl border md:grid-cols-2\">\n        <div className=\"flex flex-col justify-between gap-12 border-b p-8 md:border-e md:border-b-0 md:p-12\">\n          <p className=\"font-mono text-xs text-muted-foreground\">NOTEWELL / SIGN IN</p>\n          <h2 className=\"text-4xl leading-tight font-semibold tracking-tight md:text-5xl\">\n            No passwords.\n            <br />\n            <span className=\"text-muted-foreground\">Just you.</span>\n          </h2>\n          <p className=\"text-sm text-muted-foreground\">\n            Sign in with a passkey stored on this device, or get a one-time link\n            sent to your email.\n          </p>\n        </div>\n\n        <div className=\"flex flex-col justify-center gap-6 p-8 md:p-12\">\n          {sent ? (\n            <div className=\"space-y-4\">\n              <Mail className=\"size-6\" />\n              <h3 className=\"text-xl font-medium\">Magic link sent</h3>\n              <p className=\"text-sm text-muted-foreground\">\n                Open the email we sent to {email || \"your inbox\"} and tap the\n                link to continue. You can close this tab.\n              </p>\n              <Button variant=\"ghost\" onClick={() => setSent(false)} className=\"-ms-4\">\n                <ArrowLeft />\n                Use a different email\n              </Button>\n            </div>\n          ) : (\n            <>\n              <Button size=\"lg\" className=\"w-full\">\n                <Fingerprint />\n                Continue with passkey\n              </Button>\n              <div className=\"flex items-center gap-3 text-xs text-muted-foreground\">\n                <span className=\"h-px flex-1 bg-border\" />\n                or\n                <span className=\"h-px flex-1 bg-border\" />\n              </div>\n              <form\n                className=\"space-y-3\"\n                onSubmit={(event) => {\n                  event.preventDefault()\n                  setSent(true)\n                }}\n              >\n                <Input\n                  type=\"email\"\n                  required\n                  value={email}\n                  onChange={(event) => setEmail(event.target.value)}\n                  placeholder=\"you@example.com\"\n                  className=\"h-12 text-sm\"\n                />\n                <Button type=\"submit\" variant=\"outline\" size=\"lg\" className=\"w-full\">\n                  Email me a sign-in link\n                </Button>\n              </form>\n            </>\n          )}\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "700px"
  },
  "categories": [
    "authentication"
  ]
}