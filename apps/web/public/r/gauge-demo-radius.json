      "content": "\"use client\"\n\nimport * as React from \"react\"\n\nimport {\n  Gauge,\n  GaugeIndicator,\n  GaugeRange,\n  GaugeTrack,\n  GaugeValueText,\n} from \"@/registry/designali/ui/gauge\"\n\nexport function GaugeDemoRadius() {\n  return (\n    <div className=\"flex flex-wrap items-center justify-center gap-10\">\n      <div className=\"flex flex-col items-center gap-3\">\n        <Gauge\n          value={72}\n          size={180}\n          tickInnerRadius={77}\n          tickOuterRadius={88}\n        >\n          <GaugeIndicator>\n            <GaugeTrack />\n            <GaugeRange />\n          </GaugeIndicator>\n\n          <GaugeValueText />\n        </Gauge>\n\n        <span className=\"text-sm text-muted-foreground\">\n          Compact\n        </span>\n      </div>\n\n      <div className=\"flex flex-col items-center gap-3\">\n        <Gauge\n          value={72}\n          size={180}\n          tickInnerRadius={35}\n          tickOuterRadius={88}\n        >\n          <GaugeIndicator>\n            <GaugeTrack />\n            <GaugeRange />\n          </GaugeIndicator>\n\n          <GaugeValueText />\n        </Gauge>\n\n        <span className=\"text-sm text-muted-foreground\">\n          Wide\n        </span>\n      </div>\n    </div>\n  )\n}",
      "type": "registry:block"
    }
  ]
