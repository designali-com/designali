{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "hero-14",
  "type": "registry:block",
  "description": "Split hero with avatar-stack rating proof on the left and a staggered stack of customer quote cards on the right.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
