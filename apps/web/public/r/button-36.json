{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "button-36",
  "type": "registry:example",
  "description": "Vertical upvote and downvote buttons around a score, as in a forum thread.",
  "files": [
    {
      "path": "registry/designali/examples/button/button-36.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  ChevronDown as ChevronDownIcon,\n  ChevronUp as ChevronUpIcon,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nexport default function VoteButtons() {\n  const [vote, setVote] = React.useState<1 | 0 | -1>(0)\n  const score = 132 + vote\n\n  return (\n    <div className=\"flex w-full max-w-sm gap-3 border p-3\">\n      <div className=\"flex flex-col items-center\">\n        <Button\n          variant={vote === 1 ? \"secondary\" : \"ghost\"}\n          size=\"icon-sm\"\n          aria-label=\"Upvote\"\n          aria-pressed={vote === 1}\n          onClick={() => setVote(vote === 1 ? 0 : 1)}\n        >\n          <ChevronUpIcon />\n        </Button>\n        <span className=\"text-xs font-semibold tabular-nums\">{score}</span>\n        <Button\n          variant={vote === -1 ? \"secondary\" : \"ghost\"}\n          size=\"icon-sm\"\n          aria-label=\"Downvote\"\n          aria-pressed={vote === -1}\n          onClick={() => setVote(vote === -1 ? 0 : -1)}\n        >\n          <ChevronDownIcon />\n        </Button>\n      </div>\n      <div className=\"flex flex-col gap-1\">\n        <p className=\"text-sm font-medium\">\n          How do you organise design tokens across brands?\n        </p>\n        <p className=\"text-xs text-muted-foreground\">\n          Asked by tomasz.k · 24 answers\n        </p>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}