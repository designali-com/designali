{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "command-36",
  "type": "registry:example",
  "description": "A bottom sheet on mobile that hosts a full-height command search.",
  "files": [
    {
      "path": "registry/designali/examples/command/command-36.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  PackageIcon,\n  RotateCcwIcon,\n  SearchIcon,\n  TrendingUpIcon,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  Command,\n  CommandEmpty,\n  CommandGroup,\n  CommandInput,\n  CommandItem,\n  CommandList,\n} from \"@workspace/ui/components/command\"\nimport {\n  Sheet,\n  SheetContent,\n  SheetDescription,\n  SheetHeader,\n  SheetTitle,\n  SheetTrigger,\n} from \"@workspace/ui/components/sheet\"\n\nexport default function MobileSearchSheet() {\n  const [open, setOpen] = React.useState(false)\n\n  return (\n    <Sheet open={open} onOpenChange={setOpen}>\n      <SheetTrigger\n        render={\n          <Button\n            variant=\"outline\"\n            className=\"w-full max-w-xs justify-start text-muted-foreground\"\n          />\n        }\n      >\n        <SearchIcon data-icon=\"inline-start\" />\n        Search the store...\n      </SheetTrigger>\n      <SheetContent side=\"bottom\" className=\"h-[70vh] gap-0 p-0\">\n        <SheetHeader className=\"border-b\">\n          <SheetTitle>Search</SheetTitle>\n          <SheetDescription>\n            Find products, orders, and help articles.\n          </SheetDescription>\n        </SheetHeader>\n        <Command className=\"flex-1\">\n          <CommandInput placeholder=\"Running shoes, order #, returns...\" />\n          <CommandList className=\"max-h-none flex-1\">\n            <CommandEmpty>No results.</CommandEmpty>\n            <CommandGroup heading=\"Trending\">\n              <CommandItem onSelect={() => setOpen(false)}>\n                <TrendingUpIcon />\n                <span>Trail running shoes</span>\n              </CommandItem>\n              <CommandItem onSelect={() => setOpen(false)}>\n                <TrendingUpIcon />\n                <span>Waterproof jackets</span>\n              </CommandItem>\n            </CommandGroup>\n            <CommandGroup heading=\"Your orders\">\n              <CommandItem onSelect={() => setOpen(false)}>\n                <PackageIcon />\n                <span>Order #48213</span>\n                <span className=\"ms-auto text-[11px] text-muted-foreground\">\n                  Out for delivery\n                </span>\n              </CommandItem>\n            </CommandGroup>\n            <CommandGroup heading=\"Help\">\n              <CommandItem onSelect={() => setOpen(false)}>\n                <RotateCcwIcon />\n                <span>Start a return</span>\n              </CommandItem>\n            </CommandGroup>\n          </CommandList>\n        </Command>\n      </SheetContent>\n    </Sheet>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}