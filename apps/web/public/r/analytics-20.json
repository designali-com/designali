{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "analytics-20",
  "type": "registry:block",
  "description": "Email-style weekly digest card with a narrative summary using highlighted figures, stat row, biggest movers and CTAs.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "button"
  ],
  "files": [
    {
      "path": "registry/designali/blocks/analytics/analytics-20.tsx",
      "content": "import { ArrowRight, Sparkles } from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst highlights = [\n  { label: \"Revenue\", value: \"$212,480\", change: \"+18%\", good: true },\n  { label: \"Orders\", value: \"4,906\", change: \"+11%\", good: true },\n  { label: \"Return rate\", value: \"6.4%\", change: \"+1.2 pts\", good: false },\n]\n\nconst movers = [\n  { item: \"Merino travel hoodie\", note: \"Sold out in size M on Thursday\", delta: \"+214%\" },\n  { item: \"Canvas weekender bag\", note: \"Featured in the Sunday newsletter\", delta: \"+96%\" },\n  { item: \"Linen shirt, oat\", note: \"Seasonal drop-off as expected\", delta: \"-38%\" },\n]\n\nexport default function Analytics20() {\n  return (\n    <section className=\"w-full bg-background py-16 text-foreground md:py-24\">\n      <div className=\"mx-auto max-w-3xl px-6\">\n        <div className=\"border bg-card\">\n          <div className=\"flex items-center justify-between border-b px-6 py-4 md:px-10\">\n            <span className=\"inline-flex items-center gap-2 text-xs text-muted-foreground\">\n              <Sparkles className=\"size-3.5\" />\n              Weekly digest\n            </span>\n            <span className=\"text-xs text-muted-foreground\">Nov 9 – Nov 15, 2026</span>\n          </div>\n\n          <div className=\"px-6 py-10 md:px-10\">\n            <h2 className=\"text-2xl leading-snug font-medium tracking-tight md:text-3xl\">\n              Your best week since launch, carried by one hoodie.\n            </h2>\n            <p className=\"mt-6 text-base leading-8 text-muted-foreground\">\n              Wildmoor sold{\" \"}\n              <mark className=\"bg-emerald-500/15 px-1 text-foreground dark:bg-emerald-400/20\">\n                $212,480\n              </mark>{\" \"}\n              this week, up 18% on last week. Almost a third of that came from\n              the{\" \"}\n              <mark className=\"bg-chart-2/20 px-1 text-foreground\">Merino travel hoodie</mark>,\n              which sold through medium sizes by Thursday. Returns ticked up to{\" \"}\n              <mark className=\"bg-rose-500/15 px-1 text-foreground dark:bg-rose-400/20\">6.4%</mark>,\n              mostly sizing exchanges on outerwear.\n            </p>\n\n            <dl className=\"mt-10 grid grid-cols-1 gap-px border bg-border sm:grid-cols-3\">\n              {highlights.map((h) => (\n                <div key={h.label} className=\"bg-card p-5\">\n                  <dt className=\"text-xs text-muted-foreground\">{h.label}</dt>\n                  <dd className=\"mt-2 text-2xl font-semibold tracking-tight\">{h.value}</dd>\n                  <dd\n                    className={\n                      h.good\n                        ? \"mt-1 text-xs text-emerald-600 dark:text-emerald-400\"\n                        : \"mt-1 text-xs text-rose-600 dark:text-rose-400\"\n                    }\n                  >\n                    {h.change} week over week\n                  </dd>\n                </div>\n              ))}\n            </dl>\n\n            <h3 className=\"mt-12 text-xs tracking-widest text-muted-foreground uppercase\">\n              Biggest movers\n            </h3>\n            <ul className=\"mt-4 divide-y border-y\">\n              {movers.map((m) => (\n                <li key={m.item} className=\"flex items-center justify-between gap-4 py-4\">\n                  <div className=\"min-w-0\">\n                    <p className=\"font-medium\">{m.item}</p>\n                    <p className=\"text-sm text-muted-foreground\">{m.note}</p>\n                  </div>\n                  <span\n                    className={\n                      m.delta.startsWith(\"-\")\n                        ? \"shrink-0 font-mono text-sm text-rose-600 dark:text-rose-400\"\n                        : \"shrink-0 font-mono text-sm text-emerald-600 dark:text-emerald-400\"\n                    }\n                  >\n                    {m.delta}\n                  </span>\n                </li>\n              ))}\n            </ul>\n\n            <div className=\"mt-10 flex flex-col gap-3 sm:flex-row\">\n              <Button nativeButton={false} render={<a href=\"#\" />}>\n                Open full report\n                <ArrowRight data-icon=\"inline-end\" />\n              </Button>\n              <Button variant=\"outline\" nativeButton={false} render={<a href=\"#\" />}>\n                Restock hoodie\n              </Button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "1000px"
  },
  "categories": [
    "analytics"
  ]
}