      "path": "registry/designali/pages/developer-tools/landing-developer-tools-07/page.tsx",
      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  Check,\n  Code,\n  Gauge,\n  GitBranch,\n  GitFork,\n  Plus,\n  Puzzle,\n  Terminal,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Docs\", \"Pricing\", \"Changelog\", \"Blog\", \"GitHub\"]\n\nconst logos = [\n  \"Runloop\",\n  \"Gridline\",\n  \"Stackwise\",\n  \"Byteforge\",\n  \"Cloudnest\",\n  \"Parsec\",\n  \"Quantra\",\n  \"Hexagon\",\n]\n\nconst features = [\n  {\n    icon: Puzzle,\n    title: \"Extensible with plugins\",\n    description:\n      \"Hook into every build and deploy step with a simple plugin API and a growing ecosystem.\",\n  },\n  {\n    icon: GitFork,\n    title: \"Open source core\",\n    description:\n      \"The runtime is MIT licensed, with 40K stars and over 600 contributors on GitHub.\",\n  },\n  {\n    icon: Terminal,\n    title: \"A CLI that gets out of the way\",\n    description:\n      \"One command to scaffold, test and deploy, with readable errors and helpful suggestions.\",\n  },\n  {\n    icon: GitBranch,\n    title: \"Preview every pull request\",\n    description:\n      \"Each branch gets its own isolated environment and URL, torn down automatically on merge.\",\n  },\n  {\n    icon: Code,\n    title: \"Fully typed SDKs\",\n    description:\n      \"End-to-end type safety for TypeScript, Python, Go and Rust, generated from one OpenAPI spec.\",\n  },\n  {\n    icon: Gauge,\n    title: \"Edge-fast by default\",\n    description:\n      \"Requests are served from 31 regions with a median latency under 40 ms worldwide.\",\n  },\n]\n\nconst stats = [\n  { value: \"40K\", label: \"GitHub stars\" },\n  { value: \"180K\", label: \"Developers building\" },\n  { value: \"38ms\", label: \"Median global latency\" },\n  { value: \"4.2B\", label: \"Requests served monthly\" },\n]\n\nconst steps = [\n  {\n    title: \"Install the CLI\",\n    description:\n      \"One npm, brew or curl command. Works on macOS, Linux and Windows.\",\n  },\n  {\n    title: \"Connect your repo\",\n    description:\n      \"Link GitHub, GitLab or Bitbucket and we detect your framework automatically.\",\n  },\n  {\n    title: \"Push to deploy\",\n    description:\n      \"Every push builds, tests and deploys, with preview URLs for every branch.\",\n  },\n  {\n    title: \"Observe and scale\",\n    description:\n      \"Watch logs and traces in real time while traffic scales automatically.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"@acme/sdk\",\n    meta: \"TypeScript · Node, Deno and Bun\",\n    tag: \"Official\",\n    price: \"v4.2.0\",\n  },\n  {\n    name: \"acme-python\",\n    meta: \"Python 3.9+ · Async support\",\n    tag: \"Official\",\n    price: \"v3.8.1\",\n  },\n  {\n    name: \"acme-go\",\n    meta: \"Go 1.21+ · Zero dependencies\",\n    tag: \"Official\",\n    price: \"v2.5.0\",\n  },\n  {\n    name: \"Next.js starter\",\n    meta: \"Template · App Router and auth\",\n    tag: \"Template\",\n    price: \"1-click\",\n  },\n  {\n    name: \"acme-rs\",\n    meta: \"Rust · Tokio and async-std\",\n    tag: \"Community\",\n    price: \"v1.3.4\",\n  },\n  {\n    name: \"GitHub Action\",\n    meta: \"CI · Deploy on every push\",\n    tag: \"Integration\",\n    price: \"v2\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"We moved our whole platform over in a week. Deploys went from twelve minutes to under thirty seconds.\",\n    name: \"Alex Novak\",\n    role: \"Platform Lead, Byteforge\",\n  },\n  {\n    quote:\n      \"The TypeScript SDK is the best I have used. Autocomplete for every endpoint and errors that explain themselves.\",\n    name: \"Mei Lin\",\n    role: \"Senior Engineer, Parsec\",\n  },\n  {\n    quote:\n      \"Preview environments changed our review culture. Designers and PMs actually test PRs before they merge.\",\n    name: \"Jake Thornton\",\n    role: \"CTO, Runloop\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Hobby\",\n    price: \"$0\",\n    period: \"/month\",\n    description: \"For side projects and experiments.\",\n    features: [\n      \"100 GB bandwidth\",\n      \"1M requests\",\n      \"Preview deployments\",\n      \"Community support\",\n    ],\n    cta: \"Start building\",\n  },\n  {\n    name: \"Pro\",\n    price: \"$20\",\n    period: \"/month + usage\",\n    description: \"For production apps and small teams.\",\n    features: [\n      \"1 TB bandwidth included\",\n      \"10M requests included\",\n      \"Unlimited team members\",\n      \"7-day log retention\",\n      \"Email support\",\n    ],\n    cta: \"Upgrade to Pro\",\n  },\n  {\n    name: \"Enterprise\",\n    price: \"Custom\",\n    period: \"\",\n    description: \"For teams with scale and compliance needs.\",\n    features: [\n      \"Dedicated infrastructure\",\n      \"SSO and audit logs\",\n      \"SOC 2 and HIPAA\",\n      \"99.99% SLA\",\n      \"24/7 engineering support\",\n    ],\n    cta: \"Contact sales\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"Which languages and frameworks are supported?\",\n    a: \"Node, Python, Go, Rust and Ruby runtimes, with zero-config support for Next.js, Remix, Astro, Django and Rails.\",\n  },\n  {\n    q: \"Can I self-host?\",\n    a: \"Yes. The open source runtime can be self-hosted with Docker or Kubernetes. Enterprise includes support for self-hosted setups.\",\n  },\n  {\n    q: \"How does usage billing work?\",\n    a: \"Each plan includes a monthly allowance. Above that you pay per GB and per million requests, with spend limits you control.\",\n  },\n  {\n    q: \"Is there vendor lock-in?\",\n    a: \"No. Your code stays standard, configuration is a single portable file and you can export everything at any time.\",\n  },\n  {\n    q: \"Do you have a status page?\",\n    a: \"Yes, with real-time status for every region and a full incident history going back three years.\",\n  },\n]\n\nconst footer = [\n  {\n    title: \"Developers\",\n    links: [\"Documentation\", \"API reference\", \"CLI\", \"Status\"],\n  },\n  {\n    title: \"Open source\",\n    links: [\"GitHub\", \"Contributing\", \"Roadmap\", \"Changelog\"],\n  },\n  { title: \"Company\", links: [\"About\", \"Blog\", \"Careers\", \"Security\"] },\n]\n\nconst terminal = [\n  \"# install the CLI\",\n  \"$ npm install -g @acme/cli\",\n  \"added 1 package in 2.1s\",\n  \"$ acme init my-app --template next\",\n  \"Created my-app with 14 files\",\n  \"$ acme deploy --prod\",\n  \"Building... done in 8.4s\",\n  \"Uploading 212 assets to 31 regions\",\n  \"Deployed to https://my-app.acme.dev\",\n]\n\nexport default function LandingDeveloperTools07() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-indigo-600 text-white text-sm\">\n              C\n            </span>\n            <span className=\"\">Cronhook</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Sign in\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Run your first job\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"relative isolate overflow-hidden border-b\">\n        <div className=\"pointer-events-none absolute inset-0 -z-10 bg-radial-[ellipse_60%_50%_at_50%_0%] from-indigo-500/25 via-violet-500/10 to-transparent to-70%\" />\n        <div className=\"pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,var(--border)_1px,transparent_1px),linear-gradient(to_bottom,var(--border)_1px,transparent_1px)] bg-[size:48px_48px] [mask-image:radial-gradient(ellipse_50%_45%_at_50%_0%,#000_60%,transparent_100%)]\" />\n        <div className=\"mx-auto max-w-7xl px-6 pt-20 pb-16 md:pt-32\">\n          <div className=\"mx-auto max-w-4xl space-y-8 text-center\">\n            <a\n              href=\"#\"\n              className=\"inline-flex items-center gap-2 rounded-full border bg-background/70 py-1 pr-3 pl-1 text-xs backdrop-blur\"\n            >\n              <span className=\"rounded-full bg-indigo-600 px-2 py-0.5 font-medium text-white\">\n                New\n              </span>\n              <span className=\"text-muted-foreground\">\n                New: step-level replays for every workflow run\n              </span>\n            </a>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-8xl \">\n              {\"Background jobs that \"}\n              <span className=\"text-indigo-600 dark:text-indigo-400\">\n                never get lost\n              </span>\n            </h1>\n            <p className=\"mx-auto max-w-2xl text-lg leading-8 text-muted-foreground\">\n              Cronhook runs your queues, cron schedules and long workflows with\n              automatic retries, so a failed step resumes instead of starting\n              over.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Run your first job\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                See examples\n              </Button>\n            </div>\n          </div>\n          <div className=\"relative mx-auto mt-20 max-w-5xl\">\n            <div className=\"absolute inset-x-10 -top-6 -z-10 h-24 rounded-full bg-indigo-500/10 blur-2xl\" />\n            <HeroVisual />\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-12\">\n          <p className=\"text-center text-sm text-muted-foreground\">\n            Powering engineering teams at\n          </p>\n          <div className=\"mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-6 sm:grid-cols-4 lg:grid-cols-8\">\n            {logos.map((logo) => (\n              <div\n                key={logo}\n                className=\"text-center text-base font-semibold tracking-tight text-muted-foreground/70 \"\n              >\n                {logo}\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <p className=\"text-sm font-medium text-indigo-600 dark:text-indigo-400\">\n              Developer experience\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              Built by developers, for developers\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Sensible defaults, zero config and an escape hatch for everything.\n              Spend your time on your product, not your plumbing.\n            </p>\n          </div>\n          <div className=\"mt-14 grid overflow-hidden rounded-2xl border sm:grid-cols-2 lg:grid-cols-3\">\n            {features.map((feature) => (\n              <div\n                key={feature.title}\n                className=\"-mt-px -ml-px border-t border-l p-8\"\n              >\n                <feature.icon className=\"size-6 text-indigo-600 dark:text-indigo-400\" />\n                <h3 className=\"mt-5 font-semibold\">{feature.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl grid-cols-2 px-6 lg:grid-cols-4\">\n          {stats.slice(0, 4).map((stat, i) => (\n            <div\n              key={stat.label}\n              className={`py-12 ${i > 0 ? \"lg:border-l lg:pl-8\" : \"\"} ${i % 2 === 1 ? \"border-l pl-6 lg:pl-8\" : \"\"} `}\n            >\n              <div className=\"text-4xl font-semibold tracking-tight md:text-5xl \">\n                {stat.value}\n              </div>\n              <div className=\"mt-2 text-sm text-muted-foreground\">\n                {stat.label}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                SDKs, templates and packages\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                First-class libraries for every major language and framework,\n                all open source and fully typed.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a\n                key={item.name}\n                href=\"#\"\n                className=\"group flex flex-col rounded-xl border p-6 transition-colors hover:bg-muted/40\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"flex size-10 items-center justify-center rounded-lg border bg-muted/50 font-semibold font-mono text-sm\">\n                    {item.name.charAt(0)}\n                  </span>\n                  <span className=\"rounded-full bg-indigo-500/10 px-2.5 py-0.5 text-xs font-medium text-indigo-600 dark:text-indigo-400\">\n                    {item.tag}\n                  </span>\n                </div>\n                <h3 className=\"mt-6 font-semibold font-mono text-sm\">\n                  {item.name}\n                </h3>\n                <p className=\"mt-1 flex-1 text-sm text-muted-foreground\">\n                  {item.meta}\n                </p>\n                <div className=\"mt-6 flex items-center justify-between border-t pt-4 text-sm\">\n                  <span className=\"font-medium\">{item.price}</span>\n                  <ArrowUpRight className=\"size-4 text-muted-foreground transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5\" />\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              From zero to production\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-indigo-600 dark:text-indigo-400\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Loved by engineers\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-6 md:grid-cols-3\">\n            {testimonials.map((t) => (\n              <figure\n                key={t.name}\n                className=\"flex flex-col rounded-2xl border p-6\"\n              >\n                <blockquote className=\"flex-1 leading-7\">\n                  &ldquo;{t.quote}&rdquo;\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 border-t pt-6 text-sm\">\n                  <span className=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Pay for what you use\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              A generous free tier for side projects and transparent usage\n              pricing once you scale. No seat fees, ever.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-indigo-500 shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-indigo-600 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-indigo-600 dark:text-indigo-400\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Developer FAQ\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Get in touch\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"px-6 py-20 md:py-28\">\n        <div className=\"relative mx-auto max-w-6xl overflow-hidden rounded-3xl border bg-indigo-500/10 px-6 py-16 text-center md:py-24\">\n          <div className=\"pointer-events-none absolute -top-24 left-1/2 size-96 -translate-x-1/2 rounded-full bg-gradient-to-b from-indigo-500/25 via-violet-500/10 to-transparent blur-3xl\" />\n          <div className=\"relative mx-auto max-w-2xl space-y-6\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Stop babysitting your job queue\n            </h2>\n            <p className=\"text-lg text-muted-foreground\">\n              Write jobs in plain TypeScript or Python and run 50,000 steps a\n              month free.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Run your first job\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                See examples\n              </Button>\n            </div>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-indigo-600 text-white text-sm\">\n                C\n              </span>\n              <span className=\"\">Cronhook</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              Reliable jobs for busy apps.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Cronhook. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    <