      "path": "registry/designali/pages/restaurant/landing-restaurant-05/page.tsx",
      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  Check,\n  Flame,\n  Gift,\n  Leaf,\n  Plus,\n  Salad,\n  Sparkles,\n  Truck,\n  Users,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Services\", \"About\", \"Packages\", \"Work\", \"Contact\"]\n\nconst features = [\n  {\n    icon: Users,\n    title: \"Packages\",\n    description:\n      \"Fixed-price packages for brand, menus and website, with Ali Imam as your single point of contact.\",\n  },\n  {\n    icon: Salad,\n    title: \"Social & motion visuals\",\n    description:\n      \"Templates, short motion loops and launch visuals so your feed always looks as good as the food.\",\n  },\n  {\n    icon: Truck,\n    title: \"Delivery & ordering UX\",\n    description:\n      \"Clear ordering flows for pickup and delivery, designed to be quick on any phone.\",\n  },\n  {\n    icon: Gift,\n    title: \"Work\",\n    description:\n      \"Gift cards, vouchers and loyalty cards designed to match your brand.\",\n  },\n  {\n    icon: Leaf,\n    title: \"Brand from the table up\",\n    description:\n      \"Logos, colour and type that work on a menu, a coffee cup, a storefront sign and an Instagram post.\",\n  },\n  {\n    icon: Flame,\n    title: \"Menus that sell\",\n    description:\n      \"Print and digital menus designed for clarity, so guests find what they want and the specials stand out.\",\n  },\n]\n\nconst stats = [\n  { value: \"4.8/5\", label: \"Client rating\" },\n  { value: \"30+\", label: \"Pages and screens per project\" },\n  { value: \"2-4 wks\", label: \"Typical brand sprint\" },\n  { value: \"20+\", label: \"Deliverables per brand\" },\n]\n\nconst steps = [\n  {\n    title: \"Book a discovery call\",\n    description:\n      \"Tell us about your restaurant, your guests and what you want people to feel when they walk in.\",\n  },\n  {\n    title: \"Share your references\",\n    description:\n      \"Add photos, menus and brands you love, plus any dietary or accessibility notes for the menu.\",\n  },\n  {\n    title: \"Design together\",\n    description:\n      \"Concepts are shared in Figma with weekly reviews until the brand feels right.\",\n  },\n  {\n    title: \"Launch and serve\",\n    description:\n      \"We deliver print files, the website and social templates, ready for opening night.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Menu Design\",\n    meta: \"Print and digital menus, specials boards\",\n    tag: \"Popular\",\n    price: \"$1,800\",\n    tile: \"bg-gradient-to-br from-muted via-border to-muted-foreground dark:from-muted dark:via-card dark:to-card\",\n  },\n  {\n    name: \"Logo & Identity\",\n    meta: \"Logo, colour, type, brand guidelines\",\n    tag: \"Brand\",\n    price: \"$1,400\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-chart-1 dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Booking Website\",\n    meta: \"Next.js site, reservations, hours\",\n    tag: \"Website\",\n    price: \"$1,200\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Packaging Set\",\n    meta: \"Boxes, bags, cups and labels\",\n    tag: \"Print\",\n    price: \"$2,400\",\n    tile: \"bg-gradient-to-br from-primary/10 via-primary/20 to-chart-1 dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Social Kit\",\n    meta: \"48-hour heritage grain loaf\",\n    tag: \"Templates and launch posts\",\n    price: \"$600\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Motion Loops\",\n    meta: \"Short videos for menus and screens\",\n    tag: \"Motion\",\n    price: \"$900\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"The vegan menu design was so clear that guests started ordering from it just to try it.\",\n    name: \"Elena\",\n    role: \"Designali client\",\n  },\n  {\n    quote:\n      \"Designali found a brand direction that beat anything we had imagined. Great value, zero fuss.\",\n    name: \"Patrick\",\n    role: \"Owner, wine bar\",\n  },\n  {\n    quote:\n      \"Ali designed our menu, signage and website in one go. Guests keep telling us how easy everything is to read.\",\n    name: \"Hannah and Leo\",\n    role: \"Owners, neighbourhood restaurant\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Menu Refresh\",\n    price: \"$1,200\",\n    period: \"/project\",\n    description: \"A new look for your menus and specials.\",\n    features: [\n      \"Menu layout and typography\",\n      \"Print-ready files\",\n      \"Digital menu version\",\n      \"Two rounds of revisions\",\n    ],\n    cta: \"Book a menu refresh\",\n  },\n  {\n    name: \"Full Brand\",\n    price: \"$4,800\",\n    period: \"/project\",\n    description: \"Identity, menus and website for a new opening.\",\n    features: [\n      \"Logo and brand guidelines\",\n      \"Menus and signage\",\n      \"Next.js booking website\",\n      \"Social media templates\",\n      \"Packaging design\",\n    ],\n    cta: \"Book Full Brand\",\n  },\n  {\n    name: \"Ongoing support\",\n    price: \"From $650\",\n    period: \"/month\",\n    description: \"Monthly design support for busy restaurants.\",\n    features: [\n      \"Seasonal menu updates\",\n      \"Campaign graphics\",\n      \"Website updates\",\n      \"Social content templates\",\n      \"Motion loops for screens\",\n    ],\n    cta: \"Start support\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"Can you work with existing branding?\",\n    a: \"Yes. We can refresh an existing brand gently or extend it into new menus, packaging and a website.\",\n  },\n  {\n    q: \"Do you offer gift card designs?\",\n    a: \"Yes. Gift cards, vouchers and loyalty cards can be added to any package.\",\n  },\n  {\n    q: \"Do you work with new openings?\",\n    a: \"Yes. We often start months before opening, so the brand, menus and website are ready for the first service.\",\n  },\n  {\n    q: \"Can you design for dietary labels and allergens?\",\n    a: \"Absolutely. Menus are designed with clear dietary icons and allergen notes, based on the information you provide.\",\n  },\n  {\n    q: \"Do you also build the website?\",\n    a: \"Yes. Ali Imam designs and builds the site in Next.js, connected to the booking or ordering tools you already use.\",\n  },\n]\n\nconst footer = [\n  {\n    title: \"Contact\",\n    links: [\"Services\", \"Process\", \"Work\", \"Pricing\"],\n  },\n  { title: \"Menus\", links: [\"Brand identity\", \"Websites\", \"Packaging\", \"Social kits\"] },\n  {\n    title: \"More\",\n    links: [\"Packages\", \"Work\", \"About Ali\", \"Blog\"],\n  },\n]\n\nexport default function LandingRestaurant05() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <div className=\"border-b border-background/10 bg-foreground text-background/80 px-4 py-2 text-center text-xs sm:text-sm\">\n        <a\n          href=\"#\"\n          className=\"inline-flex items-center gap-1.5 hover:underline\"\n        >\n          New: seafood and coastal restaurant brand packages\n          <ArrowRight className=\"size-3.5\" />\n        </a>\n      </div>\n      <header className=\"bg-foreground text-background sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-background text-foreground text-sm\">\n              T\n            </span>\n            <span className=\"\">designali</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-background/70 hover:text-background transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex text-background hover:bg-background/10 hover:text-background\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Book a call\n            </Button>\n            <Button\n              size=\"sm\"\n              className=\"bg-background text-foreground hover:bg-background/90\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Book a call\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"relative overflow-hidden bg-foreground text-background\">\n        <div className=\"pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,currentColor_1px,transparent_1px),linear-gradient(to_bottom,currentColor_1px,transparent_1px)] bg-[size:64px_64px] opacity-[0.04]\" />\n        <div className=\"relative mx-auto max-w-7xl px-6 pt-16 pb-20 md:pt-28\">\n          <div className=\"max-w-4xl space-y-7\">\n            <span className=\"inline-flex items-center gap-2 rounded-full border border-background/20 text-background/80 px-3 py-1 text-xs font-medium\">\n              <Sparkles className=\"size-3.5 \" />\n              Design for seafood restaurants\n            </span>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-7xl \">\n              {\"Fresh brands \"}\n              <span className=\"text-background/60\">for every plate</span>\n            </h1>\n            <p className=\"max-w-2xl text-lg leading-8 text-background/65\">\n              Designali designs brands, menus and booking sites for seafood\n              restaurants and event venues, including wedding and event menus.\n            </p>\n            <div className=\"flex flex-wrap gap-3 \">\n              <Button\n                size=\"lg\"\n                className=\"bg-background text-foreground hover:bg-background/90\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Book a call\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                className=\"border-background/25 bg-transparent text-background hover:bg-background/10 hover:text-background\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Plan a project\n              </Button>\n            </div>\n          </div>\n          <div className=\"mt-16\">\n            <HeroVisual />\n          </div>\n        </div>\n      </section>\n      <section className=\"bg-foreground text-background\">\n        <div className=\"mx-auto grid max-w-7xl grid-cols-2 px-6 lg:grid-cols-4\">\n          {stats.slice(0, 4).map((stat, i) => (\n            <div\n              key={stat.label}\n              className={`py-12 ${i > 0 ? \"lg:border-l lg:pl-8\" : \"\"} ${i % 2 === 1 ? \"border-l pl-6 lg:pl-8\" : \"\"} border-background/10`}\n            >\n              <div className=\"text-4xl font-semibold tracking-tight md:text-5xl \">\n                {stat.value}\n              </div>\n              <div className=\"mt-2 text-sm text-background/60\">\n                {stat.label}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"max-w-2xl\">\n            <p className=\"text-sm font-medium text-primary dark:text-primary\">\n              Our approach\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              Restaurant design, made with care\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              We work closely with chefs and owners, design every touchpoint\n              together and make almost everything production ready.\n            </p>\n          </div>\n          <div className=\"mt-14 grid overflow-hidden rounded-2xl border sm:grid-cols-2 lg:grid-cols-3\">\n            {features.map((feature) => (\n              <div\n                key={feature.title}\n                className=\"-mt-px -ml-px border-t border-l p-8\"\n              >\n                <feature.icon className=\"size-6 text-primary dark:text-primary\" />\n                <h3 className=\"mt-5 font-semibold\">{feature.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Our services\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                {\n                  \"A taste of what Designali creates for restaurants. Every project is scoped around your menu, your space and your guests.\"\n                }\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a key={item.name} href=\"#\" className=\"group\">\n                <div\n                  className={`relative aspect-[4/3] overflow-hidden rounded-2xl ${item.tile}`}\n                >\n                  <div className=\"absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10\" />\n                  <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-foreground backdrop-blur\">\n                    {item.tag}\n                  </span>\n                </div>\n                <div className=\"mt-4 flex items-start justify-between gap-4\">\n                  <div className=\"min-w-0\">\n                    <h3 className=\"font-medium \">{item.name}</h3>\n                    <p className=\"mt-1 text-sm text-muted-foreground\">\n                      {item.meta}\n                    </p>\n                  </div>\n                  <span className=\"shrink-0 text-sm font-semibold\">\n                    {item.price}\n                  </span>\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              How a project works\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-primary dark:text-primary\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              What restaurant owners are saying\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-6 md:grid-cols-3\">\n            {testimonials.map((t) => (\n              <figure\n                key={t.name}\n                className=\"flex flex-col rounded-2xl border p-6\"\n              >\n                <blockquote className=\"flex-1 leading-7\">\n                  &ldquo;{t.quote}&rdquo;\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 border-t pt-6 text-sm\">\n                  <span className=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Packages and support\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              {\n                \"Start with a menu refresh, go for a full brand, or keep Designali on for monthly updates.\"\n              }\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"bg-foreground text-background border-foreground\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-background text-foreground px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p\n                    className={\n                      featured\n                        ? \"mt-2 text-sm text-background/65\"\n                        : \"mt-2 text-sm text-muted-foreground\"\n                    }\n                  >\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span\n                      className={\n                        featured\n                          ? \"text-sm text-background/65\"\n                          : \"text-sm text-muted-foreground\"\n                      }\n                    >\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check\n                          className={\n                            featured\n                              ? \"mt-0.5 size-4 shrink-0\"\n                              : \"mt-0.5 size-4 shrink-0 text-primary dark:text-primary\"\n                          }\n                        />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className={\n                      featured\n                        ? \"mt-8 w-full bg-background text-foreground hover:bg-background/90\"\n                        : \"mt-8 w-full\"\n                    }\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Good to know\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Contact us\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"bg-foreground text-background\">\n        <div className=\"mx-auto flex max-w-7xl flex-col gap-10 px-6 py-20 md:flex-row md:items-end md:justify-between md:py-28\">\n          <div className=\"max-w-2xl\">\n            <h2 className=\"text-4xl font-semibold tracking-tight text-balance md:text-6xl \">\n              Celebrate with a fresh brand\n            </h2>\n            <p className=\"mt-5 text-lg text-background/65\">\n              Book a full brand package or ask about ongoing design support.\n            </p>\n          </div>\n          <div className=\"flex flex-wrap gap-3 \">\n            <Button\n              size=\"lg\"\n              className=\"bg-background text-foreground hover:bg-background/90\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Book a call\n              <ArrowRight />\n            </Button>\n            <Button\n              size=\"lg\"\n              variant=\"outline\"\n              className=\"border-background/25 bg-transparent text-background hover:bg-background/10 hover:text-background\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Plan a project\n            </Button>\n          </div>\n        </div>\n      </section>\n      <footer className=\"border-t border-background/10 bg-foreground text-background\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-background text-foreground text-sm\">\n                T\n              </span>\n              <span className=\"\">designali</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-background/60\">\n              Design se code tak, by the water.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-background/60 transition-colors hover:text-background\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t border-background/10\">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-background/60 sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} designali. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-background\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-background\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-background\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  return (\n    <div className=\"grid grid-cols-2 gap-3 md:grid-cols-3\">\n      {showcase.slice(0, 3).map((item, i) => (\n        <div\n          key={item.name}\n          className={`relative overflow-hidden rounded-2xl ${item.tile} ${i === 0 ? \"col-span-2 aspect-[16/10] md:col-span-1 md:aspect-[3/4]\" : \"aspect-[3/4]\"}`}\n        >\n          <div className=\"absolute inset-0 bg-gradient-to-t from-black/50 via-black/0 to-black/0\" />\n          <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-foreground backdrop-blur\">\n            {item.tag}\n          </span>\n          <div className=\"absolute inset-x-3 bottom-3 flex items-end justify-between gap-2 text-white\">\n            <div className=\"min-w-0\">\n              <div className=\"truncate text-sm font-medium\">{item.name}</div>\n              <div className=\"truncate text-xs text-white/75\">{item.meta}</div>\n            </div>\n            <div className=\"shrink-0 text-sm font-semibold\">{item.price}</div>\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n",
      "type": "registry:page",
      "target": "app/landing-restaurant-05/page.tsx"
    }
