{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "table-49",
  "type": "registry:example",
  "description": "An accessible data table with a top caption, scoped headers, and a source note.",
  "files": [
    {
      "path": "registry/designali/examples/table/table-49.tsx",
      "content": "import {\n  Table,\n  TableBody,\n  TableCaption,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from \"@workspace/ui/components/table\"\n\nconst cities = [\n  { city: \"Lisbon\", temp: 17, rain: 112, sun: 6.1 },\n  { city: \"Oslo\", temp: 2, rain: 74, sun: 1.2 },\n  { city: \"Nairobi\", temp: 21, rain: 61, sun: 7.4 },\n  { city: \"Sapporo\", temp: 1, rain: 104, sun: 2.9 },\n]\n\nexport default function CaptionedDataTable() {\n  return (\n    <div className=\"w-full max-w-md border\">\n      <Table>\n        <TableCaption className=\"mt-0 caption-top border-b px-2 py-2 text-start\">\n          <span className=\"font-medium text-foreground\">\n            November climate averages\n          </span>\n          <span className=\"block\">\n            Source: fictional weather service, 1995-2025\n          </span>\n        </TableCaption>\n        <TableHeader>\n          <TableRow>\n            <TableHead scope=\"col\">City</TableHead>\n            <TableHead scope=\"col\" className=\"text-right\">\n              Temp (°C)\n            </TableHead>\n            <TableHead scope=\"col\" className=\"text-right\">\n              Rain (mm)\n            </TableHead>\n            <TableHead scope=\"col\" className=\"text-right\">\n              Sun (h/day)\n            </TableHead>\n          </TableRow>\n        </TableHeader>\n        <TableBody>\n          {cities.map((c) => (\n            <TableRow key={c.city}>\n              <TableHead scope=\"row\" className=\"font-medium\">\n                {c.city}\n              </TableHead>\n              <TableCell className=\"text-right tabular-nums\">\n                {c.temp}\n              </TableCell>\n              <TableCell className=\"text-right tabular-nums\">\n                {c.rain}\n              </TableCell>\n              <TableCell className=\"text-right tabular-nums\">{c.sun}</TableCell>\n            </TableRow>\n          ))}\n        </TableBody>\n      </Table>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}