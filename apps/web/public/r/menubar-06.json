{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "menubar-06",
  "type": "registry:example",
  "description": "Image editing menubar with adjustment and filter submenus using leading icons.",
  "files": [
    {
      "path": "registry/designali/examples/menubar/menubar-06.tsx",
      "content": "import {\n  AppWindowIcon,\n  ContrastIcon,\n  CropIcon,\n  DropletIcon,\n  FlipHorizontalIcon,\n  PaletteIcon,\n  RotateCwIcon,\n  ScalingIcon,\n  SunIcon,\n  WandSparklesIcon,\n} from \"lucide-react\"\n\nimport {\n  Menubar,\n  MenubarContent,\n  MenubarGroup,\n  MenubarItem,\n  MenubarMenu,\n  MenubarSeparator,\n  MenubarShortcut,\n  MenubarSub,\n  MenubarSubContent,\n  MenubarSubTrigger,\n  MenubarTrigger,\n} from \"@workspace/ui/components/menubar\"\n\nexport default function PhotoEditorMenubar() {\n  return (\n    <div className=\"flex w-full max-w-md flex-col gap-3\">\n      <Menubar>\n        <MenubarMenu>\n          <MenubarTrigger>Image</MenubarTrigger>\n          <MenubarContent>\n            <MenubarGroup>\n              <MenubarItem>\n                <CropIcon /> Crop <MenubarShortcut>C</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>\n                <RotateCwIcon /> Rotate 90° clockwise\n              </MenubarItem>\n              <MenubarItem>\n                <FlipHorizontalIcon /> Flip horizontal\n              </MenubarItem>\n              <MenubarItem>\n                <ScalingIcon /> Resize canvas...\n              </MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>Adjust</MenubarTrigger>\n          <MenubarContent>\n            <MenubarGroup>\n              <MenubarItem>\n                <SunIcon /> Brightness\n              </MenubarItem>\n              <MenubarItem>\n                <ContrastIcon /> Contrast\n              </MenubarItem>\n              <MenubarItem>\n                <DropletIcon /> Saturation\n              </MenubarItem>\n            </MenubarGroup>\n            <MenubarSeparator />\n            <MenubarGroup>\n              <MenubarItem>\n                <WandSparklesIcon /> Auto enhance{\" \"}\n                <MenubarShortcut>⇧⌘E</MenubarShortcut>\n              </MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>Filter</MenubarTrigger>\n          <MenubarContent>\n            <MenubarGroup>\n              <MenubarSub>\n                <MenubarSubTrigger>\n                  <AppWindowIcon /> Blur\n                </MenubarSubTrigger>\n                <MenubarSubContent>\n                  <MenubarGroup>\n                    <MenubarItem>Gaussian blur</MenubarItem>\n                    <MenubarItem>Motion blur</MenubarItem>\n                    <MenubarItem>Lens blur</MenubarItem>\n                  </MenubarGroup>\n                </MenubarSubContent>\n              </MenubarSub>\n              <MenubarSub>\n                <MenubarSubTrigger>\n                  <PaletteIcon /> Stylize\n                </MenubarSubTrigger>\n                <MenubarSubContent>\n                  <MenubarGroup>\n                    <MenubarItem>Grain</MenubarItem>\n                    <MenubarItem>Duotone</MenubarItem>\n                    <MenubarItem>Vignette</MenubarItem>\n                  </MenubarGroup>\n                </MenubarSubContent>\n              </MenubarSub>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n      </Menubar>\n      <div className=\"aspect-video w-full bg-gradient-to-br from-amber-300 via-rose-400 to-indigo-500\" />\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}