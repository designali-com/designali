{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "menubar-18",
  "type": "registry:example",
  "description": "Database console menubar with query actions and an export submenu offering several formats.",
  "files": [
    {
      "path": "registry/designali/examples/menubar/menubar-18.tsx",
      "content": "import {\n  AlignLeftIcon,\n  DatabaseBackupIcon,\n  DownloadIcon,\n  EraserIcon,\n  HistoryIcon,\n  KeyRoundIcon,\n  ListTreeIcon,\n  PlayIcon,\n  TableIcon,\n} from \"lucide-react\"\n\nimport {\n  Menubar,\n  MenubarContent,\n  MenubarGroup,\n  MenubarItem,\n  MenubarMenu,\n  MenubarSeparator,\n  MenubarShortcut,\n  MenubarSub,\n  MenubarSubContent,\n  MenubarSubTrigger,\n  MenubarTrigger,\n} from \"@workspace/ui/components/menubar\"\n\nexport default function DatabaseConsoleMenubar() {\n  return (\n    <div className=\"flex w-full max-w-md flex-col gap-2\">\n      <Menubar>\n        <MenubarMenu>\n          <MenubarTrigger>Query</MenubarTrigger>\n          <MenubarContent className=\"w-52\">\n            <MenubarGroup>\n              <MenubarItem>\n                <PlayIcon /> Run query <MenubarShortcut>⌘↵</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>\n                <ListTreeIcon /> Explain plan{\" \"}\n                <MenubarShortcut>⇧⌘E</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>\n                <AlignLeftIcon /> Format SQL\n              </MenubarItem>\n            </MenubarGroup>\n            <MenubarSeparator />\n            <MenubarGroup>\n              <MenubarItem>\n                <HistoryIcon /> Query history\n              </MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>Table</MenubarTrigger>\n          <MenubarContent>\n            <MenubarGroup>\n              <MenubarItem>\n                <TableIcon /> New table\n              </MenubarItem>\n              <MenubarItem>\n                <KeyRoundIcon /> Manage indexes\n              </MenubarItem>\n              <MenubarItem variant=\"destructive\">\n                <EraserIcon /> Truncate table\n              </MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>Export</MenubarTrigger>\n          <MenubarContent>\n            <MenubarGroup>\n              <MenubarSub>\n                <MenubarSubTrigger>\n                  <DownloadIcon /> Results as\n                </MenubarSubTrigger>\n                <MenubarSubContent>\n                  <MenubarGroup>\n                    <MenubarItem>CSV</MenubarItem>\n                    <MenubarItem>JSON</MenubarItem>\n                    <MenubarItem>SQL inserts</MenubarItem>\n                    <MenubarItem>Markdown table</MenubarItem>\n                  </MenubarGroup>\n                </MenubarSubContent>\n              </MenubarSub>\n              <MenubarItem>\n                <DatabaseBackupIcon /> Full backup...\n              </MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n      </Menubar>\n      <pre className=\"overflow-x-auto border bg-muted/50 p-3 font-mono text-[11px] leading-relaxed\">\n        {\"SELECT plan, COUNT(*)\\nFROM subscriptions\\nGROUP BY plan;\"}\n      </pre>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}