{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "navigation-menu-10",
  "type": "registry:example",
  "description": "Navigation menu with a controlled value showing which submenu is open and buttons to open them.",
  "files": [
    {
      "path": "registry/designali/examples/navigation-menu/navigation-menu-10.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  NavigationMenu,\n  NavigationMenuContent,\n  NavigationMenuItem,\n  NavigationMenuLink,\n  NavigationMenuList,\n  NavigationMenuTrigger,\n} from \"@workspace/ui/components/navigation-menu\"\n\nexport default function ControlledValueNav() {\n  const [value, setValue] = React.useState<string | null>(null)\n\n  return (\n    <div className=\"flex flex-col items-center gap-3\">\n      <NavigationMenu\n        value={value}\n        onValueChange={(next) => setValue(next as string | null)}\n      >\n        <NavigationMenuList>\n          <NavigationMenuItem value=\"solutions\">\n            <NavigationMenuTrigger>Solutions</NavigationMenuTrigger>\n            <NavigationMenuContent>\n              <ul className=\"flex w-56 flex-col gap-1\">\n                {[\"For startups\", \"For agencies\", \"For enterprise\"].map((s) => (\n                  <li key={s}>\n                    <NavigationMenuLink href=\"#\">{s}</NavigationMenuLink>\n                  </li>\n                ))}\n              </ul>\n            </NavigationMenuContent>\n          </NavigationMenuItem>\n          <NavigationMenuItem value=\"company\">\n            <NavigationMenuTrigger>Company</NavigationMenuTrigger>\n            <NavigationMenuContent>\n              <ul className=\"flex w-48 flex-col gap-1\">\n                {[\"About\", \"Careers\", \"Contact\"].map((s) => (\n                  <li key={s}>\n                    <NavigationMenuLink href=\"#\">{s}</NavigationMenuLink>\n                  </li>\n                ))}\n              </ul>\n            </NavigationMenuContent>\n          </NavigationMenuItem>\n        </NavigationMenuList>\n      </NavigationMenu>\n      <div className=\"flex items-center gap-2\">\n        <Button\n          size=\"sm\"\n          variant=\"outline\"\n          onClick={() => setValue(\"solutions\")}\n        >\n          Open Solutions\n        </Button>\n        <Button size=\"sm\" variant=\"ghost\" onClick={() => setValue(null)}>\n          Close\n        </Button>\n      </div>\n      <p className=\"text-xs text-muted-foreground\">\n        Open menu: {value ?? \"none\"}\n      </p>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}