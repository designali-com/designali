{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "command-37",
  "type": "registry:example",
  "description": "A fake search field in a site header that opens a docs command dialog with a close button.",
  "files": [
    {
      "path": "registry/designali/examples/command/command-37.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  BracesIcon,\n  DownloadIcon,\n  RocketIcon,\n  SearchIcon,\n  WebhookIcon,\n} from \"lucide-react\"\n\nimport {\n  Command,\n  CommandDialog,\n  CommandEmpty,\n  CommandGroup,\n  CommandInput,\n  CommandItem,\n  CommandList,\n} from \"@workspace/ui/components/command\"\nimport { Kbd, KbdGroup } from \"@workspace/ui/components/kbd\"\n\nexport default function NavbarSearchTrigger() {\n  const [open, setOpen] = React.useState(false)\n\n  return (\n    <div className=\"flex w-full max-w-md items-center gap-3 border px-3 py-2\">\n      <span className=\"text-sm font-semibold\">Fieldnote Docs</span>\n      <button\n        type=\"button\"\n        onClick={() => setOpen(true)}\n        className=\"ms-auto flex h-8 w-full max-w-48 items-center gap-2 border bg-muted/50 px-2 text-xs text-muted-foreground hover:bg-muted\"\n      >\n        <SearchIcon className=\"size-3.5\" />\n        Search docs\n        <KbdGroup className=\"ms-auto\">\n          <Kbd>⌘</Kbd>\n          <Kbd>K</Kbd>\n        </KbdGroup>\n      </button>\n      <CommandDialog\n        open={open}\n        onOpenChange={setOpen}\n        title=\"Search documentation\"\n        description=\"Search guides, API reference, and changelog\"\n        showCloseButton\n      >\n        <Command>\n          <CommandInput placeholder=\"Search documentation...\" />\n          <CommandList>\n            <CommandEmpty>No pages found.</CommandEmpty>\n            <CommandGroup heading=\"Getting started\">\n              <CommandItem onSelect={() => setOpen(false)}>\n                <RocketIcon />\n                <span>Quickstart</span>\n              </CommandItem>\n              <CommandItem onSelect={() => setOpen(false)}>\n                <DownloadIcon />\n                <span>Installation</span>\n              </CommandItem>\n            </CommandGroup>\n            <CommandGroup heading=\"API reference\">\n              <CommandItem onSelect={() => setOpen(false)}>\n                <BracesIcon />\n                <span>REST endpoints</span>\n              </CommandItem>\n              <CommandItem onSelect={() => setOpen(false)}>\n                <WebhookIcon />\n                <span>Webhook events</span>\n              </CommandItem>\n            </CommandGroup>\n          </CommandList>\n        </Command>\n      </CommandDialog>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}