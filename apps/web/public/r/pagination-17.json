{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "pagination-17",
  "type": "registry:example",
  "description": "Fully disabled pagination shown while a dataset is locked for re-indexing.",
  "files": [
    {
      "path": "registry/designali/examples/pagination/pagination-17.tsx",
      "content": "import {\n  Lock as LockIcon,\n} from \"@designali/icons\"\n\nimport {\n  Pagination,\n  PaginationContent,\n  PaginationItem,\n  PaginationLink,\n  PaginationNext,\n  PaginationPrevious,\n} from \"@workspace/ui/components/pagination\"\n\nexport default function DisabledPagination() {\n  return (\n    <div className=\"flex w-full max-w-md flex-col items-center gap-2\">\n      <Pagination aria-disabled className=\"pointer-events-none opacity-50\">\n        <PaginationContent>\n          <PaginationItem>\n            <PaginationPrevious href=\"#\" tabIndex={-1} />\n          </PaginationItem>\n          {[1, 2, 3].map((p) => (\n            <PaginationItem key={p}>\n              <PaginationLink href=\"#\" tabIndex={-1} isActive={p === 1}>\n                {p}\n              </PaginationLink>\n            </PaginationItem>\n          ))}\n          <PaginationItem>\n            <PaginationNext href=\"#\" tabIndex={-1} />\n          </PaginationItem>\n        </PaginationContent>\n      </Pagination>\n      <p className=\"flex items-center gap-1.5 text-xs text-muted-foreground\">\n        <LockIcon className=\"size-3\" />\n        Navigation paused while the icon index rebuilds\n      </p>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}