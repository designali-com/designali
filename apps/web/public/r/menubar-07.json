{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "menubar-07",
  "type": "registry:example",
  "description": "Media player menubar with a play/pause action, shuffle checkbox and repeat mode radio reflected in a status line.",
  "files": [
    {
      "path": "registry/designali/examples/menubar/menubar-07.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  Pause as PauseIcon,\n  Play as PlayIcon,\n  Repeat1 as Repeat1Icon,\n  Repeat as RepeatIcon,\n  Shuffle as ShuffleIcon,\n  SkipBack as SkipBackIcon,\n  SkipForward as SkipForwardIcon,\n  Volume2 as Volume2Icon,\n  VolumeX as VolumeXIcon,\n} from \"@designali/icons\"\n\nimport {\n  Menubar,\n  MenubarCheckboxItem,\n  MenubarContent,\n  MenubarGroup,\n  MenubarItem,\n  MenubarLabel,\n  MenubarMenu,\n  MenubarRadioGroup,\n  MenubarRadioItem,\n  MenubarSeparator,\n  MenubarShortcut,\n  MenubarTrigger,\n} from \"@workspace/ui/components/menubar\"\n\nexport default function MusicPlayerMenubar() {\n  const [playing, setPlaying] = React.useState(false)\n  const [shuffle, setShuffle] = React.useState(true)\n  const [repeat, setRepeat] = React.useState(\"off\")\n\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-3\">\n      <Menubar>\n        <MenubarMenu>\n          <MenubarTrigger>Controls</MenubarTrigger>\n          <MenubarContent className=\"w-52\">\n            <MenubarGroup>\n              <MenubarItem onClick={() => setPlaying((p) => !p)}>\n                {playing ? <PauseIcon /> : <PlayIcon />}\n                {playing ? \"Pause\" : \"Play\"}\n                <MenubarShortcut>Space</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>\n                <SkipForwardIcon /> Next track{\" \"}\n                <MenubarShortcut>⌘→</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>\n                <SkipBackIcon /> Previous track{\" \"}\n                <MenubarShortcut>⌘←</MenubarShortcut>\n              </MenubarItem>\n            </MenubarGroup>\n            <MenubarSeparator />\n            <MenubarGroup>\n              <MenubarCheckboxItem\n                checked={shuffle}\n                onCheckedChange={setShuffle}\n              >\n                Shuffle\n              </MenubarCheckboxItem>\n            </MenubarGroup>\n            <MenubarSeparator />\n            <MenubarGroup>\n              <MenubarLabel inset>Repeat</MenubarLabel>\n              <MenubarRadioGroup value={repeat} onValueChange={setRepeat}>\n                <MenubarRadioItem value=\"off\">Off</MenubarRadioItem>\n                <MenubarRadioItem value=\"all\">All</MenubarRadioItem>\n                <MenubarRadioItem value=\"one\">One</MenubarRadioItem>\n              </MenubarRadioGroup>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>Library</MenubarTrigger>\n          <MenubarContent>\n            <MenubarGroup>\n              <MenubarItem>Add to playlist</MenubarItem>\n              <MenubarItem>Show album</MenubarItem>\n              <MenubarItem>Love track</MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n      </Menubar>\n      <div className=\"flex items-center gap-3 border p-3\">\n        <div className=\"size-10 shrink-0 bg-gradient-to-br from-primary to-primary\" />\n        <div className=\"min-w-0 flex-1\">\n          <p className=\"truncate text-sm font-medium\">Design se code tak</p>\n          <p className=\"truncate text-xs text-muted-foreground\">\n            Designali\n          </p>\n        </div>\n        <div className=\"flex items-center gap-1.5 text-muted-foreground\">\n          {playing ? (\n            <Volume2Icon className=\"size-4\" />\n          ) : (\n            <VolumeXIcon className=\"size-4\" />\n          )}\n          {shuffle && <ShuffleIcon className=\"size-4\" />}\n          {repeat !== \"off\" &&\n            (repeat === \"one\" ? (\n              <Repeat1Icon className=\"size-4\" />\n            ) : (\n              <RepeatIcon className=\"size-4\" />\n            ))}\n        </div>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}