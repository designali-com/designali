{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "landing-event-02",
  "type": "registry:page",
  "description": "An event landing page for a summer music and arts festival with bold editorial typography.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
