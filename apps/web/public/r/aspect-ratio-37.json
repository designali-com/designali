{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "aspect-ratio-37",
  "type": "registry:example",
  "description": "A 4:1 voice memo waveform drawn as SVG bars with a playhead.",
  "files": [
    {
      "path": "registry/designali/examples/aspect-ratio/aspect-ratio-37.tsx",
      "content": "import { PlayIcon } from \"lucide-react\"\n\nimport { AspectRatio } from \"@workspace/ui/components/aspect-ratio\"\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst bars = Array.from(\n  { length: 48 },\n  (_, i) => 20 + Math.abs(Math.sin(i * 0.7) * 60) + ((i * 13) % 17)\n)\n\nexport default function AudioWaveformStrip() {\n  const progress = 0.42\n\n  return (\n    <div className=\"flex w-full max-w-md items-center gap-3 border p-3\">\n      <Button\n        size=\"icon\"\n        aria-label=\"Play memo\"\n        className=\"shrink-0 rounded-full\"\n      >\n        <PlayIcon className=\"fill-current\" />\n      </Button>\n      <div className=\"min-w-0 flex-1\">\n        <AspectRatio ratio={4}>\n          <svg\n            viewBox=\"0 0 192 100\"\n            preserveAspectRatio=\"none\"\n            className=\"absolute inset-0 size-full\"\n            aria-hidden=\"true\"\n          >\n            {bars.map((height, i) => (\n              <rect\n                key={i}\n                x={i * 4}\n                y={50 - height / 2}\n                width=\"2.5\"\n                height={height}\n                className={\n                  i / bars.length < progress\n                    ? \"fill-primary\"\n                    : \"fill-muted-foreground/30\"\n                }\n              />\n            ))}\n          </svg>\n        </AspectRatio>\n        <div className=\"mt-1 flex justify-between font-mono text-[10px] text-muted-foreground\">\n          <span>0:27</span>\n          <span>1:04</span>\n        </div>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}