{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "avatar-27",
  "type": "registry:example",
  "description": "A chat typing indicator showing who is composing a reply.",
  "files": [
    {
      "path": "registry/designali/examples/avatar/avatar-27.tsx",
      "content": "import {\n  Avatar,\n  AvatarBadge,\n  AvatarFallback,\n} from \"@workspace/ui/components/avatar\"\n\nexport default function TypingIndicatorAvatar() {\n  return (\n    <div className=\"flex items-end gap-2\">\n      <Avatar size=\"sm\">\n        <AvatarFallback>QA</AvatarFallback>\n        <AvatarBadge className=\"bg-emerald-500\" />\n      </Avatar>\n      <div\n        className=\"flex items-center gap-1 bg-muted px-3 py-2.5\"\n        aria-label=\"Quinn is typing\"\n      >\n        <span className=\"size-1.5 animate-bounce rounded-full bg-muted-foreground [animation-delay:-0.3s]\" />\n        <span className=\"size-1.5 animate-bounce rounded-full bg-muted-foreground [animation-delay:-0.15s]\" />\n        <span className=\"size-1.5 animate-bounce rounded-full bg-muted-foreground\" />\n      </div>\n      <span className=\"text-xs text-muted-foreground\">Quinn is typing...</span>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}