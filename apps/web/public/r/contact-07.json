{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "contact-07",
  "type": "registry:block",
  "description": "Three-step sales enquiry wizard with a segmented progress bar, choice tiles, back/continue controls and a success state.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "button",
    "input",
    "label",
    "textarea"
  ],
  "files": [
    {
      "path": "registry/designali/blocks/contact/contact-07.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\nimport { ArrowLeft, ArrowRight, Check } from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport { Input } from \"@workspace/ui/components/input\"\nimport { Label } from \"@workspace/ui/components/label\"\nimport { Textarea } from \"@workspace/ui/components/textarea\"\nimport { cn } from \"@workspace/ui/lib/utils\"\n\nconst steps = [\"Your team\", \"The project\", \"Contact\"]\n\nconst sizes = [\"1-10\", \"11-50\", \"51-200\", \"200+\"]\nconst goals = [\n  \"Launch a new product\",\n  \"Redesign an existing app\",\n  \"Scale a design system\",\n  \"Something else\",\n]\n\nexport default function Contact07() {\n  const [step, setStep] = useState(0)\n  const [size, setSize] = useState(\"11-50\")\n  const [goal, setGoal] = useState(goals[0])\n  const [done, setDone] = useState(false)\n\n  const last = step === steps.length - 1\n\n  return (\n    <section className=\"w-full bg-muted/40 py-20 md:py-28\">\n      <div className=\"mx-auto max-w-2xl px-6\">\n        <div className=\"text-center\">\n          <p className=\"text-xs font-medium tracking-widest text-muted-foreground uppercase\">\n            Talk to sales\n          </p>\n          <h2 className=\"mt-3 text-3xl font-semibold tracking-tight md:text-5xl\">\n            Get a tailored walkthrough\n          </h2>\n        </div>\n\n        <ol className=\"mt-12 grid grid-cols-3 gap-2\">\n          {steps.map((label, index) => (\n            <li key={label} className=\"space-y-2\">\n              <div\n                className={cn(\n                  \"h-1 transition-colors\",\n                  index <= step ? \"bg-primary\" : \"bg-border\"\n                )}\n              />\n              <p\n                className={cn(\n                  \"text-xs\",\n                  index === step\n                    ? \"font-medium text-foreground\"\n                    : \"text-muted-foreground\"\n                )}\n              >\n                <span className=\"hidden sm:inline\">Step {index + 1} &middot; </span>\n                {label}\n              </p>\n            </li>\n          ))}\n        </ol>\n\n        <div className=\"mt-6 border bg-card p-6 md:p-10\">\n          {done ? (\n            <div className=\"flex flex-col items-center py-10 text-center\">\n              <span className=\"flex size-12 items-center justify-center rounded-full bg-primary text-primary-foreground\">\n                <Check className=\"size-5\" />\n              </span>\n              <h3 className=\"mt-6 text-xl font-semibold\">Request received</h3>\n              <p className=\"mt-2 max-w-sm text-sm text-muted-foreground\">\n                A solutions engineer will email you within 24 hours to find a\n                time that works.\n              </p>\n            </div>\n          ) : (\n            <form\n              onSubmit={(event) => {\n                event.preventDefault()\n                if (last) setDone(true)\n                else setStep((s) => s + 1)\n              }}\n              className=\"space-y-8\"\n            >\n              {step === 0 && (\n                <div className=\"space-y-6\">\n                  <div className=\"space-y-2\">\n                    <Label htmlFor=\"contact-07-company\">Company name</Label>\n                    <Input id=\"contact-07-company\" placeholder=\"Fernhill Labs\" className=\"h-11\" />\n                  </div>\n                  <fieldset className=\"space-y-3\">\n                    <legend className=\"text-sm font-medium\">Team size</legend>\n                    <div className=\"grid grid-cols-2 gap-2 sm:grid-cols-4\">\n                      {sizes.map((item) => (\n                        <button\n                          key={item}\n                          type=\"button\"\n                          onClick={() => setSize(item)}\n                          className={cn(\n                            \"h-11 border text-sm transition-colors\",\n                            size === item\n                              ? \"border-foreground bg-foreground text-background\"\n                              : \"hover:bg-muted\"\n                          )}\n                        >\n                          {item}\n                        </button>\n                      ))}\n                    </div>\n                  </fieldset>\n                </div>\n              )}\n\n              {step === 1 && (\n                <div className=\"space-y-6\">\n                  <fieldset className=\"space-y-3\">\n                    <legend className=\"text-sm font-medium\">Main goal</legend>\n                    <div className=\"grid gap-2\">\n                      {goals.map((item) => (\n                        <button\n                          key={item}\n                          type=\"button\"\n                          onClick={() => setGoal(item)}\n                          className={cn(\n                            \"flex h-12 items-center justify-between border px-4 text-start text-sm transition-colors\",\n                            goal === item ? \"border-foreground bg-muted\" : \"hover:bg-muted/60\"\n                          )}\n                        >\n                          {item}\n                          <span\n                            className={cn(\n                              \"size-4 rounded-full border\",\n                              goal === item && \"border-[5px] border-foreground\"\n                            )}\n                          />\n                        </button>\n                      ))}\n                    </div>\n                  </fieldset>\n                  <div className=\"space-y-2\">\n                    <Label htmlFor=\"contact-07-notes\">Anything we should know?</Label>\n                    <Textarea\n                      id=\"contact-07-notes\"\n                      placeholder=\"Current tools, deadlines, who else is involved...\"\n                      className=\"min-h-28\"\n                    />\n                  </div>\n                </div>\n              )}\n\n              {step === 2 && (\n                <div className=\"grid gap-6 sm:grid-cols-2\">\n                  <div className=\"space-y-2\">\n                    <Label htmlFor=\"contact-07-name\">Full name</Label>\n                    <Input id=\"contact-07-name\" placeholder=\"Priya Raman\" className=\"h-11\" />\n                  </div>\n                  <div className=\"space-y-2\">\n                    <Label htmlFor=\"contact-07-role\">Role</Label>\n                    <Input id=\"contact-07-role\" placeholder=\"Head of Product\" className=\"h-11\" />\n                  </div>\n                  <div className=\"space-y-2 sm:col-span-2\">\n                    <Label htmlFor=\"contact-07-email\">Work email</Label>\n                    <Input\n                      id=\"contact-07-email\"\n                      type=\"email\"\n                      placeholder=\"priya@fernhill.io\"\n                      className=\"h-11\"\n                    />\n                  </div>\n                  <p className=\"text-xs text-muted-foreground sm:col-span-2\">\n                    {size} people &middot; {goal}\n                  </p>\n                </div>\n              )}\n\n              <div className=\"flex items-center justify-between border-t pt-6\">\n                <Button\n                  type=\"button\"\n                  variant=\"ghost\"\n                  disabled={step === 0}\n                  onClick={() => setStep((s) => s - 1)}\n                >\n                  <ArrowLeft />\n                  Back\n                </Button>\n                <Button type=\"submit\" size=\"lg\">\n                  {last ? \"Request demo\" : \"Continue\"}\n                  {!last && <ArrowRight />}\n                </Button>\n              </div>\n            </form>\n          )}\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "800px"
  },
  "categories": [
    "contact"
  ]
}