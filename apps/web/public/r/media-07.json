{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "media-07",
  "type": "registry:block",
  "description": "Cinematic video player with custom controls, seek bar chapter markers, captions and a chapter grid.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "registry/designali/blocks/media/media-07.tsx",
      "content": "\"use client\"\n\nimport { useEffect, useState } from \"react\"\nimport {\n  Captions,\n  Maximize,\n  Pause,\n  Play,\n  RotateCcw,\n  RotateCw,\n  Settings,\n  Volume2,\n  VolumeX,\n} from \"lucide-react\"\n\nconst DURATION = 754\nconst chapters = [\n  { at: 0, label: \"Cold open\" },\n  { at: 128, label: \"The workshop\" },\n  { at: 342, label: \"First prototype\" },\n  { at: 560, label: \"Launch day\" },\n]\n\nconst fmt = (s: number) =>\n  `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, \"0\")}`\n\nexport default function Media07() {\n  const [playing, setPlaying] = useState(false)\n  const [time, setTime] = useState(212)\n  const [muted, setMuted] = useState(false)\n  const [cc, setCc] = useState(true)\n\n  useEffect(() => {\n    if (!playing) return\n    const id = setInterval(() => setTime((t) => (t + 1 >= DURATION ? 0 : t + 1)), 1000)\n    return () => clearInterval(id)\n  }, [playing])\n\n  const chapter = [...chapters].reverse().find((c) => time >= c.at)!\n  const seek = (delta: number) => setTime((t) => Math.min(DURATION, Math.max(0, t + delta)))\n\n  return (\n    <section className=\"w-full bg-background py-16\">\n      <div className=\"mx-auto max-w-6xl px-6\">\n        <div className=\"mb-6 flex flex-wrap items-end justify-between gap-3\">\n          <div>\n            <p className=\"text-xs tracking-widest text-muted-foreground uppercase\">Documentary - 12 min</p>\n            <h2 className=\"mt-2 text-2xl font-semibold tracking-tight md:text-3xl\">Made by Hand: The Kettle Works Story</h2>\n          </div>\n          <p className=\"text-sm text-muted-foreground\">Directed by Noor Vance</p>\n        </div>\n        <div className=\"group relative aspect-video w-full overflow-hidden border border-border bg-black text-white\">\n          <div\n            className=\"absolute inset-0 transition-transform duration-[2000ms]\"\n            style={{\n              background: \"radial-gradient(circle at 30% 40%, var(--chart-4), transparent 55%), radial-gradient(circle at 75% 65%, var(--chart-1), transparent 50%), #0a0a0a\",\n              transform: playing ? \"scale(1.04)\" : \"scale(1)\",\n            }}\n          />\n          <button\n            type=\"button\"\n            aria-label={playing ? \"Pause\" : \"Play\"}\n            onClick={() => setPlaying((p) => !p)}\n            className=\"absolute inset-0 flex items-center justify-center\"\n          >\n            {!playing && (\n              <span className=\"flex size-16 items-center justify-center rounded-full bg-white/90 text-black transition-transform hover:scale-105 md:size-20\">\n                <Play className=\"size-6 translate-x-0.5 fill-current md:size-8\" />\n              </span>\n            )}\n          </button>\n          {cc && (\n            <p className=\"pointer-events-none absolute inset-x-0 bottom-20 mx-auto w-fit max-w-[85%] bg-black/70 px-3 py-1 text-center text-xs md:bottom-24 md:text-base\">\n              &ldquo;We never set out to build a company. We just wanted a kettle that lasted.&rdquo;\n            </p>\n          )}\n          <div className=\"absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 to-transparent px-3 pt-10 pb-3 transition-opacity md:px-5 md:pb-4\">\n            <div className=\"relative h-4\">\n              <div className=\"absolute top-1/2 h-1 w-full -translate-y-1/2 bg-white/25\">\n                <div className=\"h-full bg-white\" style={{ width: `${(time / DURATION) * 100}%` }} />\n              </div>\n              {chapters.slice(1).map((c) => (\n                <span key={c.at} className=\"absolute top-1/2 h-1 w-0.5 -translate-y-1/2 bg-black\" style={{ left: `${(c.at / DURATION) * 100}%` }} />\n              ))}\n              <input\n                type=\"range\"\n                min={0}\n                max={DURATION}\n                value={time}\n                onChange={(e) => setTime(Number(e.target.value))}\n                aria-label=\"Seek\"\n                className=\"absolute inset-0 w-full cursor-pointer opacity-0\"\n              />\n            </div>\n            <div className=\"mt-2 flex items-center gap-1 text-sm md:gap-2\">\n              <button type=\"button\" aria-label={playing ? \"Pause\" : \"Play\"} onClick={() => setPlaying((p) => !p)} className=\"flex size-8 items-center justify-center hover:bg-white/10\">\n                {playing ? <Pause className=\"size-4 fill-current\" /> : <Play className=\"size-4 fill-current\" />}\n              </button>\n              <button type=\"button\" aria-label=\"Back 10 seconds\" onClick={() => seek(-10)} className=\"hidden size-8 items-center justify-center hover:bg-white/10 sm:flex\">\n                <RotateCcw className=\"size-4\" />\n              </button>\n              <button type=\"button\" aria-label=\"Forward 10 seconds\" onClick={() => seek(10)} className=\"hidden size-8 items-center justify-center hover:bg-white/10 sm:flex\">\n                <RotateCw className=\"size-4\" />\n              </button>\n              <button type=\"button\" aria-label={muted ? \"Unmute\" : \"Mute\"} onClick={() => setMuted((m) => !m)} className=\"flex size-8 items-center justify-center hover:bg-white/10\">\n                {muted ? <VolumeX className=\"size-4\" /> : <Volume2 className=\"size-4\" />}\n              </button>\n              <span className=\"ml-1 font-mono text-xs tabular-nums\">{fmt(time)} / {fmt(DURATION)}</span>\n              <span className=\"ml-2 hidden truncate text-xs text-white/70 md:inline\">- {chapter.label}</span>\n              <div className=\"ml-auto flex items-center gap-1\">\n                <button type=\"button\" aria-label=\"Captions\" aria-pressed={cc} onClick={() => setCc((c) => !c)} className={`flex size-8 items-center justify-center hover:bg-white/10 ${cc ? \"text-white\" : \"text-white/50\"}`}>\n                  <Captions className=\"size-4\" />\n                </button>\n                <button type=\"button\" aria-label=\"Settings\" className=\"hidden size-8 items-center justify-center hover:bg-white/10 sm:flex\">\n                  <Settings className=\"size-4\" />\n                </button>\n                <button type=\"button\" aria-label=\"Fullscreen\" className=\"flex size-8 items-center justify-center hover:bg-white/10\">\n                  <Maximize className=\"size-4\" />\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div className=\"mt-4 grid grid-cols-2 gap-px border border-border bg-border md:grid-cols-4\">\n          {chapters.map((c) => (\n            <button\n              key={c.at}\n              type=\"button\"\n              onClick={() => setTime(c.at)}\n              className={`bg-background p-3 text-left text-sm transition-colors hover:bg-muted ${chapter.at === c.at ? \"text-foreground\" : \"text-muted-foreground\"}`}\n            >\n              <span className=\"block font-mono text-xs\">{fmt(c.at)}</span>\n              <span className=\"mt-0.5 block truncate font-medium\">{c.label}</span>\n            </button>\n          ))}\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "850px"
  },
  "categories": [
    "media"
  ]
}