{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "menubar-04",
  "type": "registry:example",
  "description": "IDE-style menubar with Selection, Go and Run menus plus a Run Task submenu.",
  "files": [
    {
      "path": "registry/designali/examples/menubar/menubar-04.tsx",
      "content": "import {\n  BugOff as BugOffIcon,\n  Play as PlayIcon,\n  Terminal as TerminalIcon,\n} from \"@designali/icons\"\n\nimport {\n  Menubar,\n  MenubarContent,\n  MenubarGroup,\n  MenubarItem,\n  MenubarMenu,\n  MenubarSeparator,\n  MenubarShortcut,\n  MenubarSub,\n  MenubarSubContent,\n  MenubarSubTrigger,\n  MenubarTrigger,\n} from \"@workspace/ui/components/menubar\"\n\nexport default function CodeEditorMenubar() {\n  return (\n    <div className=\"w-full max-w-md\">\n      <Menubar>\n        <MenubarMenu>\n          <MenubarTrigger>Selection</MenubarTrigger>\n          <MenubarContent className=\"w-56\">\n            <MenubarGroup>\n              <MenubarItem>\n                Expand selection <MenubarShortcut>⌃⇧→</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>\n                Add cursor above <MenubarShortcut>⌥⌘↑</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>\n                Add cursor below <MenubarShortcut>⌥⌘↓</MenubarShortcut>\n              </MenubarItem>\n            </MenubarGroup>\n            <MenubarSeparator />\n            <MenubarGroup>\n              <MenubarItem>\n                Duplicate line <MenubarShortcut>⇧⌥↓</MenubarShortcut>\n              </MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>Go</MenubarTrigger>\n          <MenubarContent className=\"w-56\">\n            <MenubarGroup>\n              <MenubarItem>\n                Go to file... <MenubarShortcut>⌘P</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>\n                Go to symbol... <MenubarShortcut>⇧⌘O</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>\n                Go to definition <MenubarShortcut>F12</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>\n                Go to line... <MenubarShortcut>⌃G</MenubarShortcut>\n              </MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>Run</MenubarTrigger>\n          <MenubarContent className=\"w-56\">\n            <MenubarGroup>\n              <MenubarItem>\n                <PlayIcon /> Start debugging{\" \"}\n                <MenubarShortcut>F5</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>\n                <BugOffIcon /> Run without debugging{\" \"}\n                <MenubarShortcut>⌃F5</MenubarShortcut>\n              </MenubarItem>\n            </MenubarGroup>\n            <MenubarSeparator />\n            <MenubarGroup>\n              <MenubarSub>\n                <MenubarSubTrigger>\n                  <TerminalIcon /> Run task\n                </MenubarSubTrigger>\n                <MenubarSubContent>\n                  <MenubarGroup>\n                    <MenubarItem>dev</MenubarItem>\n                    <MenubarItem>build</MenubarItem>\n                    <MenubarItem>test:watch</MenubarItem>\n                    <MenubarItem>lint --fix</MenubarItem>\n                  </MenubarGroup>\n                </MenubarSubContent>\n              </MenubarSub>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n      </Menubar>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}