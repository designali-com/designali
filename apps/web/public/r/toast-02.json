{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "toast-02",
  "type": "registry:example",
  "description": "Variant toast notifications displaying default, success, info, warning, and error states.",
  "registryDependencies": [
    "toast",
    "button"
  ],
  "files": [
    {
      "path": "registry/designali/examples/toast/toast-02.tsx",
      "content": "\"use client\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport { toast } from \"@workspace/ui/components/toast\"\n\nexport function ToastTypes() {\n  return (\n    <div className=\"flex flex-wrap gap-2\">\n      <Button\n        variant=\"outline\"\n        onClick={() => toast.add({ description: \"Event has been created.\" })}\n      >\n        Default\n      </Button>\n      <Button\n        variant=\"outline\"\n        onClick={() =>\n          toast.add({\n            type: \"success\",\n            description: \"Event has been created.\",\n          })\n        }\n      >\n        Success\n      </Button>\n      <Button\n        variant=\"outline\"\n        onClick={() =>\n          toast.add({\n            type: \"info\",\n            description: \"Arrive 10 minutes before the event.\",\n          })\n        }\n      >\n        Info\n      </Button>\n      <Button\n        variant=\"outline\"\n        onClick={() =>\n          toast.add({\n            type: \"warning\",\n            description: \"The event cannot start before 8:00 AM.\",\n          })\n        }\n      >\n        Warning\n      </Button>\n      <Button\n        variant=\"outline\"\n        onClick={() =>\n          toast.add({\n            type: \"error\",\n            description: \"The event could not be created.\",\n            priority: \"high\",\n          })\n        }\n      >\n        Error\n      </Button>\n    </div>\n  )\n}",
      "type": "registry:example"
    }
  ]
}