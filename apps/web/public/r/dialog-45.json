{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dialog-45",
  "type": "registry:example",
  "description": "Centered success dialog confirming a payment with summary and next steps.",
  "files": [
    {
      "path": "registry/designali/examples/dialog/dialog-45.tsx",
      "content": "import {\n  CircleCheckBig as CircleCheckBigIcon,\n  Download as DownloadIcon,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  Dialog,\n  DialogClose,\n  DialogContent,\n  DialogDescription,\n  DialogFooter,\n  DialogHeader,\n  DialogTitle,\n  DialogTrigger,\n} from \"@workspace/ui/components/dialog\"\n\nexport default function PaymentSuccessDialog() {\n  return (\n    <Dialog>\n      <DialogTrigger render={<Button />}>Pay $240.00</DialogTrigger>\n      <DialogContent showCloseButton={false} className=\"sm:max-w-xs\">\n        <div className=\"flex flex-col items-center gap-3 pt-2 text-center\">\n          <div className=\"flex size-12 items-center justify-center rounded-full bg-primary/15 text-primary dark:text-primary\">\n            <CircleCheckBigIcon className=\"size-6\" />\n          </div>\n          <DialogHeader className=\"items-center text-center\">\n            <DialogTitle>Payment received</DialogTitle>\n            <DialogDescription>\n              Designali invoice INV-2026-0311 is now paid in full.\n            </DialogDescription>\n          </DialogHeader>\n        </div>\n        <div className=\"flex flex-col gap-1 border bg-muted/40 p-3\">\n          <div className=\"flex justify-between\">\n            <span className=\"text-muted-foreground\">Amount</span>\n            <span className=\"font-medium\">$240.00</span>\n          </div>\n          <div className=\"flex justify-between\">\n            <span className=\"text-muted-foreground\">Card</span>\n            <span>Visa •••• 4417</span>\n          </div>\n        </div>\n        <DialogFooter className=\"sm:flex-col\">\n          <DialogClose render={<Button className=\"w-full\" />}>\n            Back to invoices\n          </DialogClose>\n          <Button variant=\"ghost\" className=\"w-full\">\n            <DownloadIcon data-icon=\"inline-start\" />\n            Download receipt\n          </Button>\n        </DialogFooter>\n      </DialogContent>\n    </Dialog>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}