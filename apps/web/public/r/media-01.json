{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "media-01",
  "type": "registry:block",
  "description": "A simple media section.",
  "files": [
    {
      "path": "registry/designali/blocks/media/media-01.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\n\n// Dummy data structure\nconst albumInfo = {\n  title: \"Know.\",\n  artist: \"Jason Mraz\",\n  year: 2018,\n  songs: 10,\n  rating: 4.5,\n  coverArt: \"https://is1-ssl.mzstatic.com/image/thumb/Music114/v4/a4/23/93/a42393a5-da27-1c0d-f070-23271c006a3a/888072065539.jpg/1200x1200bf-60.jpg\", // High-res Jason Mraz cover\n  duration: \"4:05\",\n  currentTime: \"02:46\",\n}\n\nconst tracklist = [\n  { id: 1, title: \"Let's See What The Night Can Do\", duration: \"4:05\", playing: true },\n  { id: 2, title: \"Have It All\", duration: \"3:51\" },\n  { id: 3, title: \"More Than Friends\", duration: \"3:51\" },\n  { id: 4, title: \"Unlonely\", duration: \"3:38\" },\n  { id: 5, title: \"Better With You\", duration: \"3:32\" },\n  { id: 6, title: \"No Plans\", duration: \"3:11\" },\n  { id: 7, title: \"Love Is Still The Answer\", duration: \"3:29\" },\n]\n\nexport function MusicPlayer() {\n  const [progress, setProgress] = React.useState(68) // Percentage\n\n  return (\n    <section className=\"min-h-screen w-full bg-stone-100 p-8 font-sans text-stone-800\">\n      {/* Main Container - Neumorphic Card Effect */}\n      <div className=\"relative mx-auto max-w-7xl overflow-hidden rounded-3xl bg-white shadow-[0_10px_40px_-10px_rgba(0,0,0,0.08)] border border-stone-100\">\n        \n        {/* Background Blurred Elements (Glassmorphism) */}\n        <div className=\"absolute -top-48 -right-48 h-96 w-96 rounded-full bg-red-500/5 blur-[120px]\" />\n        <div className=\"absolute top-64 -left-64 h-[500px] w-[500px] rounded-full bg-blue-500/5 blur-[160px]\" />\n\n        {/* --- HEADER --- */}\n        <header className=\"relative z-10 flex items-center justify-between border-b border-stone-100 px-8 py-5\">\n          <div className=\"flex items-center gap-6\">\n            <div className=\"text-lg font-bold\">🎵</div>\n            <div className=\"relative\">\n              <input\n                type=\"search\"\n                placeholder=\"Search for song, artists etc...\"\n                className=\"h-10 w-80 rounded-full bg-stone-100 px-10 text-sm placeholder:text-stone-400 focus:ring-1 focus:ring-stone-300 focus:outline-none\"\n              />\n              <span className=\"absolute left-3.5 top-1/2 -translate-y-1/2 text-stone-400 text-xs\">🔍</span>\n            </div>\n          </div>\n          \n          <div className=\"flex items-center gap-5\">\n            <button className=\"text-xs font-medium rounded-full px-3.5 py-1.5 hover:bg-stone-100\">Upgrade Plan</button>\n            <button className=\"text-stone-500 hover:text-stone-800\">⚙️</button>\n            <button className=\"text-stone-500 hover:text-stone-800 relative\">\n              🔔 <span className=\"absolute -top-1 -right-1 flex h-2.5 w-2.5 items-center justify-center rounded-full bg-red-500 text-[8px] text-white font-bold\">1</span>\n            </button>\n            <div className=\"flex items-center gap-3 rounded-full bg-stone-100 pl-2 pr-3 py-1\">\n              <img src=\"https://randomuser.me/api/portraits/women/44.jpg\" alt=\"User\" className=\"h-8 w-8 rounded-full\" />\n              <span className=\"text-xs font-medium\">Olivia</span>\n            </div>\n          </div>\n        </header>\n\n        {/* --- MAIN CONTENT AREA --- */}\n        <div className=\"relative z-10 grid grid-cols-[1.5fr,3fr] gap-10 p-12\">\n          \n          {/* --- Left Column: Cover Art & Controls --- */}\n          <div className=\"flex flex-col items-center\">\n            {/* Neumorphic Album Art Card */}\n            <div className=\"h-[380px] w-[380px] rounded-3xl bg-white p-7 shadow-[0_8px_25px_-8px_rgba(0,0,0,0.1)] border border-white/50\">\n              <img\n                src={albumInfo.coverArt}\n                alt={albumInfo.title}\n                className=\"h-full w-full rounded-2xl object-cover shadow-inner\"\n              />\n            </div>\n\n            {/* Player Controls */}\n            <div className=\"mt-8 flex w-full max-w-xs items-center justify-between gap-4 rounded-full bg-stone-100 px-6 py-4 shadow-inner\">\n              <button className=\"text-stone-600 hover:text-black\">🔀</button>\n              <button className=\"text-stone-600 hover:text-black\">⏮️</button>\n              <button className=\"flex h-16 w-16 items-center justify-center rounded-full bg-stone-900 text-white shadow-md hover:bg-stone-700 active:scale-95\">▶️</button>\n              <button className=\"text-stone-600 hover:text-black\">⏭️</button>\n              <button className=\"text-stone-600 hover:text-black\">🔁</button>\n            </div>\n          </div>\n\n          {/* --- Right Column: Info & Tracklist --- */}\n          <div className=\"pt-1\">\n            <div className=\"flex items-center justify-between gap-10\">\n              <div>\n                <h1 className=\"text-6xl font-extrabold tracking-tighter\">{albumInfo.title}</h1>\n                <p className=\"mt-2 text-sm font-medium text-stone-500\">\n                  {albumInfo.artist} • {albumInfo.year} • {albumInfo.songs} Songs\n                </p>\n              </div>\n              <div className=\"flex flex-col items-end gap-1\">\n                <div className=\"text-4xl font-bold\">{albumInfo.rating.toFixed(1)}<span className=\"text-lg font-normal text-stone-400\">/5</span></div>\n                <div className=\"flex gap-0.5 text-amber-400 text-lg\">★★★★<span className=\"text-stone-300\">★</span></div>\n              </div>\n            </div>\n\n            {/* Tracklist Table */}\n            <div className=\"mt-10 space-y-1\">\n              {tracklist.map((track, index) => (\n                <div \n                  key={track.id}\n                  className={`grid grid-cols-[50px,1fr,auto,auto] items-center gap-4 rounded-full px-5 py-3 text-sm group ${track.playing ? 'bg-stone-900 text-white' : 'hover:bg-stone-100'}`}\n                >\n                  <div className={`font-medium ${track.playing ? 'text-white' : 'text-stone-400'}`}>{String(index + 1).padStart(2, '0')}</div>\n                  <div className={`font-medium truncate ${track.playing ? 'text-white' : 'text-stone-800'}`}>{track.title}</div>\n                  <div className={`text-xs ${track.playing ? 'text-white/60' : 'text-stone-500'} group-hover:opacity-100 ${track.playing ? 'opacity-100' : 'opacity-0'}`}>...</div>\n                  <div className={`font-medium text-right w-12 ${track.playing ? 'text-white' : 'text-stone-700'}`}>{track.duration}</div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n\n        {/* --- SIDE CAROUSEL ITEMS --- */}\n        {/* Left Card */}\n        <div className=\"absolute top-[25%] -left-20 z-0 h-[450px] w-[220px] rotate-[-5deg] overflow-hidden rounded-3xl bg-white p-4 shadow-xl transition-transform hover:rotate-0 hover:-translate-x-5\">\n            <img src=\"https://images.unsplash.com/photo-1500462918059-b1a0cb512f1d?q=80&w=400&auto=format&fit=crop\" alt=\"Landscape\" className=\"h-full w-full rounded-2xl object-cover\" />\n            <div className=\"absolute bottom-8 left-8 text-white font-bold text-3xl tracking-tight\">BA</div>\n        </div>\n        \n        {/* Right Card */}\n        <div className=\"absolute top-[30%] -right-24 z-0 h-[350px] w-[350px] rotate-[5deg] overflow-hidden rounded-3xl bg-white p-5 shadow-xl transition-transform hover:rotate-0 hover:translate-x-5\">\n            <img src=\"https://images.unsplash.com/photo-1611339844228-4539b3b44d7b?q=80&w=400&auto=format&fit=crop\" alt=\"Cars\" className=\"h-full w-full rounded-2xl object-cover\" />\n            <div className=\"absolute bottom-10 left-10 rounded-full bg-white/90 px-3 py-1 text-[9px] font-mono font-semibold text-black\">/Y100</div>\n        </div>\n\n        {/* --- PLAYER BAR --- */}\n        <footer className=\"relative z-20 flex items-center justify-between gap-6 border-t border-stone-100 px-8 py-4 bg-white/95 backdrop-blur-sm\">\n            <div className=\"flex items-center gap-4\">\n                <img src={albumInfo.coverArt} alt=\"Thumb\" className=\"h-12 w-12 rounded-lg object-cover\" />\n                <div>\n                    <h4 className=\"text-sm font-semibold\">{tracklist[0].title}</h4>\n                    <p className=\"text-xs text-stone-500\">{albumInfo.artist}</p>\n                </div>\n                <button className=\"text-stone-400 text-lg hover:text-red-500 ml-3\">♡</button>\n            </div>\n\n            <div className=\"flex items-center gap-4 flex-1 max-w-2xl\">\n                <span className=\"text-xs font-mono text-stone-500\">{albumInfo.currentTime}</span>\n                <div className=\"flex-1 h-1.5 rounded-full bg-stone-100 overflow-hidden relative group\">\n                    {/* Progress Bar Fill */}\n                    <div className=\"absolute left-0 top-0 h-full bg-stone-900 rounded-full group-hover:bg-red-600\" style={{ width: `${progress}%`}} />\n                    {/* Scrubber Handle */}\n                    <div className=\"absolute top-1/2 -translate-y-1/2 h-4 w-4 rounded-full bg-stone-900 shadow-lg flex items-center justify-center -ml-1.5 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer\" style={{ left: `${progress}%`}}>\n                        <div className=\"h-2 w-2 bg-white rounded-full\" />\n                    </div>\n                </div>\n                <span className=\"text-xs font-mono text-stone-500\">{albumInfo.duration}</span>\n            </div>\n\n            <div className=\"flex items-center gap-5 text-stone-600\">\n                <button className=\"hover:text-black\">≡</button>\n                <button className=\"hover:text-black\">🔈</button>\n                <input type=\"range\" min=\"0\" max=\"100\" defaultValue=\"70\" className=\"w-20 accent-stone-900\" />\n            </div>\n        </footer>\n      </div>\n    </section>\n  )\n}",
      "type": "registry:component",
      "target": "components/media-01.tsx"
    }
  ],
  "meta": {
    "iframeHeight": "800px"
  },
  "categories": [
    "media"
  ]
}