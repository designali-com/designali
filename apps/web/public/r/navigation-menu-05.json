{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "navigation-menu-05",
  "type": "registry:example",
  "description": "Online store navigation with column-based category lists and a seasonal promo tile.",
  "files": [
    {
      "path": "registry/designali/examples/navigation-menu/navigation-menu-05.tsx",
      "content": "import {\n  NavigationMenu,\n  NavigationMenuContent,\n  NavigationMenuItem,\n  NavigationMenuLink,\n  NavigationMenuList,\n  NavigationMenuTrigger,\n  navigationMenuTriggerStyle,\n} from \"@workspace/ui/components/navigation-menu\"\nimport { cn } from \"@workspace/ui/lib/utils\"\n\nconst columns = [\n  { heading: \"Templates\", links: [\"Portfolio\", \"Agency\", \"SaaS\", \"AI\"] },\n  { heading: \"Assets\", links: [\"Icons\", \"Logos\", \"Illustrations\"] },\n]\n\nexport default function StoreCategoriesNav() {\n  return (\n    <NavigationMenu>\n      <NavigationMenuList>\n        <NavigationMenuItem>\n          <NavigationMenuTrigger>Products</NavigationMenuTrigger>\n          <NavigationMenuContent>\n            <div className=\"grid w-72 grid-cols-2 gap-3 p-2 sm:w-[30rem] sm:grid-cols-3\">\n              {columns.map((col) => (\n                <div key={col.heading} className=\"flex flex-col gap-0.5\">\n                  <p className=\"px-2 pb-1 text-[11px] font-semibold tracking-wide text-muted-foreground uppercase\">\n                    {col.heading}\n                  </p>\n                  {col.links.map((link) => (\n                    <NavigationMenuLink key={link} href=\"#\" className=\"py-1.5\">\n                      {link}\n                    </NavigationMenuLink>\n                  ))}\n                </div>\n              ))}\n              <NavigationMenuLink\n                href=\"#\"\n                className=\"col-span-2 flex-col items-start justify-end gap-1 bg-gradient-to-br from-primary/20 to-chart-1 p-3 text-chart-5 sm:col-span-1\"\n              >\n                <span className=\"text-[11px] font-semibold uppercase\">\n                  New drop\n                </span>\n                <span className=\"text-sm font-semibold\">\n                  Fresh Designali templates\n                </span>\n              </NavigationMenuLink>\n            </div>\n          </NavigationMenuContent>\n        </NavigationMenuItem>\n        <NavigationMenuItem>\n          <NavigationMenuLink href=\"#\" className={navigationMenuTriggerStyle()}>\n            Services\n          </NavigationMenuLink>\n        </NavigationMenuItem>\n        <NavigationMenuItem>\n          <NavigationMenuLink\n            href=\"#\"\n            className={cn(\n              navigationMenuTriggerStyle(),\n              \"text-destructive dark:text-destructive\"\n            )}\n          >\n            Pricing\n          </NavigationMenuLink>\n        </NavigationMenuItem>\n      </NavigationMenuList>\n    </NavigationMenu>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}