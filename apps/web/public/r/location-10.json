{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "location-10",
  "type": "registry:block",
  "description": "Opening hours table that highlights today, beside an illustrated pin map tile and a holiday hours card.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "registry/designali/blocks/location/location-10.tsx",
      "content": "\"use client\"\n\nimport { useEffect, useState } from \"react\"\nimport {\n  CalendarX,\n  MapPin,\n} from \"@designali/icons\"\n\nimport { cn } from \"@workspace/ui/lib/utils\"\n\nconst hours = [\n  { day: \"Monday\", open: \"09:00\", close: \"18:00\" },\n  { day: \"Tuesday\", open: \"09:00\", close: \"18:00\" },\n  { day: \"Wednesday\", open: \"09:00\", close: \"21:00\", note: \"Late calls for the Americas\" },\n  { day: \"Thursday\", open: \"09:00\", close: \"18:00\" },\n  { day: \"Friday\", open: \"09:00\", close: \"17:00\" },\n  { day: \"Saturday\", open: \"10:00\", close: \"14:00\" },\n  { day: \"Sunday\", open: null, close: null },\n]\n\nconst closures = [\n  { date: \"24 Dec\", label: \"Replies by email only\" },\n  { date: \"25-26 Dec\", label: \"Closed\" },\n  { date: \"1 Jan\", label: \"Back at 10:00\" },\n]\n\nexport default function Location10() {\n  const [today, setToday] = useState<number | null>(null)\n\n  useEffect(() => {\n    const id = setTimeout(() => setToday((new Date().getDay() + 6) % 7), 0)\n    return () => clearTimeout(id)\n  }, [])\n\n  return (\n    <section className=\"w-full bg-background py-20 md:py-28\">\n      <div className=\"mx-auto grid max-w-6xl gap-12 px-6 md:grid-cols-[1.3fr_1fr]\">\n        <div>\n          <h2 className=\"text-4xl font-semibold tracking-tight md:text-5xl\">\n            Studio hours\n          </h2>\n          <p className=\"mt-3 text-muted-foreground\">\n            Designali studio &middot; Remote, worldwide\n          </p>\n\n          <table className=\"mt-10 w-full text-sm\">\n            <tbody className=\"divide-y border-y\">\n              {hours.map((row, index) => {\n                const isToday = index === today\n                return (\n                  <tr key={row.day} className={cn(isToday && \"bg-muted\")}>\n                    <th scope=\"row\" className=\"py-4 ps-3 text-start font-normal\">\n                      <span className={cn(isToday && \"font-semibold\")}>{row.day}</span>\n                      {isToday && (\n                        <span className=\"ms-2 bg-primary px-1.5 py-0.5 text-[10px] font-medium text-primary-foreground uppercase\">\n                          Today\n                        </span>\n                      )}\n                    </th>\n                    <td className=\"hidden py-4 text-xs text-muted-foreground sm:table-cell\">\n                      {row.note}\n                    </td>\n                    <td className=\"py-4 pe-3 text-end tabular-nums\">\n                      {row.open ? (\n                        `${row.open} - ${row.close}`\n                      ) : (\n                        <span className=\"text-muted-foreground\">Closed</span>\n                      )}\n                    </td>\n                  </tr>\n                )\n              })}\n            </tbody>\n          </table>\n        </div>\n\n        <div className=\"flex flex-col gap-6\">\n          <div className=\"relative aspect-square overflow-hidden border bg-primary/5 dark:bg-primary/30\">\n            <svg viewBox=\"0 0 200 200\" className=\"absolute inset-0 h-full w-full\" aria-hidden>\n              <circle cx=\"100\" cy=\"100\" r=\"80\" className=\"fill-none stroke-chart-1 dark:stroke-chart-5\" strokeWidth=\"1\" />\n              <circle cx=\"100\" cy=\"100\" r=\"50\" className=\"fill-none stroke-chart-1 dark:stroke-chart-5\" strokeWidth=\"1\" />\n              <path d=\"M0 120 L200 70\" className=\"stroke-background\" strokeWidth=\"10\" />\n              <path d=\"M70 0 L120 200\" className=\"stroke-background\" strokeWidth=\"10\" />\n              <path d=\"M0 40 C 60 60, 140 20, 200 30\" className=\"stroke-background\" strokeWidth=\"5\" fill=\"none\" />\n            </svg>\n            <span className=\"absolute top-1/2 left-1/2 flex size-14 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-primary text-white shadow-lg\">\n              <MapPin className=\"size-6\" />\n            </span>\n            <p className=\"absolute start-4 bottom-4 bg-background px-3 py-2 text-xs\">\n              Remote · Worldwide · hello@designali.com\n            </p>\n          </div>\n\n          <div className=\"border p-6\">\n            <p className=\"flex items-center gap-2 text-sm font-medium\">\n              <CalendarX className=\"size-4\" />\n              Holiday hours\n            </p>\n            <ul className=\"mt-4 space-y-2 text-sm\">\n              {closures.map((c) => (\n                <li key={c.date} className=\"flex justify-between gap-4\">\n                  <span className=\"text-muted-foreground\">{c.date}</span>\n                  <span>{c.label}</span>\n                </li>\n              ))}\n            </ul>\n          </div>\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "760px"
  },
  "categories": [
    "location"
  ]
}