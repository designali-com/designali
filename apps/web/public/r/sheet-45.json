{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sheet-45",
  "type": "registry:example",
  "description": "A sheet that opens a second, narrower sheet on top of it for a sub-task.",
  "files": [
    {
      "path": "registry/designali/examples/sheet/sheet-45.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  Tag as TagIcon,\n} from \"@designali/icons\"\n\nimport { Badge } from \"@workspace/ui/components/badge\"\nimport { Button } from \"@workspace/ui/components/button\"\nimport { Field, FieldLabel } from \"@workspace/ui/components/field\"\nimport { Input } from \"@workspace/ui/components/input\"\nimport {\n  Sheet,\n  SheetClose,\n  SheetContent,\n  SheetDescription,\n  SheetFooter,\n  SheetHeader,\n  SheetTitle,\n  SheetTrigger,\n} from \"@workspace/ui/components/sheet\"\n\nexport default function NestedSheets() {\n  const [label, setLabel] = React.useState(\"Priority\")\n  return (\n    <Sheet>\n      <SheetTrigger render={<Button variant=\"outline\" />}>\n        Edit issue\n      </SheetTrigger>\n      <SheetContent>\n        <SheetHeader>\n          <SheetTitle>Edit issue</SheetTitle>\n          <SheetDescription>Labels open in a stacked sheet.</SheetDescription>\n        </SheetHeader>\n        <div className=\"flex flex-col gap-4 px-4\">\n          <Field>\n            <FieldLabel htmlFor=\"issue-title\">Title</FieldLabel>\n            <Input\n              id=\"issue-title\"\n              defaultValue=\"Pricing block crashes on Safari 17\"\n            />\n          </Field>\n          <div className=\"flex items-center justify-between\">\n            <span>\n              Label: <Badge variant=\"secondary\">{label}</Badge>\n            </span>\n            <Sheet>\n              <SheetTrigger render={<Button variant=\"outline\" size=\"sm\" />}>\n                <TagIcon data-icon=\"inline-start\" />\n                Change\n              </SheetTrigger>\n              <SheetContent className=\"w-64\">\n                <SheetHeader>\n                  <SheetTitle>Choose label</SheetTitle>\n                  <SheetDescription>\n                    Applies to this issue only.\n                  </SheetDescription>\n                </SheetHeader>\n                <div className=\"flex flex-col gap-1 px-2\">\n                  {[\"Priority\", \"Bug\", \"Design\", \"Backend\", \"Needs triage\"].map(\n                    (l) => (\n                      <SheetClose\n                        key={l}\n                        render={\n                          <Button\n                            variant={l === label ? \"secondary\" : \"ghost\"}\n                            className=\"justify-start\"\n                          />\n                        }\n                        onClick={() => setLabel(l)}\n                      >\n                        {l}\n                      </SheetClose>\n                    )\n                  )}\n                </div>\n              </SheetContent>\n            </Sheet>\n          </div>\n        </div>\n        <SheetFooter>\n          <SheetClose render={<Button />}>Save issue</SheetClose>\n        </SheetFooter>\n      </SheetContent>\n    </Sheet>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}