{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "menubar-28",
  "type": "registry:example",
  "description": "Issue tracker menubar with priority radio and assignee submenus showing avatar initials.",
  "files": [
    {
      "path": "registry/designali/examples/menubar/menubar-28.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport { LinkIcon, SignalIcon, UserPlusIcon } from \"lucide-react\"\n\nimport { Avatar, AvatarFallback } from \"@workspace/ui/components/avatar\"\nimport { Badge } from \"@workspace/ui/components/badge\"\nimport {\n  Menubar,\n  MenubarContent,\n  MenubarGroup,\n  MenubarItem,\n  MenubarMenu,\n  MenubarRadioGroup,\n  MenubarRadioItem,\n  MenubarSeparator,\n  MenubarShortcut,\n  MenubarSub,\n  MenubarSubContent,\n  MenubarSubTrigger,\n  MenubarTrigger,\n} from \"@workspace/ui/components/menubar\"\n\nconst people = [\n  { id: \"mc\", name: \"Maya Chen\" },\n  { id: \"or\", name: \"Omar Reyes\" },\n  { id: \"lb\", name: \"Lena Brandt\" },\n]\n\nexport default function IssueTrackerMenubar() {\n  const [priority, setPriority] = React.useState(\"high\")\n  const [assignee, setAssignee] = React.useState(\"or\")\n  const person = people.find((p) => p.id === assignee)\n\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-2\">\n      <Menubar>\n        <MenubarMenu>\n          <MenubarTrigger>Issue</MenubarTrigger>\n          <MenubarContent className=\"w-52\">\n            <MenubarGroup>\n              <MenubarSub>\n                <MenubarSubTrigger>\n                  <SignalIcon /> Priority\n                </MenubarSubTrigger>\n                <MenubarSubContent>\n                  <MenubarRadioGroup\n                    value={priority}\n                    onValueChange={setPriority}\n                  >\n                    <MenubarRadioItem value=\"urgent\">Urgent</MenubarRadioItem>\n                    <MenubarRadioItem value=\"high\">High</MenubarRadioItem>\n                    <MenubarRadioItem value=\"medium\">Medium</MenubarRadioItem>\n                    <MenubarRadioItem value=\"low\">Low</MenubarRadioItem>\n                  </MenubarRadioGroup>\n                </MenubarSubContent>\n              </MenubarSub>\n              <MenubarSub>\n                <MenubarSubTrigger>\n                  <UserPlusIcon /> Assignee\n                </MenubarSubTrigger>\n                <MenubarSubContent className=\"w-44\">\n                  <MenubarRadioGroup\n                    value={assignee}\n                    onValueChange={setAssignee}\n                  >\n                    {people.map((p) => (\n                      <MenubarRadioItem key={p.id} value={p.id}>\n                        <Avatar className=\"size-5\">\n                          <AvatarFallback className=\"text-[9px]\">\n                            {p.id.toUpperCase()}\n                          </AvatarFallback>\n                        </Avatar>\n                        {p.name}\n                      </MenubarRadioItem>\n                    ))}\n                  </MenubarRadioGroup>\n                </MenubarSubContent>\n              </MenubarSub>\n            </MenubarGroup>\n            <MenubarSeparator />\n            <MenubarGroup>\n              <MenubarItem>\n                <LinkIcon /> Copy issue link{\" \"}\n                <MenubarShortcut>⌘L</MenubarShortcut>\n              </MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n      </Menubar>\n      <div className=\"flex items-center gap-2 border p-3 text-xs\">\n        <span className=\"font-mono text-muted-foreground\">ENG-412</span>\n        <span className=\"flex-1 truncate\">Checkout fails on saved cards</span>\n        <Badge\n          variant={priority === \"urgent\" ? \"destructive\" : \"secondary\"}\n          className=\"capitalize\"\n        >\n          {priority}\n        </Badge>\n        <Avatar className=\"size-5\">\n          <AvatarFallback className=\"text-[9px]\">\n            {person?.id.toUpperCase()}\n          </AvatarFallback>\n        </Avatar>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}