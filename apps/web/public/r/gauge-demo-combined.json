  "description": "Combined gauge composition demo",
  "files": [
    {
      "path": "registry/designali/components/gauge/gauge-demo-combined.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\n\nimport {\n  Gauge,\n  GaugeIndicator,\n  GaugeLabel,\n  GaugeRange,\n  GaugeTrack,\n  GaugeValueText,\n} from \"@/registry/designali/ui/gauge\"\n\nexport function GaugeDemoCombined() {\n  return (\n    <div className=\"flex flex-col items-center gap-4\">\n      <Gauge\n        value={84}\n        size={220}\n        thickness={20}\n        gap={20}\n        segments={60}\n      >\n        <GaugeIndicator>\n          <GaugeTrack />\n          <GaugeRange />\n        </GaugeIndicator>\n\n        <GaugeValueText>\n          <div className=\"flex flex-col items-center\">\n            <span className=\"text-4xl font-medium tracking-tight\">\n              84%\n            </span>\n\n            <span className=\"text-xs text-muted-foreground\">\n              Excellent\n            </span>\n          </div>\n        </GaugeValueText>\n      </Gauge>\n\n      <GaugeLabel>Overall Health Score</GaugeLabel>\n    </div>\n  )\n}",
      "type": "registry:block"
    }
  ]
}