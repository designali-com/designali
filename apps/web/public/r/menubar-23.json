{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "menubar-23",
  "type": "registry:example",
  "description": "File menu with an Open Recent submenu listing recent documents and a clear action that empties it.",
  "files": [
    {
      "path": "registry/designali/examples/menubar/menubar-23.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  FileText as FileTextIcon,\n} from \"@designali/icons\"\n\nimport {\n  Menubar,\n  MenubarContent,\n  MenubarGroup,\n  MenubarItem,\n  MenubarMenu,\n  MenubarSeparator,\n  MenubarShortcut,\n  MenubarSub,\n  MenubarSubContent,\n  MenubarSubTrigger,\n  MenubarTrigger,\n} from \"@workspace/ui/components/menubar\"\n\nconst initialRecent = [\n  \"Designali pitch deck.key\",\n  \"Brand identity brief.docx\",\n  \"Templates pricing.xlsx\",\n  \"Blocks launch checklist.md\",\n]\n\nexport default function OpenRecentMenubar() {\n  const [recent, setRecent] = React.useState(initialRecent)\n\n  return (\n    <div className=\"w-full max-w-xs\">\n      <Menubar>\n        <MenubarMenu>\n          <MenubarTrigger>File</MenubarTrigger>\n          <MenubarContent className=\"w-48\">\n            <MenubarGroup>\n              <MenubarItem>\n                New <MenubarShortcut>⌘N</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>\n                Open... <MenubarShortcut>⌘O</MenubarShortcut>\n              </MenubarItem>\n              <MenubarSub>\n                <MenubarSubTrigger>Open recent</MenubarSubTrigger>\n                <MenubarSubContent className=\"w-52\">\n                  {recent.length > 0 ? (\n                    <MenubarGroup>\n                      {recent.map((file) => (\n                        <MenubarItem key={file}>\n                          <FileTextIcon /> {file}\n                        </MenubarItem>\n                      ))}\n                    </MenubarGroup>\n                  ) : (\n                    <MenubarGroup>\n                      <MenubarItem disabled>No recent files</MenubarItem>\n                    </MenubarGroup>\n                  )}\n                  <MenubarSeparator />\n                  <MenubarGroup>\n                    <MenubarItem\n                      disabled={recent.length === 0}\n                      onClick={() => setRecent([])}\n                    >\n                      Clear menu\n                    </MenubarItem>\n                    <MenubarItem\n                      disabled={recent.length > 0}\n                      onClick={() => setRecent(initialRecent)}\n                    >\n                      Restore list\n                    </MenubarItem>\n                  </MenubarGroup>\n                </MenubarSubContent>\n              </MenubarSub>\n            </MenubarGroup>\n            <MenubarSeparator />\n            <MenubarGroup>\n              <MenubarItem>\n                Close window <MenubarShortcut>⇧⌘W</MenubarShortcut>\n              </MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>Edit</MenubarTrigger>\n          <MenubarContent>\n            <MenubarGroup>\n              <MenubarItem>Cut</MenubarItem>\n              <MenubarItem>Copy</MenubarItem>\n              <MenubarItem>Paste</MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n      </Menubar>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}