{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "avatar-30",
  "type": "registry:example",
  "description": "Profile settings section with an editable avatar and upload and remove actions.",
  "files": [
    {
      "path": "registry/designali/examples/avatar/avatar-30.tsx",
      "content": "import {\n  Camera as CameraIcon,\n  Upload as UploadIcon,\n} from \"@designali/icons\"\n\nimport { Avatar, AvatarFallback } from \"@workspace/ui/components/avatar\"\nimport { Button } from \"@workspace/ui/components/button\"\n\nexport default function ProfilePhotoSettings() {\n  return (\n    <div className=\"flex w-full max-w-md flex-wrap items-center gap-4 border p-4\">\n      <div className=\"relative\">\n        <Avatar className=\"size-16\">\n          <AvatarFallback className=\"text-lg font-medium\">AI</AvatarFallback>\n        </Avatar>\n        <Button\n          size=\"icon-xs\"\n          variant=\"outline\"\n          className=\"absolute -end-1 -bottom-1 rounded-full\"\n          aria-label=\"Change photo\"\n        >\n          <CameraIcon />\n        </Button>\n      </div>\n      <div className=\"flex-1\">\n        <p className=\"text-sm font-medium\">Profile photo</p>\n        <p className=\"text-xs text-muted-foreground\">\n          PNG or JPG, at least 256 x 256 px.\n        </p>\n        <div className=\"mt-2 flex gap-2\">\n          <Button size=\"sm\">\n            <UploadIcon data-icon=\"inline-start\" />\n            Upload\n          </Button>\n          <Button size=\"sm\" variant=\"ghost\">\n            Remove\n          </Button>\n        </div>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}