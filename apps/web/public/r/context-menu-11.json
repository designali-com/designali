{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "context-menu-11",
  "type": "registry:example",
  "description": "A code editor surface with IDE-style navigation, refactor, and formatting actions.",
  "files": [
    {
      "path": "registry/designali/examples/context-menu/context-menu-11.tsx",
      "content": "import {\n  ContextMenu,\n  ContextMenuContent,\n  ContextMenuGroup,\n  ContextMenuItem,\n  ContextMenuSeparator,\n  ContextMenuShortcut,\n  ContextMenuSub,\n  ContextMenuSubContent,\n  ContextMenuSubTrigger,\n  ContextMenuTrigger,\n} from \"@workspace/ui/components/context-menu\"\n\nconst lines = [\n  \"// designali.com/templates — fetch a Designali template\",\n  \"export async function getTemplate(slug: string) {\",\n  \"  const template = await db.template.find(slug)\",\n  \"  if (!template) throw new NotFoundError()\",\n  \"  return serialize(template)\",\n  \"}\",\n]\n\nexport default function CodeEditorMenu() {\n  return (\n    <ContextMenu>\n      <ContextMenuTrigger className=\"w-full max-w-md overflow-hidden border bg-muted/30 py-2 font-sans text-[11px]\">\n        {lines.map((line, index) => (\n          <div\n            key={index}\n            className=\"flex gap-3 px-2 whitespace-pre hover:bg-muted\"\n          >\n            <span className=\"w-4 text-end text-muted-foreground select-none\">\n              {index + 1}\n            </span>\n            <span className=\"truncate\">{line}</span>\n          </div>\n        ))}\n      </ContextMenuTrigger>\n      <ContextMenuContent className=\"w-56\">\n        <ContextMenuGroup>\n          <ContextMenuItem>\n            Go to definition\n            <ContextMenuShortcut>F12</ContextMenuShortcut>\n          </ContextMenuItem>\n          <ContextMenuItem>\n            Find all references\n            <ContextMenuShortcut>⇧F12</ContextMenuShortcut>\n          </ContextMenuItem>\n          <ContextMenuItem>\n            Peek\n            <ContextMenuShortcut>⌥F12</ContextMenuShortcut>\n          </ContextMenuItem>\n        </ContextMenuGroup>\n        <ContextMenuSeparator />\n        <ContextMenuGroup>\n          <ContextMenuItem>\n            Rename symbol\n            <ContextMenuShortcut>F2</ContextMenuShortcut>\n          </ContextMenuItem>\n          <ContextMenuSub>\n            <ContextMenuSubTrigger>Refactor</ContextMenuSubTrigger>\n            <ContextMenuSubContent className=\"w-48\">\n              <ContextMenuGroup>\n                <ContextMenuItem>Extract function</ContextMenuItem>\n                <ContextMenuItem>Extract constant</ContextMenuItem>\n                <ContextMenuItem>Inline variable</ContextMenuItem>\n              </ContextMenuGroup>\n            </ContextMenuSubContent>\n          </ContextMenuSub>\n          <ContextMenuItem>\n            Format document\n            <ContextMenuShortcut>⇧⌥F</ContextMenuShortcut>\n          </ContextMenuItem>\n        </ContextMenuGroup>\n        <ContextMenuSeparator />\n        <ContextMenuGroup>\n          <ContextMenuItem>\n            Cut\n            <ContextMenuShortcut>⌘X</ContextMenuShortcut>\n          </ContextMenuItem>\n          <ContextMenuItem>\n            Copy\n            <ContextMenuShortcut>⌘C</ContextMenuShortcut>\n          </ContextMenuItem>\n          <ContextMenuItem>\n            Paste\n            <ContextMenuShortcut>⌘V</ContextMenuShortcut>\n          </ContextMenuItem>\n        </ContextMenuGroup>\n      </ContextMenuContent>\n    </ContextMenu>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}