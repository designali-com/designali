{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "tabs-44",
  "type": "registry:example",
  "description": "Multi-section form whose panels stay mounted so typed values survive tab switches.",
  "files": [
    {
      "path": "registry/designali/examples/tabs/tabs-44.tsx",
      "content": "\"use client\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport { Input } from \"@workspace/ui/components/input\"\nimport {\n  Tabs,\n  TabsContent,\n  TabsList,\n  TabsTrigger,\n} from \"@workspace/ui/components/tabs\"\n\nexport default function KeepMountedFormTabs() {\n  return (\n    <form\n      className=\"w-full max-w-sm border p-4\"\n      onSubmit={(e) => e.preventDefault()}\n    >\n      <Tabs defaultValue=\"event\">\n        <TabsList className=\"w-full\">\n          <TabsTrigger value=\"event\">Event</TabsTrigger>\n          <TabsTrigger value=\"venue\">Venue</TabsTrigger>\n          <TabsTrigger value=\"tickets\">Tickets</TabsTrigger>\n        </TabsList>\n        <TabsContent value=\"event\" keepMounted className=\"flex flex-col gap-2\">\n          <Input\n            name=\"title\"\n            placeholder=\"Event title\"\n            aria-label=\"Event title\"\n          />\n          <Input name=\"date\" type=\"date\" aria-label=\"Date\" />\n        </TabsContent>\n        <TabsContent value=\"venue\" keepMounted className=\"flex flex-col gap-2\">\n          <Input\n            name=\"venue\"\n            placeholder=\"Venue name\"\n            aria-label=\"Venue name\"\n          />\n          <Input\n            name=\"capacity\"\n            type=\"number\"\n            placeholder=\"Capacity\"\n            aria-label=\"Capacity\"\n          />\n        </TabsContent>\n        <TabsContent\n          value=\"tickets\"\n          keepMounted\n          className=\"flex flex-col gap-2\"\n        >\n          <Input\n            name=\"price\"\n            placeholder=\"Price (USD)\"\n            aria-label=\"Ticket price\"\n          />\n          <p className=\"text-muted-foreground\">\n            Values in other tabs are kept while you switch.\n          </p>\n        </TabsContent>\n      </Tabs>\n      <Button type=\"submit\" size=\"sm\" className=\"mt-4 w-full\">\n        Publish event\n      </Button>\n    </form>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}