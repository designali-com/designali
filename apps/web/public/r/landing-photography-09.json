      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  Camera,\n  Check,\n  Clock,\n  Images,\n  Plus,\n  Quote,\n  Sparkles,\n  Sun,\n  Wand,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Work\", \"Services\", \"Packages\", \"Journal\", \"Contact\"]\n\nconst logos = [\n  \"Vogue Living\",\n  \"Kinfolk\",\n  \"The Wed Journal\",\n  \"Cereal\",\n  \"Portrait Weekly\",\n  \"Field Notes\",\n  \"Lens Culture\",\n  \"Atelier\",\n]\n\nconst features = [\n  {\n    icon: Camera,\n    title: \"Natural direction\",\n    description:\n      \"Gentle prompts rather than stiff poses, so your photos feel like you on a very good day.\",\n  },\n  {\n    icon: Sun,\n    title: \"Light-first approach\",\n    description:\n      \"Shoots are planned around golden hour and the best available light for every location.\",\n  },\n  {\n    icon: Wand,\n    title: \"Hand retouching\",\n    description:\n      \"Every delivered image is colour-graded and retouched by hand, never with a one-click preset.\",\n  },\n  {\n    icon: Images,\n    title: \"Private galleries\",\n    description:\n      \"A beautiful online gallery to view, favourite, download and share with family.\",\n  },\n  {\n    icon: Clock,\n    title: \"Two-week delivery\",\n    description:\n      \"Sneak peeks within 48 hours and the full gallery within fourteen days.\",\n  },\n]\n\nconst stats = [\n  { value: \"48h\", label: \"Sneak peek turnaround\" },\n  { value: \"5.0\", label: \"Average client rating\" },\n  { value: \"18\", label: \"Countries shot in\" },\n  { value: \"9\", label: \"Industry awards\" },\n]\n\nconst steps = [\n  {\n    title: \"Enquire\",\n    description:\n      \"Tell us about your date, your plans and what you would love to remember.\",\n  },\n  {\n    title: \"Plan together\",\n    description:\n      \"A video call to choose locations, timings and the feel of your photographs.\",\n  },\n  {\n    title: \"The shoot\",\n    description:\n      \"Relaxed, guided and unhurried. Most people forget the camera after ten minutes.\",\n  },\n  {\n    title: \"Your gallery\",\n    description:\n      \"Sneak peeks in 48 hours and your full, retouched gallery within two weeks.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Lake Como Wedding\",\n    meta: \"Wedding · 640 images\",\n    tag: \"Wedding\",\n    price: \"2026\",\n    tile: \"bg-gradient-to-br from-sky-200 via-cyan-300 to-teal-400 dark:from-sky-700 dark:via-cyan-800 dark:to-teal-900\",\n  },\n  {\n    name: \"The Harlow Family\",\n    meta: \"Family · 85 images\",\n    tag: \"Family\",\n    price: \"2026\",\n    tile: \"bg-gradient-to-br from-violet-200 via-purple-300 to-fuchsia-400 dark:from-violet-700 dark:via-purple-800 dark:to-fuchsia-900\",\n  },\n  {\n    name: \"Atelier Moreau SS26\",\n    meta: \"Editorial · 42 images\",\n    tag: \"Editorial\",\n    price: \"2026\",\n    tile: \"bg-gradient-to-br from-emerald-200 via-green-300 to-lime-300 dark:from-emerald-700 dark:via-green-800 dark:to-lime-900\",\n  },\n  {\n    name: \"Coastal Elopement\",\n    meta: \"Elopement · 210 images\",\n    tag: \"Elopement\",\n    price: \"2025\",\n    tile: \"bg-gradient-to-br from-stone-200 via-neutral-300 to-zinc-400 dark:from-stone-700 dark:via-neutral-800 dark:to-zinc-900\",\n  },\n  {\n    name: \"Field Studio Team\",\n    meta: \"Headshots · 24 portraits\",\n    tag: \"Commercial\",\n    price: \"2025\",\n    tile: \"bg-gradient-to-br from-rose-200 via-pink-300 to-purple-300 dark:from-rose-700 dark:via-pink-800 dark:to-purple-900\",\n  },\n  {\n    name: \"Highland Portraits\",\n    meta: \"Portrait · 60 images\",\n    tag: \"Portrait\",\n    price: \"2025\",\n    tile: \"bg-gradient-to-br from-blue-200 via-indigo-300 to-violet-400 dark:from-blue-700 dark:via-indigo-800 dark:to-violet-900\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"Our new headshots doubled the response rate on our team page. Quick, professional and genuinely fun.\",\n    name: \"Victor Alvarez\",\n    role: \"Founder, Field Studio\",\n  },\n  {\n    quote:\n      \"The product shots were delivered early and were exactly on brief. Our conversion rate jumped noticeably.\",\n    name: \"Ines Moreau\",\n    role: \"Brand Lead, Atelier Moreau\",\n  },\n  {\n    quote:\n      \"Calm, kind and incredibly organised. We never once worried about timings on the day.\",\n    name: \"Sam and Priya\",\n    role: \"Wedding, Cornwall\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Portrait\",\n    price: \"$450\",\n    period: \"/session\",\n    description: \"A one-hour session for individuals or couples.\",\n    features: [\n      \"1 hour on location\",\n      \"40 retouched images\",\n      \"Private online gallery\",\n      \"Print release\",\n    ],\n    cta: \"Book a portrait\",\n  },\n  {\n    name: \"Family\",\n    price: \"$790\",\n    period: \"/session\",\n    description: \"Our most popular session for families.\",\n    features: [\n      \"2 hours, up to 2 locations\",\n      \"100 retouched images\",\n      \"48-hour sneak peek\",\n      \"Private online gallery\",\n      \"20x30 cm fine art print\",\n    ],\n    cta: \"Book a family session\",\n  },\n  {\n    name: \"Wedding\",\n    price: \"$3,800\",\n    period: \"/day\",\n    description: \"Full-day coverage for your wedding.\",\n    features: [\n      \"Up to 10 hours coverage\",\n      \"Second photographer\",\n      \"600+ retouched images\",\n      \"Engagement session\",\n      \"Lay-flat linen album\",\n    ],\n    cta: \"Check your date\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"What if it rains?\",\n    a: \"We reschedule outdoor sessions free of charge, or move to a covered location if you prefer to keep the date.\",\n  },\n  {\n    q: \"Do you provide RAW files?\",\n    a: \"We deliver fully edited high-resolution images. RAW files are not included, as editing is part of the final work.\",\n  },\n  {\n    q: \"Is a deposit required?\",\n    a: \"A 30% deposit secures your date, with the balance due two weeks before the session.\",\n  },\n  {\n    q: \"Can we order prints later?\",\n    a: \"Yes. Your online gallery stays live for a year and includes a print shop with archival-quality products.\",\n  },\n  {\n    q: \"How far in advance should I book?\",\n    a: \"Weddings are usually booked 9 to 14 months ahead. Portrait and family sessions typically need two to four weeks.\",\n  },\n]\n\nconst footer = [\n  { title: \"Work\", links: [\"Weddings\", \"Families\", \"Portraits\", \"Commercial\"] },\n  { title: \"Info\", links: [\"Packages\", \"Journal\", \"FAQ\", \"Gift cards\"] },\n  {\n    title: \"Contact\",\n    links: [\"Enquire\", \"Instagram\", \"Pinterest\", \"Newsletter\"],\n  },\n]\n\nexport default function LandingPhotography09() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-amber-600 text-white text-sm\">\n              A\n            </span>\n            <span className=\"\">Altitude Aerial</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Check availability\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Request a quote\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-16 md:py-24\">\n          <div className=\"mx-auto max-w-3xl space-y-6 text-center\">\n            <span className=\"inline-flex items-center gap-2 rounded-full border bg-background text-muted-foreground px-3 py-1 text-xs font-medium\">\n              <Sparkles className=\"size-3.5 text-amber-600 dark:text-amber-400\" />\n              Licensed drone photography\n            </span>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-6xl \">\n              {\"See your project \"}\n              <span className=\"text-amber-600 dark:text-amber-400\">\n                from a new height\n              </span>\n            </h1>\n            <p className=\"mx-auto max-w-2xl text-lg leading-8 text-muted-foreground\">\n              Altitude Aerial captures real estate, construction progress and\n              events from above, with licensed pilots and 4K video included.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Request a quote\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                View aerial work\n              </Button>\n            </div>\n          </div>\n          <div className=\"mt-14 grid gap-3 lg:grid-cols-[2fr_1fr]\">\n            <HeroVisual />\n            <div className=\"grid grid-cols-2 gap-3 lg:grid-cols-1\">\n              {stats.slice(0, 3).map((stat, i) => (\n                <div\n                  key={stat.label}\n                  className={`flex flex-col justify-between rounded-2xl border p-5 ${i === 0 ? \"bg-amber-500/10\" : \"bg-muted/40\"} ${i === 2 ? \"col-span-2 lg:col-span-1\" : \"\"}`}\n                >\n                  <div className=\"text-xs text-muted-foreground\">\n                    {stat.label}\n                  </div>\n                  <div className=\"mt-6 text-3xl font-semibold tracking-tight\">\n                    {stat.value}\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-12\">\n          <p className=\"text-center text-sm text-muted-foreground\">\n            Published in\n          </p>\n          <div className=\"mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-6 sm:grid-cols-4 lg:grid-cols-8\">\n            {logos.map((logo) => (\n              <div\n                key={logo}\n                className=\"text-center text-base font-semibold tracking-tight text-muted-foreground/70 \"\n              >\n                {logo}\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <p className=\"text-sm font-medium text-amber-600 dark:text-amber-400\">\n              The experience\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              Calm, considered and completely about you\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              From the first call to the final album, every step is designed so\n              you can relax and be yourself in front of the camera.\n            </p>\n          </div>\n          <div className=\"mt-14 grid gap-3 md:grid-cols-3\">\n            {features.map((feature, i) => (\n              <div\n                key={feature.title}\n                className={`group rounded-2xl border p-6 transition-colors hover:bg-muted/40 ${i === 0 ? \"bg-amber-500/10 md:col-span-2 md:row-span-2 md:p-10\" : \"\"} ${i === 3 ? \"md:col-span-2\" : \"\"}`}\n              >\n                <feature.icon\n                  className={`${i === 0 ? \"size-8\" : \"size-5\"} text-amber-600 dark:text-amber-400`}\n                />\n                <h3\n                  className={`mt-6 font-semibold tracking-tight ${i === 0 ? \"text-2xl md:text-3xl\" : \"text-lg\"}`}\n                >\n                  {feature.title}\n                </h3>\n                <p\n                  className={`mt-2 leading-7 text-muted-foreground ${i === 0 ? \"max-w-md text-lg\" : \"text-sm\"}`}\n                >\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Selected galleries\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                A small selection of recent work. Full galleries are shared\n                privately with each client on request.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a key={item.name} href=\"#\" className=\"group\">\n                <div\n                  className={`relative aspect-[4/3] overflow-hidden rounded-2xl ${item.tile}`}\n                >\n                  <div className=\"absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10\" />\n                  <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-zinc-900 backdrop-blur\">\n                    {item.tag}\n                  </span>\n                </div>\n                <div className=\"mt-4 flex items-start justify-between gap-4\">\n                  <div className=\"min-w-0\">\n                    <h3 className=\"font-medium \">{item.name}</h3>\n                    <p className=\"mt-1 text-sm text-muted-foreground\">\n                      {item.meta}\n                    </p>\n                  </div>\n                  <span className=\"shrink-0 text-sm font-semibold\">\n                    {item.price}\n                  </span>\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b bg-muted/30\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Kind words from clients\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-4 md:grid-cols-3\">\n            {testimonials.map((t, i) => (\n              <figure\n                key={t.name}\n                className={`flex flex-col justify-between rounded-2xl border bg-background p-6 ${i === 0 ? \"md:col-span-2 md:p-10\" : \"\"}`}\n              >\n                <Quote className=\"size-6 text-amber-600 dark:text-amber-400\" />\n                <blockquote\n                  className={`mt-4 leading-relaxed ${i === 0 ? \"text-xl md:text-2xl\" : \"text-muted-foreground\"}`}\n                >\n                  {t.quote}\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 text-sm\">\n                  <span className=\"flex size-9 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              How a shoot works\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-amber-600 dark:text-amber-400\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Session packages\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Every package includes a planning call, professional retouching\n              and a private online gallery to download and share.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-amber-500 shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-amber-600 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-amber-600 dark:text-amber-400\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Before you book\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Get in touch\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"px-6 py-20 md:py-28\">\n        <div className=\"relative mx-auto max-w-6xl overflow-hidden rounded-3xl border bg-amber-500/10 px-6 py-16 text-center md:py-24\">\n          <div className=\"pointer-events-none absolute -top-24 left-1/2 size-96 -translate-x-1/2 rounded-full bg-gradient-to-b from-amber-500/25 via-yellow-500/10 to-transparent blur-3xl\" />\n          <div className=\"relative mx-auto max-w-2xl space-y-6\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              {\"Give your project the bird's-eye view\"}\n            </h2>\n            <p className=\"text-lg text-muted-foreground\">\n              Fully insured, licensed pilots and edited files delivered within\n              48 hours.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Request a quote\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                View aerial work\n              </Button>\n            </div>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-amber-600 text-white text-sm\">\n                A\n              </span>\n              <span className=\"\">Altitude Aerial</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              The view from above.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Altitude Aerial. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  return (\n    <div className=\"grid grid-cols-2 gap-3 md:grid-cols-4 md:grid-rows-2\">\n      {showcase.slice(0, 5).map((item, i) => (\n        <div\n          key={item.name}\n          classN