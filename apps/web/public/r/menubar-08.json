{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "menubar-08",
  "type": "registry:example",
  "description": "Email client menubar with reply actions, a Mark as submenu and a destructive delete item.",
  "files": [
    {
      "path": "registry/designali/examples/menubar/menubar-08.tsx",
      "content": "import {\n  Archive as ArchiveIcon,\n  FileText as FileTextIcon,\n  Forward as ForwardIcon,\n  Inbox as InboxIcon,\n  Mail as MailIcon,\n  MailOpen as MailOpenIcon,\n  ReplyAll as ReplyAllIcon,\n  Reply as ReplyIcon,\n  Send as SendIcon,\n  ShieldAlert as ShieldAlertIcon,\n  Star as StarIcon,\n  Tag as TagIcon,\n  Trash2 as Trash2Icon,\n} from \"@designali/icons\"\n\nimport {\n  Menubar,\n  MenubarContent,\n  MenubarGroup,\n  MenubarItem,\n  MenubarMenu,\n  MenubarSeparator,\n  MenubarShortcut,\n  MenubarSub,\n  MenubarSubContent,\n  MenubarSubTrigger,\n  MenubarTrigger,\n} from \"@workspace/ui/components/menubar\"\n\nexport default function EmailMessageMenubar() {\n  return (\n    <div className=\"w-full max-w-sm\">\n      <Menubar>\n        <MenubarMenu>\n          <MenubarTrigger>Message</MenubarTrigger>\n          <MenubarContent className=\"w-52\">\n            <MenubarGroup>\n              <MenubarItem>\n                <ReplyIcon /> Reply <MenubarShortcut>R</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>\n                <ReplyAllIcon /> Reply all <MenubarShortcut>⇧R</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>\n                <ForwardIcon /> Forward <MenubarShortcut>F</MenubarShortcut>\n              </MenubarItem>\n            </MenubarGroup>\n            <MenubarSeparator />\n            <MenubarGroup>\n              <MenubarSub>\n                <MenubarSubTrigger>\n                  <TagIcon /> Mark as\n                </MenubarSubTrigger>\n                <MenubarSubContent>\n                  <MenubarGroup>\n                    <MenubarItem>\n                      <MailOpenIcon /> Read\n                    </MenubarItem>\n                    <MenubarItem>\n                      <MailIcon /> Unread\n                    </MenubarItem>\n                    <MenubarItem>\n                      <StarIcon /> Important\n                    </MenubarItem>\n                    <MenubarItem>\n                      <ShieldAlertIcon /> Spam\n                    </MenubarItem>\n                  </MenubarGroup>\n                </MenubarSubContent>\n              </MenubarSub>\n              <MenubarItem>\n                <ArchiveIcon /> Archive <MenubarShortcut>E</MenubarShortcut>\n              </MenubarItem>\n            </MenubarGroup>\n            <MenubarSeparator />\n            <MenubarGroup>\n              <MenubarItem variant=\"destructive\">\n                <Trash2Icon /> Delete <MenubarShortcut>⌫</MenubarShortcut>\n              </MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>Mailbox</MenubarTrigger>\n          <MenubarContent>\n            <MenubarGroup>\n              <MenubarItem>\n                <InboxIcon /> Inbox\n              </MenubarItem>\n              <MenubarItem>\n                <SendIcon /> Sent\n              </MenubarItem>\n              <MenubarItem>\n                <FileTextIcon /> Drafts\n              </MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n      </Menubar>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}