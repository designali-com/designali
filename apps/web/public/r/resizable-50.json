{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "resizable-50",
  "type": "registry:example",
  "description": "Layout where one handle is disabled to keep a fixed header region.",
  "files": [
    {
      "path": "registry/designali/examples/resizable/resizable-50.tsx",
      "content": "import { LockIcon } from \"lucide-react\"\n\nimport {\n  ResizableHandle,\n  ResizablePanel,\n  ResizablePanelGroup,\n} from \"@workspace/ui/components/resizable\"\n\nexport default function DisabledHandleSection() {\n  return (\n    <ResizablePanelGroup\n      orientation=\"vertical\"\n      className=\"h-72 w-full max-w-md border\"\n    >\n      <ResizablePanel defaultSize=\"20%\" minSize=\"20%\" maxSize=\"20%\">\n        <div className=\"flex h-full items-center gap-2 bg-muted/40 px-3 text-xs font-medium\">\n          <LockIcon className=\"size-3.5\" />\n          Fixed toolbar\n        </div>\n      </ResizablePanel>\n      <ResizableHandle disabled />\n      <ResizablePanel defaultSize=\"50%\" minSize=\"20%\">\n        <div className=\"flex h-full items-center justify-center text-xs\">\n          Timeline\n        </div>\n      </ResizablePanel>\n      <ResizableHandle withHandle />\n      <ResizablePanel defaultSize=\"30%\" minSize=\"15%\">\n        <div className=\"flex h-full items-center justify-center text-xs text-muted-foreground\">\n          Properties\n        </div>\n      </ResizablePanel>\n    </ResizablePanelGroup>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}