      "path": "registry/designali/pages/agency/landing-agency-07/page.tsx",
      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  ChartNoAxesCombined,\n  Check,\n  Clapperboard,\n  Compass,\n  MonitorSmartphone,\n  Package,\n  Palette,\n  Plus,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Work\", \"Services\", \"Studio\", \"Journal\", \"Careers\"]\n\nconst logos = [\n  \"Juniper Bank\",\n  \"Strata Outdoor\",\n  \"Mercer & Co\",\n  \"Atelier Nord\",\n  \"Bloom Coffee\",\n  \"Vela Motors\",\n  \"Copperleaf\",\n  \"Hollis Hotels\",\n]\n\nconst features = [\n  {\n    icon: ChartNoAxesCombined,\n    title: \"Growth and analytics\",\n    description:\n      \"Experimentation, conversion optimisation and reporting tied to the metrics you care about.\",\n  },\n  {\n    icon: Package,\n    title: \"Packaging\",\n    description:\n      \"Packaging and retail design that stands out on the shelf and in the unboxing video.\",\n  },\n  {\n    icon: Compass,\n    title: \"Brand strategy\",\n    description:\n      \"Positioning, naming and messaging grounded in research with your customers and your market.\",\n  },\n  {\n    icon: Palette,\n    title: \"Identity design\",\n    description:\n      \"Logos, type, colour and motion systems built to flex from a favicon to a billboard.\",\n  },\n  {\n    icon: MonitorSmartphone,\n    title: \"Websites and products\",\n    description:\n      \"Fast, accessible websites and digital products designed and engineered by the same team.\",\n  },\n  {\n    icon: Clapperboard,\n    title: \"Film and motion\",\n    description:\n      \"Launch films, product animations and social content produced by our in-house studio.\",\n  },\n]\n\nconst stats = [\n  { value: \"14\", label: \"Years in business\" },\n  { value: \"220+\", label: \"Projects launched\" },\n  { value: \"38\", label: \"Industry awards\" },\n  { value: \"92%\", label: \"Clients who return\" },\n]\n\nconst steps = [\n  {\n    title: \"Discover\",\n    description:\n      \"Workshops, stakeholder interviews and audits to understand your business, audience and goals.\",\n  },\n  {\n    title: \"Define\",\n    description:\n      \"A clear strategy, creative direction and roadmap that everyone signs off before design begins.\",\n  },\n  {\n    title: \"Design and build\",\n    description:\n      \"Iterative sprints with weekly reviews, so you see progress and steer direction throughout.\",\n  },\n  {\n    title: \"Launch and grow\",\n    description:\n      \"We launch together, measure results and keep optimising with an ongoing partnership.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Juniper Bank\",\n    meta: \"Rebrand and digital banking app\",\n    tag: \"Branding\",\n    price: \"2025\",\n    tile: \"bg-gradient-to-br from-stone-200 via-neutral-300 to-zinc-400 dark:from-stone-700 dark:via-neutral-800 dark:to-zinc-900\",\n  },\n  {\n    name: \"Vela Motors\",\n    meta: \"Website and launch campaign\",\n    tag: \"Web\",\n    price: \"2025\",\n    tile: \"bg-gradient-to-br from-rose-200 via-pink-300 to-purple-300 dark:from-rose-700 dark:via-pink-800 dark:to-purple-900\",\n  },\n  {\n    name: \"Bloom Coffee\",\n    meta: \"Packaging for a national rollout\",\n    tag: \"Packaging\",\n    price: \"2024\",\n    tile: \"bg-gradient-to-br from-blue-200 via-indigo-300 to-violet-400 dark:from-blue-700 dark:via-indigo-800 dark:to-violet-900\",\n  },\n  {\n    name: \"Hollis Hotels\",\n    meta: \"Booking experience redesign\",\n    tag: \"Product\",\n    price: \"2024\",\n    tile: \"bg-gradient-to-br from-yellow-100 via-amber-200 to-orange-300 dark:from-yellow-700 dark:via-amber-800 dark:to-orange-900\",\n  },\n  {\n    name: \"Strata Outdoor\",\n    meta: \"Brand film and social content\",\n    tag: \"Film\",\n    price: \"2024\",\n    tile: \"bg-gradient-to-br from-amber-200 via-orange-300 to-rose-400 dark:from-amber-700 dark:via-orange-800 dark:to-rose-900\",\n  },\n  {\n    name: \"Atelier Nord\",\n    meta: \"Identity and e-commerce store\",\n    tag: \"Commerce\",\n    price: \"2023\",\n    tile: \"bg-gradient-to-br from-sky-200 via-cyan-300 to-teal-400 dark:from-sky-700 dark:via-cyan-800 dark:to-teal-900\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"They challenged our brief in the best possible way. The rebrand gave our sales team something they are genuinely proud to show.\",\n    name: \"Isabelle Grant\",\n    role: \"CMO, Juniper Bank\",\n  },\n  {\n    quote:\n      \"Our new website doubled demo requests in the first quarter. The team felt like an extension of our own.\",\n    name: \"Mateo Rossi\",\n    role: \"Head of Marketing, Vela Motors\",\n  },\n  {\n    quote:\n      \"Senior people in every meeting, honest timelines and work that exceeded what we imagined. Rare combination.\",\n    name: \"Freya Lindqvist\",\n    role: \"Founder, Atelier Nord\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Sprint\",\n    price: \"$18k\",\n    period: \"fixed\",\n    description: \"A focused two-week engagement for a defined problem.\",\n    features: [\n      \"Discovery workshop\",\n      \"One core deliverable\",\n      \"Two review rounds\",\n      \"Handover documentation\",\n    ],\n    cta: \"Book a sprint\",\n  },\n  {\n    name: \"Project\",\n    price: \"From $60k\",\n    period: \"per project\",\n    description: \"End-to-end brand or product launches.\",\n    features: [\n      \"Strategy and creative direction\",\n      \"Dedicated project lead\",\n      \"Design and development\",\n      \"Weekly reviews\",\n      \"30 days of post-launch support\",\n    ],\n    cta: \"Start a project\",\n  },\n  {\n    name: \"Partnership\",\n    price: \"$25k\",\n    period: \"/month\",\n    description: \"An embedded team for ongoing work.\",\n    features: [\n      \"Dedicated multidisciplinary team\",\n      \"Quarterly strategy sessions\",\n      \"Unlimited requests in scope\",\n      \"Monthly performance reports\",\n    ],\n    cta: \"Let us talk\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"What size of companies do you work with?\",\n    a: \"Mostly growth-stage startups and established mid-market brands, though we take on a few founder-led early projects each year.\",\n  },\n  {\n    q: \"How soon can you start?\",\n    a: \"We typically book four to six weeks ahead. Sprints can sometimes start within two weeks.\",\n  },\n  {\n    q: \"Do you work with in-house teams?\",\n    a: \"Often. We are happy to lead, to collaborate or to coach your team so they can carry the work forward.\",\n  },\n  {\n    q: \"Do you work remotely?\",\n    a: \"Yes. We have studios in three cities and work with clients worldwide, meeting in person for key workshops.\",\n  },\n  {\n    q: \"Who owns the work?\",\n    a: \"You do. All intellectual property transfers to you on final payment, including source files and code.\",\n  },\n]\n\nconst footer = [\n  { title: \"Studio\", links: [\"About\", \"Team\", \"Careers\", \"Press\"] },\n  { title: \"Services\", links: [\"Branding\", \"Digital\", \"Film\", \"Campaigns\"] },\n  {\n    title: \"Connect\",\n    links: [\"Instagram\", \"LinkedIn\", \"Dribbble\", \"Newsletter\"],\n  },\n]\n\nexport default function LandingAgency07() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-orange-600 text-white text-sm\">\n              H\n            </span>\n            <span className=\"\">Hollow Oak</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Contact\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Start a packaging brief\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"relative isolate overflow-hidden border-b\">\n        <div className=\"pointer-events-none absolute inset-0 -z-10 bg-radial-[ellipse_60%_50%_at_50%_0%] from-orange-500/25 via-amber-500/10 to-transparent to-70%\" />\n        <div className=\"pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,var(--border)_1px,transparent_1px),linear-gradient(to_bottom,var(--border)_1px,transparent_1px)] bg-[size:48px_48px] [mask-image:radial-gradient(ellipse_50%_45%_at_50%_0%,#000_60%,transparent_100%)]\" />\n        <div className=\"mx-auto max-w-7xl px-6 pt-20 pb-16 md:pt-32\">\n          <div className=\"mx-auto max-w-4xl space-y-8 text-center\">\n            <a\n              href=\"#\"\n              className=\"inline-flex items-center gap-2 rounded-full border bg-background/70 py-1 pr-3 pl-1 text-xs backdrop-blur\"\n            >\n              <span className=\"rounded-full bg-orange-600 px-2 py-0.5 font-medium text-white\">\n                New\n              </span>\n              <span className=\"text-muted-foreground\">\n                Two Pentawards golds for our 2026 range work\n              </span>\n            </a>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-8xl \">\n              {\"Packaging that \"}\n              <span className=\"text-orange-600 dark:text-orange-400\">\n                wins the shelf\n              </span>\n              {\" in three seconds\"}\n            </h1>\n            <p className=\"mx-auto max-w-2xl text-lg leading-8 text-muted-foreground\">\n              Hollow Oak designs packaging systems, point-of-sale and retail\n              fixtures for food, drink and beauty brands launching into major\n              grocers.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Start a packaging brief\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                View the shelf\n              </Button>\n            </div>\n          </div>\n          <div className=\"relative mx-auto mt-20 max-w-5xl\">\n            <div className=\"absolute inset-x-10 -top-6 -z-10 h-24 rounded-full bg-orange-500/10 blur-2xl\" />\n            <HeroVisual />\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-12\">\n          <p className=\"text-center text-sm text-muted-foreground\">\n            Brands we have partnered with\n          </p>\n          <div className=\"mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-6 sm:grid-cols-4 lg:grid-cols-8\">\n            {logos.map((logo) => (\n              <div\n                key={logo}\n                className=\"text-center text-base font-semibold tracking-tight text-muted-foreground/70 \"\n              >\n                {logo}\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <p className=\"text-sm font-medium text-orange-600 dark:text-orange-400\">\n              Services\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              Strategy, design and technology under one roof\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              We partner with ambitious brands from the first workshop to launch\n              day and beyond, with senior people on every project.\n            </p>\n          </div>\n          <div className=\"mt-14 grid overflow-hidden rounded-2xl border sm:grid-cols-2 lg:grid-cols-3\">\n            {features.map((feature) => (\n              <div\n                key={feature.title}\n                className=\"-mt-px -ml-px border-t border-l p-8\"\n              >\n                <feature.icon className=\"size-6 text-orange-600 dark:text-orange-400\" />\n                <h3 className=\"mt-5 font-semibold\">{feature.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl grid-cols-2 px-6 lg:grid-cols-4\">\n          {stats.slice(0, 4).map((stat, i) => (\n            <div\n              key={stat.label}\n              className={`py-12 ${i > 0 ? \"lg:border-l lg:pl-8\" : \"\"} ${i % 2 === 1 ? \"border-l pl-6 lg:pl-8\" : \"\"} `}\n            >\n              <div className=\"text-4xl font-semibold tracking-tight md:text-5xl \">\n                {stat.value}\n              </div>\n              <div className=\"mt-2 text-sm text-muted-foreground\">\n                {stat.label}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Selected work\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                A few recent projects for clients who wanted to be remembered,\n                not just noticed.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a key={item.name} href=\"#\" className=\"group\">\n                <div\n                  className={`relative aspect-[4/3] overflow-hidden rounded-2xl ${item.tile}`}\n                >\n                  <div className=\"absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10\" />\n                  <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-zinc-900 backdrop-blur\">\n                    {item.tag}\n                  </span>\n                </div>\n                <div className=\"mt-4 flex items-start justify-between gap-4\">\n                  <div className=\"min-w-0\">\n                    <h3 className=\"font-medium \">{item.name}</h3>\n                    <p className=\"mt-1 text-sm text-muted-foreground\">\n                      {item.meta}\n                    </p>\n                  </div>\n                  <span className=\"shrink-0 text-sm font-semibold\">\n                    {item.price}\n                  </span>\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              How we work together\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-orange-600 dark:text-orange-400\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              What our clients say\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-6 md:grid-cols-3\">\n            {testimonials.map((t) => (\n              <figure\n                key={t.name}\n                className=\"flex flex-col rounded-2xl border p-6\"\n              >\n                <blockquote className=\"flex-1 leading-7\">\n                  &ldquo;{t.quote}&rdquo;\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 border-t pt-6 text-sm\">\n                  <span className=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Ways to work with us\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Clear engagement models with fixed scopes or dedicated teams. No\n              surprise invoices, ever.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-orange-500 shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-orange-600 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-orange-600 dark:text-orange-400\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Before you get in touch\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Get in touch\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"px-6 py-20 md:py-28\">\n        <div className=\"relative mx-auto max-w-6xl overflow-hidden rounded-3xl border bg-orange-500/10 px-6 py-16 text-center md:py-24\">\n          <div className=\"pointer-events-none absolute -top-24 left-1/2 size-96 -translate-x-1/2 rounded-full bg-gradient-to-b from-orange-500/25 via-amber-500/10 to-transparent blur-3xl\" />\n          <div className=\"relative mx-auto max-w-2xl space-y-6\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Launching a product into retail?\n            </h2>\n            <p className=\"text-lg text-muted-foreground\">\n              Send us your range and retailer list, and we will propose a design\n              route in ten days.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Start a packaging brief\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                View the shelf\n              </Button>\n            </div>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-orange-600 text-white text-sm\">\n                H\n              </span>\n              <span className=\"\">Hollow Oak</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              Design that sells off the shelf.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Hollow Oak. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  return (\n    <div className=\"grid grid-cols-2 gap-3 md:grid-cols-3\">\n      {showcase.slice(0, 3).map((item, i) => (\n        <div\n          key={item.name}\n          className={`relative overflow-hidden rounded-2xl ${item.tile} ${i === 0 ? \"col-span-2 aspect-[16/10] md:col-span-1 md:aspect-[3/4]\" : \"aspect-[3/4]\"}`}\n        >\n          <div className=\"absolute inset-0 bg-gradient-to-t from-black/50 via-black/0 to-black/0\" />\n          <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-zinc-900 backdrop-blur\">\n            {item.tag}\n          </span>\n          <div className=\"absolute inset-x-3 bottom-3 flex items-end justify-between gap-2 text-white\">\n            <div className=\"min-w-0\">\n              <div className=\"truncate text-sm font-medium\">{item.name}</div>\n              <div className=\"truncate text-xs text-white/75\">{item.meta}</div>\n            </div>\n            <div className=\"shrink-0 text-sm font-semibold\">{item.price}</div>\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n",
