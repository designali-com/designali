  "files": [
    {
      "path": "registry/designali/pages/consulting/landing-consulting-05/page.tsx",
      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  Check,\n  Cog,\n  Cpu,\n  GraduationCap,\n  Handshake,\n  Leaf,\n  Plus,\n  Sparkles,\n  Target,\n} from \"@designali/icons\"\n\nimport { Logo } from \"@/src/components/logo\"\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Services\", \"Audits\", \"Case studies\", \"Blog\", \"About\"]\n\nconst features = [\n  {\n    icon: Handshake,\n    title: \"Rebrand and migration\",\n    description:\n      \"Merge old brands and interfaces into one coherent system, without breaking what already works.\",\n  },\n  {\n    icon: Cpu,\n    title: \"Design engineering advisory\",\n    description:\n      \"Ali Imam advises on Next.js, React and Tailwind CSS architecture so design ships as production-ready code.\",\n  },\n  {\n    icon: Leaf,\n    title: \"Accessibility\",\n    description:\n      \"Accessibility audits and fixes that make your product usable by everyone, checked against WCAG.\",\n  },\n  {\n    icon: GraduationCap,\n    title: \"Capability building\",\n    description:\n      \"We train your team as we go, so the system sticks long after the engagement ends.\",\n  },\n  {\n    icon: Target,\n    title: \"UX strategy\",\n    description:\n      \"Journeys, positioning and product priorities grounded in real user evidence, not assumptions.\",\n  },\n  {\n    icon: Cog,\n    title: \"Design system audits\",\n    description:\n      \"A clear review of your components, tokens and docs, with a roadmap to make the system scale.\",\n  },\n]\n\nconst stats = [\n  { value: \"4000+\", label: \"Icons in @designali/icons\" },\n  { value: \"2 wks\", label: \"Typical audit\" },\n  { value: \"60+\", label: \"Products reviewed\" },\n  { value: \"460+\", label: \"Blocks in the Designali library\" },\n]\n\nconst steps = [\n  {\n    title: \"Audit\",\n    description:\n      \"A focused two-week review of your product, brand and code to find the highest-impact fixes.\",\n  },\n  {\n    title: \"Design\",\n    description:\n      \"Co-create the UX strategy, design principles and system roadmap with your team, not for them.\",\n  },\n  {\n    title: \"Build\",\n    description:\n      \"Ship real components and pages in code, review weekly and scale what works across the product.\",\n  },\n  {\n    title: \"Hand over\",\n    description:\n      \"Hand over Figma libraries, docs and trained owners so quality keeps compounding.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"E-commerce UX audit\",\n    meta: \"Checkout and product pages\",\n    tag: \"Strategy\",\n    price: \"12 key fixes\",\n  },\n  {\n    name: \"Design system rebuild\",\n    meta: \"SaaS platform · 140 components\",\n    tag: \"Systems\",\n    price: \"-22% cost\",\n  },\n  {\n    name: \"Onboarding redesign\",\n    meta: \"Health app\",\n    tag: \"UX\",\n    price: \"-34% wait time\",\n  },\n  {\n    name: \"Two-brand merge\",\n    meta: \"Unified identity and UI\",\n    tag: \"Brand\",\n    price: \"1 design system\",\n  },\n  {\n    name: \"Analytics dashboard\",\n    meta: \"Data-heavy web app\",\n    tag: \"Data UX\",\n    price: \"4x faster reviews\",\n  },\n  {\n    name: \"Accessibility programme\",\n    meta: \"Logistics web app\",\n    tag: \"Accessibility\",\n    price: \"-40% emissions\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"The design team setup was handled with care. Handoffs got faster without adding a single meeting.\",\n    name: \"Ana P.\",\n    role: \"Head of design, product team\",\n  },\n  {\n    quote:\n      \"Designali built the dashboard system in-house with us rather than making us dependent on them. That is rare.\",\n    name: \"David K.\",\n    role: \"Data product lead, Designali client\",\n  },\n  {\n    quote:\n      \"Ali challenged our assumptions in the first week and was right. The audit gave us a clear list of fixes we shipped in a month.\",\n    name: \"Catherine D.\",\n    role: \"Product lead, Designali client\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Audit\",\n    price: \"$1,800\",\n    period: \"/2 weeks\",\n    description: \"Find the biggest UX and design system wins.\",\n    features: [\n      \"Stakeholder interviews\",\n      \"Product and code review\",\n      \"Accessibility check\",\n      \"Prioritised roadmap\",\n    ],\n    cta: \"Book an audit\",\n  },\n  {\n    name: \"Embedded\",\n    price: \"From $4,500\",\n    period: \"/month\",\n    description: \"Design and build alongside your team.\",\n    features: [\n      \"Ali embedded in your team\",\n      \"Weekly design reviews\",\n      \"Components shipped in code\",\n      \"Figma library upkeep\",\n      \"Monthly roadmap check-in\",\n    ],\n    cta: \"Discuss an engagement\",\n  },\n  {\n    name: \"Advisory\",\n    price: \"Custom\",\n    period: \"\",\n    description: \"On-call design engineering advice.\",\n    features: [\n      \"Direct access to Ali\",\n      \"Launch reviews\",\n      \"Design and code reviews\",\n      \"Quarterly strategy sessions\",\n      \"Flexible scope\",\n    ],\n    cta: \"Talk to Ali\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"Do you help with implementation?\",\n    a: \"Yes. Designali can build the fixes in Next.js, React and Tailwind CSS, or pair with your developers.\",\n  },\n  {\n    q: \"Do you sign NDAs?\",\n    a: \"Always. Confidentiality is standard and your files stay private.\",\n  },\n  {\n    q: \"What size of teams do you work with?\",\n    a: \"Mostly startups and product teams from two to two hundred people, plus founders who need a senior design partner.\",\n  },\n  {\n    q: \"How are engagements priced?\",\n    a: \"Audits are fixed price. Embedded and advisory work is a simple monthly fee you can pause or cancel.\",\n  },\n  {\n    q: \"Who will we work with?\",\n    a: \"Ali Imam leads every engagement personally. You work directly with the person who designs and codes.\",\n  },\n]\n\nconst footer = [\n  { title: \"Services\", links: [\"Strategy\", \"Systems\", \"Data UX\", \"Brand\"] },\n  { title: \"Studio\", links: [\"About\", \"Ali Imam\", \"Work\", \"Contact\"] },\n  { title: \"Blog\", links: [\"Templates\", \"Blocks\", \"Docs\", \"Icons\"] },\n]\n\nexport default function LandingConsulting05() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <div className=\"border-b border-background/10 bg-foreground text-background/80 px-4 py-2 text-center text-xs sm:text-sm\">\n        <a\n          href=\"#\"\n          className=\"inline-flex items-center gap-1.5 hover:underline\"\n        >\n          AI design workflow reviews now available\n          <ArrowRight className=\"size-3.5\" />\n        </a>\n      </div>\n      <header className=\"bg-foreground text-background sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <Logo className=\"h-5 w-auto\" />\n            <span className=\"\">designali</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-background/70 hover:text-background transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex text-background hover:bg-background/10 hover:text-background\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View work\n            </Button>\n            <Button\n              size=\"sm\"\n              className=\"bg-background text-foreground hover:bg-background/90\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Get an AI workflow review\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"relative overflow-hidden bg-foreground text-background\">\n        <div className=\"pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,currentColor_1px,transparent_1px),linear-gradient(to_bottom,currentColor_1px,transparent_1px)] bg-[size:64px_64px] opacity-[0.04]\" />\n        <div className=\"relative mx-auto max-w-7xl px-6 pt-16 pb-20 md:pt-28\">\n          <div className=\"max-w-4xl space-y-7\">\n            <span className=\"inline-flex items-center gap-2 rounded-full border border-background/20 text-background/80 px-3 py-1 text-xs font-medium\">\n              <Sparkles className=\"size-3.5 \" />\n              Designali for AI-assisted design\n            </span>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-7xl \">\n              {\"Turn AI workflows into a \"}\n              <span className=\"text-background/60\">competitive edge</span>\n            </h1>\n            <p className=\"max-w-2xl text-lg leading-8 text-background/65\">\n              Designali designs AI-assisted workflows for design and front-end teams, from prompt-to-prototype to code review, that deliver value in weeks.\n            </p>\n            <div className=\"flex flex-wrap gap-3 \">\n              <Button\n                size=\"lg\"\n                className=\"bg-background text-foreground hover:bg-background/90\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Get an AI workflow review\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                className=\"border-background/25 bg-transparent text-background hover:bg-background/10 hover:text-background\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Explore services\n              </Button>\n            </div>\n          </div>\n          <div className=\"mt-16\">\n            <HeroVisual />\n          </div>\n        </div>\n      </section>\n      <section className=\"bg-foreground text-background\">\n        <div className=\"mx-auto grid max-w-7xl grid-cols-2 px-6 lg:grid-cols-4\">\n          {stats.slice(0, 4).map((stat, i) => (\n            <div\n              key={stat.label}\n              className={`py-12 ${i > 0 ? \"lg:border-l lg:pl-8\" : \"\"} ${i % 2 === 1 ? \"border-l pl-6 lg:pl-8\" : \"\"} border-background/10`}\n            >\n              <div className=\"text-4xl font-semibold tracking-tight md:text-5xl \">\n                {stat.value}\n              </div>\n              <div className=\"mt-2 text-sm text-background/60\">\n                {stat.label}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"max-w-2xl\">\n            <p className=\"text-sm font-medium text-primary dark:text-primary\">\n              Capabilities\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              Strategy that turns into shipped product\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              We work alongside your team from audit to delivery, and we measure success by what ships, not slide count.\n            </p>\n          </div>\n          <div className=\"mt-14 grid overflow-hidden rounded-2xl border sm:grid-cols-2 lg:grid-cols-3\">\n            {features.map((feature) => (\n              <div\n                key={feature.title}\n                className=\"-mt-px -ml-px border-t border-l p-8\"\n              >\n                <feature.icon className=\"size-6 text-primary dark:text-primary\" />\n                <h3 className=\"mt-5 font-semibold\">{feature.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Selected engagements\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                A few engagements where Designali helped teams fix what mattered most.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all work\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a\n                key={item.name}\n                href=\"#\"\n                className=\"group flex flex-col rounded-xl border p-6 transition-colors hover:bg-muted/40\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"flex size-10 items-center justify-center rounded-lg border bg-muted/50 font-semibold \">\n                    {item.name.charAt(0)}\n                  </span>\n                  <span className=\"rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary dark:text-primary\">\n                    {item.tag}\n                  </span>\n                </div>\n                <h3 className=\"mt-6 font-semibold \">{item.name}</h3>\n                <p className=\"mt-1 flex-1 text-sm text-muted-foreground\">\n                  {item.meta}\n                </p>\n                <div className=\"mt-6 flex items-center justify-between border-t pt-4 text-sm\">\n                  <span className=\"font-medium\">{item.price}</span>\n                  <ArrowUpRight className=\"size-4 text-muted-foreground transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5\" />\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              How an engagement works\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-primary dark:text-primary\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              What teams say about working with Designali\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-6 md:grid-cols-3\">\n            {testimonials.map((t) => (\n              <figure\n                key={t.name}\n                className=\"flex flex-col rounded-2xl border p-6\"\n              >\n                <blockquote className=\"flex-1 leading-7\">\n                  &ldquo;{t.quote}&rdquo;\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 border-t pt-6 text-sm\">\n                  <span className=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Ways to work with Designali\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              From a focused audit to an embedded design engineer, every engagement has clear scope and outcomes.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"bg-foreground text-background border-foreground\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-background text-foreground px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p\n                    className={\n                      featured\n                        ? \"mt-2 text-sm text-background/65\"\n                        : \"mt-2 text-sm text-muted-foreground\"\n                    }\n                  >\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span\n                      className={\n                        featured\n                          ? \"text-sm text-background/65\"\n                          : \"text-sm text-muted-foreground\"\n                      }\n                    >\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check\n                          className={\n                            featured\n                              ? \"mt-0.5 size-4 shrink-0\"\n                              : \"mt-0.5 size-4 shrink-0 text-primary dark:text-primary\"\n                          }\n                        />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className={\n                      featured\n                        ? \"mt-8 w-full bg-background text-foreground hover:bg-background/90\"\n                        : \"mt-8 w-full\"\n                    }\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Working with Designali\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Email hello@designali.com\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"bg-foreground text-background\">\n        <div className=\"mx-auto flex max-w-7xl flex-col gap-10 px-6 py-20 md:flex-row md:items-end md:justify-between md:py-28\">\n          <div className=\"max-w-2xl\">\n            <h2 className=\"text-4xl font-semibold tracking-tight text-balance md:text-6xl \">\n              See where AI can take your design team\n            </h2>\n            <p className=\"mt-5 text-lg text-background/65\">\n              A two-week workflow review shows the highest-value opportunities.\n            </p>\n          </div>\n          <div className=\"flex flex-wrap gap-3 \">\n            <Button\n              size=\"lg\"\n              className=\"bg-background text-foreground hover:bg-background/90\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Get an AI workflow review\n              <ArrowRight />\n            </Button>\n            <Button\n              size=\"lg\"\n              variant=\"outline\"\n              className=\"border-background/25 bg-transparent text-background hover:bg-background/10 hover:text-background\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Explore services\n            </Button>\n          </div>\n        </div>\n      </section>\n      <footer className=\"border-t border-background/10 bg-foreground text-background\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <Logo className=\"h-5 w-auto\" />\n              <span className=\"\">designali</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-background/60\">\n              AI-assisted, human-crafted.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-background/60 transition-colors hover:text-background\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t border-background/10\">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-background/60 sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Designali. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-background\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-background\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-background\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  const bars = [38, 52, 44, 63, 58, 71, 66, 80, 74, 88, 83, 95]\n  return (\n    <div className=\"overflow-hidden rounded-xl border bg-card text-left text-card-foreground shadow-2xl/10\">\n      <div className=\"flex items-center gap-2 border-b px-4 py-3\">\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"ml-3 hidden rounded-md bg-muted px-3 py-0.5 text-[11px] text-muted-foreground sm:inline\">\n          designali.com/docs\n        </span>\n      </div>\n      <div className=\"grid md:grid-cols-[180px_1fr]\">\n        <aside className=\"hidden space-y-1 border-r p-3 text-sm md:block\">\n          {navLinks.map((link, i) => (\n            <div\n              key={link}\n              className={`rounded-md px-3 py-1.5 ${i === 0 ? \"bg-muted font-medium\" : \"text-muted-foreground\"}`}\n            >\n              {link}\n            </div>\n          ))}\n        </aside>\n        <div className=\"space-y-4 p-4 md:p-6\">\n          <div className=\"grid grid-cols-2 gap-3 lg:grid-cols-4\">\n            {stats.slice(0, 4).map((stat) => (\n              <div key={stat.label} className=\"rounded-lg border p-3\">\n                <div className=\"truncate text-[11px] text-muted-foreground\">\n                  {stat.label}\n                </div>\n                <div className=\"mt-1 text-lg font-semibold tracking-tight\">\n                  {stat.value}\n                </div>\n              </div>\n            ))}\n          </div>\n          <div className=\"rounded-lg border p-4\">\n            <div className=\"mb-4 flex items-center justify-between text-xs\">\n              <span className=\"font-medium\">Usability score, last 12 weeks</span>\n              <span className=\"text-primary dark:text-primary\">\n                +24.6%\n              </span>\n            </div>\n            <div className=\"flex h-32 items-end gap-1.5\">\n              {bars.map((h, i) => (\n                <div\n                  key={i}\n                  className={`flex-1 rounded-t-sm ${i === bars.length - 1 ? \"bg-chart-2\" : \"bg-muted-foreground/20\"}`}\n                  style={{ height: `${h}%` }}\n                />\n              ))}\n            </div>\n          </div>\n          <div className=\"hidden divide-y rounded-lg border sm:block\">\n            {showcase.slice(0, 3).map((item) => (\n              <div\n                key={item.name}\n                className=\"flex items-center justify-between gap-4 px-4 py-2.5 text-sm\"\n              >\n                <div className=\"min-w-0\">\n                  <div className=\"truncate font-medium\">{item.name}</div>\n                  <div className=\"truncate text-xs text-muted-foreground\">\n                    {item.meta}\n                  </div>\n                </div>\n                <span className=\"shrink-0 rounded-full bg-primary/10 px-2 py-0.5 text-[11px] font-medium text-primary dark:text-primary\">\n                  {item.tag}\n                </span>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n    </div>\n  )\n}\n",
