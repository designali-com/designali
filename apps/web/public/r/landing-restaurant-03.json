  "files": [
    {
      "path": "registry/designali/pages/restaurant/landing-restaurant-03/page.tsx",
      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  Check,\n  Gift,\n  Plus,\n  Quote,\n  Salad,\n  Sparkles,\n  Truck,\n  Users,\n  Wheat,\n  Wine,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Services\", \"About\", \"Packages\", \"Work\", \"Contact\"]\n\nconst logos = [\n  \"Packaging\",\n  \"Booking sites\",\n  \"Ordering flows\",\n  \"Social visuals\",\n  \"Signage\",\n  \"Motion\",\n  \"Brand identity\",\n  \"Menu design\",\n]\n\nconst features = [\n  {\n    icon: Wine,\n    title: \"Booking & ordering sites\",\n    description:\n      \"Fast Next.js websites with reservations, online ordering links and opening hours that are easy to update.\",\n  },\n  {\n    icon: Wheat,\n    title: \"Packaging & print\",\n    description:\n      \"Takeaway boxes, bags, labels and gift cards designed as one system with your brand.\",\n  },\n  {\n    icon: Users,\n    title: \"Packages\",\n    description:\n      \"Fixed-price packages for brand, menus and website, with Ali Imam as your single point of contact.\",\n  },\n  {\n    icon: Salad,\n    title: \"Social & motion visuals\",\n    description:\n      \"Templates, short motion loops and launch visuals so your feed always looks as good as the food.\",\n  },\n  {\n    icon: Truck,\n    title: \"Delivery & ordering UX\",\n    description:\n      \"Clear ordering flows for pickup and delivery, designed to be quick on any phone.\",\n  },\n  {\n    icon: Gift,\n    title: \"Work\",\n    description:\n      \"Gift cards, vouchers and loyalty cards designed to match your brand.\",\n  },\n]\n\nconst stats = [\n  { value: \"3\", label: \"Revision rounds included\" },\n  { value: \"2300+\", label: \"Templates to start from\" },\n  { value: \"4.8/5\", label: \"Client rating\" },\n  { value: \"30+\", label: \"Pages and screens per project\" },\n]\n\nconst steps = [\n  {\n    title: \"Book a discovery call\",\n    description:\n      \"Tell us about your restaurant, your guests and what you want people to feel when they walk in.\",\n  },\n  {\n    title: \"Share your references\",\n    description:\n      \"Add photos, menus and brands you love, plus any dietary or accessibility notes for the menu.\",\n  },\n  {\n    title: \"Design together\",\n    description:\n      \"Concepts are shared in Figma with weekly reviews until the brand feels right.\",\n  },\n  {\n    title: \"Launch and serve\",\n    description:\n      \"We deliver print files, the website and social templates, ready for opening night.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Menu Design\",\n    meta: \"Print and digital menus, specials boards\",\n    tag: \"Popular\",\n    price: \"$1,800\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Logo & Identity\",\n    meta: \"Logo, colour, type, brand guidelines\",\n    tag: \"Brand\",\n    price: \"$1,400\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Booking Website\",\n    meta: \"Next.js site, reservations, hours\",\n    tag: \"Website\",\n    price: \"$1,200\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Packaging Set\",\n    meta: \"Boxes, bags, cups and labels\",\n    tag: \"Print\",\n    price: \"$2,400\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-chart-1 dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Social Kit\",\n    meta: \"48-hour heritage grain loaf\",\n    tag: \"Templates and launch posts\",\n    price: \"$600\",\n    tile: \"bg-gradient-to-br from-muted via-border to-muted-foreground dark:from-muted dark:via-card dark:to-card\",\n  },\n  {\n    name: \"Motion Loops\",\n    meta: \"Short videos for menus and screens\",\n    tag: \"Motion\",\n    price: \"$900\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-chart-1 dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"Designali built our booking site in weeks. Reservations moved online and the phone finally stopped ringing all day.\",\n    name: \"Joanna\",\n    role: \"Operations manager, cafe group\",\n  },\n  {\n    quote:\n      \"Relaxed, warm and genuinely thoughtful. Working with Ali felt like having a creative partner in the kitchen.\",\n    name: \"Sam\",\n    role: \"Founder, food brand\",\n  },\n  {\n    quote:\n      \"The vegan menu design was so clear that guests started ordering from it just to try it.\",\n    name: \"Elena\",\n    role: \"Designali client\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Menu Refresh\",\n    price: \"$1,200\",\n    period: \"/project\",\n    description: \"A new look for your menus and specials.\",\n    features: [\n      \"Menu layout and typography\",\n      \"Print-ready files\",\n      \"Digital menu version\",\n      \"Two rounds of revisions\",\n    ],\n    cta: \"Book a menu refresh\",\n  },\n  {\n    name: \"Full Brand\",\n    price: \"$4,800\",\n    period: \"/project\",\n    description: \"Identity, menus and website for a new opening.\",\n    features: [\n      \"Logo and brand guidelines\",\n      \"Menus and signage\",\n      \"Next.js booking website\",\n      \"Social media templates\",\n      \"Packaging design\",\n    ],\n    cta: \"Book Full Brand\",\n  },\n  {\n    name: \"Ongoing support\",\n    price: \"From $650\",\n    period: \"/month\",\n    description: \"Monthly design support for busy restaurants.\",\n    features: [\n      \"Seasonal menu updates\",\n      \"Campaign graphics\",\n      \"Website updates\",\n      \"Social content templates\",\n      \"Motion loops for screens\",\n    ],\n    cta: \"Start support\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"Do you also build the website?\",\n    a: \"Yes. Ali Imam designs and builds the site in Next.js, connected to the booking or ordering tools you already use.\",\n  },\n  {\n    q: \"What is your cancellation policy?\",\n    a: \"Projects are scoped up front. If plans change, we pause or adjust the scope together before the next milestone.\",\n  },\n  {\n    q: \"Can you work with existing branding?\",\n    a: \"Yes. We can refresh an existing brand gently or extend it into new menus, packaging and a website.\",\n  },\n  {\n    q: \"Do you offer gift card designs?\",\n    a: \"Yes. Gift cards, vouchers and loyalty cards can be added to any package.\",\n  },\n  {\n    q: \"Do you work with new openings?\",\n    a: \"Yes. We often start months before opening, so the brand, menus and website are ready for the first service.\",\n  },\n]\n\nconst footer = [\n  {\n    title: \"Contact\",\n    links: [\"Services\", \"Process\", \"Work\", \"Pricing\"],\n  },\n  { title: \"Menus\", links: [\"Brand identity\", \"Websites\", \"Packaging\", \"Social kits\"] },\n  {\n    title: \"More\",\n    links: [\"Packages\", \"Work\", \"About Ali\", \"Blog\"],\n  },\n]\n\nexport default function LandingRestaurant03() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <div className=\"border-b bg-muted/50 text-muted-foreground px-4 py-2 text-center text-xs sm:text-sm\">\n        <a\n          href=\"#\"\n          className=\"inline-flex items-center gap-1.5 hover:underline\"\n        >\n          Now booking bakery and cafe brand projects\n          <ArrowRight className=\"size-3.5\" />\n        </a>\n      </div>\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-chart-2 text-white text-sm\">\n              C\n            </span>\n            <span className=\"\">designali</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Book a call\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Book a call\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"relative overflow-hidden border-b\">\n        <div className=\"mx-auto grid max-w-7xl items-center gap-12 px-6 py-16 md:py-24 lg:grid-cols-2\">\n          <div className=\"space-y-7\">\n            <span className=\"inline-flex items-center gap-2 rounded-full border bg-background text-muted-foreground px-3 py-1 text-xs font-medium\">\n              <Sparkles className=\"size-3.5 text-primary dark:text-primary\" />\n              Design for bakeries\n            </span>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-6xl \">\n              {\"Bakery brands, designed \"}\n              <span className=\"text-primary dark:text-primary\">\n                before sunrise\n              </span>\n            </h1>\n            <p className=\"max-w-xl text-lg leading-8 text-muted-foreground\">\n              designali designs warm brands, packaging and ordering sites for\n              bakeries, from bread labels to celebration cake menus.\n            </p>\n            <div className=\"flex flex-wrap gap-3 \">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Book a call\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Packaging work\n              </Button>\n            </div>\n            <div className=\"flex flex-wrap gap-x-8 gap-y-3 pt-2\">\n              {stats.slice(0, 3).map((stat) => (\n                <div key={stat.label}>\n                  <div className=\"text-2xl font-semibold tracking-tight\">\n                    {stat.value}\n                  </div>\n                  <div className=\"text-xs text-muted-foreground\">\n                    {stat.label}\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n          <div className=\"relative\">\n            <div className=\"absolute -inset-8 -z-10 rounded-full bg-gradient-to-tr from-primary/25 via-primary/10 to-transparent blur-3xl\" />\n            <HeroVisual />\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-12\">\n          <p className=\"text-center text-sm text-muted-foreground\">\n            Services include\n          </p>\n          <div className=\"mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-6 sm:grid-cols-4 lg:grid-cols-8\">\n            {logos.map((logo) => (\n              <div\n                key={logo}\n                className=\"text-center text-base font-semibold tracking-tight text-muted-foreground/70 \"\n              >\n                {logo}\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b bg-muted/30\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"max-w-2xl\">\n            <p className=\"text-sm font-medium text-primary dark:text-primary\">\n              Our approach\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              Restaurant design, made with care\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              We work closely with chefs and owners, design every touchpoint\n              together and make almost everything production ready.\n            </p>\n          </div>\n          <div className=\"mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3\">\n            {features.map((feature) => (\n              <div\n                key={feature.title}\n                className=\"rounded-xl border bg-background p-6 shadow-xs\"\n              >\n                <span className=\"flex size-10 items-center justify-center rounded-lg bg-primary/10\">\n                  <feature.icon className=\"size-5 text-primary dark:text-primary\" />\n                </span>\n                <h3 className=\"mt-5 font-semibold\">{feature.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              How a project works\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-primary dark:text-primary\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Our services\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                {\n                  \"A taste of what Designali creates for restaurants. Every project is scoped around your menu, your space and your guests.\"\n                }\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a key={item.name} href=\"#\" className=\"group\">\n                <div\n                  className={`relative aspect-[4/3] overflow-hidden rounded-2xl ${item.tile}`}\n                >\n                  <div className=\"absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10\" />\n                  <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-foreground backdrop-blur\">\n                    {item.tag}\n                  </span>\n                </div>\n                <div className=\"mt-4 flex items-start justify-between gap-4\">\n                  <div className=\"min-w-0\">\n                    <h3 className=\"font-medium \">{item.name}</h3>\n                    <p className=\"mt-1 text-sm text-muted-foreground\">\n                      {item.meta}\n                    </p>\n                  </div>\n                  <span className=\"shrink-0 text-sm font-semibold\">\n                    {item.price}\n                  </span>\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b \">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              What restaurant owners are saying\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-4 md:grid-cols-3\">\n            {testimonials.map((t, i) => (\n              <figure\n                key={t.name}\n                className={`flex flex-col justify-between rounded-2xl border bg-background p-6 ${i === 0 ? \"md:col-span-2 md:p-10\" : \"\"}`}\n              >\n                <Quote className=\"size-6 text-primary dark:text-primary\" />\n                <blockquote\n                  className={`mt-4 leading-relaxed ${i === 0 ? \"text-xl md:text-2xl\" : \"text-muted-foreground\"}`}\n                >\n                  {t.quote}\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 text-sm\">\n                  <span className=\"flex size-9 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Packages and support\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              {\n                \"Start with a menu refresh, go for a full brand, or keep Designali on for monthly updates.\"\n              }\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-primary shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-chart-2 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-primary dark:text-primary\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Good to know\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Contact us\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"px-6 py-20 md:py-28\">\n        <div className=\"relative mx-auto max-w-6xl overflow-hidden rounded-3xl border bg-primary/10 px-6 py-16 text-center md:py-24\">\n          <div className=\"pointer-events-none absolute -top-24 left-1/2 size-96 -translate-x-1/2 rounded-full bg-gradient-to-b from-primary/25 via-primary/10 to-transparent blur-3xl\" />\n          <div className=\"relative mx-auto max-w-2xl space-y-6\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Skip the guesswork this season\n            </h2>\n            <p className=\"text-lg text-muted-foreground\">\n              Book a discovery call and get a fixed-price scope.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Book a call\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Packaging work\n              </Button>\n            </div>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-chart-2 text-white text-sm\">\n                C\n              </span>\n              <span className=\"\">designali</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              Good design, every day.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} designali. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  return (\n    <div className=\"grid grid-cols-2 gap-3 md:grid-cols-3\">\n      {showcase.slice(0, 3).map((item, i) => (\n        <div\n          key={item.name}\n          className={`relative overflow-hidden rounded-2xl ${item.tile} ${i === 0 ? \"col-span-2 aspect-[16/10] md:col-span-1 md:aspect-[3/4]\" : \"aspect-[3/4]\"}`}\n        >\n          <div className=\"absolute inset-0 bg-gradient-to-t from-black/50 via-black/0 to-black/0\" />\n          <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-foreground backdrop-blur\">\n            {item.tag}\n          </span>\n          <div className=\"absolute inset-x-3 bottom-3 flex items-end justify-between gap-2 text-white\">\n            <div className=\"min-w-0\">\n              <div className=\"truncate text-sm font-medium\">{item.name}</div>\n              <div className=\"truncate text-xs text-white/75\">{item.meta}</div>\n            </div>\n            <div className=\"shrink-0 text-sm font-semibold\">{item.price}</div>\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n",
      "type": "registry:page",
      "target": "app/landing-restaurant-03/page.tsx"
    }
