      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  Check,\n  Clock,\n  Images,\n  MapPin,\n  Plus,\n  Sun,\n  Wand,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Work\", \"Services\", \"Packages\", \"Journal\", \"Contact\"]\n\nconst features = [\n  {\n    icon: Sun,\n    title: \"Light-first approach\",\n    description:\n      \"Shoots are planned around golden hour and the best available light for every location.\",\n  },\n  {\n    icon: Wand,\n    title: \"Hand retouching\",\n    description:\n      \"Every delivered image is colour-graded and retouched by hand, never with a one-click preset.\",\n  },\n  {\n    icon: Images,\n    title: \"Private galleries\",\n    description:\n      \"A beautiful online gallery to view, favourite, download and share with family.\",\n  },\n  {\n    icon: Clock,\n    title: \"Two-week delivery\",\n    description:\n      \"Sneak peeks within 48 hours and the full gallery within fourteen days.\",\n  },\n  {\n    icon: MapPin,\n    title: \"Travel anywhere\",\n    description:\n      \"Based in the city, available worldwide. Travel within 50 km is always included.\",\n  },\n]\n\nconst stats = [\n  { value: \"5.0\", label: \"Average client rating\" },\n  { value: \"18\", label: \"Countries shot in\" },\n  { value: \"9\", label: \"Industry awards\" },\n  { value: \"640+\", label: \"Sessions photographed\" },\n]\n\nconst steps = [\n  {\n    title: \"Enquire\",\n    description:\n      \"Tell us about your date, your plans and what you would love to remember.\",\n  },\n  {\n    title: \"Plan together\",\n    description:\n      \"A video call to choose locations, timings and the feel of your photographs.\",\n  },\n  {\n    title: \"The shoot\",\n    description:\n      \"Relaxed, guided and unhurried. Most people forget the camera after ten minutes.\",\n  },\n  {\n    title: \"Your gallery\",\n    description:\n      \"Sneak peeks in 48 hours and your full, retouched gallery within two weeks.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Lake Como Wedding\",\n    meta: \"Wedding · 640 images\",\n    tag: \"Wedding\",\n    price: \"2026\",\n    tile: \"bg-gradient-to-br from-emerald-200 via-green-300 to-lime-300 dark:from-emerald-700 dark:via-green-800 dark:to-lime-900\",\n  },\n  {\n    name: \"The Harlow Family\",\n    meta: \"Family · 85 images\",\n    tag: \"Family\",\n    price: \"2026\",\n    tile: \"bg-gradient-to-br from-stone-200 via-neutral-300 to-zinc-400 dark:from-stone-700 dark:via-neutral-800 dark:to-zinc-900\",\n  },\n  {\n    name: \"Atelier Moreau SS26\",\n    meta: \"Editorial · 42 images\",\n    tag: \"Editorial\",\n    price: \"2026\",\n    tile: \"bg-gradient-to-br from-rose-200 via-pink-300 to-purple-300 dark:from-rose-700 dark:via-pink-800 dark:to-purple-900\",\n  },\n  {\n    name: \"Coastal Elopement\",\n    meta: \"Elopement · 210 images\",\n    tag: \"Elopement\",\n    price: \"2025\",\n    tile: \"bg-gradient-to-br from-blue-200 via-indigo-300 to-violet-400 dark:from-blue-700 dark:via-indigo-800 dark:to-violet-900\",\n  },\n  {\n    name: \"Field Studio Team\",\n    meta: \"Headshots · 24 portraits\",\n    tag: \"Commercial\",\n    price: \"2025\",\n    tile: \"bg-gradient-to-br from-yellow-100 via-amber-200 to-orange-300 dark:from-yellow-700 dark:via-amber-800 dark:to-orange-900\",\n  },\n  {\n    name: \"Highland Portraits\",\n    meta: \"Portrait · 60 images\",\n    tag: \"Portrait\",\n    price: \"2025\",\n    tile: \"bg-gradient-to-br from-amber-200 via-orange-300 to-rose-400 dark:from-amber-700 dark:via-orange-800 dark:to-rose-900\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"The product shots were delivered early and were exactly on brief. Our conversion rate jumped noticeably.\",\n    name: \"Ines Moreau\",\n    role: \"Brand Lead, Atelier Moreau\",\n  },\n  {\n    quote:\n      \"Calm, kind and incredibly organised. We never once worried about timings on the day.\",\n    name: \"Sam and Priya\",\n    role: \"Wedding, Cornwall\",\n  },\n  {\n    quote:\n      \"The album is the most beautiful object in our home. Our kids already ask to look through it.\",\n    name: \"Hannah Brooks\",\n    role: \"Newborn session\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Portrait\",\n    price: \"$450\",\n    period: \"/session\",\n    description: \"A one-hour session for individuals or couples.\",\n    features: [\n      \"1 hour on location\",\n      \"40 retouched images\",\n      \"Private online gallery\",\n      \"Print release\",\n    ],\n    cta: \"Book a portrait\",\n  },\n  {\n    name: \"Family\",\n    price: \"$790\",\n    period: \"/session\",\n    description: \"Our most popular session for families.\",\n    features: [\n      \"2 hours, up to 2 locations\",\n      \"100 retouched images\",\n      \"48-hour sneak peek\",\n      \"Private online gallery\",\n      \"20x30 cm fine art print\",\n    ],\n    cta: \"Book a family session\",\n  },\n  {\n    name: \"Wedding\",\n    price: \"$3,800\",\n    period: \"/day\",\n    description: \"Full-day coverage for your wedding.\",\n    features: [\n      \"Up to 10 hours coverage\",\n      \"Second photographer\",\n      \"600+ retouched images\",\n      \"Engagement session\",\n      \"Lay-flat linen album\",\n    ],\n    cta: \"Check your date\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"Do you provide RAW files?\",\n    a: \"We deliver fully edited high-resolution images. RAW files are not included, as editing is part of the final work.\",\n  },\n  {\n    q: \"Is a deposit required?\",\n    a: \"A 30% deposit secures your date, with the balance due two weeks before the session.\",\n  },\n  {\n    q: \"Can we order prints later?\",\n    a: \"Yes. Your online gallery stays live for a year and includes a print shop with archival-quality products.\",\n  },\n  {\n    q: \"How far in advance should I book?\",\n    a: \"Weddings are usually booked 9 to 14 months ahead. Portrait and family sessions typically need two to four weeks.\",\n  },\n  {\n    q: \"What should we wear?\",\n    a: \"We send a styling guide after booking. Soft, neutral tones and comfortable layers photograph beautifully.\",\n  },\n]\n\nconst footer = [\n  { title: \"Work\", links: [\"Weddings\", \"Families\", \"Portraits\", \"Commercial\"] },\n  { title: \"Info\", links: [\"Packages\", \"Journal\", \"FAQ\", \"Gift cards\"] },\n  {\n    title: \"Contact\",\n    links: [\"Enquire\", \"Instagram\", \"Pinterest\", \"Newsletter\"],\n  },\n]\n\nexport default function LandingPhotography10() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-rose-600 text-white text-sm\">\n              P\n            </span>\n            <span className=\"font-serif text-lg font-normal\">\n              {\"Plate & Light\"}\n            </span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Check availability\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Book a shoot\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 pt-16 pb-12 md:pt-28\">\n          <div className=\"flex items-center justify-between border-b pb-4 text-xs tracking-widest text-muted-foreground uppercase\">\n            <span>Food and restaurant photography</span>\n            <span className=\"hidden sm:inline\">Food, beautifully lit.</span>\n          </div>\n          <h1 className=\"mt-12 max-w-5xl text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-8xl font-serif font-normal\">\n            {\"Make every dish look \"}\n            <span className=\"text-rose-600 dark:text-rose-400\">\n              as good as it tastes\n            </span>\n          </h1>\n          <div className=\"mt-12 grid gap-8 md:grid-cols-2 md:items-end\">\n            <p className=\"max-w-lg text-lg leading-8 text-muted-foreground\">\n              We photograph menus, cookbooks and restaurant interiors with\n              styling, props and lighting handled by our in-house team.\n            </p>\n            <div className=\"md:justify-self-end\">\n              <div className=\"flex flex-wrap gap-3 \">\n                <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                  Book a shoot\n                  <ArrowRight />\n                </Button>\n                <Button\n                  size=\"lg\"\n                  variant=\"outline\"\n                  nativeButton={false}\n                  render={<a href=\"#\" />}\n                >\n                  See the portfolio\n                </Button>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div className=\"mx-auto max-w-7xl px-6 pb-16\">\n          <HeroVisual />\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl grid-cols-2 px-6 lg:grid-cols-4\">\n          {stats.slice(0, 4).map((stat, i) => (\n            <div\n              key={stat.label}\n              className={`py-12 ${i > 0 ? \"lg:border-l lg:pl-8\" : \"\"} ${i % 2 === 1 ? \"border-l pl-6 lg:pl-8\" : \"\"} `}\n            >\n              <div className=\"text-4xl font-semibold tracking-tight md:text-5xl font-serif font-normal\">\n                {stat.value}\n              </div>\n              <div className=\"mt-2 text-sm text-muted-foreground\">\n                {stat.label}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.4fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <div className=\"max-w-2xl\">\n              <p className=\"text-sm font-medium text-rose-600 dark:text-rose-400\">\n                The experience\n              </p>\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal mt-3\">\n                Calm, considered and completely about you\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                From the first call to the final album, every step is designed\n                so you can relax and be yourself in front of the camera.\n              </p>\n            </div>\n          </div>\n          <div className=\"divide-y border-y\">\n            {features.map((feature, i) => (\n              <div\n                key={feature.title}\n                className=\"grid gap-4 py-8 sm:grid-cols-[4rem_1fr]\"\n              >\n                <span className=\"font-mono text-sm text-muted-foreground\">\n                  {String(i + 1).padStart(2, \"0\")}\n                </span>\n                <div>\n                  <h3 className=\"font-serif text-2xl\">{feature.title}</h3>\n                  <p className=\"mt-2 leading-7 text-muted-foreground\">\n                    {feature.description}\n                  </p>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal\">\n                Selected galleries\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                A small selection of recent work. Full galleries are shared\n                privately with each client on request.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a key={item.name} href=\"#\" className=\"group\">\n                <div\n                  className={`relative aspect-[4/3] overflow-hidden rounded-2xl ${item.tile}`}\n                >\n                  <div className=\"absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10\" />\n                  <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-zinc-900 backdrop-blur\">\n                    {item.tag}\n                  </span>\n                </div>\n                <div className=\"mt-4 flex items-start justify-between gap-4\">\n                  <div className=\"min-w-0\">\n                    <h3 className=\"font-medium font-serif text-lg\">\n                      {item.name}\n                    </h3>\n                    <p className=\"mt-1 text-sm text-muted-foreground\">\n                      {item.meta}\n                    </p>\n                  </div>\n                  <span className=\"shrink-0 text-sm font-semibold\">\n                    {item.price}\n                  </span>\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-5xl px-6 py-20 text-center md:py-28\">\n          <p className=\"text-sm tracking-widest text-muted-foreground uppercase\">\n            Kind words from clients\n          </p>\n          {testimonials.slice(0, 1).map((t) => (\n            <figure key={t.name} className=\"mt-10\">\n              <blockquote className=\"font-serif text-3xl leading-snug text-balance md:text-5xl\">\n                &ldquo;{t.quote}&rdquo;\n              </blockquote>\n              <figcaption className=\"mt-10 text-sm\">\n                <span className=\"font-medium\">{t.name}</span>\n                <span className=\"text-muted-foreground\"> · {t.role}</span>\n              </figcaption>\n            </figure>\n          ))}\n          <div className=\"mt-16 grid gap-6 border-t pt-12 text-left md:grid-cols-2\">\n            {testimonials.slice(1).map((t) => (\n              <figure key={t.name}>\n                <blockquote className=\"leading-7 text-muted-foreground\">\n                  &ldquo;{t.quote}&rdquo;\n                </blockquote>\n                <figcaption className=\"mt-4 text-sm font-medium\">\n                  {t.name}{\" \"}\n                  <span className=\"font-normal text-muted-foreground\">\n                    · {t.role}\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"max-w-2xl\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal\">\n              How a shoot works\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-foreground pt-6\"\n              >\n                <span className=\"text-sm font-medium text-rose-600 dark:text-rose-400\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal\">\n              Session packages\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Every package includes a planning call, professional retouching\n              and a private online gallery to download and share.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-rose-500 shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-rose-600 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-rose-600 dark:text-rose-400\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal\">\n              Before you book\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Get in touch\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"bg-foreground text-background\">\n        <div className=\"mx-auto flex max-w-7xl flex-col gap-10 px-6 py-20 md:flex-row md:items-end md:justify-between md:py-28\">\n          <div className=\"max-w-2xl\">\n            <h2 className=\"text-4xl font-semibold tracking-tight text-balance md:text-6xl font-serif font-normal\">\n              Your menu deserves better photos\n            </h2>\n            <p className=\"mt-5 text-lg text-background/65\">\n              Half-day and full-day packages with styled shots ready for print\n              and delivery apps.\n            </p>\n          </div>\n          <div className=\"flex flex-wrap gap-3 \">\n            <Button\n              size=\"lg\"\n              className=\"bg-background text-foreground hover:bg-background/90\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Book a shoot\n              <ArrowRight />\n            </Button>\n            <Button\n              size=\"lg\"\n              variant=\"outline\"\n              className=\"border-background/25 bg-transparent text-background hover:bg-background/10 hover:text-background\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              See the portfolio\n            </Button>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-rose-600 text-white text-sm\">\n                P\n              </span>\n              <span className=\"font-serif text-lg font-normal\">\n                {\"Plate & Light\"}\n              </span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              Food, beautifully lit.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} {\"Plate & Light\"}. All rights\n              reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  return (\n    <div className=\"grid grid-cols-2 gap-3 md:grid-cols-3\">\n      {showcase.slice(0, 3).map((item, i) => (\n        <div\n          key={item.name}\n          className={`relative overflow-hidden rounded-2xl ${item.tile} ${i === 0 ? \"col-span-2 aspect-[16/10] md:col-span-1 md:aspect-[3/4]\" : \"aspect-[3/4]\"}`}\n        >\n          <div className=\"absolute inset-0 bg-gradient-to-t from-black/50 via-black/0 to-black/0\" />\n          <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-zinc-900 backdrop-blur\">\n            {item.tag}\n          </span>\n          <div className=\"absolute inset-x-3 bottom-3 flex items-end justify-between gap-2 text-white\">\n            <div className=\"min-w-0\">\n              <div className=\"truncate text-sm font-medium\">{item.name}</div>\n              <div className=\"truncate text-xs text-white/75\">{item.meta}</div>\n            </div>\n            <div className=\"shrink-0 text-sm font-semibold\">{item.price}</div>\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n",
      "type": "registry:page",
