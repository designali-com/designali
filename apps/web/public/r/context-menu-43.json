{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "context-menu-43",
  "type": "registry:example",
  "description": "A cloud instance card whose available power actions depend on its running state.",
  "files": [
    {
      "path": "registry/designali/examples/context-menu/context-menu-43.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  Camera as CameraIcon,\n  Play as PlayIcon,\n  PowerOff as PowerOffIcon,\n  RotateCw as RotateCwIcon,\n  Server as ServerIcon,\n  Square as SquareIcon,\n  Terminal as TerminalIcon,\n} from \"@designali/icons\"\n\nimport { Badge } from \"@workspace/ui/components/badge\"\nimport {\n  ContextMenu,\n  ContextMenuContent,\n  ContextMenuGroup,\n  ContextMenuItem,\n  ContextMenuSeparator,\n  ContextMenuTrigger,\n} from \"@workspace/ui/components/context-menu\"\nimport { cn } from \"@workspace/ui/lib/utils\"\n\nexport default function CloudInstanceMenu() {\n  const [state, setState] = React.useState<\n    \"running\" | \"stopped\" | \"terminated\"\n  >(\"running\")\n\n  return (\n    <ContextMenu disabled={state === \"terminated\"}>\n      <ContextMenuTrigger className=\"flex w-full max-w-xs flex-col gap-3 border p-4 text-xs\">\n        <div className=\"flex items-center justify-between\">\n          <span className=\"flex items-center gap-2 font-medium\">\n            <ServerIcon className=\"size-4\" />\n            designali-web-03\n          </span>\n          <Badge\n            variant={\n              state === \"running\"\n                ? \"secondary\"\n                : state === \"terminated\"\n                  ? \"destructive\"\n                  : \"outline\"\n            }\n          >\n            <span\n              className={cn(\n                \"size-1.5 rounded-full\",\n                state === \"running\"\n                  ? \"bg-primary\"\n                  : state === \"stopped\"\n                    ? \"bg-primary\"\n                    : \"bg-destructive\"\n              )}\n            />\n            {state}\n          </Badge>\n        </div>\n        <dl className=\"grid grid-cols-2 gap-1 text-muted-foreground\">\n          <dt>Type</dt>\n          <dd className=\"text-foreground\">c6.large</dd>\n          <dt>Region</dt>\n          <dd className=\"text-foreground\">eu-west-2</dd>\n          <dt>IP</dt>\n          <dd className=\"font-sans text-foreground\">10.4.18.22</dd>\n        </dl>\n      </ContextMenuTrigger>\n      <ContextMenuContent className=\"w-48\">\n        <ContextMenuGroup>\n          <ContextMenuItem\n            disabled={state === \"running\"}\n            onClick={() => setState(\"running\")}\n          >\n            <PlayIcon />\n            Start\n          </ContextMenuItem>\n          <ContextMenuItem\n            disabled={state !== \"running\"}\n            onClick={() => setState(\"stopped\")}\n          >\n            <SquareIcon />\n            Stop\n          </ContextMenuItem>\n          <ContextMenuItem disabled={state !== \"running\"}>\n            <RotateCwIcon />\n            Reboot\n          </ContextMenuItem>\n        </ContextMenuGroup>\n        <ContextMenuSeparator />\n        <ContextMenuGroup>\n          <ContextMenuItem>\n            <TerminalIcon />\n            Copy SSH command\n          </ContextMenuItem>\n          <ContextMenuItem>\n            <CameraIcon />\n            Create snapshot\n          </ContextMenuItem>\n        </ContextMenuGroup>\n        <ContextMenuSeparator />\n        <ContextMenuGroup>\n          <ContextMenuItem\n            variant=\"destructive\"\n            onClick={() => setState(\"terminated\")}\n          >\n            <PowerOffIcon />\n            Terminate instance\n          </ContextMenuItem>\n        </ContextMenuGroup>\n      </ContextMenuContent>\n    </ContextMenu>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}