{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "gallery-06",
  "type": "registry:block",
  "description": "A masonry gallery of gradient frames laid out in responsive columns.",
  "dependencies": [],
  "registryDependencies": [],
  "files": [
    {
      "path": "registry/designali/blocks/gallery/gallery-06.tsx",
      "content": "const heights = [\n  \"h-64\",\n  \"h-96\",\n  \"h-72\",\n  \"h-80\",\n  \"h-56\",\n  \"h-96\",\n  \"h-64\",\n  \"h-72\",\n  \"h-80\",\n]\n\nconst photos = [\n  \"CGI study\",\n  \"3D render\",\n  \"Motion frame\",\n  \"Abstract form\",\n  \"Colour study\",\n  \"Light study\",\n  \"Texture study\",\n  \"Shape study\",\n  \"Gradient study\",\n]\n\nconst palette = [\n  \"var(--chart-1)\",\n  \"var(--chart-2)\",\n  \"var(--chart-3)\",\n  \"var(--chart-4)\",\n  \"var(--chart-5)\",\n]\n\nexport default function Gallery06() {\n  return (\n    <section className=\"w-full bg-muted/40 py-20\">\n      <div className=\"mx-auto max-w-6xl px-6\">\n        <div className=\"mb-10 max-w-xl\">\n          <p className=\"text-xs tracking-widest text-muted-foreground uppercase\">\n            Designali visuals\n          </p>\n          <h2 className=\"mt-3 text-3xl font-semibold tracking-tight md:text-4xl\">\n            CGI, 3D and motion by Ali Imam\n          </h2>\n        </div>\n        <div className=\"columns-1 gap-4 sm:columns-2 lg:columns-3\">\n          {photos.map((photo, i) => (\n            <figure\n              key={photo}\n              className=\"mb-4 break-inside-avoid border border-border bg-background p-2\"\n            >\n              <div\n                className={heights[i]}\n                style={{\n                  background: `url(\"/img/ask/ask${i + 1}.jpg\") center / cover, linear-gradient(${i * 40}deg, ${palette[i % 5]}, ${palette[(i + 2) % 5]})`,\n                }}\n              />\n              <figcaption className=\"flex justify-between px-1 pt-2 text-xs\">\n                <span>{photo}</span>\n                <span className=\"text-muted-foreground tabular-nums\">\n                  No. {String(i + 1).padStart(2, \"0\")}\n                </span>\n              </figcaption>\n            </figure>\n          ))}\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "700px"
  },
  "categories": [
    "gallery"
  ]
}