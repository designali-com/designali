{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "popover-45",
  "type": "registry:example",
  "description": "Filter builder popover that opens a nested popover to pick the date condition.",
  "files": [
    {
      "path": "registry/designali/examples/popover/popover-45.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport { CheckIcon, ChevronRightIcon, FilterIcon } from \"lucide-react\"\n\nimport { Badge } from \"@workspace/ui/components/badge\"\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  Popover,\n  PopoverContent,\n  PopoverTitle,\n  PopoverTrigger,\n} from \"@workspace/ui/components/popover\"\nimport { Separator } from \"@workspace/ui/components/separator\"\n\nconst ranges = [\"Today\", \"Last 7 days\", \"This month\", \"This quarter\"]\n\nexport default function NestedFilterPopover() {\n  const [range, setRange] = React.useState(\"Last 7 days\")\n  const [innerOpen, setInnerOpen] = React.useState(false)\n\n  return (\n    <Popover>\n      <PopoverTrigger render={<Button variant=\"outline\" size=\"sm\" />}>\n        <FilterIcon data-icon=\"inline-start\" /> Filters\n      </PopoverTrigger>\n      <PopoverContent className=\"w-72\" align=\"start\">\n        <PopoverTitle>Show tasks where</PopoverTitle>\n        <div className=\"flex items-center gap-2 text-xs\">\n          <span className=\"w-16 text-muted-foreground\">Created</span>\n          <Popover open={innerOpen} onOpenChange={setInnerOpen}>\n            <PopoverTrigger\n              render={\n                <Button\n                  variant=\"outline\"\n                  size=\"sm\"\n                  className=\"flex-1 justify-between\"\n                />\n              }\n            >\n              {range}\n              <ChevronRightIcon data-icon=\"inline-end\" />\n            </PopoverTrigger>\n            <PopoverContent\n              side=\"right\"\n              align=\"start\"\n              className=\"w-40 gap-0 p-1\"\n            >\n              {ranges.map((r) => (\n                <Button\n                  key={r}\n                  variant=\"ghost\"\n                  size=\"sm\"\n                  className=\"justify-between\"\n                  onClick={() => (setRange(r), setInnerOpen(false))}\n                >\n                  {r}\n                  {r === range && <CheckIcon />}\n                </Button>\n              ))}\n            </PopoverContent>\n          </Popover>\n        </div>\n        <div className=\"flex items-center gap-2 text-xs\">\n          <span className=\"w-16 text-muted-foreground\">Owner</span>\n          <Badge variant=\"secondary\">Me</Badge>\n        </div>\n        <Separator />\n        <Button size=\"sm\">Apply filters</Button>\n      </PopoverContent>\n    </Popover>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}