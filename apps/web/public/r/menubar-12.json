{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "menubar-12",
  "type": "registry:example",
  "description": "View-only document menubar where editing menus are disabled and a badge explains the state.",
  "files": [
    {
      "path": "registry/designali/examples/menubar/menubar-12.tsx",
      "content": "import {\n  CopyIcon,\n  DownloadIcon,\n  EyeIcon,\n  PencilIcon,\n  Trash2Icon,\n} from \"lucide-react\"\n\nimport { Badge } from \"@workspace/ui/components/badge\"\nimport {\n  Menubar,\n  MenubarContent,\n  MenubarGroup,\n  MenubarItem,\n  MenubarMenu,\n  MenubarTrigger,\n} from \"@workspace/ui/components/menubar\"\n\nexport default function ReadOnlyModeMenubar() {\n  return (\n    <div className=\"flex w-full max-w-sm items-center gap-2\">\n      <Menubar className=\"flex-1\">\n        <MenubarMenu>\n          <MenubarTrigger>File</MenubarTrigger>\n          <MenubarContent>\n            <MenubarGroup>\n              <MenubarItem>\n                <CopyIcon /> Make a copy\n              </MenubarItem>\n              <MenubarItem>\n                <DownloadIcon /> Download\n              </MenubarItem>\n              <MenubarItem disabled>\n                <PencilIcon /> Rename\n              </MenubarItem>\n              <MenubarItem disabled variant=\"destructive\">\n                <Trash2Icon /> Move to trash\n              </MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu disabled>\n          <MenubarTrigger className=\"data-disabled:opacity-50\">\n            Edit\n          </MenubarTrigger>\n          <MenubarContent>\n            <MenubarGroup>\n              <MenubarItem>Undo</MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu disabled>\n          <MenubarTrigger className=\"data-disabled:opacity-50\">\n            Insert\n          </MenubarTrigger>\n          <MenubarContent>\n            <MenubarGroup>\n              <MenubarItem>Image</MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n      </Menubar>\n      <Badge variant=\"secondary\">\n        <EyeIcon data-icon=\"inline-start\" />\n        View only\n      </Badge>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}