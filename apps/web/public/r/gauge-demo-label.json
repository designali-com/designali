  "files": [
    {
      "path": "registry/designali/components/gauge/gauge-demo-label.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\n\nimport {\n  Gauge,\n  GaugeIndicator,\n  GaugeLabel,\n  GaugeRange,\n  GaugeTrack,\n  GaugeValueText,\n} from \"@/registry/designali/ui/gauge\"\n\nexport function GaugeDemoLabel() {\n  return (\n    <div className=\"flex flex-col items-center gap-4\">\n      <Gauge value={78} size={190}>\n        <GaugeIndicator>\n          <GaugeTrack />\n          <GaugeRange />\n        </GaugeIndicator>\n\n        <GaugeValueText />\n      </Gauge>\n\n      <GaugeLabel>Muscle Health</GaugeLabel>\n    </div>\n  )\n}\n",
      "type": "registry:component"
    }
  ]
}