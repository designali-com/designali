  "files": [
    {
      "path": "registry/designali/examples/label/label-08.tsx",
      "content": "import { Input } from \"@workspace/ui/components/input\"\nimport { Label } from \"@workspace/ui/components/label\"\n\nexport default function LabelWithForgotLink() {\n  return (\n    <div className=\"grid w-full max-w-sm gap-2\">\n      <div className=\"flex items-center justify-between\">\n        <Label htmlFor=\"login-password\">Password</Label>\n        <a\n          href=\"#\"\n          className=\"text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline\"\n        >\n          Forgot password?\n        </a>\n      </div>\n      <Input id=\"login-password\" type=\"password\" defaultValue=\"designali-2-code\" />\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}