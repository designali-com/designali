{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "menubar-41",
  "type": "registry:example",
  "description": "Billing invoice menubar whose actions update the invoice status badge, including a destructive void.",
  "files": [
    {
      "path": "registry/designali/examples/menubar/menubar-41.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  BadgeCheck as BadgeCheckIcon,\n  Ban as BanIcon,\n  Copy as CopyIcon,\n  Download as DownloadIcon,\n  RotateCcw as RotateCcwIcon,\n  Send as SendIcon,\n} from \"@designali/icons\"\n\nimport { Badge } from \"@workspace/ui/components/badge\"\nimport {\n  Menubar,\n  MenubarContent,\n  MenubarGroup,\n  MenubarItem,\n  MenubarMenu,\n  MenubarSeparator,\n  MenubarTrigger,\n} from \"@workspace/ui/components/menubar\"\n\nexport default function InvoiceActionsMenubar() {\n  const [status, setStatus] = React.useState<\n    \"Draft\" | \"Sent\" | \"Paid\" | \"Void\"\n  >(\"Draft\")\n\n  return (\n    <div className=\"w-full max-w-sm border\">\n      <div className=\"flex items-center justify-between border-b p-3\">\n        <div>\n          <p className=\"text-sm font-medium\">INV-2026-0187</p>\n          <p className=\"text-xs text-muted-foreground\">\n            Designali client · $2,340.00\n          </p>\n        </div>\n        <Badge\n          variant={\n            status === \"Void\"\n              ? \"destructive\"\n              : status === \"Paid\"\n                ? \"default\"\n                : \"secondary\"\n          }\n        >\n          {status}\n        </Badge>\n      </div>\n      <Menubar className=\"border-0\">\n        <MenubarMenu>\n          <MenubarTrigger>Invoice</MenubarTrigger>\n          <MenubarContent className=\"w-52\">\n            <MenubarGroup>\n              <MenubarItem\n                disabled={status !== \"Draft\"}\n                onClick={() => setStatus(\"Sent\")}\n              >\n                <SendIcon /> Send to customer\n              </MenubarItem>\n              <MenubarItem\n                disabled={status !== \"Sent\"}\n                onClick={() => setStatus(\"Paid\")}\n              >\n                <BadgeCheckIcon /> Mark as paid\n              </MenubarItem>\n              <MenubarItem>\n                <CopyIcon /> Duplicate\n              </MenubarItem>\n              <MenubarItem>\n                <DownloadIcon /> Download PDF\n              </MenubarItem>\n            </MenubarGroup>\n            <MenubarSeparator />\n            <MenubarGroup>\n              <MenubarItem\n                variant=\"destructive\"\n                disabled={status === \"Void\" || status === \"Paid\"}\n                onClick={() => setStatus(\"Void\")}\n              >\n                <BanIcon /> Void invoice\n              </MenubarItem>\n              <MenubarItem\n                disabled={status === \"Draft\"}\n                onClick={() => setStatus(\"Draft\")}\n              >\n                <RotateCcwIcon /> Reset demo\n              </MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>Payments</MenubarTrigger>\n          <MenubarContent>\n            <MenubarGroup>\n              <MenubarItem>Record payment</MenubarItem>\n              <MenubarItem>Set up reminders</MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n      </Menubar>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}