  "files": [
    {
      "path": "registry/designali/pages/app/landing-app-10/page.tsx",
      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  Bell,\n  Check,\n  Lock,\n  Moon,\n  Plus,\n  RefreshCw,\n  Watch,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Features\", \"How it works\", \"Reviews\", \"Pricing\", \"Support\"]\n\nconst features = [\n  {\n    icon: Bell,\n    title: \"Gentle reminders\",\n    description:\n      \"Notifications that respect focus modes and never nag. Snooze, reschedule or skip with a swipe.\",\n  },\n  {\n    icon: Lock,\n    title: \"Private by default\",\n    description:\n      \"Your data stays on your device and is end-to-end encrypted when it syncs. We never sell it.\",\n  },\n  {\n    icon: RefreshCw,\n    title: \"Seamless sync\",\n    description:\n      \"Start on your phone and pick up on your tablet or laptop. Changes appear in under a second.\",\n  },\n  {\n    icon: Watch,\n    title: \"Apple Watch and Wear OS\",\n    description:\n      \"Glanceable complications and quick actions right on your wrist.\",\n  },\n  {\n    icon: Moon,\n    title: \"Beautiful dark mode\",\n    description:\n      \"Hand-tuned themes for day and night, plus custom app icons and accent colours.\",\n  },\n]\n\nconst stats = [\n  { value: \"42\", label: \"Languages supported\" },\n  { value: \"#1\", label: \"In 18 countries\" },\n  { value: \"11 min\", label: \"Saved per user daily\" },\n  { value: \"3.2M\", label: \"Downloads\" },\n]\n\nconst steps = [\n  {\n    title: \"Download the app\",\n    description:\n      \"Free on the App Store and Google Play. No account needed to try it.\",\n  },\n  {\n    title: \"Pick your goals\",\n    description:\n      \"Answer three quick questions and we tailor the experience to you.\",\n  },\n  {\n    title: \"Add your first item\",\n    description:\n      \"Use the quick-add button, a widget, Siri or a share sheet from any app.\",\n  },\n  {\n    title: \"Build the habit\",\n    description:\n      \"Weekly insights show your progress and keep you gently on track.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Home screen widgets\",\n    meta: \"Small, medium and large sizes\",\n    tag: \"iOS and Android\",\n    price: \"Free\",\n  },\n  {\n    name: \"Lock screen glance\",\n    meta: \"See today at a glance\",\n    tag: \"iOS 17+\",\n    price: \"Free\",\n  },\n  {\n    name: \"Watch app\",\n    meta: \"Quick actions on your wrist\",\n    tag: \"watchOS\",\n    price: \"Premium\",\n  },\n  {\n    name: \"Siri and Shortcuts\",\n    meta: \"Hands-free logging\",\n    tag: \"Voice\",\n    price: \"Free\",\n  },\n  {\n    name: \"Weekly insights\",\n    meta: \"Trends and streaks\",\n    tag: \"Insights\",\n    price: \"Premium\",\n  },\n  {\n    name: \"Family spaces\",\n    meta: \"Share with up to five people\",\n    tag: \"Family\",\n    price: \"Family\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"Our whole family uses the shared space. It replaced a fridge full of sticky notes.\",\n    name: \"Carlos Mendes\",\n    role: \"Family plan user\",\n  },\n  {\n    quote:\n      \"I love that it works offline. I use it on the subway every morning without a hiccup.\",\n    name: \"Emily Shaw\",\n    role: \"App Store review\",\n  },\n  {\n    quote:\n      \"Small details everywhere. You can tell the team obsesses over making it feel right.\",\n    name: \"Andre Silva\",\n    role: \"Designer, longtime user\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Free\",\n    price: \"$0\",\n    period: \"\",\n    description: \"Everything you need to get started.\",\n    features: [\n      \"Core features\",\n      \"Sync across 2 devices\",\n      \"Home screen widgets\",\n      \"Dark mode\",\n    ],\n    cta: \"Download free\",\n  },\n  {\n    name: \"Premium\",\n    price: \"$4.99\",\n    period: \"/month\",\n    description: \"For people who want the full experience.\",\n    features: [\n      \"Unlimited devices\",\n      \"Weekly insights\",\n      \"Watch app\",\n      \"Custom themes and icons\",\n      \"Priority support\",\n    ],\n    cta: \"Try 7 days free\",\n  },\n  {\n    name: \"Family\",\n    price: \"$7.99\",\n    period: \"/month\",\n    description: \"Premium for up to six people.\",\n    features: [\n      \"Everything in Premium\",\n      \"Up to 6 members\",\n      \"Shared spaces\",\n      \"Parental controls\",\n      \"One simple bill\",\n    ],\n    cta: \"Start family plan\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"Do you sell my data?\",\n    a: \"Never. We make money from subscriptions, not advertising. Your data is encrypted and stays yours.\",\n  },\n  {\n    q: \"Can I use it without an account?\",\n    a: \"Yes. Accounts are only needed to sync between devices or share with family members.\",\n  },\n  {\n    q: \"How do I cancel Premium?\",\n    a: \"Cancel any time from your App Store or Google Play subscription settings. You keep Premium until the period ends.\",\n  },\n  {\n    q: \"Is the app really free?\",\n    a: \"Yes. The free plan has no ads and no time limit. Premium adds advanced features for people who want more.\",\n  },\n  {\n    q: \"Which devices are supported?\",\n    a: \"iPhone and iPad on iOS 16 or later, Android 10 or later, Apple Watch, Wear OS and any modern web browser.\",\n  },\n]\n\nconst footer = [\n  { title: \"App\", links: [\"Features\", \"Premium\", \"Download\", \"What is new\"] },\n  { title: \"Company\", links: [\"About\", \"Blog\", \"Press kit\", \"Careers\"] },\n  { title: \"Help\", links: [\"Support\", \"Privacy\", \"Terms\", \"Contact\"] },\n]\n\nexport default function LandingApp10() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-fuchsia-600 text-white text-sm\">\n              P\n            </span>\n            <span className=\"font-serif text-lg font-normal\">Pagecraft</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Log in\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Get the app\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 pt-16 pb-12 md:pt-28\">\n          <div className=\"flex items-center justify-between border-b pb-4 text-xs tracking-widest text-muted-foreground uppercase\">\n            <span>For people who love books</span>\n            <span className=\"hidden sm:inline\">\n              A home for your reading life.\n            </span>\n          </div>\n          <h1 className=\"mt-12 max-w-5xl text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-8xl font-serif font-normal\">\n            {\"Read more books and \"}\n            <span className=\"text-fuchsia-600 dark:text-fuchsia-400\">\n              remember them\n            </span>\n          </h1>\n          <div className=\"mt-12 grid gap-8 md:grid-cols-2 md:items-end\">\n            <p className=\"max-w-lg text-lg leading-8 text-muted-foreground\">\n              Pagecraft tracks your reading, saves highlights and quotes, and\n              brings small book clubs together around one shared shelf.\n            </p>\n            <div className=\"md:justify-self-end\">\n              <div className=\"flex flex-wrap gap-3 \">\n                <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                  Get the app\n                  <ArrowRight />\n                </Button>\n                <Button\n                  size=\"lg\"\n                  variant=\"outline\"\n                  nativeButton={false}\n                  render={<a href=\"#\" />}\n                >\n                  Start a book club\n                </Button>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div className=\"mx-auto max-w-7xl px-6 pb-16\">\n          <HeroVisual />\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl grid-cols-2 px-6 lg:grid-cols-4\">\n          {stats.slice(0, 4).map((stat, i) => (\n            <div\n              key={stat.label}\n              className={`py-12 ${i > 0 ? \"lg:border-l lg:pl-8\" : \"\"} ${i % 2 === 1 ? \"border-l pl-6 lg:pl-8\" : \"\"} `}\n            >\n              <div className=\"text-4xl font-semibold tracking-tight md:text-5xl font-serif font-normal\">\n                {stat.value}\n              </div>\n              <div className=\"mt-2 text-sm text-muted-foreground\">\n                {stat.label}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.4fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <div className=\"max-w-2xl\">\n              <p className=\"text-sm font-medium text-fuchsia-600 dark:text-fuchsia-400\">\n                Features\n              </p>\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal mt-3\">\n                Designed to fit into your day, not take it over\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                Thoughtful features, quick to learn and fast to use, on iPhone,\n                Android and the web.\n              </p>\n            </div>\n          </div>\n          <div className=\"divide-y border-y\">\n            {features.map((feature, i) => (\n              <div\n                key={feature.title}\n                className=\"grid gap-4 py-8 sm:grid-cols-[4rem_1fr]\"\n              >\n                <span className=\"font-mono text-sm text-muted-foreground\">\n                  {String(i + 1).padStart(2, \"0\")}\n                </span>\n                <div>\n                  <h3 className=\"font-serif text-2xl\">{feature.title}</h3>\n                  <p className=\"mt-2 leading-7 text-muted-foreground\">\n                    {feature.description}\n                  </p>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal\">\n                Made for every moment\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                Widgets, watch complications and shortcuts put the most useful\n                parts one tap away.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a\n                key={item.name}\n                href=\"#\"\n                className=\"group flex flex-col rounded-xl border p-6 transition-colors hover:bg-muted/40\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"flex size-10 items-center justify-center rounded-lg border bg-muted/50 font-semibold \">\n                    {item.name.charAt(0)}\n                  </span>\n                  <span className=\"rounded-full bg-fuchsia-500/10 px-2.5 py-0.5 text-xs font-medium text-fuchsia-600 dark:text-fuchsia-400\">\n                    {item.tag}\n                  </span>\n                </div>\n                <h3 className=\"mt-6 font-semibold \">{item.name}</h3>\n                <p className=\"mt-1 flex-1 text-sm text-muted-foreground\">\n                  {item.meta}\n                </p>\n                <div className=\"mt-6 flex items-center justify-between border-t pt-4 text-sm\">\n                  <span className=\"font-medium\">{item.price}</span>\n                  <ArrowUpRight className=\"size-4 text-muted-foreground transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5\" />\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-5xl px-6 py-20 text-center md:py-28\">\n          <p className=\"text-sm tracking-widest text-muted-foreground uppercase\">\n            Loved by people who hate most apps\n          </p>\n          {testimonials.slice(0, 1).map((t) => (\n            <figure key={t.name} className=\"mt-10\">\n              <blockquote className=\"font-serif text-3xl leading-snug text-balance md:text-5xl\">\n                &ldquo;{t.quote}&rdquo;\n              </blockquote>\n              <figcaption className=\"mt-10 text-sm\">\n                <span className=\"font-medium\">{t.name}</span>\n                <span className=\"text-muted-foreground\"> · {t.role}</span>\n              </figcaption>\n            </figure>\n          ))}\n          <div className=\"mt-16 grid gap-6 border-t pt-12 text-left md:grid-cols-2\">\n            {testimonials.slice(1).map((t) => (\n              <figure key={t.name}>\n                <blockquote className=\"leading-7 text-muted-foreground\">\n                  &ldquo;{t.quote}&rdquo;\n                </blockquote>\n                <figcaption className=\"mt-4 text-sm font-medium\">\n                  {t.name}{\" \"}\n                  <span className=\"font-normal text-muted-foreground\">\n                    · {t.role}\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"max-w-2xl\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal\">\n              Get started in three minutes\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-foreground pt-6\"\n              >\n                <span className=\"text-sm font-medium text-fuchsia-600 dark:text-fuchsia-400\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal\">\n              Free to start. Premium when you want more.\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              The core app is free forever. Premium unlocks advanced features\n              and supports an independent team.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-fuchsia-500 shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-fuchsia-600 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-fuchsia-600 dark:text-fuchsia-400\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal\">\n              Frequently asked\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Get in touch\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"bg-foreground text-background\">\n        <div className=\"mx-auto flex max-w-7xl flex-col gap-10 px-6 py-20 md:flex-row md:items-end md:justify-between md:py-28\">\n          <div className=\"max-w-2xl\">\n            <h2 className=\"text-4xl font-semibold tracking-tight text-balance md:text-6xl font-serif font-normal\">\n              Your next great book is one tap away\n            </h2>\n            <p className=\"mt-5 text-lg text-background/65\">\n              Free on iOS and Android. Import your shelf from Goodreads in a\n              minute.\n            </p>\n          </div>\n          <div className=\"flex flex-wrap gap-3 \">\n            <Button\n              size=\"lg\"\n              className=\"bg-background text-foreground hover:bg-background/90\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Get the app\n              <ArrowRight />\n            </Button>\n            <Button\n              size=\"lg\"\n              variant=\"outline\"\n              className=\"border-background/25 bg-transparent text-background hover:bg-background/10 hover:text-background\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Start a book club\n            </Button>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-fuchsia-600 text-white text-sm\">\n                P\n              </span>\n              <span className=\"font-serif text-lg font-normal\">Pagecraft</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              A home for your reading life.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Pagecraft. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  const bars = [38, 52, 44, 63, 58, 71, 66, 80, 74, 88, 83, 95]\n  return (\n    <div className=\"overflow-hidden rounded-xl border bg-card text-left text-card-foreground shadow-2xl/10\">\n      <div className=\"flex items-center gap-2 border-b px-4 py-3\">\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"ml-3 hidden rounded-md bg-muted px-3 py-0.5 text-[11px] text-muted-foreground sm:inline\">\n          app.pagecraft.com\n        </span>\n      </div>\n      <div className=\"grid md:grid-cols-[180px_1fr]\">\n        <aside className=\"hidden space-y-1 border-r p-3 text-sm md:block\">\n          {navLinks.map((link, i) => (\n            <div\n              key={link}\n              className={`rounded-md px-3 py-1.5 ${i === 0 ? \"bg-muted font-medium\" : \"text-muted-foreground\"}`}\n            >\n              {link}\n            </div>\n          ))}\n        </aside>\n        <div className=\"space-y-4 p-4 md:p-6\">\n          <div className=\"grid grid-cols-2 gap-3 lg:grid-cols-4\">\n            {stats.slice(0, 4).map((stat) => (\n              <div key={stat.label} className=\"rounded-lg border p-3\">\n                <div className=\"truncate text-[11px] text-muted-foreground\">\n                  {stat.label}\n                </div>\n                <div className=\"mt-1 text-lg font-semibold tracking-tight\">\n                  {stat.value}\n                </div>\n              </div>\n            ))}\n          </div>\n          <div className=\"rounded-lg border p-4\">\n            <div className=\"mb-4 flex items-center justify-between text-xs\">\n              <span className=\"font-medium\">Last 12 weeks</span>\n              <span className=\"text-fuchsia-600 dark:text-fuchsia-400\">\n                +24.6%\n              </span>\n            </div>\n            <div className=\"flex h-32 items-end gap-1.5\">\n              {bars.map((h, i) => (\n                <div\n                  key={i}\n                  className={`flex-1 rounded-t-sm ${i === bars.length - 1 ? \"bg-fuchsia-600\" : \"bg-muted-foreground/20\"}`}\n                  style={{ height: `${h}%` }}\n                />\n              ))}\n            </div>\n          </div>\n          <div className=\"hidden divide-y rounded-lg border sm:block\">\n            {showcase.slice(0, 3).map((item) => (\n              <div\n                key={item.name}\n                className=\"flex items-center justify-between gap-4 px-4 py-2.5 text-sm\"\n              >\n                <div className=\"min-w-0\">\n                  <div className=\"truncate font-medium\">{item.name}</div>\n                  <div className=\"truncate text-xs text-muted-foreground\">\n                    {item.meta}\n                  </div>\n                </div>\n                <span className=\"shrink-0 rounded-full bg-fuchsia-500/10 px-2 py-0.5 text-[11px] font-medium text-fuchsia-600 dark:text-fuchsia-400\">\n                  {item.tag}\n                </span>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n    </div>\n  )\n}\n",
