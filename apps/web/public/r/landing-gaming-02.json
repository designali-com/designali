  "files": [
    {
      "path": "registry/designali/pages/gaming/landing-gaming-02/page.tsx",
      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  Check,\n  Cpu,\n  Map,\n  Plus,\n  RefreshCw,\n  Trophy,\n  Users,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Game\", \"Editions\", \"Roadmap\", \"Community\", \"Press\"]\n\nconst features = [\n  {\n    icon: Map,\n    title: \"Hand-crafted open world\",\n    description:\n      \"Six regions built by hand, with dungeons, side stories and secrets you will still be finding a year from now.\",\n  },\n  {\n    icon: Users,\n    title: \"Four-player co-op\",\n    description:\n      \"Drop in and out of a friend's campaign at any time, with shared loot and scaling difficulty.\",\n  },\n  {\n    icon: Trophy,\n    title: \"Ranked seasons\",\n    description:\n      \"Climb from Bronze to Apex in eight-week seasons with skill-based matchmaking and exclusive cosmetic rewards.\",\n  },\n  {\n    icon: Cpu,\n    title: \"Runs at 120 FPS\",\n    description:\n      \"Optimised for current consoles and mid-range PCs, with DLSS, FSR and full ultrawide support.\",\n  },\n  {\n    icon: RefreshCw,\n    title: \"Cross-progression\",\n    description:\n      \"Start on console, continue on PC or Steam Deck. Your saves, unlocks and friends follow you everywhere.\",\n  },\n]\n\nconst stats = [\n  { value: \"94%\", label: \"Positive reviews on Steam\" },\n  { value: \"60+\", label: \"Hours of campaign content\" },\n  { value: \"18\", label: \"Languages supported\" },\n  { value: \"$1.5M\", label: \"Tournament prize pool\" },\n]\n\nconst steps = [\n  {\n    title: \"Create your character\",\n    description:\n      \"Pick from five classes and shape your look, voice and backstory in a detailed creator.\",\n  },\n  {\n    title: \"Survive the prologue\",\n    description:\n      \"A tight two-hour opening teaches every system without a single tutorial pop-up.\",\n  },\n  {\n    title: \"Find your squad\",\n    description:\n      \"Invite friends or use in-game matchmaking to form a party of up to four players.\",\n  },\n  {\n    title: \"Enter ranked\",\n    description:\n      \"Unlock ranked after level 20 and start climbing the seasonal ladder.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"The Ashen Coast\",\n    meta: \"Starting region · Levels 1-15\",\n    tag: \"Act I\",\n    price: \"8 hrs\",\n    tile: \"bg-gradient-to-br from-blue-200 via-indigo-300 to-violet-400 dark:from-blue-700 dark:via-indigo-800 dark:to-violet-900\",\n  },\n  {\n    name: \"Hollow Peaks\",\n    meta: \"Frozen highlands · Levels 15-30\",\n    tag: \"Act II\",\n    price: \"12 hrs\",\n    tile: \"bg-gradient-to-br from-yellow-100 via-amber-200 to-orange-300 dark:from-yellow-700 dark:via-amber-800 dark:to-orange-900\",\n  },\n  {\n    name: \"Verdant Deep\",\n    meta: \"Overgrown ruins · Levels 30-45\",\n    tag: \"Act III\",\n    price: \"14 hrs\",\n    tile: \"bg-gradient-to-br from-amber-200 via-orange-300 to-rose-400 dark:from-amber-700 dark:via-orange-800 dark:to-rose-900\",\n  },\n  {\n    name: \"The Iron Citadel\",\n    meta: \"Raid dungeon · 4 players\",\n    tag: \"Raid\",\n    price: \"3 hrs\",\n    tile: \"bg-gradient-to-br from-sky-200 via-cyan-300 to-teal-400 dark:from-sky-700 dark:via-cyan-800 dark:to-teal-900\",\n  },\n  {\n    name: \"Duskmarket\",\n    meta: \"Social hub · Trading and crafting\",\n    tag: \"Hub\",\n    price: \"Free\",\n    tile: \"bg-gradient-to-br from-violet-200 via-purple-300 to-fuchsia-400 dark:from-violet-700 dark:via-purple-800 dark:to-fuchsia-900\",\n  },\n  {\n    name: \"The Rift\",\n    meta: \"Endgame arena · Ranked only\",\n    tag: \"Season 3\",\n    price: \"Ranked\",\n    tile: \"bg-gradient-to-br from-emerald-200 via-green-300 to-lime-300 dark:from-emerald-700 dark:via-green-800 dark:to-lime-900\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"I have put 200 hours in and I am still discovering new areas. The world design is genuinely remarkable.\",\n    name: \"Mika Tanaka\",\n    role: \"Steam reviewer, 214 hours played\",\n  },\n  {\n    quote:\n      \"Co-op is seamless. My friends join mid-dungeon and the difficulty just adjusts. No lobbies, no waiting.\",\n    name: \"Luis Ortega\",\n    role: \"Streamer, 180K followers\",\n  },\n  {\n    quote:\n      \"Finally a ranked mode that feels fair. The matchmaking is tight and the seasons give you a reason to come back.\",\n    name: \"Aisha Bello\",\n    role: \"Pro player, Team Vortex\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Standard\",\n    price: \"$39\",\n    period: \"one-time\",\n    description: \"The complete base game.\",\n    features: [\n      \"Full campaign\",\n      \"Online co-op\",\n      \"Ranked seasons\",\n      \"Free seasonal updates\",\n    ],\n    cta: \"Buy Standard\",\n  },\n  {\n    name: \"Deluxe\",\n    price: \"$59\",\n    period: \"one-time\",\n    description: \"The game plus year-one content.\",\n    features: [\n      \"Everything in Standard\",\n      \"Year 1 expansion pass\",\n      \"Digital soundtrack\",\n      \"Exclusive armour set\",\n      \"72-hour early access\",\n    ],\n    cta: \"Buy Deluxe\",\n  },\n  {\n    name: \"Collector's\",\n    price: \"$149\",\n    period: \"one-time\",\n    description: \"For the most dedicated players.\",\n    features: [\n      \"Everything in Deluxe\",\n      \"30 cm resin statue\",\n      \"Hardcover art book\",\n      \"Steelbook case\",\n      \"Cloth world map\",\n    ],\n    cta: \"Pre-order now\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"Is there cross-play?\",\n    a: \"Yes. Co-op and ranked matchmaking work across all platforms, and you can opt out at any time.\",\n  },\n  {\n    q: \"Are there microtransactions?\",\n    a: \"Only optional cosmetics. Nothing that affects gameplay, power or progression is ever sold.\",\n  },\n  {\n    q: \"Can I play solo?\",\n    a: \"Absolutely. The full campaign is designed for solo play, with co-op as an optional extra.\",\n  },\n  {\n    q: \"What are the minimum PC requirements?\",\n    a: \"A GTX 1660 or RX 5600, 16 GB of RAM and an SSD with 70 GB of free space.\",\n  },\n  {\n    q: \"When does early access start?\",\n    a: \"Deluxe and Collector's owners can start playing 72 hours before the global launch.\",\n  },\n]\n\nconst footer = [\n  {\n    title: \"Game\",\n    links: [\"Editions\", \"Roadmap\", \"Patch notes\", \"System requirements\"],\n  },\n  {\n    title: \"Community\",\n    links: [\"Discord\", \"Forums\", \"Creator program\", \"Esports\"],\n  },\n  { title: \"Studio\", links: [\"About\", \"Careers\", \"Press kit\", \"Support\"] },\n]\n\nexport default function LandingGaming02() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-sky-600 text-white text-sm\">\n              P\n            </span>\n            <span className=\"font-serif text-lg font-normal\">Pixelhearth</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Join Discord\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Wishlist now\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 pt-16 pb-12 md:pt-28\">\n          <div className=\"flex items-center justify-between border-b pb-4 text-xs tracking-widest text-muted-foreground uppercase\">\n            <span>Wishlist on Steam</span>\n            <span className=\"hidden sm:inline\">\n              Handmade games from a small studio.\n            </span>\n          </div>\n          <h1 className=\"mt-12 max-w-5xl text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-8xl font-serif font-normal\">\n            {\"Cosy games made by a \"}\n            <span className=\"text-sky-600 dark:text-sky-400\">tiny studio</span>\n          </h1>\n          <div className=\"mt-12 grid gap-8 md:grid-cols-2 md:items-end\">\n            <p className=\"max-w-lg text-lg leading-8 text-muted-foreground\">\n              We are a six-person studio making warm, handmade games about\n              farming, friendship and finding home. Our next one arrives this\n              spring.\n            </p>\n            <div className=\"md:justify-self-end\">\n              <div className=\"flex flex-wrap gap-3 \">\n                <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                  Wishlist now\n                  <ArrowRight />\n                </Button>\n                <Button\n                  size=\"lg\"\n                  variant=\"outline\"\n                  nativeButton={false}\n                  render={<a href=\"#\" />}\n                >\n                  Play the demo\n                </Button>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div className=\"mx-auto max-w-7xl px-6 pb-16\">\n          <HeroVisual />\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl grid-cols-2 px-6 lg:grid-cols-4\">\n          {stats.slice(0, 4).map((stat, i) => (\n            <div\n              key={stat.label}\n              className={`py-12 ${i > 0 ? \"lg:border-l lg:pl-8\" : \"\"} ${i % 2 === 1 ? \"border-l pl-6 lg:pl-8\" : \"\"} `}\n            >\n              <div className=\"text-4xl font-semibold tracking-tight md:text-5xl font-serif font-normal\">\n                {stat.value}\n              </div>\n              <div className=\"mt-2 text-sm text-muted-foreground\">\n                {stat.label}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.4fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <div className=\"max-w-2xl\">\n              <p className=\"text-sm font-medium text-sky-600 dark:text-sky-400\">\n                Gameplay\n              </p>\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal mt-3\">\n                Built for the long session\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                Deep systems, hand-crafted worlds and a combat loop that rewards\n                practice, whether you play for twenty minutes or all night.\n              </p>\n            </div>\n          </div>\n          <div className=\"divide-y border-y\">\n            {features.map((feature, i) => (\n              <div\n                key={feature.title}\n                className=\"grid gap-4 py-8 sm:grid-cols-[4rem_1fr]\"\n              >\n                <span className=\"font-mono text-sm text-muted-foreground\">\n                  {String(i + 1).padStart(2, \"0\")}\n                </span>\n                <div>\n                  <h3 className=\"font-serif text-2xl\">{feature.title}</h3>\n                  <p className=\"mt-2 leading-7 text-muted-foreground\">\n                    {feature.description}\n                  </p>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal\">\n                Explore the worlds\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                Every region has its own factions, music and secrets. Here is a\n                first look at where your journey begins.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a key={item.name} href=\"#\" className=\"group\">\n                <div\n                  className={`relative aspect-[4/3] overflow-hidden rounded-2xl ${item.tile}`}\n                >\n                  <div className=\"absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10\" />\n                  <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-zinc-900 backdrop-blur\">\n                    {item.tag}\n                  </span>\n                </div>\n                <div className=\"mt-4 flex items-start justify-between gap-4\">\n                  <div className=\"min-w-0\">\n                    <h3 className=\"font-medium font-serif text-lg\">\n                      {item.name}\n                    </h3>\n                    <p className=\"mt-1 text-sm text-muted-foreground\">\n                      {item.meta}\n                    </p>\n                  </div>\n                  <span className=\"shrink-0 text-sm font-semibold\">\n                    {item.price}\n                  </span>\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-5xl px-6 py-20 text-center md:py-28\">\n          <p className=\"text-sm tracking-widest text-muted-foreground uppercase\">\n            What players and critics are saying\n          </p>\n          {testimonials.slice(0, 1).map((t) => (\n            <figure key={t.name} className=\"mt-10\">\n              <blockquote className=\"font-serif text-3xl leading-snug text-balance md:text-5xl\">\n                &ldquo;{t.quote}&rdquo;\n              </blockquote>\n              <figcaption className=\"mt-10 text-sm\">\n                <span className=\"font-medium\">{t.name}</span>\n                <span className=\"text-muted-foreground\"> · {t.role}</span>\n              </figcaption>\n            </figure>\n          ))}\n          <div className=\"mt-16 grid gap-6 border-t pt-12 text-left md:grid-cols-2\">\n            {testimonials.slice(1).map((t) => (\n              <figure key={t.name}>\n                <blockquote className=\"leading-7 text-muted-foreground\">\n                  &ldquo;{t.quote}&rdquo;\n                </blockquote>\n                <figcaption className=\"mt-4 text-sm font-medium\">\n                  {t.name}{\" \"}\n                  <span className=\"font-normal text-muted-foreground\">\n                    · {t.role}\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"max-w-2xl\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal\">\n              Your first night in the game\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-foreground pt-6\"\n              >\n                <span className=\"text-sm font-medium text-sky-600 dark:text-sky-400\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal\">\n              Choose your edition\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Every edition includes the full campaign, free seasonal updates\n              and cross-progression across PC and console.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-sky-500 shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-sky-600 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-sky-600 dark:text-sky-400\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal\">\n              Frequently asked questions\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Get in touch\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"bg-foreground text-background\">\n        <div className=\"mx-auto flex max-w-7xl flex-col gap-10 px-6 py-20 md:flex-row md:items-end md:justify-between md:py-28\">\n          <div className=\"max-w-2xl\">\n            <h2 className=\"text-4xl font-semibold tracking-tight text-balance md:text-6xl font-serif font-normal\">\n              Help a small studio with one click\n            </h2>\n            <p className=\"mt-5 text-lg text-background/65\">\n              Wishlisting on Steam is the single best way to support independent\n              games.\n            </p>\n          </div>\n          <div className=\"flex flex-wrap gap-3 \">\n            <Button\n              size=\"lg\"\n              className=\"bg-background text-foreground hover:bg-background/90\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Wishlist now\n              <ArrowRight />\n            </Button>\n            <Button\n              size=\"lg\"\n              variant=\"outline\"\n              className=\"border-background/25 bg-transparent text-background hover:bg-background/10 hover:text-background\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Play the demo\n            </Button>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-sky-600 text-white text-sm\">\n                P\n              </span>\n              <span className=\"font-serif text-lg font-normal\">\n                Pixelhearth\n              </span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              Handmade games from a small studio.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Pixelhearth. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  return (\n    <div className=\"grid grid-cols-2 gap-3 md:grid-cols-3\">\n      {showcase.slice(0, 3).map((item, i) => (\n        <div\n          key={item.name}\n          className={`relative overflow-hidden rounded-2xl ${item.tile} ${i === 0 ? \"col-span-2 aspect-[16/10] md:col-span-1 md:aspect-[3/4]\" : \"aspect-[3/4]\"}`}\n        >\n          <div className=\"absolute inset-0 bg-gradient-to-t from-black/50 via-black/0 to-black/0\" />\n          <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-zinc-900 backdrop-blur\">\n            {item.tag}\n          </span>\n          <div className=\"absolute inset-x-3 bottom-3 flex items-end justify-between gap-2 text-white\">\n            <div className=\"min-w-0\">\n              <div className=\"truncate text-sm font-medium\">{item.name}</div>\n              <div className=\"truncate text-xs text-white/75\">{item.meta}</div>\n            </div>\n            <div className=\"shrink-0 text-sm font-semibold\">{item.price}</div>\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n",
      "type": "registry:page",
      "target": "app/landing-gaming-02/page.tsx"
    }
  ],
