{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "media-09",
  "type": "registry:block",
  "description": "Webinar landing page with agenda, speaker cards and a sticky countdown registration form.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "button",
    "input",
    "label"
  ],
  "files": [
    {
      "path": "registry/designali/blocks/media/media-09.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\nimport { CalendarDays, Check, Clock, Globe, Users } from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport { Input } from \"@workspace/ui/components/input\"\nimport { Label } from \"@workspace/ui/components/label\"\n\nconst speakers = [\n  {\n    name: \"Ali Imam\",\n    role: \"Founder, Designali\",\n    initials: \"AI\",\n    avatar: \"/ali.jpg\",\n  },\n  { name: \"Sara\", role: \"UI/UX Designer, Designali\", initials: \"SA\" },\n  { name: \"Omar\", role: \"Next.js Developer, Designali\", initials: \"OM\" },\n]\nconst agenda = [\n  \"Why most website redesigns stall in month three\",\n  \"Live demo: building a landing page with Designali blocks\",\n  \"Q&A with Ali Imam and the studio\",\n]\n\nexport default function Media09() {\n  const [done, setDone] = useState(false)\n\n  return (\n    <section className=\"w-full bg-background py-20\">\n      <div className=\"mx-auto grid max-w-6xl gap-10 px-6 lg:grid-cols-[1.3fr_1fr]\">\n        <div>\n          <span className=\"inline-flex items-center gap-2 border border-border px-2.5 py-1 text-xs font-medium\">\n            <span className=\"size-1.5 rounded-full bg-primary\" /> Free Designali\n            webinar\n          </span>\n          <h2 className=\"mt-5 text-3xl font-semibold tracking-tight md:text-5xl\">\n            Shipping a website in 30 days, not 6 months\n          </h2>\n          <div className=\"mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted-foreground\">\n            <span className=\"flex items-center gap-2\">\n              <CalendarDays className=\"size-4\" /> Thu, 4 Dec 2025\n            </span>\n            <span className=\"flex items-center gap-2\">\n              <Clock className=\"size-4\" /> 17:00 - 18:00 GMT\n            </span>\n            <span className=\"flex items-center gap-2\">\n              <Globe className=\"size-4\" /> Online, English\n            </span>\n            <span className=\"flex items-center gap-2\">\n              <Users className=\"size-4\" /> 1,286 registered\n            </span>\n          </div>\n          <h3 className=\"mt-10 text-sm font-medium\">What we&apos;ll cover</h3>\n          <ol className=\"mt-3 space-y-3\">\n            {agenda.map((item, i) => (\n              <li key={item} className=\"flex gap-4 text-sm\">\n                <span className=\"font-sans text-muted-foreground\">\n                  0{i + 1}\n                </span>\n                <span>{item}</span>\n              </li>\n            ))}\n          </ol>\n          <h3 className=\"mt-10 text-sm font-medium\">Speakers</h3>\n          <ul className=\"mt-4 grid gap-3 sm:grid-cols-3\">\n            {speakers.map((s) => (\n              <li key={s.name} className=\"border border-border p-4\">\n                {\"avatar\" in s && s.avatar ? (\n                  <img\n                    src={s.avatar}\n                    alt={s.name}\n                    className=\"size-11 rounded-full object-cover\"\n                  />\n                ) : (\n                  <span className=\"flex size-11 items-center justify-center rounded-full bg-primary text-sm font-semibold text-primary-foreground\">\n                    {s.initials}\n                  </span>\n                )}\n                <p className=\"mt-3 text-sm font-medium\">{s.name}</p>\n                <p className=\"text-xs text-muted-foreground\">{s.role}</p>\n              </li>\n            ))}\n          </ul>\n        </div>\n        <div className=\"lg:sticky lg:top-10 lg:self-start\">\n          <div className=\"border border-border bg-card p-6 text-card-foreground\">\n            <div className=\"grid grid-cols-4 gap-2 text-center\">\n              {[\n                [\"18\", \"days\"],\n                [\"06\", \"hrs\"],\n                [\"42\", \"min\"],\n                [\"09\", \"sec\"],\n              ].map(([n, l]) => (\n                <div key={l} className=\"border border-border py-3\">\n                  <p className=\"font-sans text-2xl font-semibold tabular-nums\">\n                    {n}\n                  </p>\n                  <p className=\"text-[11px] text-muted-foreground uppercase\">\n                    {l}\n                  </p>\n                </div>\n              ))}\n            </div>\n            {done ? (\n              <div className=\"mt-6 flex flex-col items-center py-8 text-center\">\n                <span className=\"flex size-12 items-center justify-center rounded-full bg-primary/15 text-primary dark:text-primary\">\n                  <Check className=\"size-6\" />\n                </span>\n                <p className=\"mt-4 font-medium\">You&apos;re registered</p>\n                <p className=\"mt-1 text-sm text-muted-foreground\">\n                  A calendar invite and joining link are on their way.\n                </p>\n              </div>\n            ) : (\n              <form\n                className=\"mt-6 space-y-4\"\n                onSubmit={(e) => {\n                  e.preventDefault()\n                  setDone(true)\n                }}\n              >\n                <div className=\"space-y-1.5\">\n                  <Label htmlFor=\"m09-name\">Full name</Label>\n                  <Input id=\"m09-name\" required placeholder=\"Jordan\" />\n                </div>\n                <div className=\"space-y-1.5\">\n                  <Label htmlFor=\"m09-email\">Work email</Label>\n                  <Input\n                    id=\"m09-email\"\n                    type=\"email\"\n                    required\n                    placeholder=\"you@example.com\"\n                  />\n                </div>\n                <div className=\"space-y-1.5\">\n                  <Label htmlFor=\"m09-company\">Company</Label>\n                  <Input id=\"m09-company\" placeholder=\"Optional\" />\n                </div>\n                <Button type=\"submit\" size=\"lg\" className=\"w-full\">\n                  Save my seat\n                </Button>\n                <p className=\"text-center text-xs text-muted-foreground\">\n                  Can&apos;t make it live? Register and we&apos;ll send the\n                  recording.\n                </p>\n              </form>\n            )}\n          </div>\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "900px"
  },
  "categories": [
    "media"
  ]
}