{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "navigation-menu-43",
  "type": "registry:example",
  "description": "Navigation menu with zero open delay and a longer close delay, compared side by side with defaults.",
  "files": [
    {
      "path": "registry/designali/examples/navigation-menu/navigation-menu-43.tsx",
      "content": "import {\n  NavigationMenu,\n  NavigationMenuContent,\n  NavigationMenuItem,\n  NavigationMenuLink,\n  NavigationMenuList,\n  NavigationMenuTrigger,\n} from \"@workspace/ui/components/navigation-menu\"\n\nfunction DemoMenu({ label }: { label: string }) {\n  return (\n    <NavigationMenuItem>\n      <NavigationMenuTrigger>{label}</NavigationMenuTrigger>\n      <NavigationMenuContent>\n        <ul className=\"flex w-44 flex-col gap-1\">\n          {[\"Designali Overview\", \"Pricing\", \"Docs\"].map((link) => (\n            <li key={link}>\n              <NavigationMenuLink href=\"#\">{link}</NavigationMenuLink>\n            </li>\n          ))}\n        </ul>\n      </NavigationMenuContent>\n    </NavigationMenuItem>\n  )\n}\n\nexport default function InstantOpenNav() {\n  return (\n    <div className=\"flex flex-col items-center gap-4\">\n      <div className=\"flex flex-col items-center gap-1\">\n        <span className=\"text-[11px] text-muted-foreground\">\n          delay 0 · closeDelay 400\n        </span>\n        <NavigationMenu delay={0} closeDelay={400}>\n          <NavigationMenuList>\n            <DemoMenu label=\"Templates\" />\n            <DemoMenu label=\"Blocks\" />\n          </NavigationMenuList>\n        </NavigationMenu>\n      </div>\n      <div className=\"flex flex-col items-center gap-1\">\n        <span className=\"text-[11px] text-muted-foreground\">\n          Default timing\n        </span>\n        <NavigationMenu>\n          <NavigationMenuList>\n            <DemoMenu label=\"Icons\" />\n            <DemoMenu label=\"Logos\" />\n          </NavigationMenuList>\n        </NavigationMenu>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}