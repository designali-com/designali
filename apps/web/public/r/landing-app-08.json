      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  Bell,\n  Check,\n  Lock,\n  Plus,\n  Quote,\n  RefreshCw,\n  Sparkles,\n  Users,\n  Watch,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport { Input } from \"@workspace/ui/components/input\"\n\nconst navLinks = [\"Features\", \"How it works\", \"Reviews\", \"Pricing\", \"Support\"]\n\nconst logos = [\n  \"9to5Mac\",\n  \"App Store\",\n  \"Google Play\",\n  \"The Verge\",\n  \"Wired\",\n  \"TechCrunch\",\n  \"Product Hunt\",\n  \"Fast Company\",\n]\n\nconst features = [\n  {\n    icon: Users,\n    title: \"Share with family\",\n    description:\n      \"Invite up to five people to shared spaces with one Premium Family plan.\",\n  },\n  {\n    icon: Sparkles,\n    title: \"Smart suggestions\",\n    description:\n      \"On-device intelligence learns your routine and surfaces the right thing at the right time.\",\n  },\n  {\n    icon: Bell,\n    title: \"Gentle reminders\",\n    description:\n      \"Notifications that respect focus modes and never nag. Snooze, reschedule or skip with a swipe.\",\n  },\n  {\n    icon: Lock,\n    title: \"Private by default\",\n    description:\n      \"Your data stays on your device and is end-to-end encrypted when it syncs. We never sell it.\",\n  },\n  {\n    icon: RefreshCw,\n    title: \"Seamless sync\",\n    description:\n      \"Start on your phone and pick up on your tablet or laptop. Changes appear in under a second.\",\n  },\n  {\n    icon: Watch,\n    title: \"Apple Watch and Wear OS\",\n    description:\n      \"Glanceable complications and quick actions right on your wrist.\",\n  },\n]\n\nconst stats = [\n  { value: \"4.9\", label: \"App Store rating\" },\n  { value: \"180K\", label: \"Five-star reviews\" },\n  { value: \"42\", label: \"Languages supported\" },\n  { value: \"#1\", label: \"In 18 countries\" },\n]\n\nconst steps = [\n  {\n    title: \"Download the app\",\n    description:\n      \"Free on the App Store and Google Play. No account needed to try it.\",\n  },\n  {\n    title: \"Pick your goals\",\n    description:\n      \"Answer three quick questions and we tailor the experience to you.\",\n  },\n  {\n    title: \"Add your first item\",\n    description:\n      \"Use the quick-add button, a widget, Siri or a share sheet from any app.\",\n  },\n  {\n    title: \"Build the habit\",\n    description:\n      \"Weekly insights show your progress and keep you gently on track.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Home screen widgets\",\n    meta: \"Small, medium and large sizes\",\n    tag: \"iOS and Android\",\n    price: \"Free\",\n  },\n  {\n    name: \"Lock screen glance\",\n    meta: \"See today at a glance\",\n    tag: \"iOS 17+\",\n    price: \"Free\",\n  },\n  {\n    name: \"Watch app\",\n    meta: \"Quick actions on your wrist\",\n    tag: \"watchOS\",\n    price: \"Premium\",\n  },\n  {\n    name: \"Siri and Shortcuts\",\n    meta: \"Hands-free logging\",\n    tag: \"Voice\",\n    price: \"Free\",\n  },\n  {\n    name: \"Weekly insights\",\n    meta: \"Trends and streaks\",\n    tag: \"Insights\",\n    price: \"Premium\",\n  },\n  {\n    name: \"Family spaces\",\n    meta: \"Share with up to five people\",\n    tag: \"Family\",\n    price: \"Family\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"Clean, fast and no dark patterns. Paying for Premium felt like supporting people who respect their users.\",\n    name: \"Tyler Brooks\",\n    role: \"Google Play review\",\n  },\n  {\n    quote:\n      \"The widgets are genius. I barely open the app because everything I need is right on my lock screen.\",\n    name: \"Noor Haddad\",\n    role: \"Premium member\",\n  },\n  {\n    quote:\n      \"Our whole family uses the shared space. It replaced a fridge full of sticky notes.\",\n    name: \"Carlos Mendes\",\n    role: \"Family plan user\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Free\",\n    price: \"$0\",\n    period: \"\",\n    description: \"Everything you need to get started.\",\n    features: [\n      \"Core features\",\n      \"Sync across 2 devices\",\n      \"Home screen widgets\",\n      \"Dark mode\",\n    ],\n    cta: \"Download free\",\n  },\n  {\n    name: \"Premium\",\n    price: \"$4.99\",\n    period: \"/month\",\n    description: \"For people who want the full experience.\",\n    features: [\n      \"Unlimited devices\",\n      \"Weekly insights\",\n      \"Watch app\",\n      \"Custom themes and icons\",\n      \"Priority support\",\n    ],\n    cta: \"Try 7 days free\",\n  },\n  {\n    name: \"Family\",\n    price: \"$7.99\",\n    period: \"/month\",\n    description: \"Premium for up to six people.\",\n    features: [\n      \"Everything in Premium\",\n      \"Up to 6 members\",\n      \"Shared spaces\",\n      \"Parental controls\",\n      \"One simple bill\",\n    ],\n    cta: \"Start family plan\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"Which devices are supported?\",\n    a: \"iPhone and iPad on iOS 16 or later, Android 10 or later, Apple Watch, Wear OS and any modern web browser.\",\n  },\n  {\n    q: \"What happens to my data if I cancel?\",\n    a: \"Nothing is deleted. You keep full access to your data on the free plan and can export it at any time.\",\n  },\n  {\n    q: \"Do you sell my data?\",\n    a: \"Never. We make money from subscriptions, not advertising. Your data is encrypted and stays yours.\",\n  },\n  {\n    q: \"Can I use it without an account?\",\n    a: \"Yes. Accounts are only needed to sync between devices or share with family members.\",\n  },\n  {\n    q: \"How do I cancel Premium?\",\n    a: \"Cancel any time from your App Store or Google Play subscription settings. You keep Premium until the period ends.\",\n  },\n]\n\nconst footer = [\n  { title: \"App\", links: [\"Features\", \"Premium\", \"Download\", \"What is new\"] },\n  { title: \"Company\", links: [\"About\", \"Blog\", \"Press kit\", \"Careers\"] },\n  { title: \"Help\", links: [\"Support\", \"Privacy\", \"Terms\", \"Contact\"] },\n]\n\nexport default function LandingApp08() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <div className=\"border-b bg-muted/50 text-muted-foreground px-4 py-2 text-center text-xs sm:text-sm\">\n        <a\n          href=\"#\"\n          className=\"inline-flex items-center gap-1.5 hover:underline\"\n        >\n          Beta testers wanted for our new Alps trail pack\n          <ArrowRight className=\"size-3.5\" />\n        </a>\n      </div>\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-violet-600 text-white text-sm\">\n              H\n            </span>\n            <span className=\"\">Hikeline</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Log in\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Join the beta\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"relative overflow-hidden border-b\">\n        <div className=\"mx-auto grid max-w-7xl items-center gap-12 px-6 py-16 md:py-24 lg:grid-cols-2\">\n          <div className=\"space-y-7\">\n            <span className=\"inline-flex items-center gap-2 rounded-full border bg-background text-muted-foreground px-3 py-1 text-xs font-medium\">\n              <Sparkles className=\"size-3.5 text-violet-600 dark:text-violet-400\" />\n              Offline trail maps\n            </span>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-6xl \">\n              {\"Find your way with \"}\n              <span className=\"text-violet-600 dark:text-violet-400\">\n                no signal at all\n              </span>\n            </h1>\n            <p className=\"max-w-xl text-lg leading-8 text-muted-foreground\">\n              Hikeline downloads topographic maps, routes and waypoints to your\n              phone, so you can navigate remote trails confidently without\n              coverage.\n            </p>\n            <form\n              action=\"#\"\n              className=\"flex w-full max-w-md flex-col gap-2 sm:flex-row \"\n            >\n              <Input\n                type=\"email\"\n                required\n                placeholder=\"you@company.com\"\n                aria-label=\"Email address\"\n                className=\"h-10 bg-background\"\n              />\n              <Button type=\"submit\" size=\"lg\">\n                Join the beta\n                <ArrowRight />\n              </Button>\n            </form>\n            <div className=\"flex flex-wrap gap-x-8 gap-y-3 pt-2\">\n              {stats.slice(0, 3).map((stat) => (\n                <div key={stat.label}>\n                  <div className=\"text-2xl font-semibold tracking-tight\">\n                    {stat.value}\n                  </div>\n                  <div className=\"text-xs text-muted-foreground\">\n                    {stat.label}\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n          <div className=\"relative\">\n            <div className=\"absolute -inset-8 -z-10 rounded-full bg-gradient-to-tr from-violet-500/25 via-fuchsia-500/10 to-transparent blur-3xl\" />\n            <HeroVisual />\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-12\">\n          <p className=\"text-center text-sm text-muted-foreground\">\n            Featured by\n          </p>\n          <div className=\"mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-6 sm:grid-cols-4 lg:grid-cols-8\">\n            {logos.map((logo) => (\n              <div\n                key={logo}\n                className=\"text-center text-base font-semibold tracking-tight text-muted-foreground/70 \"\n              >\n                {logo}\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b bg-muted/30\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"max-w-2xl\">\n            <p className=\"text-sm font-medium text-violet-600 dark:text-violet-400\">\n              Features\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              Designed to fit into your day, not take it over\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Thoughtful features, quick to learn and fast to use, on iPhone,\n              Android and the web.\n            </p>\n          </div>\n          <div className=\"mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3\">\n            {features.map((feature) => (\n              <div\n                key={feature.title}\n                className=\"rounded-xl border bg-background p-6 shadow-xs\"\n              >\n                <span className=\"flex size-10 items-center justify-center rounded-lg bg-violet-500/10\">\n                  <feature.icon className=\"size-5 text-violet-600 dark:text-violet-400\" />\n                </span>\n                <h3 className=\"mt-5 font-semibold\">{feature.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Get started in three minutes\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-violet-600 dark:text-violet-400\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Made for every moment\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                Widgets, watch complications and shortcuts put the most useful\n                parts one tap away.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a\n                key={item.name}\n                href=\"#\"\n                className=\"group flex flex-col rounded-xl border p-6 transition-colors hover:bg-muted/40\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"flex size-10 items-center justify-center rounded-lg border bg-muted/50 font-semibold \">\n                    {item.name.charAt(0)}\n                  </span>\n                  <span className=\"rounded-full bg-violet-500/10 px-2.5 py-0.5 text-xs font-medium text-violet-600 dark:text-violet-400\">\n                    {item.tag}\n                  </span>\n                </div>\n                <h3 className=\"mt-6 font-semibold \">{item.name}</h3>\n                <p className=\"mt-1 flex-1 text-sm text-muted-foreground\">\n                  {item.meta}\n                </p>\n                <div className=\"mt-6 flex items-center justify-between border-t pt-4 text-sm\">\n                  <span className=\"font-medium\">{item.price}</span>\n                  <ArrowUpRight className=\"size-4 text-muted-foreground transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5\" />\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b \">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Loved by people who hate most apps\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-4 md:grid-cols-3\">\n            {testimonials.map((t, i) => (\n              <figure\n                key={t.name}\n                className={`flex flex-col justify-between rounded-2xl border bg-background p-6 ${i === 0 ? \"md:col-span-2 md:p-10\" : \"\"}`}\n              >\n                <Quote className=\"size-6 text-violet-600 dark:text-violet-400\" />\n                <blockquote\n                  className={`mt-4 leading-relaxed ${i === 0 ? \"text-xl md:text-2xl\" : \"text-muted-foreground\"}`}\n                >\n                  {t.quote}\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 text-sm\">\n                  <span className=\"flex size-9 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Free to start. Premium when you want more