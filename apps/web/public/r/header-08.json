{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "header-08",
  "type": "registry:block",
  "description": "A dismissible announcement bar above a header with mega-menu style links.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "button"
  ],
  "files": [
    {
      "path": "registry/designali/blocks/header/header-08.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\nimport {\n  ArrowRight,\n  Menu,\n  X,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport { Logo } from \"@/src/components/logo\"\n\nconst links = [\"Templates\", \"Blocks\", \"Icons\", \"Pricing\", \"Docs\"]\n\nexport default function Header08() {\n  const [open, setOpen] = useState(false)\n  const [banner, setBanner] = useState(true)\n\n  return (\n    <section className=\"w-full bg-background\">\n      {banner && (\n        <div className=\"bg-foreground text-background\">\n          <div className=\"mx-auto flex max-w-7xl items-center justify-center gap-3 px-6 py-2.5 text-xs sm:text-sm\">\n            <span className=\"hidden bg-background/15 px-2 py-0.5 text-xs sm:inline\">New</span>\n            <a href=\"#\" className=\"flex items-center gap-1.5 hover:underline\">\n              460+ blocks are now live on Designali\n              <ArrowRight className=\"size-3.5\" />\n            </a>\n            <button\n              type=\"button\"\n              onClick={() => setBanner(false)}\n              aria-label=\"Dismiss announcement\"\n              className=\"ms-auto opacity-60 hover:opacity-100 sm:absolute sm:end-6\"\n            >\n              <X className=\"size-4\" />\n            </button>\n          </div>\n        </div>\n      )}\n      <header className=\"relative border-b\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center gap-10 px-6\">\n          <a href=\"#\" className=\"flex items-center gap-2 font-semibold tracking-tight\">\n            <Logo className=\"size-6\" />\n            designali\n          </a>\n          <nav className=\"hidden gap-6 text-sm lg:flex\">\n            {links.map((link) => (\n              <a key={link} href=\"#\" className=\"text-muted-foreground transition-colors hover:text-foreground\">\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"ms-auto hidden items-center gap-2 lg:flex\">\n            <Button variant=\"ghost\">Log in</Button>\n            <Button variant=\"outline\">Contact</Button>\n            <Button>Get started</Button>\n          </div>\n          <Button\n            variant=\"outline\"\n            size=\"icon-lg\"\n            className=\"ms-auto lg:hidden\"\n            aria-label=\"Toggle menu\"\n            onClick={() => setOpen(!open)}\n          >\n            {open ? <X /> : <Menu />}\n          </Button>\n        </div>\n        {open && (\n          <div className=\"border-t lg:hidden\">\n            <nav className=\"flex flex-col px-6 py-4\">\n              {links.map((link) => (\n                <a key={link} href=\"#\" className=\"border-b py-3 text-sm\">\n                  {link}\n                </a>\n              ))}\n            </nav>\n            <div className=\"grid grid-cols-2 gap-2 px-6 pb-6\">\n              <Button variant=\"outline\">Log in</Button>\n              <Button>Get started</Button>\n            </div>\n          </div>\n        )}\n      </header>\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "450px"
  },
  "categories": [
    "header"
  ]
}