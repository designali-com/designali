{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dialog-50",
  "type": "registry:example",
  "description": "Video call dialog offering to leave quietly or end the meeting for everyone.",
  "files": [
    {
      "path": "registry/designali/examples/dialog/dialog-50.tsx",
      "content": "import {\n  LogOut as LogOutIcon,\n  Mic as MicIcon,\n  MonitorUp as MonitorUpIcon,\n  PhoneOff as PhoneOffIcon,\n  Video as VideoIcon,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  Dialog,\n  DialogClose,\n  DialogContent,\n  DialogDescription,\n  DialogHeader,\n  DialogTitle,\n  DialogTrigger,\n} from \"@workspace/ui/components/dialog\"\n\nexport default function LeaveMeetingDialog() {\n  return (\n    <div className=\"flex items-center gap-2 border bg-muted/40 p-2\">\n      <Button variant=\"outline\" size=\"icon\" aria-label=\"Mute\">\n        <MicIcon />\n      </Button>\n      <Button variant=\"outline\" size=\"icon\" aria-label=\"Turn off camera\">\n        <VideoIcon />\n      </Button>\n      <Button variant=\"outline\" size=\"icon\" aria-label=\"Share screen\">\n        <MonitorUpIcon />\n      </Button>\n      <Dialog>\n        <DialogTrigger\n          render={\n            <Button variant=\"destructive\" size=\"icon\" aria-label=\"Leave call\" />\n          }\n        >\n          <PhoneOffIcon />\n        </DialogTrigger>\n        <DialogContent className=\"sm:max-w-xs\">\n          <DialogHeader>\n            <DialogTitle>Leave &quot;Designali client kickoff&quot;?</DialogTitle>\n            <DialogDescription>\n              You&apos;re the host. 6 people are still in the call.\n            </DialogDescription>\n          </DialogHeader>\n          <div className=\"flex flex-col gap-2\">\n            <DialogClose\n              render={<Button variant=\"outline\" className=\"justify-start\" />}\n            >\n              <LogOutIcon data-icon=\"inline-start\" />\n              Leave and keep meeting running\n            </DialogClose>\n            <DialogClose\n              render={\n                <Button variant=\"destructive\" className=\"justify-start\" />\n              }\n            >\n              <PhoneOffIcon data-icon=\"inline-start\" />\n              End meeting for everyone\n            </DialogClose>\n          </div>\n        </DialogContent>\n      </Dialog>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}