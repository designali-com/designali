{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "field-39",
  "type": "registry:example",
  "description": "Multi-section job application separated by field separators with contact, role, and links.",
  "files": [
    {
      "path": "registry/designali/examples/field/field-39.tsx",
      "content": "import { Button } from \"@workspace/ui/components/button\"\nimport { Checkbox } from \"@workspace/ui/components/checkbox\"\nimport {\n  Field,\n  FieldDescription,\n  FieldGroup,\n  FieldLabel,\n  FieldLegend,\n  FieldSeparator,\n  FieldSet,\n} from \"@workspace/ui/components/field\"\nimport { Input } from \"@workspace/ui/components/input\"\nimport {\n  NativeSelect,\n  NativeSelectOption,\n} from \"@workspace/ui/components/native-select\"\n\nexport default function JobApplicationSections() {\n  return (\n    <form className=\"w-full max-w-md\">\n      <FieldGroup>\n        <FieldSet>\n          <FieldLegend>Contact</FieldLegend>\n          <div className=\"grid grid-cols-2 gap-3\">\n            <Field>\n              <FieldLabel htmlFor=\"job-name\">Full name</FieldLabel>\n              <Input id=\"job-name\" placeholder=\"Ali Imam\" />\n            </Field>\n            <Field>\n              <FieldLabel htmlFor=\"job-email\">Email</FieldLabel>\n              <Input\n                id=\"job-email\"\n                type=\"email\"\n                placeholder=\"ali@designali.com\"\n              />\n            </Field>\n          </div>\n        </FieldSet>\n        <FieldSeparator />\n        <FieldSet>\n          <FieldLegend>Role</FieldLegend>\n          <Field>\n            <FieldLabel htmlFor=\"job-role\">Position</FieldLabel>\n            <NativeSelect id=\"job-role\" defaultValue=\"fe\">\n              <NativeSelectOption value=\"fe\">\n                Frontend Engineer\n              </NativeSelectOption>\n              <NativeSelectOption value=\"pd\">\n                Product Designer\n              </NativeSelectOption>\n              <NativeSelectOption value=\"pm\">\n                Product Manager\n              </NativeSelectOption>\n            </NativeSelect>\n          </Field>\n          <Field orientation=\"horizontal\">\n            <Checkbox id=\"job-remote\" defaultChecked />\n            <FieldLabel htmlFor=\"job-remote\" className=\"font-normal\">\n              Open to fully remote\n            </FieldLabel>\n          </Field>\n        </FieldSet>\n        <FieldSeparator />\n        <FieldSet>\n          <FieldLegend>Links</FieldLegend>\n          <Field>\n            <FieldLabel htmlFor=\"job-portfolio\">Portfolio</FieldLabel>\n            <Input id=\"job-portfolio\" type=\"url\" placeholder=\"https://www.designali.com\" />\n            <FieldDescription>\n              A site, case study, or repository.\n            </FieldDescription>\n          </Field>\n        </FieldSet>\n        <Button type=\"submit\" className=\"w-fit\">\n          Submit application\n        </Button>\n      </FieldGroup>\n    </form>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}