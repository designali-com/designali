{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "resizable-29",
  "type": "registry:example",
  "description": "Sidebar sized in pixels that keeps its width when the group resizes.",
  "files": [
    {
      "path": "registry/designali/examples/resizable/resizable-29.tsx",
      "content": "import {\n  ResizableHandle,\n  ResizablePanel,\n  ResizablePanelGroup,\n} from \"@workspace/ui/components/resizable\"\n\nexport default function PixelSizedSidebar() {\n  return (\n    <ResizablePanelGroup\n      orientation=\"horizontal\"\n      className=\"h-48 w-full max-w-xl border\"\n    >\n      <ResizablePanel\n        defaultSize=\"180px\"\n        minSize=\"120px\"\n        maxSize=\"260px\"\n        groupResizeBehavior=\"preserve-pixel-size\"\n      >\n        <div className=\"flex h-full flex-col justify-center gap-1 bg-muted/40 p-3\">\n          <span className=\"text-xs font-medium\">Sidebar</span>\n          <span className=\"font-sans text-[11px] text-muted-foreground\">\n            120px - 260px\n          </span>\n        </div>\n      </ResizablePanel>\n      <ResizableHandle withHandle />\n      <ResizablePanel>\n        <div className=\"flex h-full flex-col justify-center gap-1 p-3\">\n          <span className=\"text-xs font-medium\">Main content</span>\n          <span className=\"text-[11px] text-muted-foreground\">\n            Takes the remaining space and absorbs window resizes.\n          </span>\n        </div>\n      </ResizablePanel>\n    </ResizablePanelGroup>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}