{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sheet-19",
  "type": "registry:example",
  "description": "Admin user profile sheet with account stats, plan details, and a destructive suspend action.",
  "files": [
    {
      "path": "registry/designali/examples/sheet/sheet-19.tsx",
      "content": "import { BanIcon, KeyIcon, MailIcon, UserIcon } from \"lucide-react\"\n\nimport { Avatar, AvatarFallback } from \"@workspace/ui/components/avatar\"\nimport { Badge } from \"@workspace/ui/components/badge\"\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  Sheet,\n  SheetContent,\n  SheetDescription,\n  SheetFooter,\n  SheetTitle,\n  SheetTrigger,\n} from \"@workspace/ui/components/sheet\"\n\nconst stats = [\n  { label: \"Projects\", value: \"14\" },\n  { label: \"Seats\", value: \"6\" },\n  { label: \"MRR\", value: \"$420\" },\n]\n\nexport default function AdminUserProfileSheet() {\n  return (\n    <Sheet>\n      <SheetTrigger render={<Button variant=\"outline\" />}>\n        View user\n      </SheetTrigger>\n      <SheetContent>\n        <div className=\"flex flex-col items-center gap-2 border-b p-6 text-center\">\n          <Avatar size=\"lg\">\n            <AvatarFallback>TB</AvatarFallback>\n          </Avatar>\n          <SheetTitle>Tomas Berg</SheetTitle>\n          <SheetDescription>\n            tomas@fjordworks.example · joined Jan 2024\n          </SheetDescription>\n          <div className=\"flex gap-1\">\n            <Badge>Pro plan</Badge>\n            <Badge variant=\"outline\">2FA enabled</Badge>\n          </div>\n        </div>\n        <div className=\"grid grid-cols-3 divide-x border-b\">\n          {stats.map((s) => (\n            <div key={s.label} className=\"flex flex-col items-center py-3\">\n              <span className=\"text-base font-semibold\">{s.value}</span>\n              <span className=\"text-muted-foreground\">{s.label}</span>\n            </div>\n          ))}\n        </div>\n        <div className=\"flex flex-col gap-1 p-4\">\n          <Button variant=\"ghost\" className=\"justify-start\">\n            <MailIcon data-icon=\"inline-start\" />\n            Send email\n          </Button>\n          <Button variant=\"ghost\" className=\"justify-start\">\n            <KeyIcon data-icon=\"inline-start\" />\n            Reset password\n          </Button>\n          <Button variant=\"ghost\" className=\"justify-start\">\n            <UserIcon data-icon=\"inline-start\" />\n            Impersonate\n          </Button>\n        </div>\n        <SheetFooter>\n          <Button variant=\"destructive\">\n            <BanIcon data-icon=\"inline-start\" />\n            Suspend account\n          </Button>\n        </SheetFooter>\n      </SheetContent>\n    </Sheet>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}