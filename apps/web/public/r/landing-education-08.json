      "path": "registry/designali/pages/education/landing-education-08/page.tsx",
      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  Award,\n  Briefcase,\n  Check,\n  FolderKanban,\n  MessageSquare,\n  PlayCircle,\n  Plus,\n  Quote,\n  Sparkles,\n  Users,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport { Input } from \"@workspace/ui/components/input\"\n\nconst navLinks = [\"Courses\", \"Programs\", \"Instructors\", \"Pricing\", \"For teams\"]\n\nconst logos = [\n  \"Canva\",\n  \"Google\",\n  \"Spotify\",\n  \"Airbnb\",\n  \"Shopify\",\n  \"Deloitte\",\n  \"IBM\",\n  \"Corvia\",\n]\n\nconst features = [\n  {\n    icon: Briefcase,\n    title: \"Career support\",\n    description:\n      \"Resume reviews, mock interviews and introductions to our hiring partners.\",\n  },\n  {\n    icon: PlayCircle,\n    title: \"Bite-sized lessons\",\n    description:\n      \"Video lessons under ten minutes, so you can learn on a commute or a lunch break.\",\n  },\n  {\n    icon: FolderKanban,\n    title: \"Portfolio projects\",\n    description:\n      \"Every course ends with a real project you can show employers, reviewed by an expert.\",\n  },\n  {\n    icon: Users,\n    title: \"Live cohorts\",\n    description:\n      \"Learn alongside peers with weekly live sessions, study groups and shared deadlines.\",\n  },\n  {\n    icon: MessageSquare,\n    title: \"Mentor feedback\",\n    description:\n      \"Get line-by-line feedback from industry mentors within 48 hours of every submission.\",\n  },\n  {\n    icon: Award,\n    title: \"Recognised certificates\",\n    description:\n      \"Earn certificates accredited by partner universities and shareable on LinkedIn.\",\n  },\n]\n\nconst stats = [\n  { value: \"860\", label: \"Expert-led courses\" },\n  { value: \"87%\", label: \"Report a career boost\" },\n  { value: \"4.8/5\", label: \"Average course rating\" },\n  { value: \"190\", label: \"Countries represented\" },\n]\n\nconst steps = [\n  {\n    title: \"Pick your path\",\n    description:\n      \"Take a short quiz and get a course or program matched to your goals and level.\",\n  },\n  {\n    title: \"Learn at your pace\",\n    description:\n      \"Work through short lessons and practice exercises on any device.\",\n  },\n  {\n    title: \"Build real projects\",\n    description:\n      \"Apply what you learn to projects reviewed by mentors from the industry.\",\n  },\n  {\n    title: \"Get certified\",\n    description:\n      \"Earn a certificate and share it with employers, plus access career support.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Data Analysis with Python\",\n    meta: \"12 weeks · 48 lessons\",\n    tag: \"Bestseller\",\n    price: \"$249\",\n    tile: \"bg-gradient-to-br from-blue-200 via-indigo-300 to-violet-400 dark:from-blue-700 dark:via-indigo-800 dark:to-violet-900\",\n  },\n  {\n    name: \"UX Design Fundamentals\",\n    meta: \"8 weeks · 32 lessons\",\n    tag: \"Beginner\",\n    price: \"$199\",\n    tile: \"bg-gradient-to-br from-yellow-100 via-amber-200 to-orange-300 dark:from-yellow-700 dark:via-amber-800 dark:to-orange-900\",\n  },\n  {\n    name: \"Full-Stack Web Development\",\n    meta: \"24 weeks · Live cohort\",\n    tag: \"Program\",\n    price: \"$2,400\",\n    tile: \"bg-gradient-to-br from-amber-200 via-orange-300 to-rose-400 dark:from-amber-700 dark:via-orange-800 dark:to-rose-900\",\n  },\n  {\n    name: \"Product Management\",\n    meta: \"10 weeks · 40 lessons\",\n    tag: \"Popular\",\n    price: \"$299\",\n    tile: \"bg-gradient-to-br from-sky-200 via-cyan-300 to-teal-400 dark:from-sky-700 dark:via-cyan-800 dark:to-teal-900\",\n  },\n  {\n    name: \"Machine Learning Foundations\",\n    meta: \"14 weeks · 56 lessons\",\n    tag: \"New\",\n    price: \"$349\",\n    tile: \"bg-gradient-to-br from-violet-200 via-purple-300 to-fuchsia-400 dark:from-violet-700 dark:via-purple-800 dark:to-fuchsia-900\",\n  },\n  {\n    name: \"Business Writing\",\n    meta: \"4 weeks · 16 lessons\",\n    tag: \"Short course\",\n    price: \"$89\",\n    tile: \"bg-gradient-to-br from-emerald-200 via-green-300 to-lime-300 dark:from-emerald-700 dark:via-green-800 dark:to-lime-900\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"The mentor feedback is the real value. Someone experienced actually read my code and told me how to improve it.\",\n    name: \"Arjun Mehta\",\n    role: \"Software Engineer\",\n  },\n  {\n    quote:\n      \"My son's maths grade went from a C to an A minus in one term. His tutor made it click in a way school never did.\",\n    name: \"Karen Doyle\",\n    role: \"Parent\",\n  },\n  {\n    quote:\n      \"Studying with a cohort kept me accountable. I finished every module on time for the first time in my life.\",\n    name: \"Lucas Moreau\",\n    role: \"UX Designer\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Single course\",\n    price: \"$89\",\n    period: \"from\",\n    description: \"Buy one course and keep it forever.\",\n    features: [\n      \"Lifetime access\",\n      \"All lessons and quizzes\",\n      \"Certificate of completion\",\n      \"Mobile app\",\n    ],\n    cta: \"Browse courses\",\n  },\n  {\n    name: \"All-access\",\n    price: \"$39\",\n    period: \"/month\",\n    description: \"Unlimited learning across the whole catalog.\",\n    features: [\n      \"Every course included\",\n      \"Mentor project reviews\",\n      \"Live workshops\",\n      \"Offline downloads\",\n      \"Cancel any time\",\n    ],\n    cta: \"Start free trial\",\n  },\n  {\n    name: \"Teams\",\n    price: \"$29\",\n    period: \"/seat/month\",\n    description: \"Upskill your whole organisation.\",\n    features: [\n      \"Everything in All-access\",\n      \"Admin dashboard\",\n      \"Custom learning paths\",\n      \"SSO and LMS integration\",\n      \"Dedicated success manager\",\n    ],\n    cta: \"Contact sales\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"How much time should I set aside?\",\n    a: \"Most learners spend five to eight hours a week. You can pause and resume courses at any time.\",\n  },\n  {\n    q: \"Are the certificates recognised?\",\n    a: \"Our certificates are co-issued with partner universities and are recognised by more than 300 hiring partners.\",\n  },\n  {\n    q: \"Is financial aid available?\",\n    a: \"Yes. We offer need-based scholarships and income-share options for full programs.\",\n  },\n  {\n    q: \"Can I get a refund?\",\n    a: \"You can request a full refund within 14 days of purchase if you have completed less than 20% of the course.\",\n  },\n  {\n    q: \"Do you offer live classes?\",\n    a: \"Our cohort programs include weekly live sessions with instructors and small-group study rooms.\",\n  },\n]\n\nconst footer = [\n  {\n    title: \"Learn\",\n    links: [\"Courses\", \"Programs\", \"Certificates\", \"Free resources\"],\n  },\n  {\n    title: \"Community\",\n    links: [\"Mentors\", \"Events\", \"Student stories\", \"Scholarships\"],\n  },\n  { title: \"Company\", links: [\"About\", \"Careers\", \"For business\", \"Contact\"] },\n]\n\nexport default function LandingEducation08() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <div className=\"border-b bg-muted/50 text-muted-foreground px-4 py-2 text-center text-xs sm:text-sm\">\n        <a\n          href=\"#\"\n          className=\"inline-flex items-center gap-1.5 hover:underline\"\n        >\n          Free webinar: writing a standout personal statement\n          <ArrowRight className=\"size-3.5\" />\n        </a>\n      </div>\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-sky-600 text-white text-sm\">\n              C\n            </span>\n            <span className=\"\">Campus Compass</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Log in\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Get the free guide\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"relative overflow-hidden border-b\">\n        <div className=\"mx-auto grid max-w-7xl items-center gap-12 px-6 py-16 md:py-24 lg:grid-cols-2\">\n          <div className=\"space-y-7\">\n            <span className=\"inline-flex items-center gap-2 rounded-full border bg-background text-muted-foreground px-3 py-1 text-xs font-medium\">\n              <Sparkles className=\"size-3.5 text-sky-600 dark:text-sky-400\" />\n              Admissions counselling\n            </span>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-6xl \">\n              {\"Find the right college and \"}\n              <span className=\"text-sky-600 dark:text-sky-400\">get in</span>\n            </h1>\n            <p className=\"max-w-xl text-lg leading-8 text-muted-foreground\">\n              Campus Compass pairs students with former admissions officers for\n              school lists, essay coaching and application strategy.\n            </p>\n            <form\n              action=\"#\"\n              className=\"flex w-full max-w-md flex-col gap-2 sm:flex-row \"\n            >\n              <Input\n                type=\"email\"\n                required\n                placeholder=\"you@company.com\"\n                aria-label=\"Email address\"\n                className=\"h-10 bg-background\"\n              />\n              <Button type=\"submit\" size=\"lg\">\n                Get the free guide\n                <ArrowRight />\n              </Button>\n            </form>\n            <div className=\"flex flex-wrap gap-x-8 gap-y-3 pt-2\">\n              {stats.slice(0, 3).map((stat) => (\n                <div key={stat.label}>\n                  <div className=\"text-2xl font-semibold tracking-tight\">\n                    {stat.value}\n                  </div>\n                  <div className=\"text-xs text-muted-foreground\">\n                    {stat.label}\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n          <div className=\"relative\">\n            <div className=\"absolute -inset-8 -z-10 rounded-full bg-gradient-to-tr from-sky-500/25 via-cyan-500/10 to-transparent blur-3xl\" />\n            <HeroVisual />\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-12\">\n          <p className=\"text-center text-sm text-muted-foreground\">\n            Our graduates work at\n          </p>\n          <div className=\"mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-6 sm:grid-cols-4 lg:grid-cols-8\">\n            {logos.map((logo) => (\n              <div\n                key={logo}\n                className=\"text-center text-base font-semibold tracking-tight text-muted-foreground/70 \"\n              >\n                {logo}\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b bg-muted/30\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"max-w-2xl\">\n            <p className=\"text-sm font-medium text-sky-600 dark:text-sky-400\">\n              Learning\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              Learning that actually sticks\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Short lessons, real projects and feedback from experts, designed\n              around how adults really learn.\n            </p>\n          </div>\n          <div className=\"mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3\">\n            {features.map((feature) => (\n              <div\n                key={feature.title}\n                className=\"rounded-xl border bg-background p-6 shadow-xs\"\n              >\n                <span className=\"flex size-10 items-center justify-center rounded-lg bg-sky-500/10\">\n                  <feature.icon className=\"size-5 text-sky-600 dark:text-sky-400\" />\n                </span>\n                <h3 className=\"mt-5 font-semibold\">{feature.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              How learning works here\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-sky-600 dark:text-sky-400\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Popular courses this term\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                Taught by practitioners from leading companies and universities.\n                Start any course today.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a key={item.name} href=\"#\" className=\"group\">\n                <div\n                  className={`relative aspect-[4/3] overflow-hidden rounded-2xl ${item.tile}`}\n                >\n                  <div className=\"absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10\" />\n                  <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-zinc-900 backdrop-blur\">\n                    {item.tag}\n                  </span>\n                </div>\n                <div className=\"mt-4 flex items-start justify-between gap-4\">\n                  <div className=\"min-w-0\">\n                    <h3 className=\"font-medium \">{item.name}</h3>\n                    <p className=\"mt-1 text-sm text-muted-foreground\">\n                      {item.meta}\n                    </p>\n                  </div>\n                  <span className=\"shrink-0 text-sm font-semibold\">\n                    {item.price}\n                  </span>\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b \">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Learners who changed their path\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-4 md:grid-cols-3\">\n            {testimonials.map((t, i) => (\n              <figure\n                key={t.name}\n                className={`flex flex-col justify-between rounded-2xl border bg-background p-6 ${i === 0 ? \"md:col-span-2 md:p-10\" : \"\"}`}\n              >\n                <Quote className=\"size-6 text-sky-600 dark:text-sky-400\" />\n                <blockquote\n                  className={`mt-4 leading-relaxed ${i === 0 ? \"text-xl md:text-2xl\" : \"text-muted-foreground\"}`}\n                >\n                  {t.quote}\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 text-sm\">\n                  <span className=\"flex size-9 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Plans for every learner\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Learn at your own pace or join a live cohort. Financial aid and\n              student discounts available.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-sky-500 shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-sky-600 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-sky-600 dark:text-sky-400\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Questions from learners\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Get in touch\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"px-6 py-20 md:py-28\">\n        <div className=\"relative mx-auto max-w-6xl overflow-hidden rounded-3xl border bg-sky-500/10 px-6 py-16 text-center md:py-24\">\n          <div className=\"pointer-events-none absolute -top-24 left-1/2 size-96 -translate-x-1/2 rounded-full bg-gradient-to-b from-sky-500/25 via-cyan-500/10 to-transparent blur-3xl\" />\n          <div className=\"relative mx-auto max-w-2xl space-y-6\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Start your application with a plan\n            </h2>\n            <p className=\"text-lg text-muted-foreground\">\n              Enter your email to get our admissions timeline and essay guide\n              free.\n            </p>\n            <form\n              action=\"#\"\n              className=\"flex w-full max-w-md flex-col gap-2 sm:flex-row mx-auto\"\n            >\n              <Input\n                type=\"email\"\n                required\n                placeholder=\"you@company.com\"\n                aria-label=\"Email address\"\n                className=\"h-10 bg-background\"\n              />\n              <Button type=\"submit\" size=\"lg\">\n                Get the free guide\n                <ArrowRight />\n              </Button>\n            </form>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-sky-600 text-white text-sm\">\n                C\n              </span>\n              <span className=\"\">Campus Compass</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              Your path to the right campus.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Campus Compass. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  return (\n    <div className=\"grid grid-cols-2 gap-3 md:grid-cols-3\">\n      {showcase.slice(0, 3).map((item, i) => (\n        <div\n          key={item.name}\n          className={`relative overflow-hidden rounded-2xl ${item.tile} ${i === 0 ? \"col-span-2 aspect-[16/10] md:col-span-1 md:aspect-[3/4]\" : \"aspect-[3/4]\"}`}\n        >\n          <div className=\"absolute inset-0 bg-gradient-to-t from-black/50 via-black/0 to-black/0\" />\n          <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-zinc-900 backdrop-blur\">\n            {item.tag}\n          </span>\n          <div className=\"absolute inset-x-3 bottom-3 flex items-end justify-between gap-2 text-white\">\n            <div className=\"min-w-0\">\n              <div className=\"truncate text-sm font-medium\">{item.name}</div>\n              <div className=\"truncate text-xs text-white/75\">{item.meta}</div>\n            </div>\n            <div className=\"shrink-0 text-sm font-semibold\">{item.price}</div>\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n",
