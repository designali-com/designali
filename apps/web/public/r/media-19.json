{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "media-19",
  "type": "registry:block",
  "description": "Inverted keynote band with stats and a video thumbnail that opens a modal player.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "button"
  ],
  "files": [
    {
      "path": "registry/designali/blocks/media/media-19.tsx",
      "content": "\"use client\"\n\nimport { useEffect, useState } from \"react\"\nimport { Play, X } from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport { CounterNumber } from \"@/registry/designali/ui/counter-number\"\nimport { GridPattern } from \"@/registry/designali/ui/grid-pattern\"\n\nconst stats = [\n  { value: 460, label: \"Production-ready blocks\" },\n  { value: 240, label: \"Landing pages and templates\" },\n  { value: 4000, label: \"Icons in @designali/icons\" },\n]\n\nexport default function Media19() {\n  const [open, setOpen] = useState(false)\n\n  useEffect(() => {\n    if (!open) return\n    const onKey = (e: KeyboardEvent) => e.key === \"Escape\" && setOpen(false)\n    window.addEventListener(\"keydown\", onKey)\n    return () => window.removeEventListener(\"keydown\", onKey)\n  }, [open])\n\n  return (\n    <section className=\"w-full bg-background py-16\">\n      <div className=\"mx-auto max-w-7xl px-6\">\n        <div className=\"relative overflow-hidden bg-foreground px-6 py-16 text-background md:px-14 md:py-20\">\n          <GridPattern\n            width={48}\n            height={48}\n            className=\"stroke-background opacity-20\"\n          />\n          <div className=\"relative grid gap-12 lg:grid-cols-[1.1fr_1fr] lg:items-center\">\n            <div>\n              <p className=\"text-xs tracking-widest text-background/60 uppercase\">\n                Keynote replay - Designali Live\n              </p>\n              <h2 className=\"mt-4 text-3xl font-semibold tracking-tight md:text-5xl\">\n                Watch the launch in 4 minutes.\n              </h2>\n              <p className=\"mt-4 max-w-md text-background/70\">\n                New Designali blocks, templates and icons, demoed live by Ali\n                Imam — design se code tak, in real time.\n              </p>\n              <dl className=\"mt-10 grid grid-cols-3 gap-4 border-t border-background/20 pt-6\">\n                {stats.map((s) => (\n                  <div key={s.label}>\n                    <dt className=\"sr-only\">{s.label}</dt>\n                    <dd>\n                      <CounterNumber\n                        value={s.value}\n                        suffix=\"+\"\n                        className=\"text-xl font-semibold tracking-normal text-background md:text-3xl\"\n                      />\n                    </dd>\n                    <p className=\"mt-1 text-xs text-background/60\">{s.label}</p>\n                  </div>\n                ))}\n              </dl>\n            </div>\n            <button\n              type=\"button\"\n              onClick={() => setOpen(true)}\n              aria-label=\"Play keynote video\"\n              className=\"group relative aspect-video w-full overflow-hidden border border-background/20 text-left\"\n            >\n              <img\n                src=\"/img/hero-2.jpg\"\n                alt=\"Ali Imam presenting the Designali keynote\"\n                className=\"absolute inset-0 size-full object-cover transition-transform duration-700 group-hover:scale-105\"\n              />\n              <span className=\"absolute top-1/2 left-1/2 flex size-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white text-black shadow-2xl transition-transform group-hover:scale-110\">\n                <span className=\"absolute inset-0 animate-ping rounded-full bg-white/40\" />\n                <Play className=\"relative size-7 translate-x-0.5 fill-current\" />\n              </span>\n              <span className=\"absolute bottom-3 left-3 bg-black/60 px-2 py-1 text-xs text-white backdrop-blur\">\n                Keynote - 4:06\n              </span>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {open && (\n        <div\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-label=\"Keynote video\"\n          className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/85 p-4 backdrop-blur-sm\"\n          onClick={() => setOpen(false)}\n        >\n          <div\n            className=\"relative w-full max-w-4xl\"\n            onClick={(e) => e.stopPropagation()}\n          >\n            <Button\n              variant=\"outline\"\n              size=\"icon-lg\"\n              aria-label=\"Close\"\n              className=\"absolute -top-12 right-0 border-white/20 bg-transparent text-white hover:bg-white/10 hover:text-white\"\n              onClick={() => setOpen(false)}\n            >\n              <X />\n            </Button>\n            <div className=\"relative aspect-video w-full overflow-hidden border border-white/10 bg-black\">\n              <img\n                src=\"/img/hero-2.jpg\"\n                alt=\"\"\n                className=\"absolute inset-0 size-full object-cover\"\n              />\n              <div className=\"absolute inset-x-0 bottom-0 flex items-center gap-3 bg-gradient-to-t from-black/90 to-transparent p-4 text-white\">\n                <Play className=\"size-4 fill-current\" />\n                <div className=\"h-1 flex-1 bg-white/25\">\n                  <div className=\"h-full w-[6%] bg-white\" />\n                </div>\n                <span className=\"font-sans text-xs tabular-nums\">\n                  0:14 / 4:06\n                </span>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "650px"
  },
  "categories": [
    "media"
  ]
}