{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "menubar-19",
  "type": "registry:example",
  "description": "Video editor menubar with clip, marker and playback speed menus above a timeline strip.",
  "files": [
    {
      "path": "registry/designali/examples/menubar/menubar-19.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport { BookmarkIcon, CopyIcon, ScissorsIcon, UnlinkIcon } from \"lucide-react\"\n\nimport {\n  Menubar,\n  MenubarContent,\n  MenubarGroup,\n  MenubarItem,\n  MenubarLabel,\n  MenubarMenu,\n  MenubarRadioGroup,\n  MenubarRadioItem,\n  MenubarShortcut,\n  MenubarTrigger,\n} from \"@workspace/ui/components/menubar\"\n\nexport default function VideoTimelineMenubar() {\n  const [speed, setSpeed] = React.useState(\"1\")\n\n  return (\n    <div className=\"flex w-full max-w-md flex-col gap-2\">\n      <Menubar>\n        <MenubarMenu>\n          <MenubarTrigger>Clip</MenubarTrigger>\n          <MenubarContent>\n            <MenubarGroup>\n              <MenubarItem>\n                <ScissorsIcon /> Split at playhead{\" \"}\n                <MenubarShortcut>S</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>\n                <CopyIcon /> Duplicate clip\n              </MenubarItem>\n              <MenubarItem>\n                <UnlinkIcon /> Detach audio\n              </MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>Marker</MenubarTrigger>\n          <MenubarContent>\n            <MenubarGroup>\n              <MenubarItem>\n                <BookmarkIcon /> Add marker <MenubarShortcut>M</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>Next marker</MenubarItem>\n              <MenubarItem>Clear all markers</MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>Playback</MenubarTrigger>\n          <MenubarContent>\n            <MenubarGroup>\n              <MenubarLabel inset>Speed</MenubarLabel>\n              <MenubarRadioGroup value={speed} onValueChange={setSpeed}>\n                {[\"0.5\", \"1\", \"1.5\", \"2\"].map((s) => (\n                  <MenubarRadioItem key={s} value={s}>\n                    {s}×\n                  </MenubarRadioItem>\n                ))}\n              </MenubarRadioGroup>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <span className=\"ms-auto pe-1 text-[11px] text-muted-foreground tabular-nums\">\n          {speed}× · 00:42\n        </span>\n      </Menubar>\n      <div className=\"relative flex h-10 gap-0.5 border bg-muted/40 p-1\">\n        <div className=\"w-1/3 bg-sky-500/70\" />\n        <div className=\"w-1/4 bg-violet-500/70\" />\n        <div className=\"flex-1 bg-emerald-500/70\" />\n        <div className=\"absolute inset-y-0 start-[42%] w-px bg-foreground\" />\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}