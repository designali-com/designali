{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "media-03",
  "type": "registry:block",
  "description": "A podcast episode player with cover art, play controls and show notes.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "button"
  ],
  "files": [
    {
      "path": "registry/designali/blocks/media/media-03.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\nimport { Pause, Play, SkipBack, SkipForward } from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst bars = Array.from({ length: 64 }, (_, i) =>\n  Math.round(20 + Math.abs(Math.sin(i * 0.7) * 60) + (i % 5) * 4)\n)\n\nexport default function Media03() {\n  const [playing, setPlaying] = useState(false)\n  const progress = 38\n\n  return (\n    <section className=\"w-full bg-muted/40 py-20\">\n      <div className=\"mx-auto max-w-4xl px-6\">\n        <div className=\"grid border border-border bg-background md:grid-cols-[220px_1fr]\">\n          <div\n            className=\"aspect-square border-b border-border md:border-r md:border-b-0\"\n            style={{\n              background:\n                \"conic-gradient(from 90deg, var(--chart-1), var(--chart-2), var(--chart-4), var(--chart-1))\",\n            }}\n          />\n          <div className=\"flex flex-col justify-between gap-6 p-6\">\n            <div>\n              <p className=\"text-xs text-muted-foreground\">\n                Episode 42 &middot; The Design Room\n              </p>\n              <h2 className=\"mt-2 text-xl font-semibold tracking-tight\">\n                Typography as interface, with Elena Rossi\n              </h2>\n            </div>\n            <div className=\"flex h-16 items-end gap-0.5\">\n              {bars.map((h, i) => (\n                <span\n                  key={i}\n                  className={\n                    i < (bars.length * progress) / 100\n                      ? \"flex-1 bg-foreground\"\n                      : \"flex-1 bg-border\"\n                  }\n                  style={{ height: `${h}%` }}\n                />\n              ))}\n            </div>\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-xs text-muted-foreground tabular-nums\">\n                18:42 / 49:10\n              </span>\n              <div className=\"flex items-center gap-2\">\n                <Button\n                  variant=\"ghost\"\n                  size=\"icon\"\n                  aria-label=\"Back 15 seconds\"\n                >\n                  <SkipBack />\n                </Button>\n                <Button\n                  size=\"icon-lg\"\n                  onClick={() => setPlaying((p) => !p)}\n                  aria-label={playing ? \"Pause\" : \"Play\"}\n                >\n                  {playing ? <Pause /> : <Play />}\n                </Button>\n                <Button\n                  variant=\"ghost\"\n                  size=\"icon\"\n                  aria-label=\"Forward 30 seconds\"\n                >\n                  <SkipForward />\n                </Button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "800px"
  },
  "categories": [
    "media"
  ]
}