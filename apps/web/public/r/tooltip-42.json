{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "tooltip-42",
  "type": "registry:example",
  "description": "Profile name with a verified check icon that explains verification on hover.",
  "files": [
    {
      "path": "registry/designali/examples/tooltip/tooltip-42.tsx",
      "content": "import { BadgeCheckIcon } from \"lucide-react\"\n\nimport { Avatar, AvatarFallback } from \"@workspace/ui/components/avatar\"\nimport {\n  Tooltip,\n  TooltipContent,\n  TooltipTrigger,\n} from \"@workspace/ui/components/tooltip\"\n\nexport default function VerifiedBadgeTooltip() {\n  return (\n    <div className=\"flex items-center gap-3\">\n      <Avatar size=\"lg\">\n        <AvatarFallback>RV</AvatarFallback>\n      </Avatar>\n      <div className=\"flex flex-col\">\n        <div className=\"flex items-center gap-1\">\n          <span className=\"text-sm font-semibold\">Rosa Vidal</span>\n          <Tooltip>\n            <TooltipTrigger\n              render={\n                <button\n                  type=\"button\"\n                  aria-label=\"Verified\"\n                  className=\"text-sky-500\"\n                />\n              }\n            >\n              <BadgeCheckIcon className=\"size-4\" />\n            </TooltipTrigger>\n            <TooltipContent>Identity verified on Mar 4, 2026</TooltipContent>\n          </Tooltip>\n        </div>\n        <span className=\"text-xs text-muted-foreground\">\n          Product designer · Lisbon\n        </span>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}