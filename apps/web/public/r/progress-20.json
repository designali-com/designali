{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "progress-20",
  "type": "registry:example",
  "description": "Sprint summary card with story points completed and assigned team avatars.",
  "files": [
    {
      "path": "registry/designali/examples/progress/progress-20.tsx",
      "content": "import {\n  Avatar,\n  AvatarFallback,\n  AvatarGroup,\n} from \"@workspace/ui/components/avatar\"\nimport {\n  Progress,\n  ProgressLabel,\n  ProgressValue,\n} from \"@workspace/ui/components/progress\"\n\nconst team = [\"Ali Imam\", \"Theo\", \"Iris\"]\n\nexport default function SprintProgressCard() {\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-4 border p-4\">\n      <div className=\"flex items-start justify-between gap-2\">\n        <div>\n          <p className=\"text-sm font-medium\">\n            Sprint 24 &middot; designali.com pricing revamp\n          </p>\n          <p className=\"text-xs text-muted-foreground\">Ends Friday, Nov 21</p>\n        </div>\n        <AvatarGroup>\n          {team.map((name) => (\n            <Avatar key={name} size=\"sm\">\n              <AvatarFallback>\n                {name\n                  .split(\" \")\n                  .map((p) => p[0])\n                  .join(\"\")}\n              </AvatarFallback>\n            </Avatar>\n          ))}\n        </AvatarGroup>\n      </div>\n      <Progress\n        value={34}\n        max={52}\n        className=\"[&_[data-slot=progress-track]]:h-2\"\n      >\n        <ProgressLabel>34 of 52 points</ProgressLabel>\n        <ProgressValue />\n      </Progress>\n      <div className=\"grid grid-cols-3 gap-2 text-center text-xs\">\n        <div className=\"bg-muted p-2\">\n          <p className=\"text-base font-semibold\">9</p>Done\n        </div>\n        <div className=\"bg-muted p-2\">\n          <p className=\"text-base font-semibold\">5</p>In review\n        </div>\n        <div className=\"bg-muted p-2\">\n          <p className=\"text-base font-semibold\">4</p>To do\n        </div>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}