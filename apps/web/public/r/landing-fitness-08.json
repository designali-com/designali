      "path": "registry/designali/pages/fitness/landing-fitness-08/page.tsx",
      "content": "import {\n  Apple,\n  ArrowRight,\n  ArrowUpRight,\n  CalendarDays,\n  Check,\n  Dumbbell,\n  HeartPulse,\n  Plus,\n  Quote,\n  Smartphone,\n  Sparkles,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport { Input } from \"@workspace/ui/components/input\"\n\nconst navLinks = [\"Classes\", \"Coaches\", \"Membership\", \"Locations\", \"App\"]\n\nconst logos = [\n  \"Wired\",\n  \"Men's Health\",\n  \"Runner's World\",\n  \"Outside\",\n  \"Shape\",\n  \"GQ\",\n  \"Women's Health\",\n  \"Vogue\",\n]\n\nconst features = [\n  {\n    icon: Sparkles,\n    title: \"Recovery suite\",\n    description:\n      \"Sauna, cold plunge and compression boots included with every unlimited membership.\",\n  },\n  {\n    icon: Dumbbell,\n    title: \"Coach-led strength\",\n    description:\n      \"Small-group sessions capped at 12 people, so every rep gets a coach's eye on your form.\",\n  },\n  {\n    icon: CalendarDays,\n    title: \"Programs that progress\",\n    description:\n      \"Twelve-week training blocks that adjust load and volume as you get stronger.\",\n  },\n  {\n    icon: Smartphone,\n    title: \"Book from the app\",\n    description:\n      \"Reserve classes, join the waitlist and track every workout from your phone.\",\n  },\n  {\n    icon: HeartPulse,\n    title: \"Heart-rate tracking\",\n    description:\n      \"See your effort zones live on the screens and get a summary after every class.\",\n  },\n  {\n    icon: Apple,\n    title: \"Nutrition coaching\",\n    description:\n      \"Simple, sustainable meal guidance from registered dietitians, built around foods you enjoy.\",\n  },\n]\n\nconst stats = [\n  { value: \"120+\", label: \"Classes every week\" },\n  { value: \"4.9\", label: \"Average class rating\" },\n  { value: \"86%\", label: \"Hit their 12-week goal\" },\n  { value: \"45\", label: \"Certified coaches\" },\n]\n\nconst steps = [\n  {\n    title: \"Book a free intro\",\n    description:\n      \"Meet a coach for a 30-minute session to talk goals, history and any injuries.\",\n  },\n  {\n    title: \"Get your plan\",\n    description:\n      \"We recommend classes and a weekly schedule based on your experience and goals.\",\n  },\n  {\n    title: \"Train consistently\",\n    description:\n      \"Show up two to four times a week. The app reminds you and tracks your progress.\",\n  },\n  {\n    title: \"Retest and level up\",\n    description:\n      \"Every 12 weeks we retest your benchmarks and set the next target together.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Strength Foundations\",\n    meta: \"Barbell basics · 50 min\",\n    tag: \"Beginner\",\n    price: \"6:30 AM\",\n    tile: \"bg-gradient-to-br from-sky-200 via-cyan-300 to-teal-400 dark:from-sky-700 dark:via-cyan-800 dark:to-teal-900\",\n  },\n  {\n    name: \"Hybrid Conditioning\",\n    meta: \"Rower, sled, kettlebell · 45 min\",\n    tag: \"Popular\",\n    price: \"7:15 AM\",\n    tile: \"bg-gradient-to-br from-violet-200 via-purple-300 to-fuchsia-400 dark:from-violet-700 dark:via-purple-800 dark:to-fuchsia-900\",\n  },\n  {\n    name: \"Power Yoga\",\n    meta: \"Heated flow · 60 min\",\n    tag: \"All levels\",\n    price: \"12:00 PM\",\n    tile: \"bg-gradient-to-br from-emerald-200 via-green-300 to-lime-300 dark:from-emerald-700 dark:via-green-800 dark:to-lime-900\",\n  },\n  {\n    name: \"Ride 45\",\n    meta: \"Indoor cycling intervals · 45 min\",\n    tag: \"Cardio\",\n    price: \"5:45 PM\",\n    tile: \"bg-gradient-to-br from-stone-200 via-neutral-300 to-zinc-400 dark:from-stone-700 dark:via-neutral-800 dark:to-zinc-900\",\n  },\n  {\n    name: \"Olympic Lifting\",\n    meta: \"Snatch and clean technique · 60 min\",\n    tag: \"Advanced\",\n    price: \"6:30 PM\",\n    tile: \"bg-gradient-to-br from-rose-200 via-pink-300 to-purple-300 dark:from-rose-700 dark:via-pink-800 dark:to-purple-900\",\n  },\n  {\n    name: \"Mobility Reset\",\n    meta: \"Stretch and breathwork · 30 min\",\n    tag: \"Recovery\",\n    price: \"8:00 PM\",\n    tile: \"bg-gradient-to-br from-blue-200 via-indigo-300 to-violet-400 dark:from-blue-700 dark:via-indigo-800 dark:to-violet-900\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"I have joined a dozen gyms and quit them all. This is the first place where people notice if I do not show up.\",\n    name: \"James Porter\",\n    role: \"Member for 18 months\",\n  },\n  {\n    quote:\n      \"The app plans my week for me. I just open it, see what is next and go. Zero decision fatigue.\",\n    name: \"Aisha Bello\",\n    role: \"App subscriber\",\n  },\n  {\n    quote:\n      \"Lost 9kg, dropped my blood pressure and actually look forward to Monday mornings now.\",\n    name: \"Daniel Russo\",\n    role: \"12-week program graduate\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Flex\",\n    price: \"$25\",\n    period: \"/class\",\n    description: \"Drop in whenever your schedule allows.\",\n    features: [\n      \"Any class, any studio\",\n      \"Book 7 days ahead\",\n      \"Free towel and lockers\",\n      \"No commitment\",\n    ],\n    cta: \"Book a class\",\n  },\n  {\n    name: \"Unlimited\",\n    price: \"$169\",\n    period: \"/month\",\n    description: \"For members training three or more times a week.\",\n    features: [\n      \"Unlimited classes\",\n      \"Recovery suite access\",\n      \"Quarterly progress testing\",\n      \"Bring a friend monthly\",\n      \"Book 14 days ahead\",\n    ],\n    cta: \"Join now\",\n  },\n  {\n    name: \"Personal\",\n    price: \"$399\",\n    period: \"/month\",\n    description: \"One-to-one coaching with a dedicated trainer.\",\n    features: [\n      \"8 private sessions\",\n      \"Custom program\",\n      \"Nutrition coaching\",\n      \"Unlimited classes\",\n      \"Weekly check-ins\",\n    ],\n    cta: \"Meet a coach\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"What should I bring to my first class?\",\n    a: \"Comfortable clothes, trainers and a water bottle. Towels, lockers and showers are provided.\",\n  },\n  {\n    q: \"Can I freeze my membership?\",\n    a: \"Yes. You can freeze for up to three months per year at no cost, straight from the app.\",\n  },\n  {\n    q: \"How early should I arrive?\",\n    a: \"Arrive ten minutes early for your first visit so a coach can show you around and set up your equipment.\",\n  },\n  {\n    q: \"Is there a minimum contract?\",\n    a: \"No. Memberships are month to month and can be cancelled with 30 days notice.\",\n  },\n  {\n    q: \"Do you offer corporate memberships?\",\n    a: \"Yes. Teams of five or more get discounted rates and a dedicated onboarding session.\",\n  },\n]\n\nconst footer = [\n  {\n    title: \"Train\",\n    links: [\"Classes\", \"Personal training\", \"Online coaching\", \"Schedule\"],\n  },\n  {\n    title: \"Studios\",\n    links: [\"Downtown\", \"Riverside\", \"North Park\", \"All locations\"],\n  },\n  {\n    title: \"About\",\n    links: [\"Our coaches\", \"Careers\", \"Gift cards\", \"Contact\"],\n  },\n]\n\nexport default function LandingFitness08() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <div className=\"border-b bg-muted/50 text-muted-foreground px-4 py-2 text-center text-xs sm:text-sm\">\n        <a\n          href=\"#\"\n          className=\"inline-flex items-center gap-1.5 hover:underline\"\n        >\n          Free download: our 7-day high protein meal plan\n          <ArrowRight className=\"size-3.5\" />\n        </a>\n      </div>\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-orange-600 text-white text-sm\">\n              F\n            </span>\n            <span className=\"\">Fuelplan</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Member login\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Get a free plan\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"relative overflow-hidden border-b\">\n        <div className=\"mx-auto grid max-w-7xl items-center gap-12 px-6 py-16 md:py-24 lg:grid-cols-2\">\n          <div className=\"space-y-7\">\n            <span className=\"inline-flex items-center gap-2 rounded-full border bg-background text-muted-foreground px-3 py-1 text-xs font-medium\">\n              <Sparkles className=\"size-3.5 text-orange-600 dark:text-orange-400\" />\n              Nutrition coaching\n            </span>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-6xl \">\n              {\"Eat for your goals, \"}\n              <span className=\"text-orange-600 dark:text-orange-400\">\n                without strict diets\n              </span>\n            </h1>\n            <p className=\"max-w-xl text-lg leading-8 text-muted-foreground\">\n              Fuelplan pairs you with a registered dietitian who builds flexible\n              meal plans around your training, schedule and favourite foods.\n            </p>\n            <form\n              action=\"#\"\n              className=\"flex w-full max-w-md flex-col gap-2 sm:flex-row \"\n            >\n              <Input\n                type=\"email\"\n                required\n                placeholder=\"you@company.com\"\n                aria-label=\"Email address\"\n                className=\"h-10 bg-background\"\n              />\n              <Button type=\"submit\" size=\"lg\">\n                Get a free plan\n                <ArrowRight />\n              </Button>\n            </form>\n            <div className=\"flex flex-wrap gap-x-8 gap-y-3 pt-2\">\n              {stats.slice(0, 3).map((stat) => (\n                <div key={stat.label}>\n                  <div className=\"text-2xl font-semibold tracking-tight\">\n                    {stat.value}\n                  </div>\n                  <div className=\"text-xs text-muted-foreground\">\n                    {stat.label}\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n          <div className=\"relative\">\n            <div className=\"absolute -inset-8 -z-10 rounded-full bg-gradient-to-tr from-orange-500/25 via-amber-500/10 to-transparent blur-3xl\" />\n            <HeroVisual />\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-12\">\n          <p className=\"text-center text-sm text-muted-foreground\">\n            As featured in\n          </p>\n          <div className=\"mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-6 sm:grid-cols-4 lg:grid-cols-8\">\n            {logos.map((logo) => (\n              <div\n                key={logo}\n                className=\"text-center text-base font-semibold tracking-tight text-muted-foreground/70 \"\n              >\n                {logo}\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b bg-muted/30\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"max-w-2xl\">\n            <p className=\"text-sm font-medium text-orange-600 dark:text-orange-400\">\n              Training\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              Everything you need to get stronger\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Expert coaching, smart programming and a community that shows up,\n              whether you train with us in person or at home.\n            </p>\n          </div>\n          <div className=\"mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3\">\n            {features.map((feature) => (\n              <div\n                key={feature.title}\n                className=\"rounded-xl border bg-background p-6 shadow-xs\"\n              >\n                <span className=\"flex size-10 items-center justify-center rounded-lg bg-orange-500/10\">\n                  <feature.icon className=\"size-5 text-orange-600 dark:text-orange-400\" />\n                </span>\n                <h3 className=\"mt-5 font-semibold\">{feature.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              How to get started\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-orange-600 dark:text-orange-400\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Find your class\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                More than 120 sessions a week, from sunrise strength to\n                late-night mobility. Book in two taps.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a key={item.name} href=\"#\" className=\"group\">\n                <div\n                  className={`relative aspect-[4/3] overflow-hidden rounded-2xl ${item.tile}`}\n                >\n                  <div className=\"absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10\" />\n                  <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-zinc-900 backdrop-blur\">\n                    {item.tag}\n                  </span>\n                </div>\n                <div className=\"mt-4 flex items-start justify-between gap-4\">\n                  <div className=\"min-w-0\">\n                    <h3 className=\"font-medium \">{item.name}</h3>\n                    <p className=\"mt-1 text-sm text-muted-foreground\">\n                      {item.meta}\n                    </p>\n                  </div>\n                  <span className=\"shrink-0 text-sm font-semibold\">\n                    {item.price}\n                  </span>\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b \">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Real members, real results\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-4 md:grid-cols-3\">\n            {testimonials.map((t, i) => (\n              <figure\n                key={t.name}\n                className={`flex flex-col justify-between rounded-2xl border bg-background p-6 ${i === 0 ? \"md:col-span-2 md:p-10\" : \"\"}`}\n              >\n                <Quote className=\"size-6 text-orange-600 dark:text-orange-400\" />\n                <blockquote\n                  className={`mt-4 leading-relaxed ${i === 0 ? \"text-xl md:text-2xl\" : \"text-muted-foreground\"}`}\n                >\n                  {t.quote}\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 text-sm\">\n                  <span className=\"flex size-9 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Memberships for every routine\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              No joining fee, no long contracts. Freeze or cancel your\n              membership any time from the app.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-orange-500 shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-orange-600 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-orange-600 dark:text-orange-400\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Before your first session\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Get in touch\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"px-6 py-20 md:py-28\">\n        <div className=\"relative mx-auto max-w-6xl overflow-hidden rounded-3xl border bg-orange-500/10 px-6 py-16 text-center md:py-24\">\n          <div className=\"pointer-events-none absolute -top-24 left-1/2 size-96 -translate-x-1/2 rounded-full bg-gradient-to-b from-orange-500/25 via-amber-500/10 to-transparent blur-3xl\" />\n          <div className=\"relative mx-auto max-w-2xl space-y-6\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Get your free 7-day meal plan\n            </h2>\n            <p className=\"text-lg text-muted-foreground\">\n              Enter your email and we will send a plan matched to your goals.\n            </p>\n            <form\n              action=\"#\"\n              className=\"flex w-full max-w-md flex-col gap-2 sm:flex-row mx-auto\"\n            >\n              <Input\n                type=\"email\"\n                required\n                placeholder=\"you@company.com\"\n                aria-label=\"Email address\"\n                className=\"h-10 bg-background\"\n              />\n              <Button type=\"submit\" size=\"lg\">\n                Get a free plan\n                <ArrowRight />\n              </Button>\n            </form>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-orange-600 text-white text-sm\">\n                F\n              </span>\n              <span className=\"\">Fuelplan</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              Nutrition that fits your life.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Fuelplan. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  return (\n    <div className=\"grid grid-cols-2 gap-3 md:grid-cols-3\">\n      {showcase.slice(0, 3).map((item, i) => (\n        <div\n          key={item.name}\n          className={`relative overflow-hidden rounded-2xl ${item.tile} ${i === 0 ? \"col-span-2 aspect-[16/10] md:col-span-1 md:aspect-[3/4]\" : \"aspect-[3/4]\"}`}\n        >\n          <div className=\"absolute inset-0 bg-gradient-to-t from-black/50 via-black/0 to-black/0\" />\n          <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-zinc-900 backdrop-blur\">\n            {item.tag}\n          </span>\n          <div className=\"absolute inset-x-3 bottom-3 flex items-end justify-between gap-2 text-white\">\n            <div className=\"min-w-0\">\n              <div className=\"truncate text-sm font-medium\">{item.name}</div>\n              <div className=\"truncate text-xs text-white/75\">{item.meta}</div>\n            </div>\n            <div className=\"shrink-0 text-sm font-semibold\">{item.price}</div>\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n",
