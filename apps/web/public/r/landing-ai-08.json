      "path": "registry/designali/pages/ai/landing-ai-08/page.tsx",
      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  Bot,\n  Check,\n  Database,\n  FlaskConical,\n  Gauge,\n  Languages,\n  Lock,\n  Plus,\n  Quote,\n  Sparkles,\n} from \"@designali/icons\"\n\nimport { Logo } from \"@/src/components/logo\"\nimport { Button } from \"@workspace/ui/components/button\"\nimport { Input } from \"@workspace/ui/components/input\"\n\nconst navLinks = [\"Workflows\", \"Tools\", \"Pricing\", \"Work\", \"Docs\"]\n\nconst logos = [\n  \"Notion\",\n  \"Figma\",\n  \"Cursor\",\n  \"Claude\",\n  \"OpenAI\",\n  \"v0\",\n  \"Vercel\",\n  \"Next.js\",\n]\n\nconst features = [\n  {\n    icon: Languages,\n    title: \"Multilingual content\",\n    description:\n      \"Draft UI copy and landing pages in many languages, then polish them with a human eye.\",\n  },\n  {\n    icon: Database,\n    title: \"Grounded in your brand\",\n    description:\n      \"AI drafts start from your brand guidelines, tokens and components, so every output already looks like you.\",\n  },\n  {\n    icon: Bot,\n    title: \"Prompt-to-prototype\",\n    description:\n      \"Turn a written brief into clickable Next.js prototypes built from Designali blocks in a day.\",\n  },\n  {\n    icon: Lock,\n    title: \"Human-crafted finish\",\n    description:\n      \"AI speeds up exploration, but Ali Imam reviews, refines and hand-codes every final detail.\",\n  },\n  {\n    icon: Gauge,\n    title: \"Faster iterations\",\n    description:\n      \"Explore dozens of layout and visual directions in hours instead of weeks.\",\n  },\n  {\n    icon: FlaskConical,\n    title: \"Design QA with AI\",\n    description:\n      \"Automated checks for spacing, contrast and copy catch issues before a review call.\",\n  },\n]\n\nconst stats = [\n  { value: \"2300+\", label: \"UI examples as references\" },\n  { value: \"3x\", label: \"Faster first concepts\" },\n  { value: \"4000+\", label: \"Icons in @designali/icons\" },\n  { value: \"240+\", label: \"Landing pages to start from\" },\n]\n\nconst steps = [\n  {\n    title: \"Share your brief\",\n    description:\n      \"Send goals, references and brand assets. We turn them into a structured AI-ready brief.\",\n  },\n  {\n    title: \"Explore with AI\",\n    description:\n      \"Generate moodboards, layouts and copy directions fast, then pick the strongest routes together.\",\n  },\n  {\n    title: \"Refine by hand\",\n    description:\n      \"Ali refines the chosen direction in Figma, with real type, spacing and motion decisions.\",\n  },\n  {\n    title: \"Ship production code\",\n    description:\n      \"We build it in Next.js, TypeScript and Tailwind CSS and deploy it on Vercel.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Moodboard sprint\",\n    meta: \"AI-generated visual directions\",\n    tag: \"Popular\",\n    price: \"1 day\",\n  },\n  {\n    name: \"Brief to wireframe\",\n    meta: \"Structured flows from a written brief\",\n    tag: \"UX\",\n    price: \"2 days\",\n  },\n  {\n    name: \"Design QA pass\",\n    meta: \"Checks contrast, spacing and consistency\",\n    tag: \"QA\",\n    price: \"3 days\",\n  },\n  {\n    name: \"Prompt to prototype\",\n    meta: \"Clickable Next.js prototype from blocks\",\n    tag: \"New\",\n    price: \"5 days\",\n  },\n  {\n    name: \"Copy drafts\",\n    meta: \"On-brand UI and landing page copy\",\n    tag: \"Popular\",\n    price: \"Same day\",\n  },\n  {\n    name: \"CGI concepts\",\n    meta: \"AI-assisted 3D and render explorations\",\n    tag: \"3D\",\n    price: \"2 days\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"Ali uses AI to move fast, not to cut corners. Every component in the final build was clean and typed.\",\n    name: \"Rafael O.\",\n    role: \"Engineering lead, Designali client\",\n  },\n  {\n    quote:\n      \"We went from a one-page brief to a working prototype in three days. Our investors thought it was live.\",\n    name: \"Grace W.\",\n    role: \"Product lead, Designali client\",\n  },\n  {\n    quote:\n      \"The AI-assisted workflow cut our design timeline in half without any drop in quality.\",\n    name: \"Kenji W.\",\n    role: \"CTO, Designali client\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Free\",\n    price: \"$0\",\n    period: \"/month\",\n    description: \"For makers exploring AI-assisted design.\",\n    features: [\n      \"Free Designali blocks\",\n      \"Free @designali/icons\",\n      \"Starter prompt library\",\n      \"Docs and blog guides\",\n    ],\n    cta: \"Start for free\",\n  },\n  {\n    name: \"Pro\",\n    price: \"$29\",\n    period: \"/month\",\n    description: \"For designers and developers shipping with AI every day.\",\n    features: [\n      \"All blocks and templates\",\n      \"Full AI prompt library\",\n      \"All 2300+ UI examples\",\n      \"Prompt-to-prototype\",\n      \"New releases every month\",\n    ],\n    cta: \"Get Pro\",\n  },\n  {\n    name: \"Studio\",\n    price: \"Custom\",\n    period: \"\",\n    description: \"An AI-assisted design and build project with Ali Imam.\",\n    features: [\n      \"Custom AI workflow setup\",\n      \"Brand-trained prompt library\",\n      \"Design system in code\",\n      \"Next.js build on Vercel\",\n      \"Weekly calls with Ali\",\n    ],\n    cta: \"Start a project\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"Which AI tools do you use?\",\n    a: \"We pick the right tool per task, such as Claude, Cursor and image models, alongside Figma and Next.js.\",\n  },\n  {\n    q: \"How do you keep AI output on-brand?\",\n    a: \"Prompts start from your brand guidelines and components, and every output goes through a human design review.\",\n  },\n  {\n    q: \"Can you set up AI workflows for our team?\",\n    a: \"Yes. Studio projects can include a documented prompt library and workflow your team keeps using after launch.\",\n  },\n  {\n    q: \"How is the work billed?\",\n    a: \"Pro is a simple monthly plan. Studio projects are quoted as a fixed price after a discovery call.\",\n  },\n  {\n    q: \"Will our files be kept private?\",\n    a: \"Yes. Your assets are only used for your project, and you own every Figma file and line of code we produce.\",\n  },\n]\n\nconst footer = [\n  { title: \"Workflows\", links: [\"Moodboards\", \"Prototypes\", \"Design QA\", \"Pricing\"] },\n  { title: \"Studio\", links: [\"About\", \"Work\", \"Blog\", \"Contact\"] },\n  {\n    title: \"Follow\",\n    links: [\"Instagram\", \"X\", \"LinkedIn\", \"21st.dev\"],\n  },\n]\n\nexport default function LandingAi08() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <div className=\"border-b bg-muted/50 text-muted-foreground px-4 py-2 text-center text-xs sm:text-sm\">\n        <a\n          href=\"#\"\n          className=\"inline-flex items-center gap-1.5 hover:underline\"\n        >\n          Early access: Designali AI design course\n          <ArrowRight className=\"size-3.5\" />\n        </a>\n      </div>\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <Logo className=\"h-5 w-auto\" />\n            <span className=\"\">designali</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View work\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Join the waitlist\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"relative overflow-hidden border-b\">\n        <div className=\"mx-auto grid max-w-7xl items-center gap-12 px-6 py-16 md:py-24 lg:grid-cols-2\">\n          <div className=\"space-y-7\">\n            <span className=\"inline-flex items-center gap-2 rounded-full border bg-background text-muted-foreground px-3 py-1 text-xs font-medium\">\n              <Sparkles className=\"size-3.5 text-primary dark:text-primary\" />\n              Designali AI design lessons\n            </span>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-6xl \">\n              {\"Learn AI-assisted design for \"}\n              <span className=\"text-primary dark:text-primary\">\n                every designer\n              </span>\n            </h1>\n            <p className=\"max-w-xl text-lg leading-8 text-muted-foreground\">\n              Ali Imam explains how to design and code with AI step by step, from prompting to polishing, using real Designali projects.\n            </p>\n            <form\n              action=\"#\"\n              className=\"flex w-full max-w-md flex-col gap-2 sm:flex-row \"\n            >\n              <Input\n                type=\"email\"\n                required\n                placeholder=\"you@example.com\"\n                aria-label=\"Email address\"\n                className=\"h-10 bg-background\"\n              />\n              <Button type=\"submit\" size=\"lg\">\n                Join the waitlist\n                <ArrowRight />\n              </Button>\n            </form>\n            <div className=\"flex flex-wrap gap-x-8 gap-y-3 pt-2\">\n              {stats.slice(0, 3).map((stat) => (\n                <div key={stat.label}>\n                  <div className=\"text-2xl font-semibold tracking-tight\">\n                    {stat.value}\n                  </div>\n                  <div className=\"text-xs text-muted-foreground\">\n                    {stat.label}\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n          <div className=\"relative\">\n            <div className=\"absolute -inset-8 -z-10 rounded-full bg-gradient-to-tr from-primary/25 via-primary/10 to-transparent blur-3xl\" />\n            <HeroVisual />\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-12\">\n          <p className=\"text-center text-sm text-muted-foreground\">\n            Our AI-assisted workflow runs on\n          </p>\n          <div className=\"mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-6 sm:grid-cols-4 lg:grid-cols-8\">\n            {logos.map((logo) => (\n              <div\n                key={logo}\n                className=\"text-center text-base font-semibold tracking-tight text-muted-foreground/70 \"\n              >\n                {logo}\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b bg-muted/30\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"max-w-2xl\">\n            <p className=\"text-sm font-medium text-primary dark:text-primary\">\n              Capabilities\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              AI that speeds up design without replacing craft\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Where thoughtful design meets production-ready code, with AI handling the busywork in between.\n            </p>\n          </div>\n          <div className=\"mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3\">\n            {features.map((feature) => (\n              <div\n                key={feature.title}\n                className=\"rounded-xl border bg-background p-6 shadow-xs\"\n              >\n                <span className=\"flex size-10 items-center justify-center rounded-lg bg-primary/10\">\n                  <feature.icon className=\"size-5 text-primary dark:text-primary\" />\n                </span>\n                <h3 className=\"mt-5 font-semibold\">{feature.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              From first prompt to production\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-primary dark:text-primary\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Ready-made AI workflows\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                Start from a tested Designali workflow, add your brand and get results fast. Every step is reviewed by a human.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a\n                key={item.name}\n                href=\"#\"\n                className=\"group flex flex-col rounded-xl border p-6 transition-colors hover:bg-muted/40\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"flex size-10 items-center justify-center rounded-lg border bg-muted/50 font-semibold \">\n                    {item.name.charAt(0)}\n                  </span>\n                  <span className=\"rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary dark:text-primary\">\n                    {item.tag}\n                  </span>\n                </div>\n                <h3 className=\"mt-6 font-semibold \">{item.name}</h3>\n                <p className=\"mt-1 flex-1 text-sm text-muted-foreground\">\n                  {item.meta}\n                </p>\n                <div className=\"mt-6 flex items-center justify-between border-t pt-4 text-sm\">\n                  <span className=\"font-medium\">{item.price}</span>\n                  <ArrowUpRight className=\"size-4 text-muted-foreground transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5\" />\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b \">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Loved by teams shipping with Designali\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-4 md:grid-cols-3\">\n            {testimonials.map((t, i) => (\n              <figure\n                key={t.name}\n                className={`flex flex-col justify-between rounded-2xl border bg-background p-6 ${i === 0 ? \"md:col-span-2 md:p-10\" : \"\"}`}\n              >\n                <Quote className=\"size-6 text-primary dark:text-primary\" />\n                <blockquote\n                  className={`mt-4 leading-relaxed ${i === 0 ? \"text-xl md:text-2xl\" : \"text-muted-foreground\"}`}\n                >\n                  {t.quote}\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 text-sm\">\n                  <span className=\"flex size-9 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Simple, transparent pricing\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Free resources, a simple Pro plan, or a custom AI-assisted project with Ali Imam.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-primary shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-chart-2 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-primary dark:text-primary\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Frequently asked questions\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Email hello@designali.com\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"px-6 py-20 md:py-28\">\n        <div className=\"relative mx-auto max-w-6xl overflow-hidden rounded-3xl border bg-primary/10 px-6 py-16 text-center md:py-24\">\n          <div className=\"pointer-events-none absolute -top-24 left-1/2 size-96 -translate-x-1/2 rounded-full bg-gradient-to-b from-primary/25 via-primary/10 to-transparent blur-3xl\" />\n          <div className=\"relative mx-auto max-w-2xl space-y-6\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Get early access to the course\n            </h2>\n            <p className=\"text-lg text-muted-foreground\">\n              Leave your email and we will send an invite as soon as the first lessons open.\n            </p>\n            <form\n              action=\"#\"\n              className=\"flex w-full max-w-md flex-col gap-2 sm:flex-row mx-auto\"\n            >\n              <Input\n                type=\"email\"\n                required\n                placeholder=\"you@example.com\"\n                aria-label=\"Email address\"\n                className=\"h-10 bg-background\"\n              />\n              <Button type=\"submit\" size=\"lg\">\n                Join the waitlist\n                <ArrowRight />\n              </Button>\n            </form>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <Logo className=\"h-5 w-auto\" />\n              <span className=\"\">designali</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              Learning that meets you where you are.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Designali. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  const bars = [38, 52, 44, 63, 58, 71, 66, 80, 74, 88, 83, 95]\n  return (\n    <div className=\"overflow-hidden rounded-xl border bg-card text-left text-card-foreground shadow-2xl/10\">\n      <div className=\"flex items-center gap-2 border-b px-4 py-3\">\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"ml-3 hidden rounded-md bg-muted px-3 py-0.5 text-[11px] text-muted-foreground sm:inline\">\n          designali.com/ai\n        </span>\n      </div>\n      <div className=\"grid md:grid-cols-[180px_1fr]\">\n        <aside className=\"hidden space-y-1 border-r p-3 text-sm md:block\">\n          {navLinks.map((link, i) => (\n            <div\n              key={link}\n              className={`rounded-md px-3 py-1.5 ${i === 0 ? \"bg-muted font-medium\" : \"text-muted-foreground\"}`}\n            >\n              {link}\n            </div>\n          ))}\n        </aside>\n        <div className=\"space-y-4 p-4 md:p-6\">\n          <div className=\"grid grid-cols-2 gap-3 lg:grid-cols-4\">\n            {stats.slice(0, 4).map((stat) => (\n              <div key={stat.label} className=\"rounded-lg border p-3\">\n                <div className=\"truncate text-[11px] text-muted-foreground\">\n                  {stat.label}\n                </div>\n                <div className=\"mt-1 text-lg font-semibold tracking-tight\">\n                  {stat.value}\n                </div>\n              </div>\n            ))}\n          </div>\n          <div className=\"rounded-lg border p-4\">\n            <div className=\"mb-4 flex items-center justify-between text-xs\">\n              <span className=\"font-medium\">Last 12 weeks</span>\n              <span className=\"text-primary dark:text-primary\">\n                +24.6%\n              </span>\n            </div>\n            <div className=\"flex h-32 items-end gap-1.5\">\n              {bars.map((h, i) => (\n                <div\n                  key={i}\n                  className={`flex-1 rounded-t-sm ${i === bars.length - 1 ? \"bg-chart-2\" : \"bg-muted-foreground/20\"}`}\n                  style={{ height: `${h}%` }}\n                />\n              ))}\n            </div>\n          </div>\n          <div className=\"hidden divide-y rounded-lg border sm:block\">\n            {showcase.slice(0, 3).map((item) => (\n              <div\n                key={item.name}\n                className=\"flex items-center justify-between gap-4 px-4 py-2.5 text-sm\"\n              >\n                <div className=\"min-w-0\">\n                  <div className=\"truncate font-medium\">{item.name}</div>\n                  <div className=\"truncate text-xs text-muted-foreground\">\n                    {item.meta}\n                  </div>\n                </div>\n                <span className=\"shrink-0 rounded-full bg-primary/10 px-2 py-0.5 text-[11px] font-medium text-primary dark:text-primary\">\n                  {item.tag}\n                </span>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n    </div>\n  )\n}\n",
