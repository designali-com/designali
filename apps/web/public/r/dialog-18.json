{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dialog-18",
  "type": "registry:example",
  "description": "Billing dialog for adding a card with number, expiry and CVC fields.",
  "files": [
    {
      "path": "registry/designali/examples/dialog/dialog-18.tsx",
      "content": "\"use client\"\n\nimport { CreditCardIcon, LockIcon, PlusIcon } from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport { Checkbox } from \"@workspace/ui/components/checkbox\"\nimport {\n  Dialog,\n  DialogClose,\n  DialogContent,\n  DialogDescription,\n  DialogFooter,\n  DialogHeader,\n  DialogTitle,\n  DialogTrigger,\n} from \"@workspace/ui/components/dialog\"\nimport { Field, FieldLabel } from \"@workspace/ui/components/field\"\nimport { Input } from \"@workspace/ui/components/input\"\nimport {\n  InputGroup,\n  InputGroupAddon,\n  InputGroupInput,\n} from \"@workspace/ui/components/input-group\"\n\nexport default function AddPaymentMethodDialog() {\n  return (\n    <Dialog>\n      <DialogTrigger render={<Button variant=\"outline\" />}>\n        <PlusIcon data-icon=\"inline-start\" />\n        Add payment method\n      </DialogTrigger>\n      <DialogContent>\n        <DialogHeader>\n          <DialogTitle>Add card</DialogTitle>\n          <DialogDescription>\n            Your card will be charged on the 1st of each month.\n          </DialogDescription>\n        </DialogHeader>\n        <form\n          className=\"flex flex-col gap-4\"\n          onSubmit={(event) => event.preventDefault()}\n        >\n          <Field>\n            <FieldLabel htmlFor=\"card-name\">Name on card</FieldLabel>\n            <Input id=\"card-name\" placeholder=\"Elena Vasquez\" />\n          </Field>\n          <Field>\n            <FieldLabel htmlFor=\"card-number\">Card number</FieldLabel>\n            <InputGroup>\n              <InputGroupAddon>\n                <CreditCardIcon />\n              </InputGroupAddon>\n              <InputGroupInput\n                id=\"card-number\"\n                inputMode=\"numeric\"\n                placeholder=\"4242 4242 4242 4242\"\n              />\n            </InputGroup>\n          </Field>\n          <div className=\"grid grid-cols-2 gap-3\">\n            <Field>\n              <FieldLabel htmlFor=\"card-expiry\">Expiry</FieldLabel>\n              <Input id=\"card-expiry\" placeholder=\"MM / YY\" />\n            </Field>\n            <Field>\n              <FieldLabel htmlFor=\"card-cvc\">CVC</FieldLabel>\n              <Input id=\"card-cvc\" placeholder=\"123\" inputMode=\"numeric\" />\n            </Field>\n          </div>\n          <Field orientation=\"horizontal\">\n            <Checkbox id=\"card-default\" defaultChecked />\n            <FieldLabel htmlFor=\"card-default\">\n              Set as default payment method\n            </FieldLabel>\n          </Field>\n          <DialogFooter>\n            <DialogClose render={<Button variant=\"outline\" />}>\n              Cancel\n            </DialogClose>\n            <Button type=\"submit\">\n              <LockIcon data-icon=\"inline-start\" />\n              Save card\n            </Button>\n          </DialogFooter>\n        </form>\n      </DialogContent>\n    </Dialog>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}