{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "resizable-22",
  "type": "registry:example",
  "description": "API playground with a request builder and a resizable JSON response panel.",
  "files": [
    {
      "path": "registry/designali/examples/resizable/resizable-22.tsx",
      "content": "import {\n  Send as SendIcon,\n} from \"@designali/icons\"\n\nimport { Badge } from \"@workspace/ui/components/badge\"\nimport { Button } from \"@workspace/ui/components/button\"\nimport { Input } from \"@workspace/ui/components/input\"\nimport {\n  ResizableHandle,\n  ResizablePanel,\n  ResizablePanelGroup,\n} from \"@workspace/ui/components/resizable\"\n\nconst response = {\n  id: \"ord_8F2kq\",\n  status: \"fulfilled\",\n  total: 129.5,\n  currency: \"EUR\",\n}\n\nexport default function ApiPlaygroundSplit() {\n  return (\n    <ResizablePanelGroup\n      orientation=\"horizontal\"\n      className=\"h-64 w-full max-w-2xl border\"\n    >\n      <ResizablePanel defaultSize=\"50%\" minSize=\"35%\">\n        <div className=\"flex h-full flex-col gap-3 p-3\">\n          <div className=\"flex gap-1\">\n            <Badge>GET</Badge>\n            <Input\n              aria-label=\"Endpoint\"\n              defaultValue=\"/v1/orders/ord_8F2kq\"\n              className=\"h-7 font-sans text-xs\"\n            />\n          </div>\n          <div className=\"flex flex-col gap-1 text-xs\">\n            <span className=\"font-medium\">Headers</span>\n            <span className=\"font-sans text-muted-foreground\">\n              Authorization: Bearer key_demo_...\n            </span>\n            <span className=\"font-sans text-muted-foreground\">\n              Accept: application/json\n            </span>\n          </div>\n          <Button size=\"sm\" className=\"mt-auto self-start\">\n            <SendIcon data-icon=\"inline-start\" />\n            Send request\n          </Button>\n        </div>\n      </ResizablePanel>\n      <ResizableHandle withHandle />\n      <ResizablePanel defaultSize=\"50%\" minSize=\"30%\">\n        <div className=\"flex h-full flex-col bg-muted/40\">\n          <div className=\"flex items-center gap-2 border-b px-3 py-1.5 text-xs\">\n            <Badge variant=\"secondary\">200 OK</Badge>\n            <span className=\"text-muted-foreground\">84 ms</span>\n          </div>\n          <pre className=\"flex-1 overflow-auto p-3 font-mono text-[11px]\">\n            {JSON.stringify(response, null, 2)}\n          </pre>\n        </div>\n      </ResizablePanel>\n    </ResizablePanelGroup>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}