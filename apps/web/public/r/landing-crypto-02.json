      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  ChartCandlestick,\n  Check,\n  Coins,\n  Landmark,\n  Lock,\n  Plus,\n  Quote,\n  Sparkles,\n  Wallet,\n  Zap,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Markets\", \"Earn\", \"Security\", \"Developers\", \"Learn\"]\n\nconst logos = [\n  \"Blockframe\",\n  \"Node Capital\",\n  \"Arcvault\",\n  \"Meridian\",\n  \"Chainlab\",\n  \"Polaris\",\n  \"Satori\",\n  \"Fidelis\",\n]\n\nconst features = [\n  {\n    icon: Lock,\n    title: \"Multi-party custody\",\n    description:\n      \"Keys are split across secure enclaves in three jurisdictions. No single person can ever move funds.\",\n  },\n  {\n    icon: Zap,\n    title: \"Sub-second execution\",\n    description:\n      \"Our matching engine handles 1.4 million orders per second with a median latency under 4ms.\",\n  },\n  {\n    icon: Coins,\n    title: \"Earn on idle assets\",\n    description:\n      \"Stake ETH, SOL and ATOM directly from your account, with rewards paid out daily and no lock-ups.\",\n  },\n  {\n    icon: ChartCandlestick,\n    title: \"Pro trading tools\",\n    description:\n      \"Advanced charting, limit, stop and OCO orders, plus a FIX and WebSocket API for algorithmic traders.\",\n  },\n  {\n    icon: Wallet,\n    title: \"Self-custody wallet\",\n    description:\n      \"Move to a non-custodial wallet with one tap and connect to thousands of decentralised apps.\",\n  },\n  {\n    icon: Landmark,\n    title: \"Fiat on and off ramps\",\n    description:\n      \"Deposit and withdraw in USD, EUR and GBP by bank transfer, card or Apple Pay, with same-day settlement.\",\n  },\n]\n\nconst stats = [\n  { value: \"6.2M\", label: \"Verified customers\" },\n  { value: \"312\", label: \"Supported assets\" },\n  { value: \"0.08%\", label: \"Lowest maker fee\" },\n  { value: \"98%\", label: \"Assets held in cold storage\" },\n]\n\nconst steps = [\n  {\n    title: \"Create your account\",\n    description:\n      \"Sign up with email and set up two-factor authentication in under a minute.\",\n  },\n  {\n    title: \"Verify your identity\",\n    description:\n      \"Upload an ID and a selfie. Most verifications are approved in under five minutes.\",\n  },\n  {\n    title: \"Fund your wallet\",\n    description:\n      \"Deposit by bank transfer, card or crypto from another wallet or exchange.\",\n  },\n  {\n    title: \"Trade and earn\",\n    description:\n      \"Buy, sell, swap or stake from one balance, with clear fees on every screen.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Bitcoin\",\n    meta: \"BTC · Market cap $1.3T\",\n    tag: \"+2.4%\",\n    price: \"$67,420\",\n  },\n  {\n    name: \"Ethereum\",\n    meta: \"ETH · Staking 3.8% APY\",\n    tag: \"+1.9%\",\n    price: \"$3,512\",\n  },\n  {\n    name: \"Solana\",\n    meta: \"SOL · Staking 6.7% APY\",\n    tag: \"+5.1%\",\n    price: \"$172.30\",\n  },\n  {\n    name: \"USD Coin\",\n    meta: \"USDC · Fully reserved\",\n    tag: \"Stable\",\n    price: \"$1.00\",\n  },\n  {\n    name: \"Chainlink\",\n    meta: \"LINK · Oracle network\",\n    tag: \"-0.6%\",\n    price: \"$18.04\",\n  },\n  { name: \"Arbitrum\", meta: \"ARB · Layer 2\", tag: \"New\", price: \"$1.12\" },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"The API is fast and boringly reliable, which is exactly what you want when your bots trade around the clock.\",\n    name: \"Kenji Watanabe\",\n    role: \"Quant Developer\",\n  },\n  {\n    quote:\n      \"I bought my first Bitcoin here. The interface explained everything without ever making me feel stupid.\",\n    name: \"Laura Mendes\",\n    role: \"Retail investor\",\n  },\n  {\n    quote:\n      \"Staking rewards land every day and I can unstake whenever I want. It just works the way it should.\",\n    name: \"Omar Haddad\",\n    role: \"Long-term holder\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Standard\",\n    price: \"0.40%\",\n    period: \"per trade\",\n    description: \"For everyday buying and selling.\",\n    features: [\n      \"Instant buy and sell\",\n      \"Recurring purchases\",\n      \"Staking rewards\",\n      \"Email support\",\n    ],\n    cta: \"Create account\",\n  },\n  {\n    name: \"Advanced\",\n    price: \"0.10%\",\n    period: \"maker fee\",\n    description: \"For active traders who want pro tools.\",\n    features: [\n      \"Full order book\",\n      \"Limit, stop and OCO orders\",\n      \"Advanced charting\",\n      \"API access\",\n      \"Priority support\",\n    ],\n    cta: \"Start trading\",\n  },\n  {\n    name: \"Institutional\",\n    price: \"Custom\",\n    period: \"\",\n    description: \"For funds, treasuries and market makers.\",\n    features: [\n      \"Dedicated custody\",\n      \"OTC desk\",\n      \"FIX API\",\n      \"Sub-accounts\",\n      \"Named account manager\",\n    ],\n    cta: \"Contact sales\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"Which countries are supported?\",\n    a: \"We serve customers in over 100 countries, including the US, UK, EU member states, Canada and Australia.\",\n  },\n  {\n    q: \"How long do withdrawals take?\",\n    a: \"Crypto withdrawals are processed within minutes. Bank withdrawals usually arrive the same or next business day.\",\n  },\n  {\n    q: \"Can I withdraw to my own wallet?\",\n    a: \"Yes. You can withdraw to any address you control, and we support every major network for each asset.\",\n  },\n  {\n    q: \"How are staking rewards paid?\",\n    a: \"Rewards are calculated daily and credited to your balance automatically. You can unstake at any time.\",\n  },\n  {\n    q: \"Do you report to tax authorities?\",\n    a: \"We provide downloadable tax reports and comply with local reporting rules in each country where we operate.\",\n  },\n]\n\nconst footer = [\n  {\n    title: \"Products\",\n    links: [\"Exchange\", \"Wallet\", \"Staking\", \"Institutional\"],\n  },\n  {\n    title: \"Company\",\n    links: [\"About\", \"Careers\", \"Proof of reserves\", \"Press\"],\n  },\n  { title: \"Support\", links: [\"Help center\", \"Fees\", \"API docs\", \"Status\"] },\n]\n\nexport default function LandingCrypto02() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <div className=\"border-b bg-muted/50 text-muted-foreground px-4 py-2 text-center text-xs sm:text-sm\">\n        <a\n          href=\"#\"\n          className=\"inline-flex items-center gap-1.5 hover:underline\"\n        >\n          Passkey recovery is now live on iOS and Android\n          <ArrowRight className=\"size-3.5\" />\n        </a>\n      </div>\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-orange-600 text-white text-sm\">\n              K\n            </span>\n            <span className=\"\">Keystone</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Log in\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Download wallet\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"relative overflow-hidden border-b\">\n        <div className=\"mx-auto grid max-w-7xl items-center gap-12 px-6 py-16 md:py-24 lg:grid-cols-2\">\n          <div className=\"space-y-7\">\n            <span className=\"inline-flex items-center gap-2 rounded-full border bg-background text-muted-foreground px-3 py-1 text-xs font-medium\">\n              <Sparkles className=\"size-3.5 text-orange-600 dark:text-orange-400\" />\n              Self-custody, made simple\n            </span>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-6xl \">\n              {\"Your keys. Your coins. \"}\n              <span className=\"text-orange-600 dark:text-orange-400\">\n                Your rules.\n              </span>\n            </h1>\n            <p className=\"max-w-xl text-lg leading-8 text-muted-foreground\">\n              Keystone is a non-custodial wallet with passkey recovery, built-in\n              swaps and hardware-level security on your phone.\n            </p>\n            <div className=\"flex flex-wrap gap-3 \">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Download wallet\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                How recovery works\n              </Button>\n            </div>\n            <div className=\"flex flex-wrap gap-x-8 gap-y-3 pt-2\">\n              {stats.slice(0, 3).map((stat) => (\n                <div key={stat.label}>\n                  <div className=\"text-2xl font-semibold tracking-tight\">\n                    {stat.value}\n                  </div>\n                  <div className=\"text-xs text-muted-foreground\">\n                    {stat.label}\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n          <div className=\"relative\">\n            <div className=\"absolute -inset-8 -z-10 rounded-full bg-gradient-to-tr from-orange-500/25 via-amber-500/10 to-transparent blur-3xl\" />\n            <HeroVisual />\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-12\">\n          <p className=\"text-center text-sm text-muted-foreground\">\n            Backed by and integrated with\n          </p>\n          <div className=\"mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-6 sm:grid-cols-4 lg:grid-cols-8\">\n            {logos.map((logo) => (\n              <div\n                key={logo}\n                className=\"text-center text-base font-semibold tracking-tight text-muted-foreground/70 \"\n              >\n                {logo}\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b bg-muted/30\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"max-w-2xl\">\n            <p className=\"text-sm font-medium text-orange-600 dark:text-orange-400\">\n              Why us\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              Built for people who take custody seriously\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Institutional-grade infrastructure with an interface simple enough\n              for your first trade.\n            </p>\n          </div>\n          <div className=\"mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3\">\n            {features.map((feature) => (\n              <div\n                key={feature.title}\n                className=\"rounded-xl border bg-background p-6 shadow-xs\"\n              >\n                <span className=\"flex size-10 items-center justify-center rounded-lg bg-orange-500/10\">\n                  <feature.icon className=\"size-5 text-orange-600 dark:text-orange-400\" />\n                </span>\n                <h3 className=\"mt-5 font-semibold\">{feature.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              From sign-up to first trade in minutes\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-orange-600 dark:text-orange-400\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Markets moving right now\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                Trade more than 300 assets with deep liquidity, transparent fees\n                and real-time order books.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a\n                key={item.name}\n                href=\"#\"\n                className=\"group flex flex-col rounded-xl border p-6 transition-colors hover:bg-muted/40\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"flex size-10 items-center justify-center rounded-lg border bg-muted/50 font-semibold \">\n                    {item.name.charAt(0)}\n                  </span>\n                  <span className=\"rounded-full bg-orange-500/10 px-2.5 py-0.5 text-xs font-medium text-orange-600 dark:text-orange-400\">\n                    {item.tag}\n                  </span>\n                </div>\n                <h3 className=\"mt-6 font-semibold \">{item.name}</h3>\n                <p className=\"mt-1 flex-1 text-sm text-muted-foreground\">\n                  {item.meta}\n                </p>\n                <div className=\"mt-6 flex items-center justify-between border-t pt-4 text-sm\">\n                  <span className=\"font-medium\">{item.price}</span>\n                  <ArrowUpRight className=\"size-4 text-muted-foreground transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5\" />\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b \">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Trusted by traders, builders and treasuries\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-4 md:grid-cols-3\">\n            {testimonials.map((t, i) => (\n              <figure\n                key={t.name}\n                className={`flex flex-col justify-between rounded-2xl border bg-background p-6 ${i === 0 ? \"md:col-span-2 md:p-10\" : \"\"}`}\n              >\n                <Quote className=\"size-6 text-orange-600 dark:text-orange-400\" />\n                <blockquote\n                  className={`mt-4 leading-relaxed ${i === 0 ? \"text-xl md:text-2xl\" : \"text-muted-foreground\"}`}\n                >\n                  {t.quote}\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 text-sm\">\n                  <span className=\"flex size-9 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Transparent fees, no surprises\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Pay less as you trade more. Every tier includes cold storage,\n              proof of reserves and 24/7 support.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-orange-500 shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-orange-600 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-orange-600 dark:text-orange-400\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Frequently asked questions\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Get in touch\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"px-6 py-20 md:py-28\">\n        <div className=\"relative mx-auto max-w-6xl overflow-hidden rounded-3xl border bg-orange-500/10 px-6 py-16 text-center md:py-24\">\n          <div className=\"pointer-events-none absolute -top-24 left-1/2 size-96 -translate-x-1/2 rounded-full bg-gradient-to-b from-orange-500/25 via-amber-500/10 to-transparent blur-3xl\" />\n          <div className=\"relative mx-auto max-w-2xl space-y-6\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Take custody of your crypto today\n            </h2>\n            <p className=\"text-lg text-muted-foreground\">\n              Free on iOS, Android and Chrome. Set up in under a minute.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Download wallet\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                How recovery works\n              </Button>\n            </div>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-orange-600 text-white text-sm\">\n                K\n              </span>\n              <span className=\"\">Keystone</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              The wallet you actually own.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Keystone. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  const bars = [38, 52, 44, 63, 58, 71, 66, 80, 74, 88, 83, 95]\n  return (\n    <div className=\"overflow-hidden rounded-xl border bg-card text-left text-card-foreground shadow-2xl/10\">\n      <div className=\"flex items-center gap-2 border-b px-4 py-3\">\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"ml-3 hidden rounded-md bg-muted px-3 py-0.5 text-[11px] text-muted-foreground sm:inline\">\n          app.keystone.com\n        </span>\n      </div>\n      <div className=\"grid md:grid-cols-[180px_1fr]\">\n        <aside className=\"hidden space-y-1 border-r p-3 text-sm md:block\">\n          {navLinks.map((link, i) => (\n            <div\n              key={link}\n              className={`rounded-md px-3 py-1.5 ${i === 0 ? \"bg-muted font-medium\" : \"text-muted-foreground\"}`}\n            >\n              {link}\n            </div>\n          ))}\n        </aside>\n        <div className=\"space-y-4 p-4 md:p-6\">\n          <div className=\"grid grid-cols-2 gap-3 lg:grid-cols-4\">\n            {stats.slice(0, 4).map((stat) => (\n              <div key={stat.label} className=\"rounded-lg border p-3\">\n                <div className=\"truncate text-[11px] text-muted-foreground\">\n                  {stat.label}\n                </div>\n                <div className=\"mt-1 text-lg font-semibold tracking-tight\">\n                  {stat.value}\n                </div>\n              </div>\n            ))}\n          </div>\n          <div className=\"rounded-lg border p-4\">\n            <div className=\"mb-4 flex items-center justify-between text-xs\">\n              <span className=\"font-medium\">Last 12 weeks</span>\n              <span className=\"text-orange-600 dark:text-orange-400\">\n                +24.6%\n              </span>\n            </div>\n            <div className=\"flex h-32 items-end gap-1.5\">\n              {bars.map((h, i) => (\n                <div\n                  key={i}\n                  className={`flex-1 rounded-t-sm ${i === bars.length - 1 ? \"bg-orange-600\" : \"bg-muted-foreground/20\"}`}\n                  style={{ height: `${h}%` }}\n                />\n              ))}\n            </div>\n          </div>\n          <div className=\"hidden divide-y rounded-lg border sm:block\">\n            {showcase.slice(0, 3).map((item) => (\n              <div\n                key={item.name}\n                className=\"flex items-center justify-between gap-4 px-4 py-2.5 text-sm\"\n              >\n                <div className=\"min-w-0\">\n                  <div className=\"truncate font-medium\">{item.name}</div>\n                  <div className=\"truncate text-xs text-muted-foreground\">\n                    {item.meta}\n                  </div>\n                </div>\n                <span className=\"shrink-0 rounded-full bg-orange-500/10 px-2 py-0.5 text-[11px] font-medium text-orange-600 dark:text-orange-400\">\n                  {item.tag}\n                </span>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n    </div>\n  )\n}\n",
