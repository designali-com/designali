{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "menubar-32",
  "type": "registry:example",
  "description": "Bookmarks menubar with nested folder submenus two levels deep.",
  "files": [
    {
      "path": "registry/designali/examples/menubar/menubar-32.tsx",
      "content": "import {\n  Bookmark as BookmarkIcon,\n  BookmarkPlus as BookmarkPlusIcon,\n  Folder as FolderIcon,\n} from \"@designali/icons\"\n\nimport {\n  Menubar,\n  MenubarContent,\n  MenubarGroup,\n  MenubarItem,\n  MenubarMenu,\n  MenubarSeparator,\n  MenubarShortcut,\n  MenubarSub,\n  MenubarSubContent,\n  MenubarSubTrigger,\n  MenubarTrigger,\n} from \"@workspace/ui/components/menubar\"\n\nexport default function BookmarkFoldersMenubar() {\n  return (\n    <div className=\"w-full max-w-xs\">\n      <Menubar>\n        <MenubarMenu>\n          <MenubarTrigger>Bookmarks</MenubarTrigger>\n          <MenubarContent className=\"w-52\">\n            <MenubarGroup>\n              <MenubarItem>\n                <BookmarkPlusIcon /> Bookmark this page{\" \"}\n                <MenubarShortcut>⌘D</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>\n                <BookmarkIcon /> Bookmark manager\n              </MenubarItem>\n            </MenubarGroup>\n            <MenubarSeparator />\n            <MenubarGroup>\n              <MenubarSub>\n                <MenubarSubTrigger>\n                  <FolderIcon /> Work\n                </MenubarSubTrigger>\n                <MenubarSubContent className=\"w-44\">\n                  <MenubarGroup>\n                    <MenubarItem>Team wiki</MenubarItem>\n                    <MenubarItem>Sprint board</MenubarItem>\n                    <MenubarSub>\n                      <MenubarSubTrigger>\n                        <FolderIcon /> Dashboards\n                      </MenubarSubTrigger>\n                      <MenubarSubContent>\n                        <MenubarGroup>\n                          <MenubarItem>Revenue</MenubarItem>\n                          <MenubarItem>Uptime</MenubarItem>\n                          <MenubarItem>Signups</MenubarItem>\n                        </MenubarGroup>\n                      </MenubarSubContent>\n                    </MenubarSub>\n                  </MenubarGroup>\n                </MenubarSubContent>\n              </MenubarSub>\n              <MenubarSub>\n                <MenubarSubTrigger>\n                  <FolderIcon /> Reading list\n                </MenubarSubTrigger>\n                <MenubarSubContent className=\"w-48\">\n                  <MenubarGroup>\n                    <MenubarItem>On writing clear specs</MenubarItem>\n                    <MenubarItem>Designing for latency</MenubarItem>\n                  </MenubarGroup>\n                </MenubarSubContent>\n              </MenubarSub>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>History</MenubarTrigger>\n          <MenubarContent>\n            <MenubarGroup>\n              <MenubarItem>\n                Show full history <MenubarShortcut>⌘Y</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>Reopen closed tab</MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n      </Menubar>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}