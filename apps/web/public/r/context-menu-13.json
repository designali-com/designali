{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "context-menu-13",
  "type": "registry:example",
  "description": "A kanban card whose context menu moves it between columns and edits its labels.",
  "files": [
    {
      "path": "registry/designali/examples/context-menu/context-menu-13.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport { ColumnsIcon, CopyIcon, TagIcon, TrashIcon } from \"lucide-react\"\n\nimport { Badge } from \"@workspace/ui/components/badge\"\nimport {\n  ContextMenu,\n  ContextMenuCheckboxItem,\n  ContextMenuContent,\n  ContextMenuGroup,\n  ContextMenuItem,\n  ContextMenuRadioGroup,\n  ContextMenuRadioItem,\n  ContextMenuSeparator,\n  ContextMenuSub,\n  ContextMenuSubContent,\n  ContextMenuSubTrigger,\n  ContextMenuTrigger,\n} from \"@workspace/ui/components/context-menu\"\n\nconst columns = [\"Backlog\", \"In progress\", \"In review\", \"Done\"]\n\nexport default function KanbanCardMenu() {\n  const [column, setColumn] = React.useState(\"In progress\")\n  const [labels, setLabels] = React.useState({\n    frontend: true,\n    urgent: false,\n    customer: true,\n  })\n\n  const toggle = (key: keyof typeof labels) => (checked: boolean) =>\n    setLabels((current) => ({ ...current, [key]: checked }))\n\n  return (\n    <div className=\"flex w-full max-w-xs flex-col gap-2 bg-muted/50 p-2\">\n      <span className=\"px-1 text-xs font-medium text-muted-foreground\">\n        {column}\n      </span>\n      <ContextMenu>\n        <ContextMenuTrigger className=\"flex flex-col gap-2 border bg-background p-3 shadow-xs data-popup-open:ring-2 data-popup-open:ring-ring/40\">\n          <span className=\"font-mono text-[11px] text-muted-foreground\">\n            WEB-219\n          </span>\n          <span className=\"text-sm\">\n            Fix coupon field losing focus on mobile Safari\n          </span>\n          <div className=\"flex flex-wrap gap-1\">\n            {labels.frontend ? (\n              <Badge variant=\"secondary\">frontend</Badge>\n            ) : null}\n            {labels.urgent ? <Badge variant=\"destructive\">urgent</Badge> : null}\n            {labels.customer ? <Badge variant=\"outline\">customer</Badge> : null}\n          </div>\n        </ContextMenuTrigger>\n        <ContextMenuContent className=\"w-48\">\n          <ContextMenuSub>\n            <ContextMenuSubTrigger>\n              <ColumnsIcon />\n              Move to\n            </ContextMenuSubTrigger>\n            <ContextMenuSubContent className=\"w-40\">\n              <ContextMenuRadioGroup value={column} onValueChange={setColumn}>\n                {columns.map((c) => (\n                  <ContextMenuRadioItem key={c} value={c}>\n                    {c}\n                  </ContextMenuRadioItem>\n                ))}\n              </ContextMenuRadioGroup>\n            </ContextMenuSubContent>\n          </ContextMenuSub>\n          <ContextMenuSub>\n            <ContextMenuSubTrigger>\n              <TagIcon />\n              Labels\n            </ContextMenuSubTrigger>\n            <ContextMenuSubContent className=\"w-40\">\n              <ContextMenuGroup>\n                <ContextMenuCheckboxItem\n                  checked={labels.frontend}\n                  onCheckedChange={toggle(\"frontend\")}\n                >\n                  frontend\n                </ContextMenuCheckboxItem>\n                <ContextMenuCheckboxItem\n                  checked={labels.urgent}\n                  onCheckedChange={toggle(\"urgent\")}\n                >\n                  urgent\n                </ContextMenuCheckboxItem>\n                <ContextMenuCheckboxItem\n                  checked={labels.customer}\n                  onCheckedChange={toggle(\"customer\")}\n                >\n                  customer\n                </ContextMenuCheckboxItem>\n              </ContextMenuGroup>\n            </ContextMenuSubContent>\n          </ContextMenuSub>\n          <ContextMenuSeparator />\n          <ContextMenuGroup>\n            <ContextMenuItem>\n              <CopyIcon />\n              Copy issue link\n            </ContextMenuItem>\n            <ContextMenuItem variant=\"destructive\">\n              <TrashIcon />\n              Delete issue\n            </ContextMenuItem>\n          </ContextMenuGroup>\n        </ContextMenuContent>\n      </ContextMenu>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}