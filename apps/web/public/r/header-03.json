{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "header-03",
  "type": "registry:block",
  "description": "A simple header section.",
  "registryDependencies": [
    "button",
    "navigation-menu",
    "toggle",
    "accordion",
    "sheet"
  ],
  "files": [
    {
      "path": "registry/designali/blocks/header/header-03/page.tsx",
      "content": "import { Header } from \"@/registry/designali/blocks/header/header-03/components/header\"\n\nexport default function Header03() {\n  return (\n    <div className=\"flex min-h-screen w-full flex-col\">\n      <Header />\n      <main className=\"flex-1\">\n        <section className=\"flex h-screen items-center justify-center\">\n          <h1 className=\"text-4xl font-bold\">Hero</h1>\n        </section>\n\n        <section className=\"flex h-screen items-center justify-center\">\n          <h1 className=\"text-4xl font-bold\">Section</h1>\n        </section>\n      </main>\n    </div>\n  )\n}\n",
      "type": "registry:component",
      "target": "components/header-03.tsx"
    },
    {
      "path": "registry/designali/blocks/header/header-03/components/header.tsx",
      "content": "\"use client\"\n\nimport React, { useState } from \"react\"\nimport { ArrowUpRight, ChevronsLeftRight, Equal, X } from \"lucide-react\"\n\nimport { ModeToggle } from \"@/registry/designali/blocks/header/header-03/components/theme-switch\"\nimport {\n  Accordion,\n  AccordionContent,\n  AccordionItem,\n  AccordionTrigger,\n} from \"@workspace/ui/components/accordion\"\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  NavigationMenu,\n  NavigationMenuContent,\n  NavigationMenuItem,\n  NavigationMenuLink,\n  NavigationMenuList,\n  NavigationMenuTrigger,\n} from \"@workspace/ui/components/navigation-menu\"\nimport {\n  Sheet,\n  SheetContent,\n  SheetTrigger,\n} from \"@workspace/ui/components/sheet\"\nimport { Logo } from \"@workspace/ui/designali/logo\"\n\nconst services = [\n  { name: \"UI/UX Design\", href: \"/services/ui-ux-design\" },\n  { name: \"Graphic Design\", href: \"/services/graphic-design\" },\n  { name: \"Web Design\", href: \"/services/web-design\" },\n  { name: \"Branding\", href: \"/services/branding\" },\n]\n\nconst industries = [\n  { name: \"Technology\", href: \"/industries/technology\" },\n  { name: \"E-commerce\", href: \"/industries/e-commerce\" },\n  { name: \"Healthcare\", href: \"/industries/healthcare\" },\n  { name: \"Education\", href: \"/industries/education\" },\n  { name: \"Finance\", href: \"/industries/finance\" },\n  { name: \"Entertainment\", href: \"/industries/entertainment\" },\n  { name: \"Retail\", href: \"/industries/retail\" },\n  { name: \"Hospitality\", href: \"/industries/hospitality\" },\n]\n\nconst insights = [\n  { name: \"Design Trends\", href: \"/insights/design-trends\" },\n  { name: \"Case Studies\", href: \"/insights/case-studies\" },\n  { name: \"Design Tips\", href: \"/insights/design-tips\" },\n  { name: \"Podcast Hub\", href: \"/insights/podcasts\" },\n]\n\nconst aboutUs = [\n  { name: \"Our Team\", href: \"/about/team\" },\n  { name: \"Portfolio\", href: \"/about/portfolio\" },\n  { name: \"Careers\", href: \"/careers\" },\n]\n\nexport function Header() {\n  const [isOpen, setIsOpen] = useState(false)\n\n  return (\n    <header className=\"fixed top-0 left-0 z-50 w-full bg-background/50 backdrop-blur-md\">\n      <div className=\"px-3\">\n        <div className=\"flex h-20 items-center justify-between\">\n          <div className=\"flex h-14 items-center gap-2 border px-4\">\n            <Logo className=\"size-8\" />\n            <span className=\"text-lg font-medium\">designali</span>\n          </div>\n\n          {/* Desktop Navigation */}\n          <nav className=\"hidden items-center lg:flex\">\n            <NavigationMenu align=\"center\">\n              <NavigationMenuList>\n                {/* Services */}\n                <NavigationMenuItem>\n                  <NavigationMenuTrigger className=\"h-14 rounded-none border px-6 text-sm\">\n                    Services\n                  </NavigationMenuTrigger>\n\n                  <NavigationMenuContent>\n                    <ul className=\"grid w-[485px] gap-3 p-4\">\n                      {services.map((item) => (\n                        <li key={item.name}>\n                          <NavigationMenuLink\n                            render={\n                              <a\n                                href={item.href}\n                                className=\"block p-3 leading-none no-underline transition-colors outline-none hover:bg-primary hover:text-background focus:bg-primary\"\n                              />\n                            }\n                          >\n                            <div className=\"text-sm font-medium\">\n                              {item.name}\n                            </div>\n                          </NavigationMenuLink>\n                        </li>\n                      ))}\n                    </ul>\n                  </NavigationMenuContent>\n                </NavigationMenuItem>\n\n                {/* Industries */}\n                <NavigationMenuItem>\n                  <NavigationMenuTrigger className=\"h-14 rounded-none border border-l-0 px-6 text-sm\">\n                    Industries\n                  </NavigationMenuTrigger>\n\n                  <NavigationMenuContent>\n                    <ul className=\"grid w-[485px] grid-cols-2 gap-3 p-4\">\n                      {industries.map((item) => (\n                        <li key={item.name}>\n                          <NavigationMenuLink\n                            render={\n                              <a\n                                href={item.href}\n                                className=\"block p-3 leading-none no-underline transition-colors outline-none hover:bg-primary hover:text-background focus:bg-primary\"\n                              />\n                            }\n                          >\n                            <div className=\"text-sm font-medium\">\n                              {item.name}\n                            </div>\n                          </NavigationMenuLink>\n                        </li>\n                      ))}\n                    </ul>\n                  </NavigationMenuContent>\n                </NavigationMenuItem>\n\n                {/* Insights */}\n                <NavigationMenuItem>\n                  <NavigationMenuTrigger className=\"h-14 rounded-none border-y px-6 text-sm\">\n                    Insights\n                  </NavigationMenuTrigger>\n\n                  <NavigationMenuContent>\n                    <ul className=\"grid w-[485px] gap-3 p-4\">\n                      {insights.map((item) => (\n                        <li key={item.name}>\n                          <NavigationMenuLink\n                            render={\n                              <a\n                                href={item.href}\n                                className=\"block p-3 leading-none no-underline transition-colors outline-none hover:bg-primary hover:text-background focus:bg-primary\"\n                              />\n                            }\n                          >\n                            <div className=\"text-sm font-medium\">\n                              {item.name}\n                            </div>\n                          </NavigationMenuLink>\n                        </li>\n                      ))}\n                    </ul>\n                  </NavigationMenuContent>\n                </NavigationMenuItem>\n\n                {/* About Us */}\n                <NavigationMenuItem>\n                  <NavigationMenuTrigger className=\"h-14 rounded-none border px-6 text-sm\">\n                    About Us\n                  </NavigationMenuTrigger>\n\n                  <NavigationMenuContent>\n                    <ul className=\"grid w-[485px] gap-3 p-4\">\n                      {aboutUs.map((item) => (\n                        <li key={item.name}>\n                          <NavigationMenuLink\n                            render={\n                              <a\n                                href={item.href}\n                                className=\"block p-3 leading-none no-underline transition-colors outline-none hover:bg-primary hover:text-background focus:bg-primary\"\n                              />\n                            }\n                          >\n                            <div className=\"text-sm font-medium\">\n                              {item.name}\n                            </div>\n                          </NavigationMenuLink>\n                        </li>\n                      ))}\n                    </ul>\n                  </NavigationMenuContent>\n                </NavigationMenuItem>\n              </NavigationMenuList>\n            </NavigationMenu>\n          </nav>\n\n          {/* CTA Button */}\n          <div className=\"hidden items-center gap-1 lg:flex\">\n            <ModeToggle />\n            <Button\n              nativeButton={false}\n              variant={\"outline\"}\n              className=\"h-14 px-6\"\n              render={<a href=\"/contact\" className=\"flex items-center gap-2\" />}\n            >\n              Get in touch\n              <ArrowUpRight />\n            </Button>\n          </div>\n\n          {/* Mobile Menu */}\n          <Sheet open={isOpen} onOpenChange={setIsOpen}>\n            <SheetTrigger\n              className=\"lg:hidden\"\n              render={\n                <button\n                  type=\"button\"\n                  className=\"inline-flex h-10 w-10 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground\"\n                />\n              }\n            >\n              {isOpen ? <X className=\"size-8\" /> : <Equal className=\"size-8\" />}\n            </SheetTrigger>\n            <SheetContent\n              side=\"right\"\n              className=\"w-full overflow-y-auto p-6 sm:w-[485px]\"\n            >\n              <div className=\"flex h-full flex-col\">\n                <div className=\"flex-1 py-6\">\n                  <Accordion className=\"w-full\">\n                    <AccordionItem value=\"services\">\n                      <AccordionTrigger className=\"text-lg font-semibold\">\n                        Services\n                      </AccordionTrigger>\n                      <AccordionContent>\n                        <ul className=\"space-y-2 pl-4\">\n                          {services.map((item) => (\n                            <li key={item.name}>\n                              <a\n                                href={item.href}\n                                className=\"block py-2 text-muted-foreground hover:text-foreground\"\n                                onClick={() => setIsOpen(false)}\n                              >\n                                {item.name}\n                              </a>\n                            </li>\n                          ))}\n                        </ul>\n                      </AccordionContent>\n                    </AccordionItem>\n\n                    <AccordionItem value=\"industries\">\n                      <AccordionTrigger className=\"text-lg font-semibold\">\n                        Industries\n                      </AccordionTrigger>\n                      <AccordionContent>\n                        <ul className=\"space-y-2 pl-4\">\n                          {industries.map((item) => (\n                            <li key={item.name}>\n                              <a\n                                href={item.href}\n                                className=\"block py-2 text-muted-foreground hover:text-foreground\"\n                                onClick={() => setIsOpen(false)}\n                              >\n                                {item.name}\n                              </a>\n                            </li>\n                          ))}\n                        </ul>\n                      </AccordionContent>\n                    </AccordionItem>\n\n                    <AccordionItem value=\"insights\">\n                      <AccordionTrigger className=\"text-lg font-semibold\">\n                        Insights\n                      </AccordionTrigger>\n                      <AccordionContent>\n                        <ul className=\"space-y-2 pl-4\">\n                          {insights.map((item) => (\n                            <li key={item.name}>\n                              <a\n                                href={item.href}\n                                className=\"block py-2 text-muted-foreground hover:text-foreground\"\n                                onClick={() => setIsOpen(false)}\n                              >\n                                {item.name}\n                              </a>\n                            </li>\n                          ))}\n                        </ul>\n                      </AccordionContent>\n                    </AccordionItem>\n\n                    <AccordionItem value=\"about\">\n                      <AccordionTrigger className=\"text-lg font-semibold\">\n                        About Us\n                      </AccordionTrigger>\n                      <AccordionContent>\n                        <ul className=\"space-y-2 pl-4\">\n                          {aboutUs.map((item) => (\n                            <li key={item.name}>\n                              <a\n                                href={item.href}\n                                className=\"block py-2 text-muted-foreground hover:text-foreground\"\n                                onClick={() => setIsOpen(false)}\n                              >\n                                {item.name}\n                              </a>\n                            </li>\n                          ))}\n                        </ul>\n                      </AccordionContent>\n                    </AccordionItem>\n                  </Accordion>\n                </div>\n\n                <div className=\"pb-6\">\n                  <Button\n                    nativeButton={false}\n                    render={\n                      <a\n                        href=\"/contact\"\n                        className=\"flex items-center justify-center gap-2\"\n                      />\n                    }\n                    className=\"w-full\"\n                  >\n                    Get in touch\n                    <ChevronsLeftRight />\n                  </Button>\n                </div>\n              </div>\n            </SheetContent>\n          </Sheet>\n        </div>\n      </div>\n    </header>\n  )\n}\n",
      "type": "registry:component"
    },
    {
      "path": "registry/designali/blocks/header/header-03/components/theme-switch.tsx",
      "content": "\"use client\"\n\nimport { Moon, Sun } from \"lucide-react\"\nimport { useTheme } from \"next-themes\"\n\nimport { Toggle } from \"@workspace/ui/components/toggle\"\n\nexport function ModeToggle() {\n  const { resolvedTheme, setTheme } = useTheme()\n\n  const isDark = resolvedTheme === \"dark\"\n\n  return (\n    <div className=\"flex flex-col justify-center\">\n      <Toggle\n        className=\"group size-9 cursor-pointer bg-secondary data-[state=on]:bg-transparent data-[state=on]:hover:bg-muted dark:bg-secondary\"\n        pressed={isDark}\n        onPressedChange={() => setTheme(isDark ? \"light\" : \"dark\")}\n        aria-label={`Switch to ${isDark ? \"light\" : \"dark\"} mode`}\n      >\n        <Moon\n          size={16}\n          className=\"shrink-0 scale-0 opacity-0 transition-all group-data-[state=on]:scale-100 group-data-[state=on]:opacity-100\"\n          aria-hidden=\"true\"\n        />\n\n        <Sun\n          size={16}\n          className=\"absolute shrink-0 scale-100 opacity-100 transition-all group-data-[state=on]:scale-0 group-data-[state=on]:opacity-0\"\n          aria-hidden=\"true\"\n        />\n      </Toggle>\n    </div>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "500px"
  },
  "categories": [
    "header"
  ]
}