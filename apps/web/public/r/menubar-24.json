{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "menubar-24",
  "type": "registry:example",
  "description": "View menu with zoom in, zoom out and reset items that update a live zoom readout in the menubar.",
  "files": [
    {
      "path": "registry/designali/examples/menubar/menubar-24.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  Scan as ScanIcon,\n  ZoomIn as ZoomInIcon,\n  ZoomOut as ZoomOutIcon,\n} from \"@designali/icons\"\n\nimport {\n  Menubar,\n  MenubarContent,\n  MenubarGroup,\n  MenubarItem,\n  MenubarMenu,\n  MenubarShortcut,\n  MenubarTrigger,\n} from \"@workspace/ui/components/menubar\"\n\nexport default function ZoomLevelMenubar() {\n  const [zoom, setZoom] = React.useState(100)\n\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-2\">\n      <Menubar>\n        <MenubarMenu>\n          <MenubarTrigger>View</MenubarTrigger>\n          <MenubarContent className=\"w-48\">\n            <MenubarGroup>\n              <MenubarItem\n                closeOnClick={false}\n                disabled={zoom >= 200}\n                onClick={() => setZoom((z) => Math.min(200, z + 25))}\n              >\n                <ZoomInIcon /> Zoom in <MenubarShortcut>⌘+</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem\n                closeOnClick={false}\n                disabled={zoom <= 25}\n                onClick={() => setZoom((z) => Math.max(25, z - 25))}\n              >\n                <ZoomOutIcon /> Zoom out <MenubarShortcut>⌘-</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem onClick={() => setZoom(100)}>\n                <ScanIcon /> Actual size <MenubarShortcut>⌘0</MenubarShortcut>\n              </MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>Layout</MenubarTrigger>\n          <MenubarContent>\n            <MenubarGroup>\n              <MenubarItem>Fit to width</MenubarItem>\n              <MenubarItem>Fit page</MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <span className=\"ms-auto pe-1 font-sans text-[11px] text-muted-foreground\">\n          {zoom}%\n        </span>\n      </Menubar>\n      <div className=\"flex h-32 items-center justify-center overflow-hidden border bg-muted/40\">\n        <div\n          className=\"size-12 bg-gradient-to-br from-primary to-primary\"\n          style={{ transform: \"scale(\" + zoom / 100 + \")\" }}\n        />\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}