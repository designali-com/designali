{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "menubar-39",
  "type": "registry:example",
  "description": "Debugger menubar using Kbd keys for shortcuts, breakpoint toggles and a disabled step menu while stopped.",
  "files": [
    {
      "path": "registry/designali/examples/menubar/menubar-39.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  Play as PlayIcon,\n  RotateCcw as RotateCcwIcon,\n  Square as SquareIcon,\n} from \"@designali/icons\"\n\nimport { Kbd, KbdGroup } from \"@workspace/ui/components/kbd\"\nimport {\n  Menubar,\n  MenubarCheckboxItem,\n  MenubarContent,\n  MenubarGroup,\n  MenubarItem,\n  MenubarMenu,\n  MenubarSeparator,\n  MenubarTrigger,\n} from \"@workspace/ui/components/menubar\"\nimport { cn } from \"@workspace/ui/lib/utils\"\n\nexport default function DebuggerMenubar() {\n  const [running, setRunning] = React.useState(false)\n  const [pauseOnExceptions, setPauseOnExceptions] = React.useState(true)\n\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-2\">\n      <Menubar>\n        <MenubarMenu>\n          <MenubarTrigger>Debug</MenubarTrigger>\n          <MenubarContent className=\"w-56\">\n            <MenubarGroup>\n              <MenubarItem onClick={() => setRunning((r) => !r)}>\n                {running ? <SquareIcon /> : <PlayIcon />}\n                {running ? \"Stop\" : \"Start\"}\n                <Kbd className=\"ms-auto\">{running ? \"⇧F5\" : \"F5\"}</Kbd>\n              </MenubarItem>\n              <MenubarItem disabled={!running}>\n                <RotateCcwIcon /> Restart\n                <KbdGroup className=\"ms-auto\">\n                  <Kbd>⇧</Kbd>\n                  <Kbd>⌘</Kbd>\n                  <Kbd>F5</Kbd>\n                </KbdGroup>\n              </MenubarItem>\n            </MenubarGroup>\n            <MenubarSeparator />\n            <MenubarGroup>\n              <MenubarCheckboxItem\n                checked={pauseOnExceptions}\n                onCheckedChange={setPauseOnExceptions}\n              >\n                Pause on exceptions\n              </MenubarCheckboxItem>\n              <MenubarItem inset>Remove all breakpoints</MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu disabled={!running}>\n          <MenubarTrigger className=\"data-disabled:opacity-50\">\n            Step\n          </MenubarTrigger>\n          <MenubarContent>\n            <MenubarGroup>\n              <MenubarItem>\n                Step over <Kbd className=\"ms-auto\">F10</Kbd>\n              </MenubarItem>\n              <MenubarItem>\n                Step into <Kbd className=\"ms-auto\">F11</Kbd>\n              </MenubarItem>\n              <MenubarItem>\n                Step out <Kbd className=\"ms-auto\">⇧F11</Kbd>\n              </MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n      </Menubar>\n      <p className=\"flex items-center gap-1.5 text-xs text-muted-foreground\">\n        <span\n          className={cn(\n            \"size-2 rounded-full\",\n            running ? \"bg-primary\" : \"bg-muted-foreground/40\"\n          )}\n        />\n        {running ? \"Debugging api-server\" : \"Not running\"}\n      </p>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}