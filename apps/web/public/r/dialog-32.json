{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dialog-32",
  "type": "registry:example",
  "description": "Storefront quick view dialog with color and size selection and add to bag.",
  "files": [
    {
      "path": "registry/designali/examples/dialog/dialog-32.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  Eye as EyeIcon,\n  ShoppingBag as ShoppingBagIcon,\n  Star as StarIcon,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  Dialog,\n  DialogClose,\n  DialogContent,\n  DialogDescription,\n  DialogHeader,\n  DialogTitle,\n  DialogTrigger,\n} from \"@workspace/ui/components/dialog\"\nimport {\n  ToggleGroup,\n  ToggleGroupItem,\n} from \"@workspace/ui/components/toggle-group\"\nimport { cn } from \"@workspace/ui/lib/utils\"\n\nconst sizes = [\"XS\", \"S\", \"M\", \"L\", \"XL\"]\n\nexport default function ProductQuickViewDialog() {\n  const [size, setSize] = React.useState<string[]>([\"M\"])\n\n  return (\n    <div className=\"flex w-full max-w-48 flex-col gap-2\">\n      <div className=\"aspect-square bg-gradient-to-br from-muted to-muted-foreground dark:from-muted dark:to-card\" />\n      <div className=\"flex items-center justify-between\">\n        <span className=\"font-medium\">Merino Crew</span>\n        <span className=\"text-muted-foreground\">$89</span>\n      </div>\n      <Dialog>\n        <DialogTrigger render={<Button variant=\"outline\" size=\"sm\" />}>\n          <EyeIcon data-icon=\"inline-start\" />\n          Quick view\n        </DialogTrigger>\n        <DialogContent className=\"sm:max-w-xl\">\n          <div className=\"grid gap-4 sm:grid-cols-2\">\n            <div className=\"aspect-square bg-gradient-to-br from-muted to-muted-foreground dark:from-muted dark:to-card\" />\n            <div className=\"flex flex-col gap-3\">\n              <DialogHeader>\n                <DialogTitle className=\"text-base\">\n                  Merino Crew Sweater\n                </DialogTitle>\n                <DialogDescription>\n                  Fine-gauge knit in undyed merino wool.\n                </DialogDescription>\n              </DialogHeader>\n              <div className=\"flex items-center gap-1\">\n                {[0, 1, 2, 3, 4].map((star) => (\n                  <StarIcon\n                    key={star}\n                    className={cn(\n                      \"size-3.5\",\n                      star < 4 ? \"fill-current\" : \"text-muted-foreground\"\n                    )}\n                  />\n                ))}\n                <span className=\"ms-1 text-muted-foreground\">128 reviews</span>\n              </div>\n              <p className=\"font-heading text-lg font-semibold\">$89.00</p>\n              <ToggleGroup\n                variant=\"outline\"\n                size=\"sm\"\n                spacing={1}\n                value={size}\n                onValueChange={(value) =>\n                  value.length && setSize(value.map(String))\n                }\n              >\n                {sizes.map((item) => (\n                  <ToggleGroupItem\n                    key={item}\n                    value={item}\n                    disabled={item === \"XS\"}\n                  >\n                    {item}\n                  </ToggleGroupItem>\n                ))}\n              </ToggleGroup>\n              <DialogClose render={<Button className=\"mt-auto\" />}>\n                <ShoppingBagIcon data-icon=\"inline-start\" />\n                Add to bag · {size[0]}\n              </DialogClose>\n            </div>\n          </div>\n        </DialogContent>\n      </Dialog>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}