      "content": "import {\n  Apple,\n  ArrowRight,\n  ArrowUpRight,\n  Check,\n  HeartPulse,\n  Plus,\n  Quote,\n  Smartphone,\n  Sparkles,\n  Timer,\n  Users,\n} from \"@designali/icons\"\n\nimport { Logo } from \"@/src/components/logo\"\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Work\", \"Services\", \"Pricing\", \"Process\", \"Contact\"]\n\nconst logos = [\n  \"TypeScript\",\n  \"Tailwind CSS\",\n  \"Figma\",\n  \"Vercel\",\n  \"shadcn/ui\",\n  \"@designali/icons\",\n  \"Next.js\",\n  \"React\",\n]\n\nconst features = [\n  {\n    icon: Smartphone,\n    title: \"Member app UI\",\n    description:\n      \"UI/UX for booking, waitlists and workout tracking, designed in Figma and handed off as real components.\",\n  },\n  {\n    icon: HeartPulse,\n    title: \"Live data screens\",\n    description:\n      \"Dashboards and in-studio displays for effort zones, leaderboards and progress, built with clear data design.\",\n  },\n  {\n    icon: Apple,\n    title: \"Content & motion\",\n    description:\n      \"Social templates, CGI and motion loops so every launch, challenge and class drop looks on-brand.\",\n  },\n  {\n    icon: Users,\n    title: \"Design systems\",\n    description:\n      \"A shared component library and tokens, so your team can ship new pages without breaking the brand.\",\n  },\n  {\n    icon: Timer,\n    title: \"Fast, accessible builds\",\n    description:\n      \"Typed, responsive and accessible code on Next.js and Tailwind CSS, deployed on Vercel.\",\n  },\n  {\n    icon: Sparkles,\n    title: \"AI-assisted workflows\",\n    description:\n      \"AI helps us explore directions and draft content faster, while every final decision stays hand-crafted.\",\n  },\n]\n\nconst stats = [\n  { value: \"4.9\", label: \"Average client rating\" },\n  { value: \"92%\", label: \"Launched within 8 weeks\" },\n  { value: \"4000+\", label: \"Icons in @designali/icons\" },\n  { value: \"2300+\", label: \"UI examples on designali.com\" },\n]\n\nconst steps = [\n  {\n    title: \"Book a discovery call\",\n    description:\n      \"A 30-minute call with Ali to talk about your members, your goals and what is not working today.\",\n  },\n  {\n    title: \"Get a clear proposal\",\n    description:\n      \"You receive scope, timeline and a fixed price, with no surprises once the work begins.\",\n  },\n  {\n    title: \"Design and build\",\n    description:\n      \"Weekly check-ins in Figma, then production-ready code you can preview from the first sprint.\",\n  },\n  {\n    title: \"Launch and grow\",\n    description:\n      \"We launch, measure sign-ups and bookings, and keep improving the experience together.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Strength gym rebrand\",\n    meta: \"Brand identity · Website\",\n    tag: \"Identity\",\n    price: \"6 weeks\",\n    tile: \"bg-gradient-to-br from-primary/10 via-primary/20 to-chart-1 dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Hybrid training site\",\n    meta: \"Next.js · Booking flow\",\n    tag: \"Web\",\n    price: \"8 weeks\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Pilates studio brand\",\n    meta: \"Identity · Social templates\",\n    tag: \"Brand\",\n    price: \"4 weeks\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Cycling studio launch\",\n    meta: \"Motion · Landing page\",\n    tag: \"Motion\",\n    price: \"5 weeks\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Coaching app UI\",\n    meta: \"UI/UX · Design system\",\n    tag: \"Product\",\n    price: \"10 weeks\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-chart-1 dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Recovery studio CGI\",\n    meta: \"CGI · 3D product renders\",\n    tag: \"3D\",\n    price: \"3 weeks\",\n    tile: \"bg-gradient-to-br from-muted via-border to-muted-foreground dark:from-muted dark:via-card dark:to-card\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"The app UI was so clear that our coaches stopped getting support questions. That alone paid for the project.\",\n    name: \"Aisha B.\",\n    role: \"Coaching app founder\",\n  },\n  {\n    quote:\n      \"We got a full design system, not just screens. Our team ships new class pages in an afternoon now.\",\n    name: \"Daniel R.\",\n    role: \"Head of product, fitness app\",\n  },\n  {\n    quote:\n      \"The 3D renders and motion loops Designali made for our launch still outperform every other post we publish.\",\n    name: \"Chloe M.\",\n    role: \"Marketing lead, recovery studio\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Sprint\",\n    price: \"$2,400\",\n    period: \"/project\",\n    description: \"A focused landing page for a launch, challenge or new location.\",\n    features: [\n      \"One landing page, designed and coded\",\n      \"Built from Designali blocks\",\n      \"Responsive and accessible\",\n      \"Delivered in two weeks\",\n    ],\n    cta: \"Start a sprint\",\n  },\n  {\n    name: \"Studio\",\n    price: \"$4,500\",\n    period: \"/month\",\n    description: \"Ongoing design and development for growing fitness brands.\",\n    features: [\n      \"Unlimited design requests\",\n      \"Next.js development included\",\n      \"Monthly performance review\",\n      \"Social and motion templates\",\n      \"Pause or cancel any time\",\n    ],\n    cta: \"Work with Designali\",\n  },\n  {\n    name: \"Partner\",\n    price: \"$8,000\",\n    period: \"/month\",\n    description: \"Ali Imam as your embedded design engineer, every week.\",\n    features: [\n      \"Dedicated design engineer\",\n      \"Product UI and code\",\n      \"Content & motion\",\n      \"Unlimited design requests\",\n      \"Weekly check-ins with Ali\",\n    ],\n    cta: \"Book a call\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"Can I pause a monthly plan?\",\n    a: \"Yes. Studio plans can be paused or cancelled at the end of any month, just send us an email.\",\n  },\n  {\n    q: \"How long does a project take?\",\n    a: \"Most landing pages take two weeks and a full brand plus website takes six to eight weeks.\",\n  },\n  {\n    q: \"Will I own the design and code?\",\n    a: \"Yes. You get the Figma files and the full Next.js codebase, ready to host on Vercel or anywhere you like.\",\n  },\n  {\n    q: \"Do you work with multi-location brands?\",\n    a: \"Yes. We build design systems that scale across locations, apps and campaigns without losing consistency.\",\n  },\n  {\n    q: \"We are a new fitness brand. Is that okay?\",\n    a: \"Absolutely. Many projects start with nothing but a name. We shape the identity first, then design and build around it.\",\n  },\n]\n\nconst footer = [\n  {\n    title: \"Studio\",\n    links: [\"Work\", \"Services\", \"Process\", \"Contact\"],\n  },\n  {\n    title: \"Resources\",\n    links: [\"Templates\", \"Blocks\", \"Icons\", \"Docs\"],\n  },\n  {\n    title: \"Follow\",\n    links: [\"Instagram\", \"X\", \"LinkedIn\", \"21st.dev\"],\n  },\n]\n\nexport default function LandingFitness03() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <div className=\"border-b bg-muted/50 text-muted-foreground px-4 py-2 text-center text-xs sm:text-sm\">\n        <a\n          href=\"#\"\n          className=\"inline-flex items-center gap-1.5 hover:underline\"\n        >\n          New: coaching app UI kit on designali.com\n          <ArrowRight className=\"size-3.5\" />\n        </a>\n      </div>\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <Logo className=\"h-5 w-auto\" />\n            <span className=\"\">designali</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View work\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Start a project\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"relative overflow-hidden border-b\">\n        <div className=\"mx-auto grid max-w-7xl items-center gap-12 px-6 py-16 md:py-24 lg:grid-cols-2\">\n          <div className=\"space-y-7\">\n            <span className=\"inline-flex items-center gap-2 rounded-full border bg-background text-muted-foreground px-3 py-1 text-xs font-medium\">\n              <Sparkles className=\"size-3.5 text-primary dark:text-primary\" />\n              Designali for coaching apps\n            </span>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-6xl \">\n              {\"Coaching apps, \"}\n              <span className=\"text-primary dark:text-primary\">\n                designed to ship\n              </span>\n            </h1>\n            <p className=\"max-w-xl text-lg leading-8 text-muted-foreground\">\n              Designali designs and builds coaching apps end to end: onboarding, plans, form-check video and weekly check-ins, in Figma and in code.\n            </p>\n            <div className=\"flex flex-wrap gap-3 \">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Start a project\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                How it works\n              </Button>\n            </div>\n            <div className=\"flex flex-wrap gap-x-8 gap-y-3 pt-2\">\n              {stats.slice(0, 3).map((stat) => (\n                <div key={stat.label}>\n                  <div className=\"text-2xl font-semibold tracking-tight\">\n                    {stat.value}\n                  </div>\n                  <div className=\"text-xs text-muted-foreground\">\n                    {stat.label}\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n          <div className=\"relative\">\n            <div className=\"absolute -inset-8 -z-10 rounded-full bg-gradient-to-tr from-primary/25 via-primary/10 to-transparent blur-3xl\" />\n            <HeroVisual />\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-12\">\n          <p className=\"text-center text-sm text-muted-foreground\">\n            Designed in Figma, built with\n          </p>\n          <div className=\"mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-6 sm:grid-cols-4 lg:grid-cols-8\">\n            {logos.map((logo) => (\n              <div\n                key={logo}\n                className=\"text-center text-base font-semibold tracking-tight text-muted-foreground/70 \"\n              >\n                {logo}\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b bg-muted/30\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"max-w-2xl\">\n            <p className=\"text-sm font-medium text-primary dark:text-primary\">\n              Services\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              Everything a fitness brand needs to grow\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Where thoughtful design meets production-ready code. From the first logo sketch to the live booking flow.\n            </p>\n          </div>\n          <div className=\"mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3\">\n            {features.map((feature) => (\n              <div\n                key={feature.title}\n                className=\"rounded-xl border bg-background p-6 shadow-xs\"\n              >\n                <span className=\"flex size-10 items-center justify-center rounded-lg bg-primary/10\">\n                  <feature.icon className=\"size-5 text-primary dark:text-primary\" />\n                </span>\n                <h3 className=\"mt-5 font-semibold\">{feature.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              How we work together\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-primary dark:text-primary\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Selected fitness work\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                Identities, websites, apps and motion for gyms, studios and coaches, all designed and built by Designali.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all work\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a key={item.name} href=\"#\" className=\"group\">\n                <div\n                  className={`relative aspect-[4/3] overflow-hidden rounded-2xl ${item.tile}`}\n                >\n                  <div className=\"absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10\" />\n                  <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-foreground backdrop-blur\">\n                    {item.tag}\n                  </span>\n                </div>\n                <div className=\"mt-4 flex items-start justify-between gap-4\">\n                  <div className=\"min-w-0\">\n                    <h3 className=\"font-medium \">{item.name}</h3>\n                    <p className=\"mt-1 text-sm text-muted-foreground\">\n                      {item.meta}\n                    </p>\n                  </div>\n                  <span className=\"shrink-0 text-sm font-semibold\">\n                    {item.price}\n                  </span>\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b \">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              What fitness clients say\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-4 md:grid-cols-3\">\n            {testimonials.map((t, i) => (\n              <figure\n                key={t.name}\n                className={`flex flex-col justify-between rounded-2xl border bg-background p-6 ${i === 0 ? \"md:col-span-2 md:p-10\" : \"\"}`}\n              >\n                <Quote className=\"size-6 text-primary dark:text-primary\" />\n                <blockquote\n                  className={`mt-4 leading-relaxed ${i === 0 ? \"text-xl md:text-2xl\" : \"text-muted-foreground\"}`}\n                >\n                  {t.quote}\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 text-sm\">\n                  <span className=\"flex size-9 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Simple pricing for fitness brands\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Fixed-price projects or a monthly studio plan. No hidden fees and you own everything we make.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-primary shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-chart-2 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-primary dark:text-primary\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Before we start\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Email hello@designali.com\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"px-6 py-20 md:py-28\">\n        <div className=\"relative mx-auto max-w-6xl overflow-hidden rounded-3xl border bg-primary/10 px-6 py-16 text-center md:py-24\">\n          <div className=\"pointer-events-none absolute -top-24 left-1/2 size-96 -translate-x-1/2 rounded-full bg-gradient-to-b from-primary/25 via-primary/10 to-transparent blur-3xl\" />\n          <div className=\"relative mx-auto max-w-2xl space-y-6\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Ship your coaching app with Designali\n            </h2>\n            <p className=\"text-lg text-muted-foreground\">\n              Start with a two-week design sprint and see real screens before you commit.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Start a project\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                How it works\n              </Button>\n            </div>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <Logo className=\"h-5 w-auto\" />\n              <span className=\"\">designali</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              Product design that ships.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Designali. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  return (\n    <div className=\"grid grid-cols-2 gap-3 md:grid-cols-3\">\n      {showcase.slice(0, 3).map((item, i) => (\n        <div\n          key={item.name}\n          className={`relative overflow-hidden rounded-2xl ${item.tile} ${i === 0 ? \"col-span-2 aspect-[16/10] md:col-span-1 md:aspect-[3/4]\" : \"aspect-[3/4]\"}`}\n        >\n          <div className=\"absolute inset-0 bg-gradient-to-t from-black/50 via-black/0 to-black/0\" />\n          <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-foreground backdrop-blur\">\n            {item.tag}\n          </span>\n          <div className=\"absolute inset-x-3 bottom-3 flex items-end justify-between gap-2 text-white\">\n            <div className=\"min-w-0\">\n              <div className=\"truncate text-sm font-medium\">{item.name}</div>\n              <div className=\"truncate text-xs text-white/75\">{item.meta}</div>\n            </div>\n            <div className=\"shrink-0 text-sm font-semibold\">{item.price}</div>\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n",
