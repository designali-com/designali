      "path": "registry/designali/pages/fintech/landing-fintech-02/page.tsx",
      "content": "import {\n  ArrowLeftRight,\n  ArrowRight,\n  ArrowUpRight,\n  ChartPie,\n  Check,\n  PiggyBank,\n  Plus,\n  Receipt,\n  ShieldCheck,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Personal\", \"Business\", \"Pricing\", \"Security\", \"Help\"]\n\nconst features = [\n  {\n    icon: ArrowLeftRight,\n    title: \"Global transfers\",\n    description:\n      \"Send money to 70 countries at the real exchange rate with a small, upfront fee.\",\n  },\n  {\n    icon: PiggyBank,\n    title: \"High-yield savings\",\n    description:\n      \"Earn up to 4.1% AER on savings with instant access and no minimum balance.\",\n  },\n  {\n    icon: ShieldCheck,\n    title: \"Bank-grade security\",\n    description:\n      \"Biometric login, real-time fraud monitoring and deposits protected up to $250,000.\",\n  },\n  {\n    icon: ChartPie,\n    title: \"Smart budgeting\",\n    description:\n      \"Automatic categories and spending insights help you see where every dollar goes.\",\n  },\n  {\n    icon: Receipt,\n    title: \"Automatic receipts\",\n    description:\n      \"Snap receipts or forward emails and they match to transactions automatically.\",\n  },\n]\n\nconst stats = [\n  { value: \"3.4M\", label: \"Customers worldwide\" },\n  { value: \"70\", label: \"Countries for transfers\" },\n  { value: \"4.1%\", label: \"AER on savings\" },\n  { value: \"1.2s\", label: \"Average card authorisation\" },\n]\n\nconst steps = [\n  {\n    title: \"Download the app\",\n    description:\n      \"Available on iOS and Android, or sign up on the web in a couple of minutes.\",\n  },\n  {\n    title: \"Verify your identity\",\n    description:\n      \"Scan your ID and take a quick selfie. Most accounts are approved in under five minutes.\",\n  },\n  {\n    title: \"Add money\",\n    description:\n      \"Top up by bank transfer, card or Apple Pay, or switch your salary with one form.\",\n  },\n  {\n    title: \"Start spending\",\n    description:\n      \"Use your virtual card instantly while your physical card ships to you for free.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Current account\",\n    meta: \"Spend and get paid with no monthly fee\",\n    tag: \"Everyday\",\n    price: \"$0/mo\",\n  },\n  {\n    name: \"Savings vault\",\n    meta: \"Instant access, interest paid daily\",\n    tag: \"4.1% AER\",\n    price: \"$0/mo\",\n  },\n  {\n    name: \"Business account\",\n    meta: \"Invoices, cards and accounting sync\",\n    tag: \"Business\",\n    price: \"$15/mo\",\n  },\n  {\n    name: \"Metal card\",\n    meta: \"Stainless steel with 1% cashback\",\n    tag: \"Premium\",\n    price: \"$12/mo\",\n  },\n  {\n    name: \"Global transfers\",\n    meta: \"Real exchange rate to 70 countries\",\n    tag: \"Low fee\",\n    price: \"From 0.4%\",\n  },\n  {\n    name: \"Investing\",\n    meta: \"Stocks and ETFs from $1\",\n    tag: \"New\",\n    price: \"No commission\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"Paying contractors in four countries used to cost me a fortune in fees. Now it costs a few dollars and arrives the same day.\",\n    name: \"Diego Santos\",\n    role: \"Agency owner\",\n  },\n  {\n    quote:\n      \"The savings rate is better than my old bank and I can move money out instantly. No reason to go back.\",\n    name: \"Megan Price\",\n    role: \"Personal customer\",\n  },\n  {\n    quote:\n      \"Our month-end close went from three days to half a day once transactions synced straight into Xero.\",\n    name: \"Alex Novak\",\n    role: \"Finance Lead, Brightfield\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Standard\",\n    price: \"$0\",\n    period: \"/month\",\n    description: \"Everything you need for everyday banking.\",\n    features: [\n      \"Free current account\",\n      \"Virtual and physical card\",\n      \"Fee-free spending abroad\",\n      \"Instant notifications\",\n    ],\n    cta: \"Open free account\",\n  },\n  {\n    name: \"Plus\",\n    price: \"$7\",\n    period: \"/month\",\n    description: \"Earn more and pay less on every transaction.\",\n    features: [\n      \"4.1% AER on savings\",\n      \"1% cashback on card spend\",\n      \"Unlimited free transfers\",\n      \"Priority 24/7 support\",\n      \"Purchase protection\",\n    ],\n    cta: \"Get Plus\",\n  },\n  {\n    name: \"Business\",\n    price: \"$15\",\n    period: \"/month\",\n    description: \"For freelancers, founders and growing teams.\",\n    features: [\n      \"Unlimited team cards\",\n      \"Invoicing and payment links\",\n      \"Accounting integrations\",\n      \"Spend controls and approvals\",\n      \"Multi-currency accounts\",\n    ],\n    cta: \"Open business account\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"How long does it take to open an account?\",\n    a: \"Most people are verified and ready to spend in under five minutes. Business accounts usually take one working day.\",\n  },\n  {\n    q: \"Are there any hidden fees?\",\n    a: \"No. Every fee is listed on our pricing page and shown in the app before you confirm a transaction.\",\n  },\n  {\n    q: \"Can I use my card abroad?\",\n    a: \"Yes. Card payments abroad are fee-free on all plans and use the real exchange rate.\",\n  },\n  {\n    q: \"What happens if I lose my card?\",\n    a: \"Freeze it instantly in the app, then order a replacement. Your virtual card keeps working in the meantime.\",\n  },\n  {\n    q: \"Do you report to credit bureaus?\",\n    a: \"Our credit-builder feature reports on-time payments to all three major bureaus to help improve your score.\",\n  },\n]\n\nconst footer = [\n  { title: \"Products\", links: [\"Personal\", \"Business\", \"Savings\", \"Cards\"] },\n  { title: \"Company\", links: [\"About\", \"Careers\", \"Press\", \"Blog\"] },\n  { title: \"Legal\", links: [\"Privacy\", \"Terms\", \"Licences\", \"Complaints\"] },\n]\n\nexport default function LandingFintech02() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-amber-600 text-white text-sm\">\n              P\n            </span>\n            <span className=\"font-serif text-lg font-normal\">Paywave</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Log in\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Start integrating\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 pt-16 pb-12 md:pt-28\">\n          <div className=\"flex items-center justify-between border-b pb-4 text-xs tracking-widest text-muted-foreground uppercase\">\n            <span>Payments infrastructure</span>\n            <span className=\"hidden sm:inline\">Payments for the internet.</span>\n          </div>\n          <h1 className=\"mt-12 max-w-5xl text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-8xl font-serif font-normal\">\n            {\"Accept payments \"}\n            <span className=\"text-amber-600 dark:text-amber-400\">\n              anywhere in the world\n            </span>\n          </h1>\n          <div className=\"mt-12 grid gap-8 md:grid-cols-2 md:items-end\">\n            <p className=\"max-w-lg text-lg leading-8 text-muted-foreground\">\n              Paywave lets online businesses accept cards, wallets and local\n              payment methods in 135 currencies with a single integration.\n            </p>\n            <div className=\"md:justify-self-end\">\n              <div className=\"flex flex-wrap gap-3 \">\n                <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                  Start integrating\n                  <ArrowRight />\n                </Button>\n                <Button\n                  size=\"lg\"\n                  variant=\"outline\"\n                  nativeButton={false}\n                  render={<a href=\"#\" />}\n                >\n                  Contact sales\n                </Button>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div className=\"mx-auto max-w-7xl px-6 pb-16\">\n          <HeroVisual />\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl grid-cols-2 px-6 lg:grid-cols-4\">\n          {stats.slice(0, 4).map((stat, i) => (\n            <div\n              key={stat.label}\n              className={`py-12 ${i > 0 ? \"lg:border-l lg:pl-8\" : \"\"} ${i % 2 === 1 ? \"border-l pl-6 lg:pl-8\" : \"\"} `}\n            >\n              <div className=\"text-4xl font-semibold tracking-tight md:text-5xl font-serif font-normal\">\n                {stat.value}\n              </div>\n              <div className=\"mt-2 text-sm text-muted-foreground\">\n                {stat.label}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.4fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <div className=\"max-w-2xl\">\n              <p className=\"text-sm font-medium text-amber-600 dark:text-amber-400\">\n                Features\n              </p>\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal mt-3\">\n                Money tools that work as hard as you do\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                Accounts, cards and payments built on modern infrastructure,\n                with fees you can understand at a glance.\n              </p>\n            </div>\n          </div>\n          <div className=\"divide-y border-y\">\n            {features.map((feature, i) => (\n              <div\n                key={feature.title}\n                className=\"grid gap-4 py-8 sm:grid-cols-[4rem_1fr]\"\n              >\n                <span className=\"font-mono text-sm text-muted-foreground\">\n                  {String(i + 1).padStart(2, \"0\")}\n                </span>\n                <div>\n                  <h3 className=\"font-serif text-2xl\">{feature.title}</h3>\n                  <p className=\"mt-2 leading-7 text-muted-foreground\">\n                    {feature.description}\n                  </p>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal\">\n                Plans and products\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                Everything you need to spend, save and move money, available in\n                one app and one login.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a\n                key={item.name}\n                href=\"#\"\n                className=\"group flex flex-col rounded-xl border p-6 transition-colors hover:bg-muted/40\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"flex size-10 items-center justify-center rounded-lg border bg-muted/50 font-semibold \">\n                    {item.name.charAt(0)}\n                  </span>\n                  <span className=\"rounded-full bg-amber-500/10 px-2.5 py-0.5 text-xs font-medium text-amber-600 dark:text-amber-400\">\n                    {item.tag}\n                  </span>\n                </div>\n                <h3 className=\"mt-6 font-semibold \">{item.name}</h3>\n                <p className=\"mt-1 flex-1 text-sm text-muted-foreground\">\n                  {item.meta}\n                </p>\n                <div className=\"mt-6 flex items-center justify-between border-t pt-4 text-sm\">\n                  <span className=\"font-medium\">{item.price}</span>\n                  <ArrowUpRight className=\"size-4 text-muted-foreground transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5\" />\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-5xl px-6 py-20 text-center md:py-28\">\n          <p className=\"text-sm tracking-widest text-muted-foreground uppercase\">\n            Trusted with millions every day\n          </p>\n          {testimonials.slice(0, 1).map((t) => (\n            <figure key={t.name} className=\"mt-10\">\n              <blockquote className=\"font-serif text-3xl leading-snug text-balance md:text-5xl\">\n                &ldquo;{t.quote}&rdquo;\n              </blockquote>\n              <figcaption className=\"mt-10 text-sm\">\n                <span className=\"font-medium\">{t.name}</span>\n                <span className=\"text-muted-foreground\"> · {t.role}</span>\n              </figcaption>\n            </figure>\n          ))}\n          <div className=\"mt-16 grid gap-6 border-t pt-12 text-left md:grid-cols-2\">\n            {testimonials.slice(1).map((t) => (\n              <figure key={t.name}>\n                <blockquote className=\"leading-7 text-muted-foreground\">\n                  &ldquo;{t.quote}&rdquo;\n                </blockquote>\n                <figcaption className=\"mt-4 text-sm font-medium\">\n                  {t.name}{\" \"}\n                  <span className=\"font-normal text-muted-foreground\">\n                    · {t.role}\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"max-w-2xl\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal\">\n              Open an account in minutes\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-foreground pt-6\"\n              >\n                <span className=\"text-sm font-medium text-amber-600 dark:text-amber-400\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal\">\n              Transparent fees, no fine print\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Pick the plan that fits how you use money. Switch or cancel at any\n              time with no penalty.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-amber-500 shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-amber-600 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-amber-600 dark:text-amber-400\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-serif font-normal\">\n              Your questions, answered\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Get in touch\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"bg-foreground text-background\">\n        <div className=\"mx-auto flex max-w-7xl flex-col gap-10 px-6 py-20 md:flex-row md:items-end md:justify-between md:py-28\">\n          <div className=\"max-w-2xl\">\n            <h2 className=\"text-4xl font-semibold tracking-tight text-balance md:text-6xl font-serif font-normal\">\n              Go live with payments this week\n            </h2>\n            <p className=\"mt-5 text-lg text-background/65\">\n              Create an account and process your first test payment in minutes.\n            </p>\n          </div>\n          <div className=\"flex flex-wrap gap-3 \">\n            <Button\n              size=\"lg\"\n              className=\"bg-background text-foreground hover:bg-background/90\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Start integrating\n              <ArrowRight />\n            </Button>\n            <Button\n              size=\"lg\"\n              variant=\"outline\"\n              className=\"border-background/25 bg-transparent text-background hover:bg-background/10 hover:text-background\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Contact sales\n            </Button>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-amber-600 text-white text-sm\">\n                P\n              </span>\n              <span className=\"font-serif text-lg font-normal\">Paywave</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              Payments for the internet.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Paywave. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  const bars = [38, 52, 44, 63, 58, 71, 66, 80, 74, 88, 83, 95]\n  return (\n    <div className=\"overflow-hidden rounded-xl border bg-card text-left text-card-foreground shadow-2xl/10\">\n      <div className=\"flex items-center gap-2 border-b px-4 py-3\">\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"ml-3 hidden rounded-md bg-muted px-3 py-0.5 text-[11px] text-muted-foreground sm:inline\">\n          app.paywave.com\n        </span>\n      </div>\n      <div className=\"grid md:grid-cols-[180px_1fr]\">\n        <aside className=\"hidden space-y-1 border-r p-3 text-sm md:block\">\n          {navLinks.map((link, i) => (\n            <div\n              key={link}\n              className={`rounded-md px-3 py-1.5 ${i === 0 ? \"bg-muted font-medium\" : \"text-muted-foreground\"}`}\n            >\n              {link}\n            </div>\n          ))}\n        </aside>\n        <div className=\"space-y-4 p-4 md:p-6\">\n          <div className=\"grid grid-cols-2 gap-3 lg:grid-cols-4\">\n            {stats.slice(0, 4).map((stat) => (\n              <div key={stat.label} className=\"rounded-lg border p-3\">\n                <div className=\"truncate text-[11px] text-muted-foreground\">\n                  {stat.label}\n                </div>\n                <div className=\"mt-1 text-lg font-semibold tracking-tight\">\n                  {stat.value}\n                </div>\n              </div>\n            ))}\n          </div>\n          <div className=\"rounded-lg border p-4\">\n            <div className=\"mb-4 flex items-center justify-between text-xs\">\n              <span className=\"font-medium\">Last 12 weeks</span>\n              <span className=\"text-amber-600 dark:text-amber-400\">+24.6%</span>\n            </div>\n            <div className=\"flex h-32 items-end gap-1.5\">\n              {bars.map((h, i) => (\n                <div\n                  key={i}\n                  className={`flex-1 rounded-t-sm ${i === bars.length - 1 ? \"bg-amber-600\" : \"bg-muted-foreground/20\"}`}\n                  style={{ height: `${h}%` }}\n                />\n              ))}\n            </div>\n          </div>\n          <div className=\"hidden divide-y rounded-lg border sm:block\">\n            {showcase.slice(0, 3).map((item) => (\n              <div\n                key={item.name}\n                className=\"flex items-center justify-between gap-4 px-4 py-2.5 text-sm\"\n              >\n                <div className=\"min-w-0\">\n                  <div className=\"truncate font-medium\">{item.name}</div>\n                  <div className=\"truncate text-xs text-muted-foreground\">\n                    {item.meta}\n                  </div>\n                </div>\n                <span className=\"shrink-0 rounded-full bg-amber-500/10 px-2 py-0.5 text-[11px] font-medium text-amber-600 dark:text-amber-400\">\n                  {item.tag}\n                </span>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n    </div>\n  )\n}\n",
