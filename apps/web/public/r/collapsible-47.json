{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "collapsible-47",
  "type": "registry:example",
  "description": "Billing page showing the current invoice with past invoices tucked into a collapsible.",
  "files": [
    {
      "path": "registry/designali/examples/collapsible/collapsible-47.tsx",
      "content": "import { ArchiveIcon, ChevronDownIcon, DownloadIcon } from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  Collapsible,\n  CollapsibleContent,\n  CollapsibleTrigger,\n} from \"@workspace/ui/components/collapsible\"\n\nconst past = [\n  { month: \"October 2026\", amount: \"$49.00\" },\n  { month: \"September 2026\", amount: \"$49.00\" },\n  { month: \"August 2026\", amount: \"$29.00\" },\n]\n\nexport default function PastInvoicesHistory() {\n  return (\n    <div className=\"w-full max-w-sm space-y-3\">\n      <div className=\"flex items-center justify-between border p-3\">\n        <div>\n          <p className=\"text-sm font-medium\">November 2026</p>\n          <p className=\"text-xs text-muted-foreground\">\n            Due Dec 1 · Visa ending 4242\n          </p>\n        </div>\n        <span className=\"text-sm font-semibold\">$49.00</span>\n      </div>\n      <Collapsible>\n        <CollapsibleTrigger\n          render={\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"w-full justify-start\"\n            />\n          }\n        >\n          <ArchiveIcon />\n          Past invoices\n          <ChevronDownIcon className=\"ml-auto transition-transform group-data-panel-open/button:rotate-180\" />\n        </CollapsibleTrigger>\n        <CollapsibleContent className=\"h-(--collapsible-panel-height) overflow-hidden transition-[height] duration-200 ease-out data-ending-style:h-0 data-starting-style:h-0\">\n          <ul className=\"divide-y border\">\n            {past.map((invoice) => (\n              <li\n                key={invoice.month}\n                className=\"flex items-center gap-2 px-3 py-2 text-sm\"\n              >\n                <span className=\"flex-1\">{invoice.month}</span>\n                <span className=\"text-muted-foreground\">{invoice.amount}</span>\n                <Button\n                  variant=\"ghost\"\n                  size=\"icon-xs\"\n                  aria-label={\"Download \" + invoice.month}\n                >\n                  <DownloadIcon />\n                </Button>\n              </li>\n            ))}\n          </ul>\n        </CollapsibleContent>\n      </Collapsible>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}