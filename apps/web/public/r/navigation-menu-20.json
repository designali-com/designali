{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "navigation-menu-20",
  "type": "registry:example",
  "description": "Creative agency navigation with case study tiles and a services list side by side.",
  "files": [
    {
      "path": "registry/designali/examples/navigation-menu/navigation-menu-20.tsx",
      "content": "import {\n  NavigationMenu,\n  NavigationMenuContent,\n  NavigationMenuItem,\n  NavigationMenuLink,\n  NavigationMenuList,\n  NavigationMenuTrigger,\n  navigationMenuTriggerStyle,\n} from \"@workspace/ui/components/navigation-menu\"\nimport { cn } from \"@workspace/ui/lib/utils\"\n\nconst work = [\n  {\n    client: \"Pinecone Coffee\",\n    type: \"Brand identity\",\n    gradient: \"from-stone-400 to-amber-700\",\n  },\n  {\n    client: \"Volta Bikes\",\n    type: \"E-commerce\",\n    gradient: \"from-lime-300 to-emerald-600\",\n  },\n]\n\nconst services = [\"Brand strategy\", \"Web design\", \"Motion\", \"Product design\"]\n\nexport default function AgencyWorkNav() {\n  return (\n    <NavigationMenu>\n      <NavigationMenuList>\n        <NavigationMenuItem>\n          <NavigationMenuTrigger>Work</NavigationMenuTrigger>\n          <NavigationMenuContent>\n            <div className=\"grid w-72 gap-1 sm:w-[30rem] sm:grid-cols-[1fr_10rem]\">\n              <ul className=\"grid grid-cols-2 gap-1\">\n                {work.map((w) => (\n                  <li key={w.client}>\n                    <NavigationMenuLink\n                      href=\"#\"\n                      className=\"flex-col items-stretch gap-1\"\n                    >\n                      <span\n                        className={cn(\n                          \"aspect-[4/3] bg-gradient-to-br\",\n                          w.gradient\n                        )}\n                      />\n                      <span className=\"font-medium\">{w.client}</span>\n                      <span className=\"text-muted-foreground\">{w.type}</span>\n                    </NavigationMenuLink>\n                  </li>\n                ))}\n              </ul>\n              <ul className=\"flex flex-col gap-0.5 border-t pt-1 sm:border-s sm:border-t-0 sm:ps-1 sm:pt-0\">\n                {services.map((s) => (\n                  <li key={s}>\n                    <NavigationMenuLink href=\"#\">{s}</NavigationMenuLink>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          </NavigationMenuContent>\n        </NavigationMenuItem>\n        <NavigationMenuItem>\n          <NavigationMenuLink href=\"#\" className={navigationMenuTriggerStyle()}>\n            Studio\n          </NavigationMenuLink>\n        </NavigationMenuItem>\n      </NavigationMenuList>\n    </NavigationMenu>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}