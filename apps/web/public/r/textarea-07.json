  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "textarea-07",
  "type": "registry:example",
  "description": "Textarea that grows with its content up to a maximum height, then scrolls.",
  "files": [
    {
      "path": "registry/designali/examples/textarea/textarea-07.tsx",
      "content": "import { Label } from \"@workspace/ui/components/label\"\nimport { Textarea } from \"@workspace/ui/components/textarea\"\n\nexport default function AutoGrowTextarea() {\n  return (\n    <div className=\"grid w-full max-w-sm gap-1.5\">\n      <Label htmlFor=\"ta-grow\">Meeting agenda</Label>\n      <Textarea\n        id=\"ta-grow\"\n        rows={1}\n        className=\"max-h-40 min-h-9 resize-none\"\n        placeholder=\"Type and press Enter, the box grows with you…\"\n      />\n      <p className=\"text-xs text-muted-foreground\">\n        Grows up to 10 lines, then scrolls.\n      </p>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}