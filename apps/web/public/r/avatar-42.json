{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "avatar-42",
  "type": "registry:example",
  "description": "An avatar wrapped in an SVG progress ring that shows profile completion.",
  "files": [
    {
      "path": "registry/designali/examples/avatar/avatar-42.tsx",
      "content": "import { Avatar, AvatarFallback } from \"@workspace/ui/components/avatar\"\n\nconst percent = 70\nconst radius = 30\nconst circumference = 2 * Math.PI * radius\n\nexport default function ProfileCompletionRing() {\n  return (\n    <div className=\"flex w-full max-w-xs items-center gap-4 border p-4\">\n      <div className=\"relative size-16 shrink-0\">\n        <svg viewBox=\"0 0 64 64\" className=\"absolute inset-0 -rotate-90\">\n          <circle\n            cx=\"32\"\n            cy=\"32\"\n            r={radius}\n            fill=\"none\"\n            strokeWidth=\"3\"\n            className=\"stroke-muted\"\n          />\n          <circle\n            cx=\"32\"\n            cy=\"32\"\n            r={radius}\n            fill=\"none\"\n            strokeWidth=\"3\"\n            strokeLinecap=\"round\"\n            strokeDasharray={circumference}\n            strokeDashoffset={circumference * (1 - percent / 100)}\n            className=\"stroke-primary\"\n          />\n        </svg>\n        <Avatar className=\"absolute inset-1.5 size-auto\">\n          <AvatarFallback className=\"font-medium\">RB</AvatarFallback>\n        </Avatar>\n      </div>\n      <div>\n        <p className=\"text-sm font-medium\">Profile {percent}% complete</p>\n        <p className=\"text-xs text-muted-foreground\">\n          Add a bio and timezone to finish setup.\n        </p>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}