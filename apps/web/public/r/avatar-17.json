{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "avatar-17",
  "type": "registry:example",
  "description": "A profile card with an oversized avatar, bio, and follow action.",
  "files": [
    {
      "path": "registry/designali/examples/avatar/avatar-17.tsx",
      "content": "import { Avatar, AvatarFallback } from \"@workspace/ui/components/avatar\"\nimport { Button } from \"@workspace/ui/components/button\"\nimport { Card, CardContent } from \"@workspace/ui/components/card\"\n\nexport default function ProfileCardHeader() {\n  return (\n    <Card className=\"w-full max-w-xs\">\n      <CardContent className=\"flex flex-col items-center gap-3 text-center\">\n        <Avatar className=\"size-20\">\n          <AvatarFallback className=\"bg-gradient-to-br from-primary to-primary text-2xl font-semibold text-white\">\n            AI\n          </AvatarFallback>\n        </Avatar>\n        <div>\n          <p className=\"text-base font-semibold\">Ali Imam</p>\n          <p className=\"text-xs text-muted-foreground\">\n            Design engineer at Designali\n          </p>\n        </div>\n        <div className=\"flex gap-6 text-xs\">\n          <div>\n            <span className=\"block text-sm font-semibold\">460</span>Blocks\n          </div>\n          <div>\n            <span className=\"block text-sm font-semibold\">2.3k</span>UI designs\n          </div>\n          <div>\n            <span className=\"block text-sm font-semibold\">4k</span>Icons\n          </div>\n        </div>\n        <Button className=\"w-full\">Follow</Button>\n      </CardContent>\n    </Card>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}