{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "popover-44",
  "type": "registry:example",
  "description": "Locked premium setting whose lock icon opens an upgrade prompt instead of the control.",
  "files": [
    {
      "path": "registry/designali/examples/popover/popover-44.tsx",
      "content": "import {\n  Lock as LockIcon,\n  Sparkles as SparklesIcon,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  Popover,\n  PopoverContent,\n  PopoverDescription,\n  PopoverHeader,\n  PopoverTitle,\n  PopoverTrigger,\n} from \"@workspace/ui/components/popover\"\nimport { Switch } from \"@workspace/ui/components/switch\"\n\nexport default function UpgradeLockedFeaturePopover() {\n  return (\n    <div className=\"flex w-full max-w-sm flex-col divide-y border\">\n      <div className=\"flex items-center justify-between p-3\">\n        <div className=\"flex flex-col\">\n          <span className=\"text-xs font-medium\">Two-factor authentication</span>\n          <span className=\"text-[11px] text-muted-foreground\">\n            Required for all members\n          </span>\n        </div>\n        <Switch defaultChecked />\n      </div>\n      <div className=\"flex items-center justify-between p-3\">\n        <div className=\"flex flex-col\">\n          <span className=\"text-xs font-medium\">SAML single sign-on</span>\n          <span className=\"text-[11px] text-muted-foreground\">\n            Connect your identity provider\n          </span>\n        </div>\n        <Popover>\n          <PopoverTrigger render={<Button variant=\"outline\" size=\"xs\" />}>\n            <LockIcon data-icon=\"inline-start\" /> Business\n          </PopoverTrigger>\n          <PopoverContent className=\"w-64\" align=\"end\">\n            <div className=\"flex size-8 items-center justify-center bg-gradient-to-br from-primary to-primary text-white\">\n              <SparklesIcon className=\"size-4\" />\n            </div>\n            <PopoverHeader>\n              <PopoverTitle>Available on Business</PopoverTitle>\n              <PopoverDescription>\n                Upgrade to enforce SSO, provision users automatically, and get\n                audit logs.\n              </PopoverDescription>\n            </PopoverHeader>\n            <div className=\"flex gap-2\">\n              <Button size=\"sm\" className=\"flex-1\">\n                Upgrade\n              </Button>\n              <Button size=\"sm\" variant=\"ghost\" className=\"flex-1\">\n                Compare plans\n              </Button>\n            </div>\n          </PopoverContent>\n        </Popover>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}