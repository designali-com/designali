{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dialog-36",
  "type": "registry:example",
  "description": "File upload dialog with a dropzone and per-file progress rows.",
  "files": [
    {
      "path": "registry/designali/examples/dialog/dialog-36.tsx",
      "content": "import {\n  CircleCheck as CircleCheckIcon,\n  CloudUpload as CloudUploadIcon,\n  File as FileIcon,\n  Upload as UploadIcon,\n  X as XIcon,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  Dialog,\n  DialogClose,\n  DialogContent,\n  DialogDescription,\n  DialogFooter,\n  DialogHeader,\n  DialogTitle,\n  DialogTrigger,\n} from \"@workspace/ui/components/dialog\"\nimport { Progress } from \"@workspace/ui/components/progress\"\n\nconst files = [\n  { name: \"designali-hero.fig\", size: \"4.2 MB\", progress: 100 },\n  { name: \"brand-identity-guide.pdf\", size: \"12.8 MB\", progress: 64 },\n  { name: \"project-brief.docx\", size: \"860 KB\", progress: 18 },\n]\n\nexport default function UploadFilesDialog() {\n  return (\n    <Dialog>\n      <DialogTrigger render={<Button />}>\n        <UploadIcon data-icon=\"inline-start\" />\n        Upload files\n      </DialogTrigger>\n      <DialogContent className=\"sm:max-w-md\">\n        <DialogHeader>\n          <DialogTitle>Upload to Designali Studio</DialogTitle>\n          <DialogDescription>Max 100 MB per file.</DialogDescription>\n        </DialogHeader>\n        <label className=\"flex cursor-pointer flex-col items-center gap-2 border border-dashed bg-muted/30 px-4 py-8 text-center hover:bg-muted/60\">\n          <CloudUploadIcon className=\"size-6 text-muted-foreground\" />\n          <span className=\"font-medium\">\n            Drop files here or click to browse\n          </span>\n          <span className=\"text-muted-foreground\">\n            PDF, DOCX, FIG, PNG up to 100 MB\n          </span>\n          <input type=\"file\" multiple className=\"sr-only\" />\n        </label>\n        <div className=\"flex flex-col gap-3\">\n          {files.map((file) => (\n            <div key={file.name} className=\"flex items-center gap-3\">\n              <FileIcon className=\"size-4 shrink-0 text-muted-foreground\" />\n              <div className=\"flex min-w-0 flex-1 flex-col gap-1\">\n                <div className=\"flex justify-between gap-2\">\n                  <span className=\"truncate\">{file.name}</span>\n                  <span className=\"shrink-0 text-muted-foreground\">\n                    {file.progress === 100 ? file.size : file.progress + \"%\"}\n                  </span>\n                </div>\n                <Progress value={file.progress} />\n              </div>\n              {file.progress === 100 ? (\n                <CircleCheckIcon className=\"size-4 shrink-0\" />\n              ) : (\n                <Button\n                  variant=\"ghost\"\n                  size=\"icon-xs\"\n                  aria-label={\"Cancel \" + file.name}\n                >\n                  <XIcon />\n                </Button>\n              )}\n            </div>\n          ))}\n        </div>\n        <DialogFooter>\n          <DialogClose render={<Button variant=\"outline\" />}>Close</DialogClose>\n        </DialogFooter>\n      </DialogContent>\n    </Dialog>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}