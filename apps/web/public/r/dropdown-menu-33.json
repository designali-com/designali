{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dropdown-menu-33",
  "type": "registry:example",
  "description": "Email toolbar menu with two levels of nested submenus for labels and folders.",
  "files": [
    {
      "path": "registry/designali/examples/dropdown-menu/dropdown-menu-33.tsx",
      "content": "import {\n  ArchiveIcon,\n  FolderIcon,\n  FolderInputIcon,\n  InboxIcon,\n  ReceiptIcon,\n  ShieldAlertIcon,\n  Trash2Icon,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuSeparator,\n  DropdownMenuSub,\n  DropdownMenuSubContent,\n  DropdownMenuSubTrigger,\n  DropdownMenuTrigger,\n} from \"@workspace/ui/components/dropdown-menu\"\n\nexport default function EmailMoveToNestedMenu() {\n  return (\n    <div className=\"flex items-center gap-1 border p-1\">\n      <Button variant=\"ghost\" size=\"icon-sm\" aria-label=\"Archive\">\n        <ArchiveIcon />\n      </Button>\n      <Button variant=\"ghost\" size=\"icon-sm\" aria-label=\"Delete\">\n        <Trash2Icon />\n      </Button>\n      <DropdownMenu>\n        <DropdownMenuTrigger render={<Button variant=\"ghost\" size=\"sm\" />}>\n          <FolderInputIcon data-icon=\"inline-start\" />\n          Move\n        </DropdownMenuTrigger>\n        <DropdownMenuContent className=\"w-44\">\n          <DropdownMenuItem>\n            <InboxIcon />\n            Inbox\n          </DropdownMenuItem>\n          <DropdownMenuSub>\n            <DropdownMenuSubTrigger>\n              <FolderIcon />\n              Projects\n            </DropdownMenuSubTrigger>\n            <DropdownMenuSubContent className=\"w-40\">\n              <DropdownMenuItem>Harbor redesign</DropdownMenuItem>\n              <DropdownMenuSub>\n                <DropdownMenuSubTrigger>Clients</DropdownMenuSubTrigger>\n                <DropdownMenuSubContent className=\"w-36\">\n                  <DropdownMenuItem>Willow & Co</DropdownMenuItem>\n                  <DropdownMenuItem>Brightside</DropdownMenuItem>\n                  <DropdownMenuItem>Kestrel Labs</DropdownMenuItem>\n                </DropdownMenuSubContent>\n              </DropdownMenuSub>\n              <DropdownMenuItem>Internal</DropdownMenuItem>\n            </DropdownMenuSubContent>\n          </DropdownMenuSub>\n          <DropdownMenuItem>\n            <ReceiptIcon />\n            Receipts\n          </DropdownMenuItem>\n          <DropdownMenuSeparator />\n          <DropdownMenuItem>\n            <ShieldAlertIcon />\n            Report spam\n          </DropdownMenuItem>\n        </DropdownMenuContent>\n      </DropdownMenu>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}