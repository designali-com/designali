{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "drawer-33",
  "type": "registry:example",
  "description": "Storefront bottom drawer for choosing color and size before adding to bag.",
  "files": [
    {
      "path": "registry/designali/examples/drawer/drawer-33.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  ShoppingBag as ShoppingBagIcon,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  Drawer,\n  DrawerClose,\n  DrawerContent,\n  DrawerDescription,\n  DrawerFooter,\n  DrawerHeader,\n  DrawerTitle,\n  DrawerTrigger,\n} from \"@workspace/ui/components/drawer\"\nimport {\n  ToggleGroup,\n  ToggleGroupItem,\n} from \"@workspace/ui/components/toggle-group\"\nimport { cn } from \"@workspace/ui/lib/utils\"\n\nconst colors = [\n  { value: \"olive\", label: \"Olive\", className: \"bg-chart-4\" },\n  { value: \"navy\", label: \"Navy\", className: \"bg-chart-5\" },\n  { value: \"rust\", label: \"Rust\", className: \"bg-chart-3\" },\n]\nconst sizes = [\"S\", \"M\", \"L\", \"XL\"]\n\nexport default function ProductOptionsDrawer() {\n  const [color, setColor] = React.useState(\"olive\")\n  const [size, setSize] = React.useState<string[]>([])\n\n  return (\n    <Drawer>\n      <DrawerTrigger render={<Button className=\"w-full max-w-xs\" />}>\n        <ShoppingBagIcon data-icon=\"inline-start\" />\n        Add to bag · $148\n      </DrawerTrigger>\n      <DrawerContent>\n        <div className=\"mx-auto flex w-full max-w-sm flex-col\">\n          <DrawerHeader className=\"flex-row items-center gap-3 text-start\">\n            <div className=\"size-14 shrink-0 bg-gradient-to-br from-chart-3 to-chart-5\" />\n            <div>\n              <DrawerTitle>Field Jacket</DrawerTitle>\n              <DrawerDescription>Waxed cotton · $148</DrawerDescription>\n            </div>\n          </DrawerHeader>\n          <div className=\"flex flex-col gap-4 p-4\">\n            <div className=\"flex flex-col gap-2\">\n              <p className=\"font-medium\">\n                Color:{\" \"}\n                <span className=\"font-normal text-muted-foreground capitalize\">\n                  {color}\n                </span>\n              </p>\n              <div className=\"flex gap-2\">\n                {colors.map((item) => (\n                  <button\n                    key={item.value}\n                    type=\"button\"\n                    aria-label={item.label}\n                    aria-pressed={item.value === color}\n                    onClick={() => setColor(item.value)}\n                    className={cn(\n                      \"size-8 rounded-full ring-offset-2 ring-offset-background\",\n                      item.className,\n                      item.value === color && \"ring-2 ring-foreground\"\n                    )}\n                  />\n                ))}\n              </div>\n            </div>\n            <div className=\"flex flex-col gap-2\">\n              <div className=\"flex justify-between\">\n                <p className=\"font-medium\">Size</p>\n                <Button variant=\"link\" size=\"xs\" className=\"h-auto p-0\">\n                  Size guide\n                </Button>\n              </div>\n              <ToggleGroup\n                variant=\"outline\"\n                value={size}\n                onValueChange={(value) => setSize(value.map(String))}\n                className=\"grid w-full grid-cols-4\"\n              >\n                {sizes.map((item) => (\n                  <ToggleGroupItem\n                    key={item}\n                    value={item}\n                    disabled={item === \"XL\"}\n                  >\n                    {item}\n                  </ToggleGroupItem>\n                ))}\n              </ToggleGroup>\n              <p className=\"text-muted-foreground\">\n                XL is sold out in {color}.\n              </p>\n            </div>\n          </div>\n          <DrawerFooter>\n            <DrawerClose render={<Button disabled={size.length === 0} />}>\n              {size.length\n                ? \"Add size \" + size[0] + \" to bag\"\n                : \"Select a size\"}\n            </DrawerClose>\n          </DrawerFooter>\n        </div>\n      </DrawerContent>\n    </Drawer>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}