    {
      "path": "registry/designali/pages/health/landing-health-04/page.tsx",
      "content": "import {\n  Activity,\n  ArrowRight,\n  ArrowUpRight,\n  CalendarCheck,\n  Check,\n  FlaskConical,\n  MessageCircle,\n  Plus,\n  Quote,\n  ShieldCheck,\n  Sparkles,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Services\", \"How it works\", \"Pricing\", \"Clinicians\", \"FAQ\"]\n\nconst logos = [\n  \"Humana\",\n  \"Anthem\",\n  \"Kaiser\",\n  \"Blue Shield\",\n  \"Oscar\",\n  \"Aetna\",\n  \"Cigna\",\n  \"UnitedHealthcare\",\n]\n\nconst features = [\n  {\n    icon: MessageCircle,\n    title: \"Message your clinician\",\n    description:\n      \"Ask follow-up questions in a secure chat and get a reply within one business day.\",\n  },\n  {\n    icon: FlaskConical,\n    title: \"At-home lab tests\",\n    description:\n      \"Order blood work online, collect a sample at home and get results with a doctor's notes.\",\n  },\n  {\n    icon: ShieldCheck,\n    title: \"Private and secure\",\n    description:\n      \"HIPAA compliant, end-to-end encrypted, and we never sell your health data. Ever.\",\n  },\n  {\n    icon: CalendarCheck,\n    title: \"Same-day appointments\",\n    description:\n      \"Book in-person visits at partner clinics near you, with real-time availability.\",\n  },\n  {\n    icon: Activity,\n    title: \"Connected monitoring\",\n    description:\n      \"Sync blood pressure cuffs, glucose monitors and wearables so your team sees trends.\",\n  },\n]\n\nconst stats = [\n  { value: \"50\", label: \"States covered\" },\n  { value: \"2,300\", label: \"Licensed clinicians\" },\n  { value: \"92%\", label: \"Issues resolved in one visit\" },\n  { value: \"1.8M\", label: \"Patients treated\" },\n]\n\nconst steps = [\n  {\n    title: \"Tell us what is going on\",\n    description:\n      \"Answer a few questions about your symptoms and medical history in about three minutes.\",\n  },\n  {\n    title: \"Meet your clinician\",\n    description:\n      \"Connect by video or chat with a licensed provider in your state, often within minutes.\",\n  },\n  {\n    title: \"Get your treatment plan\",\n    description:\n      \"Receive a diagnosis, prescriptions and clear next steps, all saved in your app.\",\n  },\n  {\n    title: \"Follow up any time\",\n    description:\n      \"Message your care team with questions or book a follow-up with the same clinician.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Urgent care\",\n    meta: \"Colds, flu, infections, rashes\",\n    tag: \"24/7\",\n    price: \"$49\",\n  },\n  {\n    name: \"Mental health\",\n    meta: \"Therapy and psychiatry\",\n    tag: \"Popular\",\n    price: \"$99\",\n  },\n  {\n    name: \"Women's health\",\n    meta: \"Birth control, UTIs, menopause\",\n    tag: \"Same day\",\n    price: \"$39\",\n  },\n  {\n    name: \"Chronic care\",\n    meta: \"Diabetes, hypertension, thyroid\",\n    tag: \"Ongoing\",\n    price: \"$29/mo\",\n  },\n  {\n    name: \"Dermatology\",\n    meta: \"Acne, eczema, hair loss\",\n    tag: \"Photo visit\",\n    price: \"$59\",\n  },\n  {\n    name: \"Weight care\",\n    meta: \"Clinician-led programs\",\n    tag: \"New\",\n    price: \"$79/mo\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"As a working parent, being able to get my kids seen at 9pm on a Tuesday is genuinely life-changing.\",\n    name: \"Carlos Rivera\",\n    role: \"Family plan member\",\n  },\n  {\n    quote:\n      \"Prices are listed upfront, and the bill matched exactly. That alone made me switch.\",\n    name: \"Nina Patel\",\n    role: \"Self-pay patient\",\n  },\n  {\n    quote:\n      \"We offer this to all 1,200 employees. Sick days dropped and our benefits survey scores went up.\",\n    name: \"Michael Owens\",\n    role: \"HR Director\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Pay per visit\",\n    price: \"$49\",\n    period: \"/visit\",\n    description: \"For occasional care when you need it.\",\n    features: [\n      \"24/7 urgent care\",\n      \"Prescriptions sent anywhere\",\n      \"Visit notes in the app\",\n      \"No membership\",\n    ],\n    cta: \"Book a visit\",\n  },\n  {\n    name: \"Membership\",\n    price: \"$19\",\n    period: \"/month\",\n    description: \"For individuals who want a regular care team.\",\n    features: [\n      \"Unlimited messaging\",\n      \"$0 urgent care visits\",\n      \"Dedicated primary care doctor\",\n      \"Discounted lab tests\",\n      \"Annual wellness check\",\n    ],\n    cta: \"Become a member\",\n  },\n  {\n    name: \"Family\",\n    price: \"$39\",\n    period: \"/month\",\n    description: \"Cover up to six people on one plan.\",\n    features: [\n      \"Everything in Membership\",\n      \"Pediatric care\",\n      \"Shared family dashboard\",\n      \"Up to 6 members\",\n      \"Priority booking\",\n    ],\n    cta: \"Cover your family\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"Who are your clinicians?\",\n    a: \"Every clinician is board certified and licensed in your state, with an average of 11 years of experience.\",\n  },\n  {\n    q: \"Is my information private?\",\n    a: \"Your data is protected under HIPAA, encrypted end to end and never sold or shared for advertising.\",\n  },\n  {\n    q: \"What if I need emergency care?\",\n    a: \"For emergencies such as chest pain or difficulty breathing, call 911 or go to the nearest emergency room.\",\n  },\n  {\n    q: \"Do you accept insurance?\",\n    a: \"Yes. We are in network with most major insurers. Enter your plan details at checkout to see your exact cost.\",\n  },\n  {\n    q: \"Can you prescribe medication?\",\n    a: \"Our clinicians can prescribe most common medications. We do not prescribe controlled substances online.\",\n  },\n]\n\nconst footer = [\n  {\n    title: \"Care\",\n    links: [\"Urgent care\", \"Mental health\", \"Chronic care\", \"Lab tests\"],\n  },\n  { title: \"Company\", links: [\"About\", \"Clinicians\", \"Careers\", \"Press\"] },\n  {\n    title: \"Support\",\n    links: [\"Help center\", \"Insurance\", \"Privacy\", \"Contact\"],\n  },\n]\n\nexport default function LandingHealth04() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-indigo-600 text-white text-sm\">\n              P\n            </span>\n            <span className=\"\">Pulsepoint</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Patient login\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Check eligibility\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-16 md:py-24\">\n          <div className=\"mx-auto max-w-3xl space-y-6 text-center\">\n            <span className=\"inline-flex items-center gap-2 rounded-full border bg-background text-muted-foreground px-3 py-1 text-xs font-medium\">\n              <Sparkles className=\"size-3.5 text-indigo-600 dark:text-indigo-400\" />\n              Remote monitoring for chronic care\n            </span>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-6xl \">\n              {\"Chronic care that keeps watch \"}\n              <span className=\"text-indigo-600 dark:text-indigo-400\">\n                between visits\n              </span>\n            </h1>\n            <p className=\"mx-auto max-w-2xl text-lg leading-8 text-muted-foreground\">\n              Pulsepoint pairs connected devices with a dedicated nurse who\n              reviews your readings daily and adjusts your plan with your\n              doctor.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Check eligibility\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                For providers\n              </Button>\n            </div>\n          </div>\n          <div className=\"mt-14 grid gap-3 lg:grid-cols-[2fr_1fr]\">\n            <HeroVisual />\n            <div className=\"grid grid-cols-2 gap-3 lg:grid-cols-1\">\n              {stats.slice(0, 3).map((stat, i) => (\n                <div\n                  key={stat.label}\n                  className={`flex flex-col justify-between rounded-2xl border p-5 ${i === 0 ? \"bg-indigo-500/10\" : \"bg-muted/40\"} ${i === 2 ? \"col-span-2 lg:col-span-1\" : \"\"}`}\n                >\n                  <div className=\"text-xs text-muted-foreground\">\n                    {stat.label}\n                  </div>\n                  <div className=\"mt-6 text-3xl font-semibold tracking-tight\">\n                    {stat.value}\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-12\">\n          <p className=\"text-center text-sm text-muted-foreground\">\n            In network with\n          </p>\n          <div className=\"mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-6 sm:grid-cols-4 lg:grid-cols-8\">\n            {logos.map((logo) => (\n              <div\n                key={logo}\n                className=\"text-center text-base font-semibold tracking-tight text-muted-foreground/70 \"\n              >\n                {logo}\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <p className=\"text-sm font-medium text-indigo-600 dark:text-indigo-400\">\n              Care\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              Healthcare that fits around your life\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Licensed clinicians, same-day appointments and prescriptions\n              delivered to your door, all from your phone.\n            </p>\n          </div>\n          <div className=\"mt-14 grid gap-3 md:grid-cols-3\">\n            {features.map((feature, i) => (\n              <div\n                key={feature.title}\n                className={`group rounded-2xl border p-6 transition-colors hover:bg-muted/40 ${i === 0 ? \"bg-indigo-500/10 md:col-span-2 md:row-span-2 md:p-10\" : \"\"} ${i === 3 ? \"md:col-span-2\" : \"\"}`}\n              >\n                <feature.icon\n                  className={`${i === 0 ? \"size-8\" : \"size-5\"} text-indigo-600 dark:text-indigo-400`}\n                />\n                <h3\n                  className={`mt-6 font-semibold tracking-tight ${i === 0 ? \"text-2xl md:text-3xl\" : \"text-lg\"}`}\n                >\n                  {feature.title}\n                </h3>\n                <p\n                  className={`mt-2 leading-7 text-muted-foreground ${i === 0 ? \"max-w-md text-lg\" : \"text-sm\"}`}\n                >\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                What we can help with\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                From everyday illnesses to ongoing conditions, our clinicians\n                treat hundreds of concerns online.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a\n                key={item.name}\n                href=\"#\"\n                className=\"group flex flex-col rounded-xl border p-6 transition-colors hover:bg-muted/40\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"flex size-10 items-center justify-center rounded-lg border bg-muted/50 font-semibold \">\n                    {item.name.charAt(0)}\n                  </span>\n                  <span className=\"rounded-full bg-indigo-500/10 px-2.5 py-0.5 text-xs font-medium text-indigo-600 dark:text-indigo-400\">\n                    {item.tag}\n                  </span>\n                </div>\n                <h3 className=\"mt-6 font-semibold \">{item.name}</h3>\n                <p className=\"mt-1 flex-1 text-sm text-muted-foreground\">\n                  {item.meta}\n                </p>\n                <div className=\"mt-6 flex items-center justify-between border-t pt-4 text-sm\">\n                  <span className=\"font-medium\">{item.price}</span>\n                  <ArrowUpRight className=\"size-4 text-muted-foreground transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5\" />\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b bg-muted/30\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Patients who feel heard\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-4 md:grid-cols-3\">\n            {testimonials.map((t, i) => (\n              <figure\n                key={t.name}\n                className={`flex flex-col justify-between rounded-2xl border bg-background p-6 ${i === 0 ? \"md:col-span-2 md:p-10\" : \"\"}`}\n              >\n                <Quote className=\"size-6 text-indigo-600 dark:text-indigo-400\" />\n                <blockquote\n                  className={`mt-4 leading-relaxed ${i === 0 ? \"text-xl md:text-2xl\" : \"text-muted-foreground\"}`}\n                >\n                  {t.quote}\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 text-sm\">\n                  <span className=\"flex size-9 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Getting care is simple\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-indigo-600 dark:text-indigo-400\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Clear pricing, with or without insurance\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Most major insurance plans accepted. Self-pay prices are listed\n              upfront, with no surprise bills.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-indigo-500 shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-indigo-600 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-indigo-600 dark:text-indigo-400\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Common questions\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Get in touch\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"px-6 py-20 md:py-28\">\n        <div className=\"relative mx-auto max-w-6xl overflow-hidden rounded-3xl border bg-indigo-500/10 px-6 py-16 text-center md:py-24\">\n          <div className=\"pointer-events-none absolute -top-24 left-1/2 size-96 -translate-x-1/2 rounded-full bg-gradient-to-b from-indigo-500/25 via-violet-500/10 to-transparent blur-3xl\" />\n          <div className=\"relative mx-auto max-w-2xl space-y-6\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Fewer flare-ups, fewer hospital visits\n            </h2>\n            <p className=\"text-lg text-muted-foreground\">\n              Most Medicare patients pay nothing. Check your eligibility in two\n              minutes.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Check eligibility\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                For providers\n              </Button>\n            </div>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-indigo-600 text-white text-sm\">\n                P\n              </span>\n              <span className=\"\">Pulsepoint</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              Care that never clocks off.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Pulsepoint. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  const bars = [38, 52, 44, 63, 58, 71, 66, 80, 74, 88, 83, 95]\n  return (\n    <div className=\"overflow-hidden rounded-xl border bg-card text-left text-card-foreground shadow-2xl/10\">\n      <div className=\"flex items-center gap-2 border-b px-4 py-3\">\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"ml-3 hidden rounded-md bg-muted px-3 py-0.5 text-[11px] text-muted-foreground sm:inline\">\n          app.pulsepoint.com\n        </span>\n      </div>\n      <div className=\"grid md:grid-cols-[180px_1fr]\">\n        <aside className=\"hidden space-y-1 border-r p-3 text-sm md:block\">\n          {navLinks.map((link, i) => (\n            <div\n              key={link}\n              className={`rounded-md px-3 py-1.5 ${i === 0 ? \"bg-muted font-medium\" : \"text-muted-foreground\"}`}\n            >\n              {link}\n            </div>\n          ))}\n        </aside>\n        <div className=\"space-y-4 p-4 md:p-6\">\n          <div className=\"grid grid-cols-2 gap-3 lg:grid-cols-4\">\n            {stats.slice(0, 4).map((stat) => (\n              <div key={stat.label} className=\"rounded-lg border p-3\">\n                <div className=\"truncate text-[11px] text-muted-foreground\">\n                  {stat.label}\n                </div>\n                <div className=\"mt-1 text-lg font-semibold tracking-tight\">\n                  {stat.value}\n                </div>\n              </div>\n            ))}\n          </div>\n          <div className=\"rounded-lg border p-4\">\n            <div className=\"mb-4 flex items-center justify-between text-xs\">\n              <span className=\"font-medium\">Last 12 weeks</span>\n              <span className=\"text-indigo-600 dark:text-indigo-400\">\n                +24.6%\n              </span>\n            </div>\n            <div className=\"flex h-32 items-end gap-1.5\">\n              {bars.map((h, i) => (\n                <div\n                  key={i}\n                  className={`flex-1 rounded-t-sm ${i === bars.length - 1 ? \"bg-indigo-600\" : \"bg-muted-foreground/20\"}`}\n                  style={{ height: `${h}%` }}\n                />\n              ))}\n            </div>\n          </div>\n          <div className=\"hidden divide-y rounded-lg border sm:block\">\n            {showcase.slice(0, 3).map((item) => (\n              <div\n                key={item.name}\n                className=\"flex items-center justify-between gap-4 px-4 py-2.5 text-sm\"\n              >\n                <div className=\"min-w-0\">\n                  <div className=\"truncate font-medium\">{item.name}</div>\n                  <div className=\"truncate text-xs text-muted-foreground\">\n                    {item.meta}\n                  </div>\n                </div>\n                <span className=\"shrink-0 rounded-full bg-indigo-500/10 px-2 py-0.5 text-[11px] font-medium text-indigo-600 dark:text-indigo-400\">\n                  {item.tag}\n                </span>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n    </div>\n  )\n}\n",
