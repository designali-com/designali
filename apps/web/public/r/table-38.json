{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "table-38",
  "type": "registry:example",
  "description": "Subscriptions table with status badges and contextual pause, resume, or cancel actions.",
  "files": [
    {
      "path": "registry/designali/examples/table/table-38.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  Pause as PauseIcon,\n  Play as PlayIcon,\n} from \"@designali/icons\"\n\nimport { Badge } from \"@workspace/ui/components/badge\"\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from \"@workspace/ui/components/table\"\n\nconst initialSubs = [\n  {\n    id: \"s1\",\n    customer: \"Sara Khan\",\n    plan: \"Annual Pro\",\n    renews: \"Mar 3, 2027\",\n    status: \"Active\",\n  },\n  {\n    id: \"s2\",\n    customer: \"Omar Ali\",\n    plan: \"Monthly Basic\",\n    renews: \"Dec 1, 2026\",\n    status: \"Paused\",\n  },\n  {\n    id: \"s3\",\n    customer: \"Priya Shah\",\n    plan: \"Monthly Pro\",\n    renews: \"Nov 28, 2026\",\n    status: \"Active\",\n  },\n]\n\nexport default function SubscriptionsActionsTable() {\n  const [subs, setSubs] = React.useState(initialSubs)\n  const setStatus = (id: string, status: string) =>\n    setSubs((list) => list.map((s) => (s.id === id ? { ...s, status } : s)))\n\n  return (\n    <div className=\"w-full max-w-xl border\">\n      <Table>\n        <TableHeader>\n          <TableRow>\n            <TableHead>Customer</TableHead>\n            <TableHead>Plan</TableHead>\n            <TableHead>Status</TableHead>\n            <TableHead className=\"text-right\">Action</TableHead>\n          </TableRow>\n        </TableHeader>\n        <TableBody>\n          {subs.map((sub) => (\n            <TableRow key={sub.id}>\n              <TableCell>\n                <p className=\"font-medium\">{sub.customer}</p>\n                <p className=\"text-muted-foreground\">Renews {sub.renews}</p>\n              </TableCell>\n              <TableCell>{sub.plan}</TableCell>\n              <TableCell>\n                <Badge\n                  variant={\n                    sub.status === \"Active\"\n                      ? \"default\"\n                      : sub.status === \"Canceled\"\n                        ? \"destructive\"\n                        : \"secondary\"\n                  }\n                >\n                  {sub.status}\n                </Badge>\n              </TableCell>\n              <TableCell className=\"text-right\">\n                {sub.status === \"Canceled\" ? (\n                  <span className=\"text-muted-foreground\">—</span>\n                ) : (\n                  <div className=\"flex justify-end gap-1\">\n                    <Button\n                      variant=\"outline\"\n                      size=\"xs\"\n                      onClick={() =>\n                        setStatus(\n                          sub.id,\n                          sub.status === \"Active\" ? \"Paused\" : \"Active\"\n                        )\n                      }\n                    >\n                      {sub.status === \"Active\" ? (\n                        <PauseIcon data-icon=\"inline-start\" />\n                      ) : (\n                        <PlayIcon data-icon=\"inline-start\" />\n                      )}\n                      {sub.status === \"Active\" ? \"Pause\" : \"Resume\"}\n                    </Button>\n                    <Button\n                      variant=\"ghost\"\n                      size=\"xs\"\n                      className=\"text-destructive\"\n                      onClick={() => setStatus(sub.id, \"Canceled\")}\n                    >\n                      Cancel\n                    </Button>\n                  </div>\n                )}\n              </TableCell>\n            </TableRow>\n          ))}\n        </TableBody>\n      </Table>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}