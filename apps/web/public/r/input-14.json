{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "input-14",
  "type": "registry:example",
  "description": "A sign-in card with email and password inputs and a forgot password link.",
  "files": [
    {
      "path": "registry/designali/examples/input/input-14.tsx",
      "content": "import { Button } from \"@workspace/ui/components/button\"\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@workspace/ui/components/card\"\nimport { Field, FieldGroup, FieldLabel } from \"@workspace/ui/components/field\"\nimport { Input } from \"@workspace/ui/components/input\"\n\nexport default function SignInFormInputs() {\n  return (\n    <Card className=\"w-full max-w-sm\">\n      <CardHeader>\n        <CardTitle>Welcome back</CardTitle>\n        <CardDescription>Sign in to your Fieldnote workspace.</CardDescription>\n      </CardHeader>\n      <CardContent>\n        <FieldGroup>\n          <Field>\n            <FieldLabel htmlFor=\"signin-email\">Email</FieldLabel>\n            <Input\n              id=\"signin-email\"\n              type=\"email\"\n              autoComplete=\"email\"\n              placeholder=\"you@company.com\"\n            />\n          </Field>\n          <Field>\n            <div className=\"flex items-center justify-between\">\n              <FieldLabel htmlFor=\"signin-password\">Password</FieldLabel>\n              <a\n                href=\"#\"\n                className=\"text-xs text-muted-foreground hover:underline\"\n              >\n                Forgot password?\n              </a>\n            </div>\n            <Input\n              id=\"signin-password\"\n              type=\"password\"\n              autoComplete=\"current-password\"\n            />\n          </Field>\n          <Button className=\"w-full\">Sign in</Button>\n        </FieldGroup>\n      </CardContent>\n    </Card>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}