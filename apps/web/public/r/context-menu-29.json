{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "context-menu-29",
  "type": "registry:example",
  "description": "A terminal pane with copy, paste, clear, split, and kill process actions.",
  "files": [
    {
      "path": "registry/designali/examples/context-menu/context-menu-29.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  ClipboardPasteIcon,\n  Columns2Icon,\n  CopyIcon,\n  EraserIcon,\n  Rows2Icon,\n  SquareIcon,\n} from \"lucide-react\"\n\nimport {\n  ContextMenu,\n  ContextMenuContent,\n  ContextMenuGroup,\n  ContextMenuItem,\n  ContextMenuSeparator,\n  ContextMenuShortcut,\n  ContextMenuTrigger,\n} from \"@workspace/ui/components/context-menu\"\n\nconst initialLines = [\n  \"$ pnpm dev\",\n  \"▲ Next.js ready on http://localhost:3000\",\n  \"✓ Compiled /dashboard in 412ms\",\n  \"GET /api/health 200 in 8ms\",\n]\n\nexport default function TerminalPaneMenu() {\n  const [lines, setLines] = React.useState(initialLines)\n\n  return (\n    <ContextMenu>\n      <ContextMenuTrigger className=\"flex h-40 w-full max-w-md flex-col gap-0.5 overflow-hidden border bg-zinc-950 p-3 font-mono text-[11px] text-zinc-200\">\n        {lines.map((line, index) => (\n          <span\n            key={index}\n            className={line.startsWith(\"$\") ? \"text-emerald-400\" : undefined}\n          >\n            {line}\n          </span>\n        ))}\n        <span className=\"animate-pulse\">▍</span>\n      </ContextMenuTrigger>\n      <ContextMenuContent className=\"w-52\">\n        <ContextMenuGroup>\n          <ContextMenuItem>\n            <CopyIcon />\n            Copy\n            <ContextMenuShortcut>⌘C</ContextMenuShortcut>\n          </ContextMenuItem>\n          <ContextMenuItem>\n            <ClipboardPasteIcon />\n            Paste\n            <ContextMenuShortcut>⌘V</ContextMenuShortcut>\n          </ContextMenuItem>\n          <ContextMenuItem onClick={() => setLines([])}>\n            <EraserIcon />\n            Clear\n            <ContextMenuShortcut>⌘K</ContextMenuShortcut>\n          </ContextMenuItem>\n        </ContextMenuGroup>\n        <ContextMenuSeparator />\n        <ContextMenuGroup>\n          <ContextMenuItem>\n            <Columns2Icon />\n            Split right\n            <ContextMenuShortcut>⌘D</ContextMenuShortcut>\n          </ContextMenuItem>\n          <ContextMenuItem>\n            <Rows2Icon />\n            Split down\n            <ContextMenuShortcut>⇧⌘D</ContextMenuShortcut>\n          </ContextMenuItem>\n        </ContextMenuGroup>\n        <ContextMenuSeparator />\n        <ContextMenuGroup>\n          <ContextMenuItem\n            variant=\"destructive\"\n            onClick={() => setLines([\"Process exited with code 130\"])}\n          >\n            <SquareIcon />\n            Kill process\n          </ContextMenuItem>\n        </ContextMenuGroup>\n      </ContextMenuContent>\n    </ContextMenu>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}