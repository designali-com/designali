  "files": [
    {
      "path": "registry/designali/pages/consulting/landing-consulting-07/page.tsx",
      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  ChartNoAxesCombined,\n  Check,\n  Cog,\n  GraduationCap,\n  Leaf,\n  Plus,\n  Target,\n  Users,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Services\", \"Industries\", \"Case studies\", \"Insights\", \"About\"]\n\nconst logos = [\n  \"Ironclad\",\n  \"Summit Bank\",\n  \"Corvex\",\n  \"Stratus Group\",\n  \"Pinnacle Health\",\n  \"Atlas Retail\",\n  \"Ferro Industries\",\n  \"Bluewave\",\n]\n\nconst features = [\n  {\n    icon: Leaf,\n    title: \"Sustainability\",\n    description:\n      \"Decarbonisation roadmaps and ESG reporting that hold up to investor and regulator scrutiny.\",\n  },\n  {\n    icon: GraduationCap,\n    title: \"Capability building\",\n    description:\n      \"We train your people as we go, so the change sticks long after we leave.\",\n  },\n  {\n    icon: Target,\n    title: \"Growth strategy\",\n    description:\n      \"Market sizing, positioning and portfolio choices grounded in customer evidence, not assumptions.\",\n  },\n  {\n    icon: Cog,\n    title: \"Operational excellence\",\n    description:\n      \"Redesign processes, cut cost-to-serve and build the operating rhythm to sustain the gains.\",\n  },\n  {\n    icon: ChartNoAxesCombined,\n    title: \"Data and analytics\",\n    description:\n      \"Turn scattered data into decision-ready dashboards and models your teams actually use.\",\n  },\n  {\n    icon: Users,\n    title: \"Organisation design\",\n    description:\n      \"Clarify roles, spans and decision rights so teams move faster with fewer handoffs.\",\n  },\n]\n\nconst stats = [\n  { value: \"$2.4B\", label: \"Value delivered for clients\" },\n  { value: \"320+\", label: \"Engagements completed\" },\n  { value: \"18%\", label: \"Average margin uplift\" },\n  { value: \"91%\", label: \"Clients who return\" },\n]\n\nconst steps = [\n  {\n    title: \"Diagnose\",\n    description:\n      \"A focused six-week diagnostic to quantify the opportunity and agree priorities with leadership.\",\n  },\n  {\n    title: \"Design\",\n    description:\n      \"Co-create the strategy, operating model and business case with your team, not for them.\",\n  },\n  {\n    title: \"Deliver\",\n    description:\n      \"Mobilise pilots, track value weekly and scale what works across the organisation.\",\n  },\n  {\n    title: \"Sustain\",\n    description:\n      \"Hand over tools, governance and trained owners so results keep compounding.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Retail pricing reset\",\n    meta: \"National retailer · 1,200 stores\",\n    tag: \"Strategy\",\n    price: \"+11 pts margin\",\n  },\n  {\n    name: \"Plant network redesign\",\n    meta: \"Industrial manufacturer · 9 plants\",\n    tag: \"Operations\",\n    price: \"-22% cost\",\n  },\n  {\n    name: \"Patient flow programme\",\n    meta: \"Regional health system\",\n    tag: \"Healthcare\",\n    price: \"-34% wait time\",\n  },\n  {\n    name: \"Post-merger integration\",\n    meta: \"Two regional banks\",\n    tag: \"M&A\",\n    price: \"$180M synergies\",\n  },\n  {\n    name: \"Data platform roadmap\",\n    meta: \"Insurance group\",\n    tag: \"Digital\",\n    price: \"4x faster reporting\",\n  },\n  {\n    name: \"Net zero roadmap\",\n    meta: \"Logistics operator\",\n    tag: \"Sustainability\",\n    price: \"-40% emissions\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"They challenged our assumptions in the first week and were right. The new pricing model added 11 points of margin in a year.\",\n    name: \"Catherine Doyle\",\n    role: \"CFO, Atlas Retail\",\n  },\n  {\n    quote:\n      \"Unlike other firms, their team stayed through implementation. Our plants are running 22% more efficiently.\",\n    name: \"Hiroshi Nakamura\",\n    role: \"COO, Ferro Industries\",\n  },\n  {\n    quote:\n      \"Clear thinking, no fluff and a team our people genuinely liked working with.\",\n    name: \"Rachel Adeyemi\",\n    role: \"CEO, Pinnacle Health\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Diagnostic\",\n    price: \"$85K\",\n    period: \"/6 weeks\",\n    description: \"Size the prize and set priorities.\",\n    features: [\n      \"Leadership interviews\",\n      \"Data deep-dive\",\n      \"Opportunity sizing\",\n      \"Prioritised roadmap\",\n    ],\n    cta: \"Scope a diagnostic\",\n  },\n  {\n    name: \"Transformation\",\n    price: \"From $450K\",\n    period: \"/quarter\",\n    description: \"Design and deliver change at scale.\",\n    features: [\n      \"Dedicated senior team\",\n      \"Weekly value tracking\",\n      \"Pilot to scale delivery\",\n      \"Change management\",\n      \"Executive steering\",\n    ],\n    cta: \"Discuss a programme\",\n  },\n  {\n    name: \"Advisory retainer\",\n    price: \"Custom\",\n    period: \"\",\n    description: \"On-call counsel for the C-suite.\",\n    features: [\n      \"Partner access\",\n      \"Board preparation\",\n      \"Deal and market reviews\",\n      \"Quarterly strategy sessions\",\n      \"Flexible scope\",\n    ],\n    cta: \"Talk to a partner\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"What size of companies do you work with?\",\n    a: \"Mostly mid-market and enterprise organisations with 200 to 20,000 employees, plus private equity funds and their portfolio companies.\",\n  },\n  {\n    q: \"How are engagements priced?\",\n    a: \"We price by scope and outcome. Many engagements include a fee at risk tied to the results we agree at the start.\",\n  },\n  {\n    q: \"Who will be on our team?\",\n    a: \"A partner leads every engagement personally, supported by a small senior team. We do not staff projects with junior analysts alone.\",\n  },\n  {\n    q: \"How quickly can you start?\",\n    a: \"We can usually mobilise a diagnostic team within two to three weeks of agreeing the scope.\",\n  },\n  {\n    q: \"Do you help with implementation?\",\n    a: \"Yes. Most of our work is implementation. We stay until the results are visible in your numbers.\",\n  },\n]\n\nconst footer = [\n  { title: \"Services\", links: [\"Strategy\", \"Operations\", \"Digital\", \"M&A\"] },\n  { title: \"Firm\", links: [\"About\", \"Our people\", \"Careers\", \"Alumni\"] },\n  { title: \"Insights\", links: [\"Articles\", \"Reports\", \"Events\", \"Newsletter\"] },\n]\n\nexport default function LandingConsulting07() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-rose-600 text-white text-sm\">\n              G\n            </span>\n            <span className=\"\">Greenline Advisory</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Client login\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Get a carbon baseline\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"relative isolate overflow-hidden border-b\">\n        <div className=\"pointer-events-none absolute inset-0 -z-10 bg-radial-[ellipse_60%_50%_at_50%_0%] from-rose-500/25 via-pink-500/10 to-transparent to-70%\" />\n        <div className=\"pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,var(--border)_1px,transparent_1px),linear-gradient(to_bottom,var(--border)_1px,transparent_1px)] bg-[size:48px_48px] [mask-image:radial-gradient(ellipse_50%_45%_at_50%_0%,#000_60%,transparent_100%)]\" />\n        <div className=\"mx-auto max-w-7xl px-6 pt-20 pb-16 md:pt-32\">\n          <div className=\"mx-auto max-w-4xl space-y-8 text-center\">\n            <a\n              href=\"#\"\n              className=\"inline-flex items-center gap-2 rounded-full border bg-background/70 py-1 pr-3 pl-1 text-xs backdrop-blur\"\n            >\n              <span className=\"rounded-full bg-rose-600 px-2 py-0.5 font-medium text-white\">\n                New\n              </span>\n              <span className=\"text-muted-foreground\">\n                New CSRD readiness assessment for mid-size firms\n              </span>\n            </a>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-8xl \">\n              {\"Net zero plans that \"}\n              <span className=\"text-rose-600 dark:text-rose-400\">\n                survive the boardroom\n              </span>\n            </h1>\n            <p className=\"mx-auto max-w-2xl text-lg leading-8 text-muted-foreground\">\n              Greenline Advisory measures emissions, sets credible targets and\n              builds reporting that meets CSRD and investor expectations.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Get a carbon baseline\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Read our approach\n              </Button>\n            </div>\n          </div>\n          <div className=\"relative mx-auto mt-20 max-w-5xl\">\n            <div className=\"absolute inset-x-10 -top-6 -z-10 h-24 rounded-full bg-rose-500/10 blur-2xl\" />\n            <HeroVisual />\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-12\">\n          <p className=\"text-center text-sm text-muted-foreground\">\n            Trusted by leadership teams at\n          </p>\n          <div className=\"mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-6 sm:grid-cols-4 lg:grid-cols-8\">\n            {logos.map((logo) => (\n              <div\n                key={logo}\n                className=\"text-center text-base font-semibold tracking-tight text-muted-foreground/70 \"\n              >\n                {logo}\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <p className=\"text-sm font-medium text-rose-600 dark:text-rose-400\">\n              Capabilities\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              Strategy that turns into results\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              We work alongside your leadership team from diagnosis to delivery,\n              and we measure success by outcomes, not slide count.\n            </p>\n          </div>\n          <div className=\"mt-14 grid overflow-hidden rounded-2xl border sm:grid-cols-2 lg:grid-cols-3\">\n            {features.map((feature) => (\n              <div\n                key={feature.title}\n                className=\"-mt-px -ml-px border-t border-l p-8\"\n              >\n                <feature.icon className=\"size-6 text-rose-600 dark:text-rose-400\" />\n                <h3 className=\"mt-5 font-semibold\">{feature.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl grid-cols-2 px-6 lg:grid-cols-4\">\n          {stats.slice(0, 4).map((stat, i) => (\n            <div\n              key={stat.label}\n              className={`py-12 ${i > 0 ? \"lg:border-l lg:pl-8\" : \"\"} ${i % 2 === 1 ? \"border-l pl-6 lg:pl-8\" : \"\"} `}\n            >\n              <div className=\"text-4xl font-semibold tracking-tight md:text-5xl \">\n                {stat.value}\n              </div>\n              <div className=\"mt-2 text-sm text-muted-foreground\">\n                {stat.label}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Selected case studies\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                A few of the engagements where our clients moved the numbers\n                that matter.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a\n                key={item.name}\n                href=\"#\"\n                className=\"group flex flex-col rounded-xl border p-6 transition-colors hover:bg-muted/40\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"flex size-10 items-center justify-center rounded-lg border bg-muted/50 font-semibold \">\n                    {item.name.charAt(0)}\n                  </span>\n                  <span className=\"rounded-full bg-rose-500/10 px-2.5 py-0.5 text-xs font-medium text-rose-600 dark:text-rose-400\">\n                    {item.tag}\n                  </span>\n                </div>\n                <h3 className=\"mt-6 font-semibold \">{item.name}</h3>\n                <p className=\"mt-1 flex-1 text-sm text-muted-foreground\">\n                  {item.meta}\n                </p>\n                <div className=\"mt-6 flex items-center justify-between border-t pt-4 text-sm\">\n                  <span className=\"font-medium\">{item.price}</span>\n                  <ArrowUpRight className=\"size-4 text-muted-foreground transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5\" />\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Our engagement model\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-rose-600 dark:text-rose-400\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              What leaders say about working with us\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-6 md:grid-cols-3\">\n            {testimonials.map((t) => (\n              <figure\n                key={t.name}\n                className=\"flex flex-col rounded-2xl border p-6\"\n              >\n                <blockquote className=\"flex-1 leading-7\">\n                  &ldquo;{t.quote}&rdquo;\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 border-t pt-6 text-sm\">\n                  <span className=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Ways to engage\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              From a focused diagnostic to a long-term transformation\n              partnership, every engagement has clear scope and outcomes.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-rose-500 shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-rose-600 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-rose-600 dark:text-rose-400\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Working with us\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Get in touch\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"px-6 py-20 md:py-28\">\n        <div className=\"relative mx-auto max-w-6xl overflow-hidden rounded-3xl border bg-rose-500/10 px-6 py-16 text-center md:py-24\">\n          <div className=\"pointer-events-none absolute -top-24 left-1/2 size-96 -translate-x-1/2 rounded-full bg-gradient-to-b from-rose-500/25 via-pink-500/10 to-transparent blur-3xl\" />\n          <div className=\"relative mx-auto max-w-2xl space-y-6\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Turn climate targets into a real plan\n            </h2>\n            <p className=\"text-lg text-muted-foreground\">\n              Get a scoped carbon baseline proposal within one week.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Get a carbon baseline\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Read our approach\n              </Button>\n            </div>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-rose-600 text-white text-sm\">\n                G\n              </span>\n              <span className=\"\">Greenline Advisory</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              Sustainability, made credible.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Greenline Advisory. All rights\n              reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  const bars = [38, 52, 44, 63, 58, 71, 66, 80, 74, 88, 83, 95]\n  return (\n    <div className=\"overflow-hidden rounded-xl border bg-card text-left text-card-foreground shadow-2xl/10\">\n      <div className=\"flex items-center gap-2 border-b px-4 py-3\">\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"ml-3 hidden rounded-md bg-muted px-3 py-0.5 text-[11px] text-muted-foreground sm:inline\">\n          app.greenlineadvisory.com\n        </span>\n      </div>\n      <div className=\"grid md:grid-cols-[180px_1fr]\">\n        <aside className=\"hidden space-y-1 border-r p-3 text-sm md:block\">\n          {navLinks.map((link, i) => (\n            <div\n              key={link}\n              className={`rounded-md px-3 py-1.5 ${i === 0 ? \"bg-muted font-medium\" : \"text-muted-foreground\"}`}\n            >\n              {link}\n            </div>\n          ))}\n        </aside>\n        <div className=\"space-y-4 p-4 md:p-6\">\n          <div className=\"grid grid-cols-2 gap-3 lg:grid-cols-4\">\n            {stats.slice(0, 4).map((stat) => (\n              <div key={stat.label} className=\"rounded-lg border p-3\">\n                <div className=\"truncate text-[11px] text-muted-foreground\">\n                  {stat.label}\n                </div>\n                <div className=\"mt-1 text-lg font-semibold tracking-tight\">\n                  {stat.value}\n                </div>\n              </div>\n            ))}\n          </div>\n          <div className=\"rounded-lg border p-4\">\n            <div className=\"mb-4 flex items-center justify-between text-xs\">\n              <span className=\"font-medium\">Last 12 weeks</span>\n              <span className=\"text-rose-600 dark:text-rose-400\">+24.6%</span>\n            </div>\n            <div className=\"flex h-32 items-end gap-1.5\">\n              {bars.map((h, i) => (\n                <div\n                  key={i}\n                  className={`flex-1 rounded-t-sm ${i === bars.length - 1 ? \"bg-rose-600\" : \"bg-muted-foreground/20\"}`}\n                  style={{ height: `${h}%` }}\n                />\n              ))}\n            </div>\n          </div>\n          <div className=\"hidden divide-y rounded-lg border sm:block\">\n            {showcase.slice(0, 3).map((item) => (\n              <div\n                key={item.name}\n                className=\"flex items-center justify-between gap-4 px-4 py-2.5 text-sm\"\n              >\n                <div className=\"min-w-0\">\n                  <div className=\"truncate font-medium\">{item.name}</div>\n                  <div className=\"truncate text-xs text-muted-foreground\">\n                    {item.meta}\n                  </div>\n                </div>\n                <span className=\"shrink-0 rounded-full bg-rose-500/10 px-2 py-0.5 text-[11px] font-medium text-rose-600 dark:text-rose-400\">\n                  {item.tag}\n                </span>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n    </div>\n  )\n}\n",
