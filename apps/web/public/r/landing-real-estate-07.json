      "path": "registry/designali/pages/real-estate/landing-real-estate-07/page.tsx",
      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  Bell,\n  Calendar,\n  Camera,\n  ChartLine,\n  Check,\n  MapPin,\n  Plus,\n  ShieldCheck,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Studio\", \"Work\", \"Process\", \"Pricing\", \"Insights\"]\n\nconst logos = [\n  \"Blender\",\n  \"shadcn-style UI\",\n  \"Next.js\",\n  \"React\",\n  \"Figma\",\n  \"Vercel\",\n  \"TypeScript\",\n  \"Tailwind CSS\",\n]\n\nconst features = [\n  {\n    icon: Calendar,\n    title: \"Flexible collaboration\",\n    description:\n      \"Reviews by video at times that suit your team, with shared Figma files throughout.\",\n  },\n  {\n    icon: ShieldCheck,\n    title: \"Production-ready code\",\n    description:\n      \"Every site is built in Next.js and TypeScript, so what you approve in Figma is what goes live.\",\n  },\n  {\n    icon: MapPin,\n    title: \"Brand identity for property\",\n    description:\n      \"Logos, colour and type systems for agencies and developers that look as premium as the homes they sell.\",\n  },\n  {\n    icon: ChartLine,\n    title: \"Listing websites\",\n    description:\n      \"Fast Next.js property sites with search, filters and listing pages your team can update without a developer.\",\n  },\n  {\n    icon: Camera,\n    title: \"CGI & 3D renders\",\n    description:\n      \"Architectural renders, interiors and walkthrough motion so buyers can see a home before it is built.\",\n  },\n  {\n    icon: Bell,\n    title: \"Lead capture flows\",\n    description:\n      \"Viewing requests, enquiry forms and valuation flows designed to be short and easy to complete on a phone.\",\n  },\n]\n\nconst stats = [\n  { value: \"240+\", label: \"Property pages designed\" },\n  { value: \"4 weeks\", label: \"Average time to launch\" },\n  { value: \"100%\", label: \"Projects delivered on scope\" },\n  { value: \"2300+\", label: \"Screens designed\" },\n]\n\nconst steps = [\n  {\n    title: \"Book a discovery call\",\n    description:\n      \"Meet Ali Imam to talk about your brand, your listings and what the project needs.\",\n  },\n  {\n    title: \"Shortlist the direction\",\n    description:\n      \"Review moodboards and concepts in Figma, with honest notes on what will work best.\",\n  },\n  {\n    title: \"Design and build\",\n    description:\n      \"Brand, CGI and website are designed together, then built in Next.js and tested.\",\n  },\n  {\n    title: \"Launch and hand over\",\n    description:\n      \"We launch the site, hand over Figma files and documentation, and stay on for updates.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Hillside Residence Launch\",\n    meta: \"Brand · Website · CGI renders\",\n    tag: \"New project\",\n    price: \"6 wks\",\n    tile: \"bg-gradient-to-br from-primary/10 via-primary/20 to-chart-1 dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Riverside Loft Site\",\n    meta: \"Listing site · 12 pages\",\n    tag: \"Website\",\n    price: \"4 wks\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Townhouse Brochure\",\n    meta: \"Print · Digital brochure\",\n    tag: \"Brochure\",\n    price: \"5 wks\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Penthouse CGI Walkthrough\",\n    meta: \"3D · Motion · 90 seconds\",\n    tag: \"CGI\",\n    price: \"8 wks\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Coastal Resort Brand\",\n    meta: \"Identity · Booking site\",\n    tag: \"Brand\",\n    price: \"3 wks\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-chart-1 dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Agency Design System\",\n    meta: \"Components · Docs\",\n    tag: \"System\",\n    price: \"From $2,100/mo\",\n    tile: \"bg-gradient-to-br from-muted via-border to-muted-foreground dark:from-muted dark:via-card dark:to-card\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"We had four enquiries in the first weekend after launch. The renders and the new site made the development feel real.\",\n    name: \"Emily\",\n    role: \"Sales director, property developer\",\n  },\n  {\n    quote:\n      \"Ali explained every step and delivered a brand that finally matched the quality of our homes.\",\n    name: \"Priya\",\n    role: \"Founder, boutique agency\",\n  },\n  {\n    quote:\n      \"The 3D walkthrough let overseas buyers explore the apartment before it existed. It made the launch feel easy.\",\n    name: \"Oliver\",\n    role: \"Marketing lead, Designali client\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Website\",\n    price: \"$2,900\",\n    period: \"per project\",\n    description: \"For agencies that need a modern listing site.\",\n    features: [\n      \"Next.js listing site\",\n      \"Search and filter pages\",\n      \"Enquiry and viewing flows\",\n      \"Launch support\",\n    ],\n    cta: \"Start a website\",\n  },\n  {\n    name: \"Launch\",\n    price: \"$6,500\",\n    period: \"per project\",\n    description: \"Our most popular package for new developments.\",\n    features: [\n      \"Everything in Website\",\n      \"Brand identity\",\n      \"CGI renders and floor plans\",\n      \"Digital brochure\",\n      \"Weekly progress calls\",\n    ],\n    cta: \"Book a launch\",\n  },\n  {\n    name: \"Signature\",\n    price: \"Custom\",\n    period: \"\",\n    description: \"For luxury and architect-designed projects.\",\n    features: [\n      \"Full brand campaign\",\n      \"CGI walkthrough film\",\n      \"Print and digital sales kit\",\n      \"Design system and docs\",\n      \"Ali Imam as lead designer\",\n    ],\n    cta: \"Talk to the studio\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"How much does a property website cost?\",\n    a: \"Book a free discovery call and Ali Imam will review your listings and goals, then send a written scope and fixed price within 48 hours.\",\n  },\n  {\n    q: \"How long does a project take?\",\n    a: \"Most websites launch in about four weeks, though timing depends on scope, content and CGI work.\",\n  },\n  {\n    q: \"Do I have to sign a long contract?\",\n    a: \"No. Projects are scoped up front, and monthly support can be paused or cancelled at any time.\",\n  },\n  {\n    q: \"Can you create renders before construction?\",\n    a: \"Yes. We create CGI renders and walkthroughs from plans, sketches or CAD files, so you can market homes early.\",\n  },\n  {\n    q: \"Do you support the site after launch?\",\n    a: \"Yes. Monthly design support covers new listings templates, campaign pages and small updates.\",\n  },\n]\n\nconst footer = [\n  { title: \"Studio\", links: [\"Studio\", \"Work\", \"Process\", \"Brand identity\"] },\n  {\n    title: \"Studio\",\n    links: [\"Websites\", \"CGI renders\", \"Design systems\", \"Brochures\"],\n  },\n  {\n    title: \"Designali\",\n    links: [\"About Ali\", \"Insights\", \"Templates\", \"Contact\"],\n  },\n]\n\nexport default function LandingRealEstate07() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-chart-2 text-white text-sm\">\n              C\n            </span>\n            <span className=\"\">designali</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Our work\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Browse work\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"relative isolate overflow-hidden border-b\">\n        <div className=\"pointer-events-none absolute inset-0 -z-10 bg-radial-[ellipse_60%_50%_at_50%_0%] from-primary/25 via-primary/10 to-transparent to-70%\" />\n        <div className=\"pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,var(--border)_1px,transparent_1px),linear-gradient(to_bottom,var(--border)_1px,transparent_1px)] bg-[size:48px_48px] [mask-image:radial-gradient(ellipse_50%_45%_at_50%_0%,#000_60%,transparent_100%)]\" />\n        <div className=\"mx-auto max-w-7xl px-6 pt-20 pb-16 md:pt-32\">\n          <div className=\"mx-auto max-w-4xl space-y-8 text-center\">\n            <a\n              href=\"#\"\n              className=\"inline-flex items-center gap-2 rounded-full border bg-background/70 py-1 pr-3 pl-1 text-xs backdrop-blur\"\n            >\n              <span className=\"rounded-full bg-chart-2 px-2 py-0.5 font-medium text-white\">\n                New\n              </span>\n              <span className=\"text-muted-foreground\">\n                New: rural property website template\n              </span>\n            </a>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-8xl \">\n              <span className=\"text-primary dark:text-primary\">\n                Space to grow\n              </span>\n              {\" with a strong brand\"}\n            </h1>\n            <p className=\"mx-auto max-w-2xl text-lg leading-8 text-muted-foreground\">\n              Designali designs brands and listing sites for land, farms and rural\n              property, with clear maps, galleries and enquiry forms.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Browse work\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Talk to the studio\n              </Button>\n            </div>\n          </div>\n          <div className=\"relative mx-auto mt-20 max-w-5xl\">\n            <div className=\"absolute inset-x-10 -top-6 -z-10 h-24 rounded-full bg-primary/10 blur-2xl\" />\n            <HeroVisual />\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-12\">\n          <p className=\"text-center text-sm text-muted-foreground\">\n            Built with\n          </p>\n          <div className=\"mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-6 sm:grid-cols-4 lg:grid-cols-8\">\n            {logos.map((logo) => (\n              <div\n                key={logo}\n                className=\"text-center text-base font-semibold tracking-tight text-muted-foreground/70 \"\n              >\n                {logo}\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <p className=\"text-sm font-medium text-primary dark:text-primary\">\n              Why choose Designali\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              A smarter way to market property\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Brand, CGI and code from one studio, with a process that keeps you\n              informed from the first concept to launch day.\n            </p>\n          </div>\n          <div className=\"mt-14 grid overflow-hidden rounded-2xl border sm:grid-cols-2 lg:grid-cols-3\">\n            {features.map((feature) => (\n              <div\n                key={feature.title}\n                className=\"-mt-px -ml-px border-t border-l p-8\"\n              >\n                <feature.icon className=\"size-6 text-primary dark:text-primary\" />\n                <h3 className=\"mt-5 font-semibold\">{feature.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl grid-cols-2 px-6 lg:grid-cols-4\">\n          {stats.slice(0, 4).map((stat, i) => (\n            <div\n              key={stat.label}\n              className={`py-12 ${i > 0 ? \"lg:border-l lg:pl-8\" : \"\"} ${i % 2 === 1 ? \"border-l pl-6 lg:pl-8\" : \"\"} `}\n            >\n              <div className=\"text-4xl font-semibold tracking-tight md:text-5xl \">\n                {stat.value}\n              </div>\n              <div className=\"mt-2 text-sm text-muted-foreground\">\n                {stat.label}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Featured projects\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                Hand-picked property projects, from launch sites to 3D walkthroughs.\n                Explore case studies in detail on the work page.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a key={item.name} href=\"#\" className=\"group\">\n                <div\n                  className={`relative aspect-[4/3] overflow-hidden rounded-2xl ${item.tile}`}\n                >\n                  <div className=\"absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10\" />\n                  <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-foreground backdrop-blur\">\n                    {item.tag}\n                  </span>\n                </div>\n                <div className=\"mt-4 flex items-start justify-between gap-4\">\n                  <div className=\"min-w-0\">\n                    <h3 className=\"font-medium \">{item.name}</h3>\n                    <p className=\"mt-1 text-sm text-muted-foreground\">\n                      {item.meta}\n                    </p>\n                  </div>\n                  <span className=\"shrink-0 text-sm font-semibold\">\n                    {item.price}\n                  </span>\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              From first concept to launch day\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-primary dark:text-primary\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Clients who trusted Designali\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-6 md:grid-cols-3\">\n            {testimonials.map((t) => (\n              <figure\n                key={t.name}\n                className=\"flex flex-col rounded-2xl border p-6\"\n              >\n                <blockquote className=\"flex-1 leading-7\">\n                  &ldquo;{t.quote}&rdquo;\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 border-t pt-6 text-sm\">\n                  <span className=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Fair pricing, clearly explained\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Choose the package that suits your project. No hidden\n              charges and no long tie-in contracts.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-primary shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-chart-2 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-primary dark:text-primary\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Common questions\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Contact us\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"px-6 py-20 md:py-28\">\n        <div className=\"relative mx-auto max-w-6xl overflow-hidden rounded-3xl border bg-primary/10 px-6 py-16 text-center md:py-24\">\n          <div className=\"pointer-events-none absolute -top-24 left-1/2 size-96 -translate-x-1/2 rounded-full bg-gradient-to-b from-primary/25 via-primary/10 to-transparent blur-3xl\" />\n          <div className=\"relative mx-auto max-w-2xl space-y-6\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Selling rural property online?\n            </h2>\n            <p className=\"text-lg text-muted-foreground\">\n              We design sites that present land clearly to qualified buyers.\n              Request a free project scope.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Browse work\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Talk to the studio\n              </Button>\n            </div>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-chart-2 text-white text-sm\">\n                C\n              </span>\n              <span className=\"\">designali</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              Room to grow, by design.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} designali. All rights\n              reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  return (\n    <div className=\"grid grid-cols-2 gap-3 md:grid-cols-3\">\n      {showcase.slice(0, 3).map((item, i) => (\n        <div\n          key={item.name}\n          className={`relative overflow-hidden rounded-2xl ${item.tile} ${i === 0 ? \"col-span-2 aspect-[16/10] md:col-span-1 md:aspect-[3/4]\" : \"aspect-[3/4]\"}`}\n        >\n          <div className=\"absolute inset-0 bg-gradient-to-t from-black/50 via-black/0 to-black/0\" />\n          <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-foreground backdrop-blur\">\n            {item.tag}\n          </span>\n          <div className=\"absolute inset-x-3 bottom-3 flex items-end justify-between gap-2 text-white\">\n            <div className=\"min-w-0\">\n              <div className=\"truncate text-sm font-medium\">{item.name}</div>\n              <div className=\"truncate text-xs text-white/75\">{item.meta}</div>\n            </div>\n            <div className=\"shrink-0 text-sm font-semibold\">{item.price}</div>\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n",
