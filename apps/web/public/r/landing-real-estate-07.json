      "path": "registry/designali/pages/real-estate/landing-real-estate-07/page.tsx",
      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  Bell,\n  Calendar,\n  Camera,\n  ChartLine,\n  Check,\n  MapPin,\n  Plus,\n  ShieldCheck,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Buy\", \"Rent\", \"Sell\", \"Agents\", \"Insights\"]\n\nconst logos = [\n  \"Wells Fargo\",\n  \"Matterport\",\n  \"Zillow\",\n  \"Realtor.com\",\n  \"Compass\",\n  \"Redfin\",\n  \"Rocket Mortgage\",\n  \"Chase\",\n]\n\nconst features = [\n  {\n    icon: Calendar,\n    title: \"Flexible viewings\",\n    description:\n      \"Book viewings in the evenings and at weekends, in person or by live video.\",\n  },\n  {\n    icon: ShieldCheck,\n    title: \"Verified listings\",\n    description:\n      \"Every property is checked by an agent, so what you see is exactly what you get.\",\n  },\n  {\n    icon: MapPin,\n    title: \"Local market experts\",\n    description:\n      \"Agents who live in the neighbourhoods they sell, with an average of 12 years experience.\",\n  },\n  {\n    icon: ChartLine,\n    title: \"Accurate valuations\",\n    description:\n      \"Pricing backed by recent sales data, so your home sells fast without leaving money on the table.\",\n  },\n  {\n    icon: Camera,\n    title: \"Professional media\",\n    description:\n      \"Photography, floor plans and 3D tours included with every listing at no extra cost.\",\n  },\n  {\n    icon: Bell,\n    title: \"Instant alerts\",\n    description:\n      \"Get notified the moment a home matching your criteria comes on the market.\",\n  },\n]\n\nconst stats = [\n  { value: \"$2.8B\", label: \"Property sold last year\" },\n  { value: \"21 days\", label: \"Average time to sale\" },\n  { value: \"102%\", label: \"Of asking price achieved\" },\n  { value: \"4,600\", label: \"Homes sold\" },\n]\n\nconst steps = [\n  {\n    title: \"Book a consultation\",\n    description:\n      \"Meet a local agent to talk budget, timeline and the neighbourhoods you love.\",\n  },\n  {\n    title: \"Tour your shortlist\",\n    description:\n      \"View homes in person or by video, with honest notes on every property.\",\n  },\n  {\n    title: \"Make a strong offer\",\n    description:\n      \"We use recent sales data to help you offer confidently and negotiate the best terms.\",\n  },\n  {\n    title: \"Close and move in\",\n    description:\n      \"We coordinate inspections, lenders and lawyers right up to handing over the keys.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Hillside Modern Residence\",\n    meta: \"4 bed · 3 bath · 280 m²\",\n    tag: \"New listing\",\n    price: \"$1,450,000\",\n    tile: \"bg-gradient-to-br from-yellow-100 via-amber-200 to-orange-300 dark:from-yellow-700 dark:via-amber-800 dark:to-orange-900\",\n  },\n  {\n    name: \"Riverside Loft\",\n    meta: \"2 bed · 2 bath · 118 m²\",\n    tag: \"Open house\",\n    price: \"$725,000\",\n    tile: \"bg-gradient-to-br from-amber-200 via-orange-300 to-rose-400 dark:from-amber-700 dark:via-orange-800 dark:to-rose-900\",\n  },\n  {\n    name: \"Garden Townhouse\",\n    meta: \"3 bed · 2.5 bath · 190 m²\",\n    tag: \"Price reduced\",\n    price: \"$899,000\",\n    tile: \"bg-gradient-to-br from-sky-200 via-cyan-300 to-teal-400 dark:from-sky-700 dark:via-cyan-800 dark:to-teal-900\",\n  },\n  {\n    name: \"Penthouse at The Arbor\",\n    meta: \"3 bed · 3 bath · 210 m²\",\n    tag: \"Exclusive\",\n    price: \"$2,300,000\",\n    tile: \"bg-gradient-to-br from-violet-200 via-purple-300 to-fuchsia-400 dark:from-violet-700 dark:via-purple-800 dark:to-fuchsia-900\",\n  },\n  {\n    name: \"Coastal Cottage\",\n    meta: \"2 bed · 1 bath · 92 m²\",\n    tag: \"Sea view\",\n    price: \"$640,000\",\n    tile: \"bg-gradient-to-br from-emerald-200 via-green-300 to-lime-300 dark:from-emerald-700 dark:via-green-800 dark:to-lime-900\",\n  },\n  {\n    name: \"Downtown Studio\",\n    meta: \"1 bed · 1 bath · 48 m²\",\n    tag: \"For rent\",\n    price: \"$2,100/mo\",\n    tile: \"bg-gradient-to-br from-stone-200 via-neutral-300 to-zinc-400 dark:from-stone-700 dark:via-neutral-800 dark:to-zinc-900\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"We had four offers in the first weekend and sold above asking. The valuation was spot on and the photos were stunning.\",\n    name: \"Emily and Josh Turner\",\n    role: \"Sold in Brooklyn\",\n  },\n  {\n    quote:\n      \"As first-time buyers we were terrified. Our agent explained every step and got us the house we had almost given up on.\",\n    name: \"Priya Shah\",\n    role: \"First-time buyer\",\n  },\n  {\n    quote:\n      \"I relocated from London without ever visiting in person. The video viewings and 3D tours made it feel easy.\",\n    name: \"Oliver Grant\",\n    role: \"Bought remotely\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Essentials\",\n    price: \"1.5%\",\n    period: \"of sale price\",\n    description: \"For confident sellers who want expert marketing.\",\n    features: [\n      \"Professional photography\",\n      \"Listing on all major portals\",\n      \"Online offer management\",\n      \"Sale progression support\",\n    ],\n    cta: \"Get a valuation\",\n  },\n  {\n    name: \"Full service\",\n    price: \"2.5%\",\n    period: \"of sale price\",\n    description: \"Our most popular, fully managed sale.\",\n    features: [\n      \"Everything in Essentials\",\n      \"Accompanied viewings\",\n      \"3D tour and floor plan\",\n      \"Dedicated negotiator\",\n      \"Weekly progress reports\",\n    ],\n    cta: \"Book an agent\",\n  },\n  {\n    name: \"Premier\",\n    price: \"Custom\",\n    period: \"\",\n    description: \"For luxury and architect-designed homes.\",\n    features: [\n      \"Bespoke marketing campaign\",\n      \"Print and film production\",\n      \"Private buyer network\",\n      \"International exposure\",\n      \"Senior partner as lead agent\",\n    ],\n    cta: \"Speak to a partner\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"How much is my home worth?\",\n    a: \"Book a free valuation and a local agent will visit, review recent comparable sales and give you a written estimate within 48 hours.\",\n  },\n  {\n    q: \"How long does it take to sell?\",\n    a: \"Our homes sell in an average of 21 days, though timing depends on price, location and the season.\",\n  },\n  {\n    q: \"Do I have to sign a long contract?\",\n    a: \"No. Our agreements run for 12 weeks and you can cancel with 14 days notice.\",\n  },\n  {\n    q: \"Can you help me get a mortgage?\",\n    a: \"Yes. Our in-house advisers compare rates from more than 40 lenders and can arrange pre-approval quickly.\",\n  },\n  {\n    q: \"Do you manage rental properties?\",\n    a: \"We offer tenant finding and fully managed lettings, including rent collection, maintenance and compliance.\",\n  },\n]\n\nconst footer = [\n  { title: \"Property\", links: [\"Buy\", \"Rent\", \"Sell\", \"New developments\"] },\n  {\n    title: \"Services\",\n    links: [\"Valuations\", \"Mortgages\", \"Property management\", \"Commercial\"],\n  },\n  {\n    title: \"Company\",\n    links: [\"Our agents\", \"Market insights\", \"Careers\", \"Contact\"],\n  },\n]\n\nexport default function LandingRealEstate07() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-fuchsia-600 text-white text-sm\">\n              C\n            </span>\n            <span className=\"\">Cottonwood Ranch</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Saved homes\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Browse land\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"relative isolate overflow-hidden border-b\">\n        <div className=\"pointer-events-none absolute inset-0 -z-10 bg-radial-[ellipse_60%_50%_at_50%_0%] from-fuchsia-500/25 via-purple-500/10 to-transparent to-70%\" />\n        <div className=\"pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,var(--border)_1px,transparent_1px),linear-gradient(to_bottom,var(--border)_1px,transparent_1px)] bg-[size:48px_48px] [mask-image:radial-gradient(ellipse_50%_45%_at_50%_0%,#000_60%,transparent_100%)]\" />\n        <div className=\"mx-auto max-w-7xl px-6 pt-20 pb-16 md:pt-32\">\n          <div className=\"mx-auto max-w-4xl space-y-8 text-center\">\n            <a\n              href=\"#\"\n              className=\"inline-flex items-center gap-2 rounded-full border bg-background/70 py-1 pr-3 pl-1 text-xs backdrop-blur\"\n            >\n              <span className=\"rounded-full bg-fuchsia-600 px-2 py-0.5 font-medium text-white\">\n                New\n              </span>\n              <span className=\"text-muted-foreground\">\n                New: 320-acre cattle ranch near the Brazos River\n              </span>\n            </a>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-8xl \">\n              <span className=\"text-fuchsia-600 dark:text-fuchsia-400\">\n                Acres of room\n              </span>\n              {\" to build your dream\"}\n            </h1>\n            <p className=\"mx-auto max-w-2xl text-lg leading-8 text-muted-foreground\">\n              Cottonwood Ranch sells farmland, ranches and wooded lots across\n              Texas and Oklahoma, with agents who know water rights and soil.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Browse land\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Talk to a land agent\n              </Button>\n            </div>\n          </div>\n          <div className=\"relative mx-auto mt-20 max-w-5xl\">\n            <div className=\"absolute inset-x-10 -top-6 -z-10 h-24 rounded-full bg-fuchsia-500/10 blur-2xl\" />\n            <HeroVisual />\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-12\">\n          <p className=\"text-center text-sm text-muted-foreground\">\n            Partnered with\n          </p>\n          <div className=\"mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-6 sm:grid-cols-4 lg:grid-cols-8\">\n            {logos.map((logo) => (\n              <div\n                key={logo}\n                className=\"text-center text-base font-semibold tracking-tight text-muted-foreground/70 \"\n              >\n                {logo}\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <p className=\"text-sm font-medium text-fuchsia-600 dark:text-fuchsia-400\">\n              Why choose us\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              A smarter way to buy, sell and rent\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Local experts, accurate data and a process that keeps you informed\n              from the first viewing to the final signature.\n            </p>\n          </div>\n          <div className=\"mt-14 grid overflow-hidden rounded-2xl border sm:grid-cols-2 lg:grid-cols-3\">\n            {features.map((feature) => (\n              <div\n                key={feature.title}\n                className=\"-mt-px -ml-px border-t border-l p-8\"\n              >\n                <feature.icon className=\"size-6 text-fuchsia-600 dark:text-fuchsia-400\" />\n                <h3 className=\"mt-5 font-semibold\">{feature.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl grid-cols-2 px-6 lg:grid-cols-4\">\n          {stats.slice(0, 4).map((stat, i) => (\n            <div\n              key={stat.label}\n              className={`py-12 ${i > 0 ? \"lg:border-l lg:pl-8\" : \"\"} ${i % 2 === 1 ? \"border-l pl-6 lg:pl-8\" : \"\"} `}\n            >\n              <div className=\"text-4xl font-semibold tracking-tight md:text-5xl \">\n                {stat.value}\n              </div>\n              <div className=\"mt-2 text-sm text-muted-foreground\">\n                {stat.label}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Featured listings\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                Hand-picked homes, updated daily. Book a viewing in person or\n                take a 3D tour from your sofa.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a key={item.name} href=\"#\" className=\"group\">\n                <div\n                  className={`relative aspect-[4/3] overflow-hidden rounded-2xl ${item.tile}`}\n                >\n                  <div className=\"absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10\" />\n                  <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-zinc-900 backdrop-blur\">\n                    {item.tag}\n                  </span>\n                </div>\n                <div className=\"mt-4 flex items-start justify-between gap-4\">\n                  <div className=\"min-w-0\">\n                    <h3 className=\"font-medium \">{item.name}</h3>\n                    <p className=\"mt-1 text-sm text-muted-foreground\">\n                      {item.meta}\n                    </p>\n                  </div>\n                  <span className=\"shrink-0 text-sm font-semibold\">\n                    {item.price}\n                  </span>\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              From first viewing to keys in hand\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-fuchsia-600 dark:text-fuchsia-400\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Homeowners who trusted us\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-6 md:grid-cols-3\">\n            {testimonials.map((t) => (\n              <figure\n                key={t.name}\n                className=\"flex flex-col rounded-2xl border p-6\"\n              >\n                <blockquote className=\"flex-1 leading-7\">\n                  &ldquo;{t.quote}&rdquo;\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 border-t pt-6 text-sm\">\n                  <span className=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Fair fees, clearly explained\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Choose the level of service that suits your sale. No hidden\n              charges and no long tie-in contracts.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-fuchsia-500 shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-fuchsia-600 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-fuchsia-600 dark:text-fuchsia-400\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Buying and selling questions\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Get in touch\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"px-6 py-20 md:py-28\">\n        <div className=\"relative mx-auto max-w-6xl overflow-hidden rounded-3xl border bg-fuchsia-500/10 px-6 py-16 text-center md:py-24\">\n          <div className=\"pointer-events-none absolute -top-24 left-1/2 size-96 -translate-x-1/2 rounded-full bg-gradient-to-b from-fuchsia-500/25 via-purple-500/10 to-transparent blur-3xl\" />\n          <div className=\"relative mx-auto max-w-2xl space-y-6\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Selling land or a working ranch?\n            </h2>\n            <p className=\"text-lg text-muted-foreground\">\n              Our agents market rural property to qualified buyers nationwide.\n              Request a free land valuation.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Browse land\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Talk to a land agent\n              </Button>\n            </div>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-fuchsia-600 text-white text-sm\">\n                C\n              </span>\n              <span className=\"\">Cottonwood Ranch</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              Room to roam since 1987.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Cottonwood Ranch. All rights\n              reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  return (\n    <div className=\"grid grid-cols-2 gap-3 md:grid-cols-3\">\n      {showcase.slice(0, 3).map((item, i) => (\n        <div\n          key={item.name}\n          className={`relative overflow-hidden rounded-2xl ${item.tile} ${i === 0 ? \"col-span-2 aspect-[16/10] md:col-span-1 md:aspect-[3/4]\" : \"aspect-[3/4]\"}`}\n        >\n          <div className=\"absolute inset-0 bg-gradient-to-t from-black/50 via-black/0 to-black/0\" />\n          <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-zinc-900 backdrop-blur\">\n            {item.tag}\n          </span>\n          <div className=\"absolute inset-x-3 bottom-3 flex items-end justify-between gap-2 text-white\">\n            <div className=\"min-w-0\">\n              <div className=\"truncate text-sm font-medium\">{item.name}</div>\n              <div className=\"truncate text-xs text-white/75\">{item.meta}</div>\n            </div>\n            <div className=\"shrink-0 text-sm font-semibold\">{item.price}</div>\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n",
