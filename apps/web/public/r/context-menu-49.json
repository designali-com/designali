{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "context-menu-49",
  "type": "registry:example",
  "description": "An automation workflow step whose menu renames, disables, duplicates, or inserts steps after it.",
  "files": [
    {
      "path": "registry/designali/examples/context-menu/context-menu-49.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  CopyPlus as CopyPlusIcon,\n  Hourglass as HourglassIcon,\n  Mail as MailIcon,\n  MessageSquare as MessageSquareIcon,\n  Pencil as PencilIcon,\n  Plus as PlusIcon,\n  Split as SplitIcon,\n  Trash as TrashIcon,\n  Zap as ZapIcon,\n} from \"@designali/icons\"\n\nimport {\n  ContextMenu,\n  ContextMenuCheckboxItem,\n  ContextMenuContent,\n  ContextMenuGroup,\n  ContextMenuItem,\n  ContextMenuSeparator,\n  ContextMenuSub,\n  ContextMenuSubContent,\n  ContextMenuSubTrigger,\n  ContextMenuTrigger,\n} from \"@workspace/ui/components/context-menu\"\nimport { cn } from \"@workspace/ui/lib/utils\"\n\nexport default function WorkflowNodeMenu() {\n  const [enabled, setEnabled] = React.useState(true)\n  const [next, setNext] = React.useState<string | null>(null)\n\n  return (\n    <div className=\"flex w-full max-w-xs flex-col items-center gap-2\">\n      <div className=\"flex w-full items-center gap-2 border border-dashed p-2 text-xs text-muted-foreground\">\n        <ZapIcon className=\"size-4\" />\n        When the designali.com contact form is submitted\n      </div>\n      <span className=\"h-4 w-px bg-border\" />\n      <ContextMenu>\n        <ContextMenuTrigger\n          className={cn(\n            \"flex w-full items-center gap-3 border bg-background p-3 text-xs shadow-xs data-popup-open:ring-2 data-popup-open:ring-ring/40\",\n            !enabled && \"opacity-50\"\n          )}\n        >\n          <div className=\"flex size-8 items-center justify-center bg-primary/15 text-primary\">\n            <MailIcon className=\"size-4\" />\n          </div>\n          <div className=\"flex flex-col\">\n            <span className=\"font-medium\">Send welcome email</span>\n            <span className=\"text-muted-foreground\">\n              {enabled ? \"Step 2 · Email\" : \"Step 2 · Skipped\"}\n            </span>\n          </div>\n        </ContextMenuTrigger>\n        <ContextMenuContent className=\"w-52\">\n          <ContextMenuGroup>\n            <ContextMenuItem>\n              <PencilIcon />\n              Rename step\n            </ContextMenuItem>\n            <ContextMenuItem>\n              <CopyPlusIcon />\n              Duplicate step\n            </ContextMenuItem>\n            <ContextMenuCheckboxItem\n              checked={enabled}\n              onCheckedChange={setEnabled}\n            >\n              Step enabled\n            </ContextMenuCheckboxItem>\n          </ContextMenuGroup>\n          <ContextMenuSeparator />\n          <ContextMenuSub>\n            <ContextMenuSubTrigger>\n              <PlusIcon />\n              Add step after\n            </ContextMenuSubTrigger>\n            <ContextMenuSubContent className=\"w-44\">\n              <ContextMenuGroup>\n                <ContextMenuItem onClick={() => setNext(\"Wait 1 day\")}>\n                  <HourglassIcon />\n                  Delay\n                </ContextMenuItem>\n                <ContextMenuItem onClick={() => setNext(\"If plan is Pro\")}>\n                  <SplitIcon />\n                  Condition\n                </ContextMenuItem>\n                <ContextMenuItem onClick={() => setNext(\"Post to #studio\")}>\n                  <MessageSquareIcon />\n                  Send message\n                </ContextMenuItem>\n              </ContextMenuGroup>\n            </ContextMenuSubContent>\n          </ContextMenuSub>\n          <ContextMenuSeparator />\n          <ContextMenuGroup>\n            <ContextMenuItem variant=\"destructive\">\n              <TrashIcon />\n              Delete step\n            </ContextMenuItem>\n          </ContextMenuGroup>\n        </ContextMenuContent>\n      </ContextMenu>\n      {next ? (\n        <>\n          <span className=\"h-4 w-px bg-border\" />\n          <div className=\"w-full border p-2 text-xs\">{next}</div>\n        </>\n      ) : null}\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}