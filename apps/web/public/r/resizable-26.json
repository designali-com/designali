{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "resizable-26",
  "type": "registry:example",
  "description": "Support desk with a ticket queue and a resizable conversation panel.",
  "files": [
    {
      "path": "registry/designali/examples/resizable/resizable-26.tsx",
      "content": "import { Avatar, AvatarFallback } from \"@workspace/ui/components/avatar\"\nimport { Badge } from \"@workspace/ui/components/badge\"\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  ResizableHandle,\n  ResizablePanel,\n  ResizablePanelGroup,\n} from \"@workspace/ui/components/resizable\"\nimport { Textarea } from \"@workspace/ui/components/textarea\"\nimport { cn } from \"@workspace/ui/lib/utils\"\n\nconst tickets = [\n  { id: \"#4821\", subject: \"Template download link expired\", priority: \"High\" },\n  { id: \"#4819\", subject: \"Refund for duplicate order\", priority: \"Medium\" },\n  { id: \"#4815\", subject: \"Icons package install fails\", priority: \"Low\" },\n]\n\nexport default function SupportTicketWorkspace() {\n  return (\n    <ResizablePanelGroup\n      orientation=\"horizontal\"\n      className=\"h-72 w-full max-w-2xl border\"\n    >\n      <ResizablePanel defaultSize=\"38%\" minSize=\"28%\">\n        <div className=\"flex h-full flex-col divide-y\">\n          {tickets.map((ticket, i) => (\n            <div\n              key={ticket.id}\n              className={cn(\n                \"flex flex-col gap-1 p-3\",\n                i === 0 && \"bg-muted/60\"\n              )}\n            >\n              <div className=\"flex items-center justify-between text-[11px]\">\n                <span className=\"font-sans text-muted-foreground\">\n                  {ticket.id}\n                </span>\n                <Badge\n                  variant={\n                    ticket.priority === \"High\" ? \"destructive\" : \"outline\"\n                  }\n                >\n                  {ticket.priority}\n                </Badge>\n              </div>\n              <span className=\"truncate text-xs font-medium\">\n                {ticket.subject}\n              </span>\n            </div>\n          ))}\n        </div>\n      </ResizablePanel>\n      <ResizableHandle withHandle />\n      <ResizablePanel defaultSize=\"62%\" minSize=\"40%\">\n        <div className=\"flex h-full flex-col gap-3 p-3\">\n          <div className=\"flex items-center gap-2\">\n            <Avatar className=\"size-6\">\n              <AvatarFallback className=\"text-[10px]\">E</AvatarFallback>\n            </Avatar>\n            <span className=\"text-xs font-medium\">Elif</span>\n            <span className=\"text-[11px] text-muted-foreground\">\n              12 min ago\n            </span>\n          </div>\n          <p className=\"text-xs\">\n            The download email never arrives. I&apos;ve checked spam and tried\n            twice.\n          </p>\n          <Textarea\n            placeholder=\"Write a reply...\"\n            className=\"mt-auto min-h-16 text-xs\"\n          />\n          <div className=\"flex justify-end gap-2\">\n            <Button size=\"sm\" variant=\"outline\">\n              Add note\n            </Button>\n            <Button size=\"sm\">Send reply</Button>\n          </div>\n        </div>\n      </ResizablePanel>\n    </ResizablePanelGroup>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}