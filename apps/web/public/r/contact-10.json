{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "contact-10",
  "type": "registry:block",
  "description": "Bento grid of support channels with a large live-chat tile, community, phone, hours, uptime status bars and office cards.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "button"
  ],
  "files": [
    {
      "path": "registry/designali/blocks/contact/contact-10.tsx",
      "content": "import {\n  ArrowUpRight,\n  Clock,\n  Users,\n  MapPin,\n  MessageCircle,\n  Phone,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nexport default function Contact10() {\n  return (\n    <section className=\"w-full bg-background py-20 md:py-28\">\n      <div className=\"mx-auto max-w-7xl px-6\">\n        <div className=\"mb-10 max-w-2xl\">\n          <p className=\"text-xs font-medium tracking-widest text-muted-foreground uppercase\">\n            Support\n          </p>\n          <h2 className=\"mt-3 text-4xl font-semibold tracking-tight md:text-5xl\">\n            Every way to reach Quillstack\n          </h2>\n        </div>\n\n        <div className=\"grid auto-rows-[minmax(180px,auto)] gap-4 md:grid-cols-4\">\n          <div className=\"relative flex flex-col justify-between overflow-hidden border bg-primary p-8 text-primary-foreground md:col-span-2 md:row-span-2\">\n            <div className=\"absolute -end-16 -top-16 size-64 rounded-full border-[40px] border-primary-foreground/10\" />\n            <MessageCircle className=\"size-8\" />\n            <div className=\"relative space-y-4\">\n              <h3 className=\"text-3xl font-semibold tracking-tight\">\n                Live chat with engineers\n              </h3>\n              <p className=\"max-w-sm text-primary-foreground/80\">\n                Our support team is made of the people who build the product.\n                Median first reply: 4 minutes.\n              </p>\n              <Button variant=\"secondary\" size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Start a conversation\n              </Button>\n            </div>\n          </div>\n\n          <a href=\"#\" className=\"group flex flex-col justify-between border bg-card p-6 transition-colors hover:bg-muted md:col-span-2\">\n            <div className=\"flex items-center justify-between\">\n              <Users className=\"size-5\" />\n              <ArrowUpRight className=\"size-4 text-muted-foreground transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5\" />\n            </div>\n            <div>\n              <p className=\"font-medium\">Community discussions</p>\n              <p className=\"mt-1 text-sm text-muted-foreground\">\n                12,400 developers sharing plugins, recipes and fixes.\n              </p>\n            </div>\n          </a>\n\n          <div className=\"flex flex-col justify-between border bg-card p-6\">\n            <Phone className=\"size-5\" />\n            <div>\n              <p className=\"font-medium\">+1 (206) 555-0167</p>\n              <p className=\"mt-1 text-sm text-muted-foreground\">Enterprise plans</p>\n            </div>\n          </div>\n\n          <div className=\"flex flex-col justify-between border bg-card p-6\">\n            <Clock className=\"size-5\" />\n            <div>\n              <p className=\"font-medium\">Mon&ndash;Fri, 6am&ndash;8pm PT</p>\n              <p className=\"mt-1 text-sm text-muted-foreground\">Weekend on-call for P1</p>\n            </div>\n          </div>\n\n          <div className=\"flex flex-col justify-between border bg-muted/50 p-6 md:col-span-3\">\n            <div className=\"flex items-center gap-2 text-sm\">\n              <span className=\"relative flex size-2\">\n                <span className=\"absolute inline-flex size-full animate-ping rounded-full bg-emerald-500 opacity-60\" />\n                <span className=\"relative inline-flex size-2 rounded-full bg-emerald-500\" />\n              </span>\n              All systems operational\n            </div>\n            <div className=\"mt-6 flex h-8 items-end gap-0.5\">\n              {Array.from({ length: 60 }).map((_, i) => (\n                <span\n                  key={i}\n                  className={\n                    i === 41\n                      ? \"h-5 flex-1 bg-amber-400\"\n                      : \"h-8 flex-1 bg-emerald-500/70 dark:bg-emerald-400/60\"\n                  }\n                />\n              ))}\n            </div>\n            <p className=\"mt-2 text-xs text-muted-foreground\">\n              99.98% uptime over the last 60 days\n            </p>\n          </div>\n\n          <div className=\"flex flex-col justify-between border bg-card p-6\">\n            <MapPin className=\"size-5\" />\n            <div>\n              <p className=\"font-medium\">Seattle, WA</p>\n              <p className=\"mt-1 text-sm text-muted-foreground\">\n                1520 Western Ave, Suite 4\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "820px"
  },
  "categories": [
    "contact"
  ]
}