      "path": "registry/designali/examples/resizable/resizable-27.tsx",
      "content": "import {\n  ResizableHandle,\n  ResizablePanel,\n  ResizablePanelGroup,\n} from \"@workspace/ui/components/resizable\"\n\nexport default function WideHoverHandle() {\n  return (\n    <ResizablePanelGroup\n      orientation=\"horizontal\"\n      className=\"h-44 w-full max-w-md border\"\n    >\n      <ResizablePanel defaultSize=\"50%\">\n        <div className=\"flex h-full items-center justify-center text-xs\">\n          Source\n        </div>\n      </ResizablePanel>\n      <ResizableHandle className=\"w-2 bg-muted transition-colors data-[separator=active]:bg-primary data-[separator=hover]:bg-primary/40\" />\n      <ResizablePanel defaultSize=\"50%\">\n        <div className=\"flex h-full items-center justify-center text-xs text-muted-foreground\">\n          Target\n        </div>\n      </ResizablePanel>\n    </ResizablePanelGroup>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}