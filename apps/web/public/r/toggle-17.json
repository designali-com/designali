{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "toggle-17",
  "type": "registry:example",
  "description": "Shuffle and repeat toggles around play controls in a compact music player.",
  "files": [
    {
      "path": "registry/designali/examples/toggle/toggle-17.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  Pause as PauseIcon,\n  Play as PlayIcon,\n  Repeat1 as Repeat1Icon,\n  Shuffle as ShuffleIcon,\n  SkipBack as SkipBackIcon,\n  SkipForward as SkipForwardIcon,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport { Toggle } from \"@workspace/ui/components/toggle\"\n\nexport default function MusicPlayerModeToggles() {\n  const [playing, setPlaying] = React.useState(false)\n\n  return (\n    <div className=\"flex w-full max-w-xs flex-col gap-3 border p-4\">\n      <div className=\"flex items-center gap-3\">\n        <div className=\"size-12 shrink-0 bg-gradient-to-br from-primary to-primary\" />\n        <div className=\"min-w-0\">\n          <p className=\"truncate text-sm font-medium\">Night Drive</p>\n          <p className=\"truncate text-xs text-muted-foreground\">\n            The Paper Lanterns\n          </p>\n        </div>\n      </div>\n      <div className=\"flex items-center justify-between\">\n        <Toggle\n          size=\"sm\"\n          aria-label=\"Shuffle\"\n          className=\"aria-pressed:text-primary\"\n        >\n          <ShuffleIcon />\n        </Toggle>\n        <Button variant=\"ghost\" size=\"icon-sm\" aria-label=\"Previous\">\n          <SkipBackIcon />\n        </Button>\n        <Toggle\n          variant=\"outline\"\n          size=\"lg\"\n          pressed={playing}\n          onPressedChange={setPlaying}\n          aria-label={playing ? \"Pause\" : \"Play\"}\n        >\n          {playing ? <PauseIcon /> : <PlayIcon />}\n        </Toggle>\n        <Button variant=\"ghost\" size=\"icon-sm\" aria-label=\"Next\">\n          <SkipForwardIcon />\n        </Button>\n        <Toggle\n          size=\"sm\"\n          aria-label=\"Repeat\"\n          className=\"aria-pressed:text-primary\"\n        >\n          <Repeat1Icon />\n        </Toggle>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}