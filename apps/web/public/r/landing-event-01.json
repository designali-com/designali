{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "landing-event-01",
  "type": "registry:page",
  "description": "An event landing page for a product and engineering conference with speakers and ticket tiers.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "button"
  ],
  "files": [
    {
      "path": "registry/designali/pages/event/landing-event-01/page.tsx",
      "content": "import {\n  Accessibility,\n  ArrowRight,\n  ArrowUpRight,\n  Check,\n  Mic,\n  Plus,\n  Presentation,\n  Sparkles,\n  Users,\n  UtensilsCrossed,\n  Video,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Speakers\", \"Schedule\", \"Venue\", \"Tickets\", \"Sponsors\"]\n\nconst logos = [\n  \"Northwind\",\n  \"Parallel\",\n  \"Stackhouse\",\n  \"Cobalt\",\n  \"Fieldnote\",\n  \"Harbor\",\n  \"Lumen\",\n  \"Quartz\",\n]\n\nconst features = [\n  {\n    icon: Mic,\n    title: \"40+ curated talks\",\n    description:\n      \"Every session is reviewed by a programme committee and rehearsed with a coach before the event.\",\n  },\n  {\n    icon: Users,\n    title: \"Hallway-track networking\",\n    description:\n      \"Matchmaking in the event app pairs you with attendees who share your goals before you arrive.\",\n  },\n  {\n    icon: Presentation,\n    title: \"Hands-on workshops\",\n    description:\n      \"Small-room sessions capped at 30 people, with materials and laptops-open exercises.\",\n  },\n  {\n    icon: Video,\n    title: \"Every talk recorded\",\n    description:\n      \"Ticket holders get lifetime access to recordings, slides and transcripts within 48 hours.\",\n  },\n  {\n    icon: UtensilsCrossed,\n    title: \"Food that is good\",\n    description:\n      \"Local caterers, vegan and allergy-friendly options, and coffee that does not taste like a conference.\",\n  },\n  {\n    icon: Accessibility,\n    title: \"Accessible by design\",\n    description:\n      \"Step-free venue, live captions on every stage, quiet rooms and a dedicated accessibility team.\",\n  },\n]\n\nconst stats = [\n  { value: \"2,400\", label: \"Attendees expected\" },\n  { value: \"60+\", label: \"Speakers\" },\n  { value: \"3\", label: \"Stages\" },\n  { value: \"28\", label: \"Countries represented\" },\n]\n\nconst steps = [\n  {\n    title: \"Morning keynotes\",\n    description:\n      \"Doors open at 8:30 with breakfast. Keynotes run on the main stage from 9:30 until 11:00.\",\n  },\n  {\n    title: \"Parallel tracks\",\n    description:\n      \"Choose between three stages covering strategy, engineering and design through the afternoon.\",\n  },\n  {\n    title: \"Workshops\",\n    description:\n      \"Pre-booked small-group workshops run in the studios from 14:00, with limited seats.\",\n  },\n  {\n    title: \"Evening social\",\n    description:\n      \"Wind down with live music, food trucks and the people you met in the hallway.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Amara Okoye\",\n    meta: \"Designing for the next billion users\",\n    tag: \"Keynote\",\n    price: \"Day 1 · 09:30\",\n    tile: \"bg-gradient-to-br from-sky-200 via-cyan-300 to-teal-400 dark:from-sky-700 dark:via-cyan-800 dark:to-teal-900\",\n  },\n  {\n    name: \"Lucas Bernard\",\n    meta: \"Scaling teams without losing culture\",\n    tag: \"Leadership\",\n    price: \"Day 1 · 11:15\",\n    tile: \"bg-gradient-to-br from-violet-200 via-purple-300 to-fuchsia-400 dark:from-violet-700 dark:via-purple-800 dark:to-fuchsia-900\",\n  },\n  {\n    name: \"Ingrid Solberg\",\n    meta: \"What we learned shipping weekly for 5 years\",\n    tag: \"Engineering\",\n    price: \"Day 1 · 14:00\",\n    tile: \"bg-gradient-to-br from-emerald-200 via-green-300 to-lime-300 dark:from-emerald-700 dark:via-green-800 dark:to-lime-900\",\n  },\n  {\n    name: \"Diego Herrera\",\n    meta: \"Hands-on: prototyping with real data\",\n    tag: \"Workshop\",\n    price: \"Day 2 · 10:00\",\n    tile: \"bg-gradient-to-br from-stone-200 via-neutral-300 to-zinc-400 dark:from-stone-700 dark:via-neutral-800 dark:to-zinc-900\",\n  },\n  {\n    name: \"Yuna Park\",\n    meta: \"The quiet power of good defaults\",\n    tag: \"Design\",\n    price: \"Day 2 · 13:30\",\n    tile: \"bg-gradient-to-br from-rose-200 via-pink-300 to-purple-300 dark:from-rose-700 dark:via-pink-800 dark:to-purple-900\",\n  },\n  {\n    name: \"Samuel Adeyemi\",\n    meta: \"Closing keynote: building for decades\",\n    tag: \"Keynote\",\n    price: \"Day 2 · 16:45\",\n    tile: \"bg-gradient-to-br from-blue-200 via-indigo-300 to-violet-400 dark:from-blue-700 dark:via-indigo-800 dark:to-violet-900\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"I came for the talks and left with two new hires and a partnership. The networking app actually worked.\",\n    name: \"Aisha Bello\",\n    role: \"Founder, attended 2025\",\n  },\n  {\n    quote:\n      \"The most well-run event I have been to. Sessions started on time and every speaker had something real to say.\",\n    name: \"Chris Navarro\",\n    role: \"Engineering Manager\",\n  },\n  {\n    quote:\n      \"The workshops alone were worth the ticket. I used what I learned on Monday morning.\",\n    name: \"Mei Tanaka\",\n    role: \"Product Designer\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Early bird\",\n    price: \"$349\",\n    period: \"/ticket\",\n    description: \"Limited release for the first 300 attendees.\",\n    features: [\n      \"Both conference days\",\n      \"All talks and stages\",\n      \"Lunch and coffee\",\n      \"Evening social\",\n      \"Session recordings\",\n    ],\n    cta: \"Buy early bird\",\n  },\n  {\n    name: \"Full pass\",\n    price: \"$549\",\n    period: \"/ticket\",\n    description: \"Everything, including workshops.\",\n    features: [\n      \"Both conference days\",\n      \"Two workshop seats\",\n      \"Priority seating\",\n      \"Speaker dinner draw\",\n      \"Recordings and slides\",\n    ],\n    cta: \"Get the full pass\",\n  },\n  {\n    name: \"Team\",\n    price: \"$449\",\n    period: \"/person\",\n    description: \"For groups of five or more.\",\n    features: [\n      \"Full pass benefits\",\n      \"Single invoice\",\n      \"Reserved team table\",\n      \"Flexible name changes\",\n      \"Dedicated contact\",\n    ],\n    cta: \"Book for your team\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"Where is the event held?\",\n    a: \"At a converted riverside warehouse ten minutes from the central station, with step-free access throughout.\",\n  },\n  {\n    q: \"Can I get a refund?\",\n    a: \"Tickets are refundable up to 30 days before the event. After that you can transfer your ticket to someone else for free.\",\n  },\n  {\n    q: \"Is there a code of conduct?\",\n    a: \"Yes. Every attendee, speaker and sponsor agrees to our code of conduct, and a safety team is on site at all times.\",\n  },\n  {\n    q: \"Will the talks be streamed?\",\n    a: \"Talks are recorded and shared with ticket holders within 48 hours. There is no public livestream.\",\n  },\n  {\n    q: \"Do you offer diversity tickets?\",\n    a: \"We fund over 100 free tickets each year for people from under-represented groups. Applications open in spring.\",\n  },\n]\n\nconst footer = [\n  { title: \"Event\", links: [\"Speakers\", \"Schedule\", \"Workshops\", \"Tickets\"] },\n  {\n    title: \"Attend\",\n    links: [\"Venue\", \"Travel and hotels\", \"Accessibility\", \"Code of conduct\"],\n  },\n  {\n    title: \"Get involved\",\n    links: [\"Call for speakers\", \"Sponsorship\", \"Volunteer\", \"Contact\"],\n  },\n]\n\nexport default function LandingEvent01() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <div className=\"border-b bg-muted/50 text-muted-foreground px-4 py-2 text-center text-xs sm:text-sm\">\n        <a\n          href=\"#\"\n          className=\"inline-flex items-center gap-1.5 hover:underline\"\n        >\n          Early bird tickets end Friday\n          <ArrowRight className=\"size-3.5\" />\n        </a>\n      </div>\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-amber-600 text-white text-sm\">\n              S\n            </span>\n            <span className=\"\">Shipyard Conf</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Log in\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Get tickets\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"relative overflow-hidden border-b\">\n        <div className=\"pointer-events-none absolute inset-x-0 top-0 -z-10 h-96 bg-gradient-to-b from-amber-500/25 to-transparent opacity-50\" />\n        <div className=\"mx-auto max-w-7xl px-6 pt-16 pb-16 md:pt-28\">\n          <div className=\"mx-auto max-w-4xl space-y-7 text-center\">\n            <span className=\"inline-flex items-center gap-2 rounded-full border bg-background text-muted-foreground px-3 py-1 text-xs font-medium\">\n              <Sparkles className=\"size-3.5 text-amber-600 dark:text-amber-400\" />\n              June 11 to 12 · Amsterdam\n            </span>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-7xl \">\n              {\"Two days with the people who \"}\n              <span className=\"text-amber-600 dark:text-amber-400\">\n                ship great software\n              </span>\n            </h1>\n            <p className=\"mx-auto max-w-2xl text-lg leading-8 text-muted-foreground\">\n              Shipyard brings 2,400 engineers, designers and product leaders\n              together for talks, workshops and conversations that change how\n              you work.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Get tickets\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                View schedule\n              </Button>\n            </div>\n          </div>\n          <div className=\"mx-auto mt-16 max-w-6xl\">\n            <HeroVisual />\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-12\">\n          <p className=\"text-center text-sm text-muted-foreground\">\n            Supported by our partners\n          </p>\n          <div className=\"mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-6 sm:grid-cols-4 lg:grid-cols-8\">\n            {logos.map((logo) => (\n              <div\n                key={logo}\n                className=\"text-center text-base font-semibold tracking-tight text-muted-foreground/70 \"\n              >\n                {logo}\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <p className=\"text-sm font-medium text-amber-600 dark:text-amber-400\">\n              The experience\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              Two days designed to be worth the trip\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Talks, workshops and conversations you cannot get from a\n              livestream, in a venue built for meeting the right people.\n            </p>\n          </div>\n          <div className=\"mt-14 grid overflow-hidden rounded-2xl border sm:grid-cols-2 lg:grid-cols-3\">\n            {features.map((feature) => (\n              <div\n                key={feature.title}\n                className=\"-mt-px -ml-px border-t border-l p-8\"\n              >\n                <feature.icon className=\"size-6 text-amber-600 dark:text-amber-400\" />\n                <h3 className=\"mt-5 font-semibold\">{feature.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Speakers and sessions\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                Practitioners, founders and researchers sharing what they have\n                actually built, not what they plan to build.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a key={item.name} href=\"#\" className=\"group\">\n                <div\n                  className={`relative aspect-[4/3] overflow-hidden rounded-2xl ${item.tile}`}\n                >\n                  <div className=\"absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10\" />\n                  <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-zinc-900 backdrop-blur\">\n                    {item.tag}\n                  </span>\n                </div>\n                <div className=\"mt-4 flex items-start justify-between gap-4\">\n                  <div className=\"min-w-0\">\n                    <h3 className=\"font-medium \">{item.name}</h3>\n                    <p className=\"mt-1 text-sm text-muted-foreground\">\n                      {item.meta}\n                    </p>\n                  </div>\n                  <span className=\"shrink-0 text-sm font-semibold\">\n                    {item.price}\n                  </span>\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              How the days unfold\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-amber-600 dark:text-amber-400\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl grid-cols-2 px-6 lg:grid-cols-4\">\n          {stats.slice(0, 4).map((stat, i) => (\n            <div\n              key={stat.label}\n              className={`py-12 ${i > 0 ? \"lg:border-l lg:pl-8\" : \"\"} ${i % 2 === 1 ? \"border-l pl-6 lg:pl-8\" : \"\"} `}\n            >\n              <div className=\"text-4xl font-semibold tracking-tight md:text-5xl \">\n                {stat.value}\n              </div>\n              <div className=\"mt-2 text-sm text-muted-foreground\">\n                {stat.label}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              What past attendees say\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-6 md:grid-cols-3\">\n            {testimonials.map((t) => (\n              <figure\n                key={t.name}\n                className=\"flex flex-col rounded-2xl border p-6\"\n              >\n                <blockquote className=\"flex-1 leading-7\">\n                  &ldquo;{t.quote}&rdquo;\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 border-t pt-6 text-sm\">\n                  <span className=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Get your ticket\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Prices rise as each release sells out. Group discounts apply\n              automatically for five or more tickets.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-amber-500 shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-amber-600 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-amber-600 dark:text-amber-400\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Event FAQ\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Get in touch\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"px-6 py-20 md:py-28\">\n        <div className=\"relative mx-auto max-w-6xl overflow-hidden rounded-3xl border bg-amber-500/10 px-6 py-16 text-center md:py-24\">\n          <div className=\"pointer-events-none absolute -top-24 left-1/2 size-96 -translate-x-1/2 rounded-full bg-gradient-to-b from-amber-500/25 via-yellow-500/10 to-transparent blur-3xl\" />\n          <div className=\"relative mx-auto max-w-2xl space-y-6\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              See you in Amsterdam\n            </h2>\n            <p className=\"text-lg text-muted-foreground\">\n              Early bird tickets are limited. Lock in the lowest price today.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Get tickets\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                View schedule\n              </Button>\n            </div>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-amber-600 text-white text-sm\">\n                S\n              </span>\n              <span className=\"\">Shipyard Conf</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              The conference for builders.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Shipyard Conf. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  return (\n    <div className=\"grid grid-cols-2 gap-3 md:grid-cols-3\">\n      {showcase.slice(0, 3).map((item, i) => (\n        <div\n          key={item.name}\n          className={`relative overflow-hidden rounded-2xl ${item.tile} ${i === 0 ? \"col-span-2 aspect-[16/10] md:col-span-1 md:aspect-[3/4]\" : \"aspect-[3/4]\"}`}\n        >\n          <div className=\"absolute inset-0 bg-gradient-to-t from-black/50 via-black/0 to-black/0\" />\n          <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-zinc-900 backdrop-blur\">\n            {item.tag}\n          </span>\n          <div className=\"absolute inset-x-3 bottom-3 flex items-end justify-between gap-2 text-white\">\n            <div className=\"min-w-0\">\n              <div className=\"truncate text-sm font-medium\">{item.name}</div>\n              <div className=\"truncate text-xs text-white/75\">{item.meta}</div>\n            </div>\n            <div className=\"shrink-0 text-sm font-semibold\">{item.price}</div>\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n",
