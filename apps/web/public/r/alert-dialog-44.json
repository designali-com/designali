{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "alert-dialog-44",
  "type": "registry:example",
  "description": "Checkout cart line item whose remove button confirms in a small dialog.",
  "files": [
    {
      "path": "registry/designali/examples/alert-dialog/alert-dialog-44.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport { ShoppingCartIcon } from \"lucide-react\"\n\nimport {\n  AlertDialog,\n  AlertDialogAction,\n  AlertDialogCancel,\n  AlertDialogContent,\n  AlertDialogDescription,\n  AlertDialogFooter,\n  AlertDialogHeader,\n  AlertDialogMedia,\n  AlertDialogTitle,\n  AlertDialogTrigger,\n} from \"@workspace/ui/components/alert-dialog\"\nimport { Button } from \"@workspace/ui/components/button\"\n\nexport default function CartRemoveItem() {\n  const [removed, setRemoved] = React.useState(false)\n\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-3 border p-4\">\n      {removed ? (\n        <p className=\"py-4 text-center text-sm text-muted-foreground\">\n          Your cart is empty.\n        </p>\n      ) : (\n        <div className=\"flex items-center gap-3\">\n          <div className=\"size-14 shrink-0 bg-linear-to-br from-orange-300 to-rose-400\" />\n          <div className=\"min-w-0 flex-1\">\n            <p className=\"text-sm font-medium\">Ceramic pour-over set</p>\n            <p className=\"text-xs text-muted-foreground\">Sand - Qty 1</p>\n            <p className=\"mt-1 text-sm font-semibold\">$64.00</p>\n          </div>\n          <AlertDialog>\n            <AlertDialogTrigger render={<Button variant=\"ghost\" size=\"sm\" />}>\n              Remove\n            </AlertDialogTrigger>\n            <AlertDialogContent size=\"sm\">\n              <AlertDialogHeader>\n                <AlertDialogMedia>\n                  <ShoppingCartIcon />\n                </AlertDialogMedia>\n                <AlertDialogTitle>Remove from cart?</AlertDialogTitle>\n                <AlertDialogDescription>\n                  Only 3 left in stock.\n                </AlertDialogDescription>\n              </AlertDialogHeader>\n              <AlertDialogFooter>\n                <AlertDialogCancel>Keep</AlertDialogCancel>\n                <AlertDialogAction\n                  variant=\"destructive\"\n                  onClick={() => setRemoved(true)}\n                >\n                  Remove\n                </AlertDialogAction>\n              </AlertDialogFooter>\n            </AlertDialogContent>\n          </AlertDialog>\n        </div>\n      )}\n      <Button disabled={removed} className=\"w-full\">\n        Checkout\n      </Button>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}