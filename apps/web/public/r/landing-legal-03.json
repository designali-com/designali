      "path": "registry/designali/pages/legal/landing-legal-03/page.tsx",
      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  Award,\n  Check,\n  Clock,\n  Languages,\n  Lock,\n  Plus,\n  Quote,\n  Receipt,\n  Sparkles,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\n  \"Practice areas\",\n  \"Attorneys\",\n  \"Results\",\n  \"Insights\",\n  \"Contact\",\n]\n\nconst logos = [\n  \"Super Lawyers\",\n  \"Legal 500\",\n  \"Martindale-Hubbell\",\n  \"Law360\",\n  \"The American Lawyer\",\n  \"Benchmark Litigation\",\n  \"Chambers USA\",\n  \"Best Lawyers\",\n]\n\nconst features = [\n  {\n    icon: Clock,\n    title: \"Same-day responses\",\n    description:\n      \"Every client has a named attorney who returns calls and emails within one business day.\",\n  },\n  {\n    icon: Lock,\n    title: \"Strict confidentiality\",\n    description:\n      \"Encrypted client portal, secure document sharing and conflict checks on every new matter.\",\n  },\n  {\n    icon: Award,\n    title: \"Recognised expertise\",\n    description:\n      \"Partners ranked by leading legal directories and peer-reviewed for ethics and ability.\",\n  },\n  {\n    icon: Receipt,\n    title: \"Fixed-fee options\",\n    description:\n      \"Many matters are offered on a fixed fee, so you know the cost before we start.\",\n  },\n  {\n    icon: Languages,\n    title: \"Multilingual team\",\n    description:\n      \"We advise in English, Spanish, Mandarin and Arabic, with certified translation when needed.\",\n  },\n]\n\nconst stats = [\n  { value: \"2,800\", label: \"Matters resolved\" },\n  { value: \"42\", label: \"Attorneys\" },\n  { value: \"96%\", label: \"Client satisfaction\" },\n  { value: \"24 hr\", label: \"Response guarantee\" },\n]\n\nconst steps = [\n  {\n    title: \"Free consultation\",\n    description:\n      \"Tell us about your situation in a confidential 30-minute call with an attorney.\",\n  },\n  {\n    title: \"Clear plan and fee\",\n    description:\n      \"We outline your options, the strategy we recommend and the cost, in writing.\",\n  },\n  {\n    title: \"We get to work\",\n    description:\n      \"Your named attorney leads the matter with regular updates through the client portal.\",\n  },\n  {\n    title: \"Resolution\",\n    description:\n      \"We negotiate, litigate or close, and stay available for whatever comes next.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Corporate and M&A\",\n    meta: \"Formation, financing, acquisitions\",\n    tag: \"Business\",\n    price: \"Fixed or hourly\",\n    tile: \"bg-gradient-to-br from-violet-200 via-purple-300 to-fuchsia-400 dark:from-violet-700 dark:via-purple-800 dark:to-fuchsia-900\",\n  },\n  {\n    name: \"Commercial litigation\",\n    meta: \"Contract, partnership and IP disputes\",\n    tag: \"Disputes\",\n    price: \"Hourly\",\n    tile: \"bg-gradient-to-br from-emerald-200 via-green-300 to-lime-300 dark:from-emerald-700 dark:via-green-800 dark:to-lime-900\",\n  },\n  {\n    name: \"Employment law\",\n    meta: \"Policies, terminations, discrimination\",\n    tag: \"Employers\",\n    price: \"From $450\",\n    tile: \"bg-gradient-to-br from-stone-200 via-neutral-300 to-zinc-400 dark:from-stone-700 dark:via-neutral-800 dark:to-zinc-900\",\n  },\n  {\n    name: \"Family law\",\n    meta: \"Divorce, custody, prenuptial agreements\",\n    tag: \"Private clients\",\n    price: \"Fixed fee\",\n    tile: \"bg-gradient-to-br from-rose-200 via-pink-300 to-purple-300 dark:from-rose-700 dark:via-pink-800 dark:to-purple-900\",\n  },\n  {\n    name: \"Estate planning\",\n    meta: \"Wills, trusts, probate\",\n    tag: \"Private clients\",\n    price: \"From $1,800\",\n    tile: \"bg-gradient-to-br from-blue-200 via-indigo-300 to-violet-400 dark:from-blue-700 dark:via-indigo-800 dark:to-violet-900\",\n  },\n  {\n    name: \"Immigration\",\n    meta: \"Visas, green cards, citizenship\",\n    tag: \"Individuals\",\n    price: \"Fixed fee\",\n    tile: \"bg-gradient-to-br from-yellow-100 via-amber-200 to-orange-300 dark:from-yellow-700 dark:via-amber-800 dark:to-orange-900\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"A difficult divorce handled with real compassion. I always knew where things stood and what came next.\",\n    name: \"Maria Delgado\",\n    role: \"Family law client\",\n  },\n  {\n    quote:\n      \"We have used them as outside counsel for eight years. Responsive, practical and commercially minded.\",\n    name: \"James Holloway\",\n    role: \"General Counsel, logistics group\",\n  },\n  {\n    quote:\n      \"They secured my green card after two other firms told me it was impossible.\",\n    name: \"Wei Zhang\",\n    role: \"Immigration client\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Consultation\",\n    price: \"Free\",\n    period: \"\",\n    description: \"A confidential first conversation.\",\n    features: [\n      \"30 minutes with an attorney\",\n      \"Case assessment\",\n      \"Options explained\",\n      \"No obligation\",\n    ],\n    cta: \"Book a consultation\",\n  },\n  {\n    name: \"Fixed fee\",\n    price: \"From $1,800\",\n    period: \"/matter\",\n    description: \"Defined matters at a set price.\",\n    features: [\n      \"Wills and trusts\",\n      \"Uncontested divorce\",\n      \"Visa applications\",\n      \"Company formation\",\n      \"Price agreed up front\",\n    ],\n    cta: \"Get a fixed quote\",\n  },\n  {\n    name: \"Retainer\",\n    price: \"Custom\",\n    period: \"\",\n    description: \"Ongoing counsel for businesses.\",\n    features: [\n      \"Named outside counsel\",\n      \"Monthly hours included\",\n      \"Contract review\",\n      \"Priority response\",\n      \"Quarterly legal health check\",\n    ],\n    cta: \"Discuss a retainer\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"Do you take cases on contingency?\",\n    a: \"For personal injury and some employment claims we work on contingency, which means no fee unless we recover compensation.\",\n  },\n  {\n    q: \"Who will handle my matter?\",\n    a: \"You will have a named lead attorney supported by a small team. You will never be passed around.\",\n  },\n  {\n    q: \"Can we meet by video?\",\n    a: \"Yes. Most meetings can be held by secure video, and documents can be signed electronically.\",\n  },\n  {\n    q: \"Is what I tell you confidential?\",\n    a: \"Yes. Everything you share in a consultation is protected by attorney-client privilege, even if you do not hire us.\",\n  },\n  {\n    q: \"Is the first consultation really free?\",\n    a: \"Yes. Your first 30-minute consultation is free and confidential, with no obligation to instruct us.\",\n  },\n]\n\nconst footer = [\n  {\n    title: \"Practice\",\n    links: [\"Business\", \"Litigation\", \"Private clients\", \"Immigration\"],\n  },\n  { title: \"Firm\", links: [\"Attorneys\", \"Results\", \"Careers\", \"Pro bono\"] },\n  {\n    title: \"Contact\",\n    links: [\"New York\", \"Chicago\", \"Austin\", \"Client portal\"],\n  },\n]\n\nexport default function LandingLegal03() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-teal-600 text-white text-sm\">\n              N\n            </span>\n            <span className=\"\">Northgate Counsel</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Client portal\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Get a fixed quote\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-16 md:py-24\">\n          <div className=\"mx-auto max-w-3xl space-y-6 text-center\">\n            <span className=\"inline-flex items-center gap-2 rounded-full border bg-background text-muted-foreground px-3 py-1 text-xs font-medium\">\n              <Sparkles className=\"size-3.5 text-teal-600 dark:text-teal-400\" />\n              Startup and venture law\n            </span>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-6xl \">\n              {\"Legal for founders, \"}\n              <span className=\"text-teal-600 dark:text-teal-400\">\n                priced for startups\n              </span>\n            </h1>\n            <p className=\"mx-auto max-w-2xl text-lg leading-8 text-muted-foreground\">\n              Northgate handles incorporation, fundraising, equity and\n              commercial contracts for venture-backed companies, with fixed fees\n              and fast turnaround.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Get a fixed quote\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                See fee schedule\n              </Button>\n            </div>\n          </div>\n          <div className=\"mt-14 grid gap-3 lg:grid-cols-[2fr_1fr]\">\n            <HeroVisual />\n            <div className=\"grid grid-cols-2 gap-3 lg:grid-cols-1\">\n              {stats.slice(0, 3).map((stat, i) => (\n                <div\n                  key={stat.label}\n                  className={`flex flex-col justify-between rounded-2xl border p-5 ${i === 0 ? \"bg-teal-500/10\" : \"bg-muted/40\"} ${i === 2 ? \"col-span-2 lg:col-span-1\" : \"\"}`}\n                >\n                  <div className=\"text-xs text-muted-foreground\">\n                    {stat.label}\n                  </div>\n                  <div className=\"mt-6 text-3xl font-semibold tracking-tight\">\n                    {stat.value}\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-12\">\n          <p className=\"text-center text-sm text-muted-foreground\">\n            Recognised by\n          </p>\n          <div className=\"mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-6 sm:grid-cols-4 lg:grid-cols-8\">\n            {logos.map((logo) => (\n              <div\n                key={logo}\n                className=\"text-center text-base font-semibold tracking-tight text-muted-foreground/70 \"\n              >\n                {logo}\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <p className=\"text-sm font-medium text-teal-600 dark:text-teal-400\">\n              Why clients choose us\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              Counsel that is clear, responsive and relentless\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              We combine the depth of a large firm with the attention of a\n              boutique, and we explain every option in plain language.\n            </p>\n          </div>\n          <div className=\"mt-14 grid gap-3 md:grid-cols-3\">\n            {features.map((feature, i) => (\n              <div\n                key={feature.title}\n                className={`group rounded-2xl border p-6 transition-colors hover:bg-muted/40 ${i === 0 ? \"bg-teal-500/10 md:col-span-2 md:row-span-2 md:p-10\" : \"\"} ${i === 3 ? \"md:col-span-2\" : \"\"}`}\n              >\n                <feature.icon\n                  className={`${i === 0 ? \"size-8\" : \"size-5\"} text-teal-600 dark:text-teal-400`}\n                />\n                <h3\n                  className={`mt-6 font-semibold tracking-tight ${i === 0 ? \"text-2xl md:text-3xl\" : \"text-lg\"}`}\n                >\n                  {feature.title}\n                </h3>\n                <p\n                  className={`mt-2 leading-7 text-muted-foreground ${i === 0 ? \"max-w-md text-lg\" : \"text-sm\"}`}\n                >\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Practice areas\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                Experienced attorneys focused on the matters that affect your\n                business, your family and your future.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a key={item.name} href=\"#\" className=\"group\">\n                <div\n                  className={`relative aspect-[4/3] overflow-hidden rounded-2xl ${item.tile}`}\n                >\n                  <div className=\"absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10\" />\n                  <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-zinc-900 backdrop-blur\">\n                    {item.tag}\n                  </span>\n                </div>\n                <div className=\"mt-4 flex items-start justify-between gap-4\">\n                  <div className=\"min-w-0\">\n                    <h3 className=\"font-medium \">{item.name}</h3>\n                    <p className=\"mt-1 text-sm text-muted-foreground\">\n                      {item.meta}\n                    </p>\n                  </div>\n                  <span className=\"shrink-0 text-sm font-semibold\">\n                    {item.price}\n                  </span>\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b bg-muted/30\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              What our clients say\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-4 md:grid-cols-3\">\n            {testimonials.map((t, i) => (\n              <figure\n                key={t.name}\n                className={`flex flex-col justify-between rounded-2xl border bg-background p-6 ${i === 0 ? \"md:col-span-2 md:p-10\" : \"\"}`}\n              >\n                <Quote className=\"size-6 text-teal-600 dark:text-teal-400\" />\n                <blockquote\n                  className={`mt-4 leading-relaxed ${i === 0 ? \"text-xl md:text-2xl\" : \"text-muted-foreground\"}`}\n                >\n                  {t.quote}\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 text-sm\">\n                  <span className=\"flex size-9 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              How we work with you\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-teal-600 dark:text-teal-400\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Transparent fees\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              No surprise invoices. We agree the fee structure in writing before\n              any work begins.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-teal-500 shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-teal-600 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-teal-600 dark:text-teal-400\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Common questions\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Get in touch\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"px-6 py-20 md:py-28\">\n        <div className=\"relative mx-auto max-w-6xl overflow-hidden rounded-3xl border bg-teal-500/10 px-6 py-16 text-center md:py-24\">\n          <div className=\"pointer-events-none absolute -top-24 left-1/2 size-96 -translate-x-1/2 rounded-full bg-gradient-to-b from-teal-500/25 via-emerald-500/10 to-transparent blur-3xl\" />\n          <div className=\"relative mx-auto max-w-2xl space-y-6\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Raise your next round with confidence\n            </h2>\n            <p className=\"text-lg text-muted-foreground\">\n              Book a call with a partner and get a fixed quote within 24 hours.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Get a fixed quote\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                See fee schedule\n              </Button>\n            </div>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-teal-600 text-white text-sm\">\n                N\n              </span>\n              <span className=\"\">Northgate Counsel</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              Build fast, stay protected.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Northgate Counsel. All rights\n              reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  return (\n    <div className=\"grid grid-cols-2 gap-3 md:grid-cols-4 md:grid-rows-2\">\n      {showcase.slice(0, 5).map((item, i) => (\n        <div\n          key={item.name}\n          className={`relative overflow-hidden rounded-2xl ${item.tile} ${i === 0 ? \"col-span-2 row-span-2 aspect-square md:aspect-auto\" : \"aspect-[4/3]\"}`}\n        >\n          <div className=\"absolute inset-0 bg-gradient-to-t from-black/50 via-black/0 to-black/0\" />\n          <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-zinc-900 backdrop-blur\">\n            {item.tag}\n          </span>\n          <div className=\"absolute inset-x-3 bottom-3 flex items-end justify-between gap-2 text-white\">\n            <div className=\"min-w-0\">\n              <div className=\"truncate text-sm font-medium\">{item.name}</div>\n              <div className=\"truncate text-xs text-white/75\">{item.meta}</div>\n            </div>\n            <div className=\"shrink-0 text-sm font-semibold\">{item.price}</div>\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n",
