{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "command-33",
  "type": "registry:example",
  "description": "An admin console action menu scoped to a selected user, including a destructive suspend action.",
  "files": [
    {
      "path": "registry/designali/examples/command/command-33.tsx",
      "content": "import {\n  BanIcon,\n  HistoryIcon,\n  KeyRoundIcon,\n  ShieldCheckIcon,\n  VenetianMaskIcon,\n} from \"lucide-react\"\n\nimport { Avatar, AvatarFallback } from \"@workspace/ui/components/avatar\"\nimport { Badge } from \"@workspace/ui/components/badge\"\nimport {\n  Command,\n  CommandEmpty,\n  CommandGroup,\n  CommandInput,\n  CommandItem,\n  CommandList,\n  CommandSeparator,\n} from \"@workspace/ui/components/command\"\n\nexport default function AdminUserActions() {\n  return (\n    <Command className=\"w-full max-w-sm border\">\n      <div className=\"flex items-center gap-3 border-b p-3\">\n        <Avatar>\n          <AvatarFallback>RK</AvatarFallback>\n        </Avatar>\n        <div className=\"flex min-w-0 flex-col\">\n          <span className=\"text-sm font-medium\">Rina Kowalski</span>\n          <span className=\"truncate text-xs text-muted-foreground\">\n            rina@fieldnote.io · Admin\n          </span>\n        </div>\n        <Badge variant=\"outline\" className=\"ms-auto\">\n          Active\n        </Badge>\n      </div>\n      <CommandInput placeholder=\"Run an action on this user...\" />\n      <CommandList>\n        <CommandEmpty>No action found.</CommandEmpty>\n        <CommandGroup heading=\"Account\">\n          <CommandItem>\n            <VenetianMaskIcon />\n            <span>Impersonate user</span>\n          </CommandItem>\n          <CommandItem>\n            <KeyRoundIcon />\n            <span>Send password reset</span>\n          </CommandItem>\n          <CommandItem>\n            <ShieldCheckIcon />\n            <span>Reset two-factor auth</span>\n          </CommandItem>\n          <CommandItem>\n            <HistoryIcon />\n            <span>View audit log</span>\n          </CommandItem>\n        </CommandGroup>\n        <CommandSeparator />\n        <CommandGroup heading=\"Danger zone\">\n          <CommandItem className=\"text-destructive data-selected:text-destructive data-selected:*:[svg]:text-destructive\">\n            <BanIcon />\n            <span>Suspend account</span>\n          </CommandItem>\n        </CommandGroup>\n      </CommandList>\n    </Command>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}