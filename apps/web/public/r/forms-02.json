{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "forms-02",
  "type": "registry:block",
  "description": "A multi-step account creation form with progress indicator.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "button",
    "input",
    "label"
  ],
  "files": [
    {
      "path": "registry/designali/blocks/forms/forms-02.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\nimport {\n  ArrowLeft,\n  ArrowRight,\n  Check,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport { Input } from \"@workspace/ui/components/input\"\nimport { Label } from \"@workspace/ui/components/label\"\nimport { cn } from \"@workspace/ui/lib/utils\"\n\nconst steps = [\"Account\", \"Workspace\", \"Invite team\"]\n\nconst roles = [\"Designer\", \"Developer\", \"Design engineer\", \"Founder\"]\n\nexport default function Forms02() {\n  const [step, setStep] = useState(0)\n  const [role, setRole] = useState(\"Designer\")\n\n  return (\n    <section className=\"w-full bg-muted/40 py-20\">\n      <div className=\"mx-auto max-w-xl px-6\">\n        <ol className=\"mb-10 grid grid-cols-3 border border-border bg-background\">\n          {steps.map((label, index) => (\n            <li\n              key={label}\n              className={cn(\n                \"flex items-center gap-2 border-border px-3 py-3 text-xs not-last:border-r\",\n                index === step ? \"text-foreground\" : \"text-muted-foreground\"\n              )}\n            >\n              <span\n                className={cn(\n                  \"flex size-5 shrink-0 items-center justify-center border text-[10px]\",\n                  index < step && \"border-foreground bg-foreground text-background\",\n                  index === step && \"border-foreground\",\n                  index > step && \"border-border\"\n                )}\n              >\n                {index < step ? <Check className=\"size-3\" /> : index + 1}\n              </span>\n              <span className=\"truncate\">{label}</span>\n            </li>\n          ))}\n        </ol>\n\n        <div className=\"border border-border bg-background p-6 md:p-8\">\n          {step === 0 && (\n            <div className=\"space-y-5\">\n              <h2 className=\"text-2xl font-semibold tracking-tight\">\n                Create your Designali account\n              </h2>\n              <div className=\"space-y-2\">\n                <Label htmlFor=\"f2-email\">Email</Label>\n                <Input id=\"f2-email\" type=\"email\" placeholder=\"you@example.com\" className=\"h-10\" />\n              </div>\n              <div className=\"space-y-2\">\n                <Label htmlFor=\"f2-password\">Password</Label>\n                <Input id=\"f2-password\" type=\"password\" placeholder=\"At least 12 characters\" className=\"h-10\" />\n              </div>\n            </div>\n          )}\n\n          {step === 1 && (\n            <div className=\"space-y-5\">\n              <h2 className=\"text-2xl font-semibold tracking-tight\">\n                Set up your Designali workspace\n              </h2>\n              <div className=\"space-y-2\">\n                <Label htmlFor=\"f2-workspace\">Workspace name</Label>\n                <div className=\"flex\">\n                  <span className=\"flex h-10 items-center border border-r-0 border-input bg-muted px-3 text-xs text-muted-foreground\">\n                    designali.com/\n                  </span>\n                  <Input id=\"f2-workspace\" placeholder=\"your-studio\" className=\"h-10\" />\n                </div>\n              </div>\n              <div className=\"space-y-2\">\n                <p className=\"text-xs\">What best describes you?</p>\n                <div className=\"grid grid-cols-2 gap-2\">\n                  {roles.map((item) => (\n                    <button\n                      key={item}\n                      type=\"button\"\n                      onClick={() => setRole(item)}\n                      className={cn(\n                        \"border px-3 py-2.5 text-left text-xs transition-colors\",\n                        role === item\n                          ? \"border-foreground bg-muted\"\n                          : \"border-border hover:bg-muted/60\"\n                      )}\n                    >\n                      {item}\n                    </button>\n                  ))}\n                </div>\n              </div>\n            </div>\n          )}\n\n          {step === 2 && (\n            <div className=\"space-y-5\">\n              <h2 className=\"text-2xl font-semibold tracking-tight\">\n                Invite your teammates\n              </h2>\n              {[\"sara@example.com\", \"dev@example.com\", \"\"].map((email, index) => (\n                <Input\n                  key={index}\n                  type=\"email\"\n                  defaultValue={email}\n                  placeholder=\"teammate@example.com\"\n                  className=\"h-10\"\n                />\n              ))}\n              <p className=\"text-xs text-muted-foreground\">\n                You can always invite more people later from settings.\n              </p>\n            </div>\n          )}\n\n          <div className=\"mt-8 flex items-center justify-between border-t border-border pt-6\">\n            <Button\n              variant=\"ghost\"\n              disabled={step === 0}\n              onClick={() => setStep((s) => Math.max(0, s - 1))}\n            >\n              <ArrowLeft />\n              Back\n            </Button>\n            <Button onClick={() => setStep((s) => Math.min(steps.length - 1, s + 1))}>\n              {step === steps.length - 1 ? \"Finish setup\" : \"Continue\"}\n              <ArrowRight />\n            </Button>\n          </div>\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "800px"
  },
  "categories": [
    "forms"
  ]
}