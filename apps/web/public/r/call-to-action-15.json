{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "call-to-action-15",
  "type": "registry:block",
  "description": "Inverted primary-colour band with a large headline, two buttons and a row of four headline stats.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "button"
  ],
  "files": [
    {
      "path": "registry/designali/blocks/call-to-action/call-to-action-15.tsx",
      "content": "import { ArrowRight } from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst stats = [\n  [\"2.1M\", \"invoices sent\"],\n  [\"$4.8B\", \"processed in 2025\"],\n  [\"38\", \"currencies\"],\n  [\"11 days\", \"faster payouts\"],\n]\n\nexport default function CallToAction15() {\n  return (\n    <section className=\"w-full bg-primary px-6 py-20 text-primary-foreground md:py-24\">\n      <div className=\"mx-auto max-w-6xl\">\n        <div className=\"grid gap-10 lg:grid-cols-[1.3fr_1fr] lg:items-end\">\n          <h2 className=\"text-4xl font-medium tracking-tight md:text-6xl\">\n            Get paid like the companies ten times your size.\n          </h2>\n          <div className=\"flex flex-col gap-3 sm:flex-row lg:justify-end\">\n            <Button\n              size=\"lg\"\n              variant=\"secondary\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Open a free account\n              <ArrowRight data-icon=\"inline-end\" />\n            </Button>\n            <Button\n              size=\"lg\"\n              variant=\"ghost\"\n              className=\"border-primary-foreground/30 text-primary-foreground hover:bg-primary-foreground/10 hover:text-primary-foreground\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              See pricing\n            </Button>\n          </div>\n        </div>\n        <dl className=\"mt-16 grid grid-cols-2 gap-px border-t border-primary-foreground/20 bg-primary-foreground/20 md:grid-cols-4\">\n          {stats.map(([value, label]) => (\n            <div key={label} className=\"bg-primary py-8 pr-4 pl-0 [&:nth-child(even)]:pl-6 md:[&:not(:first-child)]:pl-6\">\n              <dt className=\"sr-only\">{label}</dt>\n              <dd className=\"text-3xl font-medium tracking-tight md:text-4xl\">\n                {value}\n              </dd>\n              <dd className=\"mt-1 text-sm text-primary-foreground/70\">{label}</dd>\n            </div>\n          ))}\n        </dl>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "520px"
  },
  "categories": [
    "call-to-action"
  ]
}