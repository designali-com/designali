{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "radio-group-42",
  "type": "registry:example",
  "description": "Native form submission using the radio group's name to read the value.",
  "files": [
    {
      "path": "registry/designali/examples/radio-group/radio-group-42.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  Field,\n  FieldLabel,\n  FieldLegend,\n  FieldSet,\n} from \"@workspace/ui/components/field\"\nimport {\n  RadioGroup,\n  RadioGroupItem,\n} from \"@workspace/ui/components/radio-group\"\n\nexport default function NamedRadioFormSubmit() {\n  const [result, setResult] = React.useState<string | null>(null)\n\n  return (\n    <form\n      className=\"flex w-full max-w-sm flex-col gap-4\"\n      onSubmit={(event) => {\n        event.preventDefault()\n        const data = new FormData(event.currentTarget)\n        setResult(String(data.get(\"contact\") ?? \"\"))\n      }}\n    >\n      <FieldSet>\n        <FieldLegend variant=\"label\">Preferred contact method</FieldLegend>\n        <RadioGroup name=\"contact\" defaultValue=\"email\" required>\n          <Field orientation=\"horizontal\">\n            <RadioGroupItem value=\"email\" id=\"contact-email\" />\n            <FieldLabel htmlFor=\"contact-email\" className=\"font-normal\">\n              Email\n            </FieldLabel>\n          </Field>\n          <Field orientation=\"horizontal\">\n            <RadioGroupItem value=\"phone\" id=\"contact-phone\" />\n            <FieldLabel htmlFor=\"contact-phone\" className=\"font-normal\">\n              Phone call\n            </FieldLabel>\n          </Field>\n          <Field orientation=\"horizontal\">\n            <RadioGroupItem value=\"none\" id=\"contact-none\" />\n            <FieldLabel htmlFor=\"contact-none\" className=\"font-normal\">\n              Don&apos;t contact me\n            </FieldLabel>\n          </Field>\n        </RadioGroup>\n      </FieldSet>\n      <div className=\"flex items-center gap-3\">\n        <Button type=\"submit\" size=\"sm\">\n          Save preference\n        </Button>\n        {result && (\n          <span className=\"font-mono text-xs text-muted-foreground\">\n            contact=&quot;{result}&quot;\n          </span>\n        )}\n      </div>\n    </form>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}