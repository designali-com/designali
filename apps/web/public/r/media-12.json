{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "media-12",
  "type": "registry:block",
  "description": "Horizontal scroll of vertical 9:16 customer video testimonial reels.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "registry/designali/blocks/media/media-12.tsx",
      "content": "import { Play, Quote } from \"@designali/icons\"\n\nconst reels = [\n  {\n    name: \"Dana\",\n    role: \"Founder, Designali client\",\n    quote: \"Designali built our brand and site in weeks.\",\n    length: \"0:42\",\n    image: \"/img/ask/ask1.jpg\",\n  },\n  {\n    name: \"Kwame\",\n    role: \"Frontend developer\",\n    quote: \"The blocks cut our build time in half.\",\n    length: \"0:58\",\n    image: \"/img/ask/ask4.jpg\",\n  },\n  {\n    name: \"Lucia\",\n    role: \"Product designer\",\n    quote: \"The Figma files match the code exactly.\",\n    length: \"1:04\",\n    image: \"/img/ask/ask8.jpg\",\n  },\n  {\n    name: \"Sam\",\n    role: \"Studio client\",\n    quote: \"Ali designs and codes. It shows.\",\n    length: \"0:37\",\n    image: \"/img/ask/ask11.jpg\",\n  },\n  {\n    name: \"Mei\",\n    role: \"Designali Pro member\",\n    quote: \"4000+ icons and every one is consistent.\",\n    length: \"0:51\",\n    image: \"/img/ask/ask14.jpg\",\n  },\n]\n\nexport default function Media12() {\n  return (\n    <section className=\"w-full overflow-hidden bg-background py-20\">\n      <div className=\"mx-auto max-w-7xl px-6\">\n        <div className=\"grid gap-6 md:grid-cols-2 md:items-end\">\n          <h2 className=\"text-3xl font-semibold tracking-tight md:text-4xl\">\n            Designali clients, in their own words\n          </h2>\n          <p className=\"text-muted-foreground md:text-right\">\n            Unscripted, one-minute clips recorded by the people who build with\n            Designali every day.\n          </p>\n        </div>\n        <div className=\"-mx-6 mt-10 flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden\">\n          {reels.map((reel) => (\n            <a\n              key={reel.name}\n              href=\"#\"\n              className=\"group relative aspect-[9/16] w-[62%] shrink-0 snap-start overflow-hidden border border-border sm:w-[38%] md:w-[28%] lg:w-[calc((100%-4rem)/5)]\"\n            >\n              <img\n                src={reel.image}\n                alt={`${reel.name} on Designali`}\n                className=\"absolute inset-0 size-full object-cover transition-transform duration-700 group-hover:scale-105\"\n              />\n              <div className=\"absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-black/20\" />\n              <span className=\"absolute top-3 right-3 bg-black/50 px-1.5 py-0.5 font-sans text-[11px] text-white backdrop-blur\">\n                {reel.length}\n              </span>\n              <span className=\"absolute top-1/2 left-1/2 flex size-14 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white/20 text-white backdrop-blur-md transition group-hover:scale-110 group-hover:bg-white group-hover:text-black\">\n                <Play className=\"size-5 translate-x-0.5 fill-current\" />\n              </span>\n              <div className=\"absolute inset-x-0 bottom-0 p-4 text-white\">\n                <Quote className=\"size-4 text-white/60\" />\n                <p className=\"mt-2 text-sm leading-snug font-medium\">\n                  {reel.quote}\n                </p>\n                <div className=\"mt-4 flex items-center gap-2\">\n                  <span className=\"flex size-7 items-center justify-center rounded-full bg-white text-[10px] font-semibold text-black\">\n                    {reel.name\n                      .split(\" \")\n                      .map((n) => n[0])\n                      .join(\"\")}\n                  </span>\n                  <div className=\"min-w-0\">\n                    <p className=\"truncate text-xs font-medium\">{reel.name}</p>\n                    <p className=\"truncate text-[11px] text-white/70\">\n                      {reel.role}\n                    </p>\n                  </div>\n                </div>\n              </div>\n            </a>\n          ))}\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "800px"
  },
  "categories": [
    "media"
  ]
}