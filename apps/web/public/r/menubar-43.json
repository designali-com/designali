{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "menubar-43",
  "type": "registry:example",
  "description": "Accessibility menubar with reduce motion, high contrast and text size options applied to sample text.",
  "files": [
    {
      "path": "registry/designali/examples/menubar/menubar-43.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport { AccessibilityIcon } from \"lucide-react\"\n\nimport {\n  Menubar,\n  MenubarCheckboxItem,\n  MenubarContent,\n  MenubarGroup,\n  MenubarLabel,\n  MenubarMenu,\n  MenubarRadioGroup,\n  MenubarRadioItem,\n  MenubarSeparator,\n  MenubarTrigger,\n} from \"@workspace/ui/components/menubar\"\nimport { cn } from \"@workspace/ui/lib/utils\"\n\nexport default function AccessibilityOptionsMenubar() {\n  const [contrast, setContrast] = React.useState(false)\n  const [motion, setMotion] = React.useState(false)\n  const [textSize, setTextSize] = React.useState(\"100\")\n\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-2\">\n      <Menubar>\n        <MenubarMenu>\n          <MenubarTrigger>\n            <AccessibilityIcon className=\"me-1.5 size-3.5\" /> Accessibility\n          </MenubarTrigger>\n          <MenubarContent className=\"w-52\">\n            <MenubarGroup>\n              <MenubarCheckboxItem\n                checked={contrast}\n                onCheckedChange={setContrast}\n              >\n                High contrast\n              </MenubarCheckboxItem>\n              <MenubarCheckboxItem checked={motion} onCheckedChange={setMotion}>\n                Reduce motion\n              </MenubarCheckboxItem>\n            </MenubarGroup>\n            <MenubarSeparator />\n            <MenubarGroup>\n              <MenubarLabel inset>Text size</MenubarLabel>\n              <MenubarRadioGroup value={textSize} onValueChange={setTextSize}>\n                <MenubarRadioItem value=\"100\">100%</MenubarRadioItem>\n                <MenubarRadioItem value=\"125\">125%</MenubarRadioItem>\n                <MenubarRadioItem value=\"150\">150%</MenubarRadioItem>\n              </MenubarRadioGroup>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n      </Menubar>\n      <div\n        className={cn(\n          \"border p-3\",\n          contrast && \"border-foreground bg-foreground text-background\",\n          textSize === \"100\" && \"text-sm\",\n          textSize === \"125\" && \"text-base\",\n          textSize === \"150\" && \"text-lg\"\n        )}\n      >\n        <p className={cn(\"font-medium\", !motion && \"animate-pulse\")}>\n          Your order has shipped\n        </p>\n        <p\n          className={cn(\n            contrast ? \"\" : \"text-muted-foreground\",\n            \"text-[0.85em]\"\n          )}\n        >\n          Arrives Thursday between 9am and 1pm.\n        </p>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}