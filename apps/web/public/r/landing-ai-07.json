  "files": [
    {
      "path": "registry/designali/pages/ai/landing-ai-07/page.tsx",
      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  Bot,\n  Check,\n  Database,\n  Gauge,\n  Languages,\n  Lock,\n  Plus,\n  ScrollText,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Product\", \"Models\", \"Pricing\", \"Research\", \"Docs\"]\n\nconst logos = [\n  \"Atlas Freight\",\n  \"Nimbus\",\n  \"Parallax\",\n  \"Meridian\",\n  \"Cobalt Health\",\n  \"Fernway\",\n  \"Quanta\",\n  \"Silverpine\",\n]\n\nconst features = [\n  {\n    icon: ScrollText,\n    title: \"Full audit trail\",\n    description:\n      \"Every prompt, tool call and response is logged with user, timestamp and policy decision.\",\n  },\n  {\n    icon: Languages,\n    title: \"Multilingual\",\n    description:\n      \"Understand and reply in more than 40 languages with consistent tone and terminology.\",\n  },\n  {\n    icon: Database,\n    title: \"Grounded in your data\",\n    description:\n      \"Connect docs, tickets and wikis. Every answer cites its sources so reviewers can verify in one click.\",\n  },\n  {\n    icon: Bot,\n    title: \"Custom agents\",\n    description:\n      \"Give agents tools, instructions and guardrails, then let them handle multi-step tasks end to end.\",\n  },\n  {\n    icon: Lock,\n    title: \"Private by design\",\n    description:\n      \"Your data is never used to train models. Zero data retention options and customer-managed keys.\",\n  },\n  {\n    icon: Gauge,\n    title: \"Low-latency inference\",\n    description:\n      \"Streaming responses start in under 300ms, served from regions close to your users.\",\n  },\n]\n\nconst stats = [\n  { value: \"3.2B\", label: \"Tokens processed daily\" },\n  { value: \"280ms\", label: \"Median time to first token\" },\n  { value: \"61%\", label: \"Average cost reduction\" },\n  { value: \"9,000+\", label: \"Companies building with us\" },\n]\n\nconst steps = [\n  {\n    title: \"Connect your sources\",\n    description:\n      \"Sync Google Drive, Notion, Confluence, Zendesk and more with permission-aware connectors.\",\n  },\n  {\n    title: \"Design the assistant\",\n    description:\n      \"Write instructions, choose tools and set guardrails in a visual builder or in code.\",\n  },\n  {\n    title: \"Evaluate before launch\",\n    description:\n      \"Run test suites against real questions and compare models side by side on quality and cost.\",\n  },\n  {\n    title: \"Deploy anywhere\",\n    description:\n      \"Ship to Slack, your help center, your app or the API, and monitor every conversation live.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Support Copilot\",\n    meta: \"Drafts replies from your help center\",\n    tag: \"Popular\",\n    price: \"2 min setup\",\n  },\n  {\n    name: \"Research Agent\",\n    meta: \"Summarises accounts before sales calls\",\n    tag: \"Sales\",\n    price: \"5 min setup\",\n  },\n  {\n    name: \"Contract Reviewer\",\n    meta: \"Flags risky clauses against your playbook\",\n    tag: \"Legal\",\n    price: \"10 min setup\",\n  },\n  {\n    name: \"Data Analyst\",\n    meta: \"Answers questions in plain English with SQL\",\n    tag: \"New\",\n    price: \"8 min setup\",\n  },\n  {\n    name: \"Meeting Notes\",\n    meta: \"Action items and decisions after every call\",\n    tag: \"Popular\",\n    price: \"1 min setup\",\n  },\n  {\n    name: \"Onboarding Guide\",\n    meta: \"Answers new-hire questions from your wiki\",\n    tag: \"HR\",\n    price: \"3 min setup\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"Our support agents resolve 40% of tickets with a single suggested reply. The citations are what won over our compliance team.\",\n    name: \"Hannah Cole\",\n    role: \"Head of Support, Fernway\",\n  },\n  {\n    quote:\n      \"We evaluated six vendors. This was the only one where evals, routing and logging were first-class instead of an afterthought.\",\n    name: \"Rafael Ortiz\",\n    role: \"ML Platform Lead, Quanta\",\n  },\n  {\n    quote:\n      \"Legal approved the rollout in a week because of zero retention and the audit trail. That is unheard of here.\",\n    name: \"Grace Whitfield\",\n    role: \"General Counsel, Cobalt Health\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Free\",\n    price: \"$0\",\n    period: \"/month\",\n    description: \"For individuals exploring what AI can do.\",\n    features: [\n      \"100 messages per day\",\n      \"Standard models\",\n      \"3 connected sources\",\n      \"Community support\",\n    ],\n    cta: \"Start for free\",\n  },\n  {\n    name: \"Team\",\n    price: \"$25\",\n    period: \"/user/month\",\n    description: \"For teams deploying assistants to real workflows.\",\n    features: [\n      \"Unlimited messages\",\n      \"Frontier models and routing\",\n      \"Unlimited sources\",\n      \"Custom agents\",\n      \"Evaluations and analytics\",\n    ],\n    cta: \"Start 14-day trial\",\n  },\n  {\n    name: \"Enterprise\",\n    price: \"Custom\",\n    period: \"\",\n    description: \"For organisations with strict governance needs.\",\n    features: [\n      \"Zero data retention\",\n      \"Customer-managed keys\",\n      \"SSO, SCIM and audit logs\",\n      \"Private deployment options\",\n      \"Dedicated solutions engineer\",\n    ],\n    cta: \"Contact sales\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"Do you train models on our data?\",\n    a: \"Never. Your prompts, files and outputs are not used to train any model, and Enterprise customers can enable zero data retention.\",\n  },\n  {\n    q: \"Which models do you support?\",\n    a: \"We support leading frontier and open-weight models, and automatically route each request to the best fit for quality, latency and cost.\",\n  },\n  {\n    q: \"How do you prevent hallucinations?\",\n    a: \"Answers are grounded in your connected sources with inline citations, and evaluations let you measure accuracy before and after every change.\",\n  },\n  {\n    q: \"Can we bring our own model?\",\n    a: \"Yes. Enterprise plans can connect fine-tuned or self-hosted models through a standard OpenAI-compatible endpoint.\",\n  },\n  {\n    q: \"How is usage billed?\",\n    a: \"Team plans include generous usage per seat. Heavy API workloads are billed per million tokens with volume discounts.\",\n  },\n]\n\nconst footer = [\n  { title: \"Product\", links: [\"Assistants\", \"Agents\", \"API\", \"Pricing\"] },\n  { title: \"Company\", links: [\"About\", \"Research\", \"Careers\", \"Contact\"] },\n  {\n    title: \"Trust\",\n    links: [\"Security\", \"Privacy\", \"Responsible AI\", \"Status\"],\n  },\n]\n\nexport default function LandingAi07() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-violet-600 text-white text-sm\">\n              L\n            </span>\n            <span className=\"\">Lumen Vision</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Log in\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Book a pilot\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"relative isolate overflow-hidden border-b\">\n        <div className=\"pointer-events-none absolute inset-0 -z-10 bg-radial-[ellipse_60%_50%_at_50%_0%] from-violet-500/25 via-fuchsia-500/10 to-transparent to-70%\" />\n        <div className=\"pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,var(--border)_1px,transparent_1px),linear-gradient(to_bottom,var(--border)_1px,transparent_1px)] bg-[size:48px_48px] [mask-image:radial-gradient(ellipse_50%_45%_at_50%_0%,#000_60%,transparent_100%)]\" />\n        <div className=\"mx-auto max-w-7xl px-6 pt-20 pb-16 md:pt-32\">\n          <div className=\"mx-auto max-w-4xl space-y-8 text-center\">\n            <a\n              href=\"#\"\n              className=\"inline-flex items-center gap-2 rounded-full border bg-background/70 py-1 pr-3 pl-1 text-xs backdrop-blur\"\n            >\n              <span className=\"rounded-full bg-violet-600 px-2 py-0.5 font-medium text-white\">\n                New\n              </span>\n              <span className=\"text-muted-foreground\">\n                Edge deployment on NVIDIA Jetson now available\n              </span>\n            </a>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-8xl \">\n              {\"Catch \"}\n              <span className=\"text-violet-600 dark:text-violet-400\">\n                every defect\n              </span>\n              {\" before it ships\"}\n            </h1>\n            <p className=\"mx-auto max-w-2xl text-lg leading-8 text-muted-foreground\">\n              Lumen Vision trains inspection models on a few hundred images of\n              your parts and spots scratches, misalignments and missing\n              components on the line.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Book a pilot\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Watch it inspect\n              </Button>\n            </div>\n          </div>\n          <div className=\"relative mx-auto mt-20 max-w-5xl\">\n            <div className=\"absolute inset-x-10 -top-6 -z-10 h-24 rounded-full bg-violet-500/10 blur-2xl\" />\n            <HeroVisual />\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-12\">\n          <p className=\"text-center text-sm text-muted-foreground\">\n            Powering AI workflows at\n          </p>\n          <div className=\"mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-6 sm:grid-cols-4 lg:grid-cols-8\">\n            {logos.map((logo) => (\n              <div\n                key={logo}\n                className=\"text-center text-base font-semibold tracking-tight text-muted-foreground/70 \"\n              >\n                {logo}\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <p className=\"text-sm font-medium text-violet-600 dark:text-violet-400\">\n              Capabilities\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              AI that works where your team already works\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Grounded in your own data, governed by your own policies, and fast\n              enough to feel like part of the interface.\n            </p>\n          </div>\n          <div className=\"mt-14 grid overflow-hidden rounded-2xl border sm:grid-cols-2 lg:grid-cols-3\">\n            {features.map((feature) => (\n              <div\n                key={feature.title}\n                className=\"-mt-px -ml-px border-t border-l p-8\"\n              >\n                <feature.icon className=\"size-6 text-violet-600 dark:text-violet-400\" />\n                <h3 className=\"mt-5 font-semibold\">{feature.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl grid-cols-2 px-6 lg:grid-cols-4\">\n          {stats.slice(0, 4).map((stat, i) => (\n            <div\n              key={stat.label}\n              className={`py-12 ${i > 0 ? \"lg:border-l lg:pl-8\" : \"\"} ${i % 2 === 1 ? \"border-l pl-6 lg:pl-8\" : \"\"} `}\n            >\n              <div className=\"text-4xl font-semibold tracking-tight md:text-5xl \">\n                {stat.value}\n              </div>\n              <div className=\"mt-2 text-sm text-muted-foreground\">\n                {stat.label}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Ready-made agents for every team\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                Start from a tested template, connect your sources and deploy in\n                minutes. Every agent can be customised and audited.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a\n                key={item.name}\n                href=\"#\"\n                className=\"group flex flex-col rounded-xl border p-6 transition-colors hover:bg-muted/40\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"flex size-10 items-center justify-center rounded-lg border bg-muted/50 font-semibold \">\n                    {item.name.charAt(0)}\n                  </span>\n                  <span className=\"rounded-full bg-violet-500/10 px-2.5 py-0.5 text-xs font-medium text-violet-600 dark:text-violet-400\">\n                    {item.tag}\n                  </span>\n                </div>\n                <h3 className=\"mt-6 font-semibold \">{item.name}</h3>\n                <p className=\"mt-1 flex-1 text-sm text-muted-foreground\">\n                  {item.meta}\n                </p>\n                <div className=\"mt-6 flex items-center justify-between border-t pt-4 text-sm\">\n                  <span className=\"font-medium\">{item.price}</span>\n                  <ArrowUpRight className=\"size-4 text-muted-foreground transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5\" />\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              From first prompt to production\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-violet-600 dark:text-violet-400\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Loved by teams putting AI to real work\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-6 md:grid-cols-3\">\n            {testimonials.map((t) => (\n              <figure\n                key={t.name}\n                className=\"flex flex-col rounded-2xl border p-6\"\n              >\n                <blockquote className=\"flex-1 leading-7\">\n                  &ldquo;{t.quote}&rdquo;\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 border-t pt-6 text-sm\">\n                  <span className=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Pay for what you use\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Transparent per-seat and usage pricing. No minimums on self-serve\n              plans and volume discounts as you grow.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-violet-500 shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-violet-600 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-violet-600 dark:text-violet-400\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Frequently asked questions\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Get in touch\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"px-6 py-20 md:py-28\">\n        <div className=\"relative mx-auto max-w-6xl overflow-hidden rounded-3xl border bg-violet-500/10 px-6 py-16 text-center md:py-24\">\n          <div className=\"pointer-events-none absolute -top-24 left-1/2 size-96 -translate-x-1/2 rounded-full bg-gradient-to-b from-violet-500/25 via-fuchsia-500/10 to-transparent blur-3xl\" />\n          <div className=\"relative mx-auto max-w-2xl space-y-6\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Bring zero-defect lines within reach\n            </h2>\n            <p className=\"text-lg text-muted-foreground\">\n              Start a four-week pilot on one production line with no upfront\n              hardware cost.\n            </p>\n            <div className=\"flex flex-wrap gap-3 justify-center\">\n              <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                Book a pilot\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Watch it inspect\n              </Button>\n            </div>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-violet-600 text-white text-sm\">\n                L\n              </span>\n              <span className=\"\">Lumen Vision</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              Inspection that never blinks.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Lumen Vision. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  const bars = [38, 52, 44, 63, 58, 71, 66, 80, 74, 88, 83, 95]\n  return (\n    <div className=\"overflow-hidden rounded-xl border bg-card text-left text-card-foreground shadow-2xl/10\">\n      <div className=\"flex items-center gap-2 border-b px-4 py-3\">\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n        <span className=\"ml-3 hidden rounded-md bg-muted px-3 py-0.5 text-[11px] text-muted-foreground sm:inline\">\n          app.lumenvision.com\n        </span>\n      </div>\n      <div className=\"grid md:grid-cols-[180px_1fr]\">\n        <aside className=\"hidden space-y-1 border-r p-3 text-sm md:block\">\n          {navLinks.map((link, i) => (\n            <div\n              key={link}\n              className={`rounded-md px-3 py-1.5 ${i === 0 ? \"bg-muted font-medium\" : \"text-muted-foreground\"}`}\n            >\n              {link}\n            </div>\n          ))}\n        </aside>\n        <div className=\"space-y-4 p-4 md:p-6\">\n          <div className=\"grid grid-cols-2 gap-3 lg:grid-cols-4\">\n            {stats.slice(0, 4).map((stat) => (\n              <div key={stat.label} className=\"rounded-lg border p-3\">\n                <div className=\"truncate text-[11px] text-muted-foreground\">\n                  {stat.label}\n                </div>\n                <div className=\"mt-1 text-lg font-semibold tracking-tight\">\n                  {stat.value}\n                </div>\n              </div>\n            ))}\n          </div>\n          <div className=\"rounded-lg border p-4\">\n            <div className=\"mb-4 flex items-center justify-between text-xs\">\n              <span className=\"font-medium\">Last 12 weeks</span>\n              <span className=\"text-violet-600 dark:text-violet-400\">\n                +24.6%\n              </span>\n            </div>\n            <div className=\"flex h-32 items-end gap-1.5\">\n              {bars.map((h, i) => (\n                <div\n                  key={i}\n                  className={`flex-1 rounded-t-sm ${i === bars.length - 1 ? \"bg-violet-600\" : \"bg-muted-foreground/20\"}`}\n                  style={{ height: `${h}%` }}\n                />\n              ))}\n            </div>\n          </div>\n          <div className=\"hidden divide-y rounded-lg border sm:block\">\n            {showcase.slice(0, 3).map((item) => (\n              <div\n                key={item.name}\n                className=\"flex items-center justify-between gap-4 px-4 py-2.5 text-sm\"\n              >\n                <div className=\"min-w-0\">\n                  <div className=\"truncate font-medium\">{item.name}</div>\n                  <div className=\"truncate text-xs text-muted-foreground\">\n                    {item.meta}\n                  </div>\n                </div>\n                <span className=\"shrink-0 rounded-full bg-violet-500/10 px-2 py-0.5 text-[11px] font-medium text-violet-600 dark:text-violet-400\">\n                  {item.tag}\n                </span>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n    </div>\n  )\n}\n",
