{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "contact-19",
  "type": "registry:block",
  "description": "Compact warm-toned callback band with country code phone field, preferred time segmented control and ASAP checkbox.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "button"
  ],
  "files": [
    {
      "path": "registry/designali/blocks/contact/contact-19.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\nimport { PhoneCall } from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport { cn } from \"@workspace/ui/lib/utils\"\n\nconst codes = [\n  { code: \"+1\", label: \"US\" },\n  { code: \"+44\", label: \"UK\" },\n  { code: \"+49\", label: \"DE\" },\n  { code: \"+61\", label: \"AU\" },\n  { code: \"+91\", label: \"IN\" },\n]\n\nconst windows = [\"Morning\", \"Lunchtime\", \"Afternoon\", \"Evening\"]\n\nexport default function Contact19() {\n  const [when, setWhen] = useState(\"Afternoon\")\n  const [asap, setAsap] = useState(false)\n\n  return (\n    <section className=\"w-full bg-background py-16 md:py-20\">\n      <div className=\"mx-auto max-w-7xl px-6\">\n        <div className=\"grid gap-10 border bg-gradient-to-br from-amber-50 to-orange-100 p-6 md:p-10 lg:grid-cols-[1fr_1.4fr] lg:items-center dark:from-amber-950/40 dark:to-orange-950/30\">\n          <div className=\"flex gap-5\">\n            <span className=\"flex size-12 shrink-0 items-center justify-center rounded-full bg-orange-500 text-white\">\n              <PhoneCall className=\"size-5\" />\n            </span>\n            <div>\n              <h2 className=\"text-2xl font-semibold tracking-tight md:text-3xl\">\n                Rather talk it through?\n              </h2>\n              <p className=\"mt-2 text-sm text-muted-foreground\">\n                Leave your number and a Hearthline energy advisor will call\n                you, free of charge, at a time that suits.\n              </p>\n            </div>\n          </div>\n\n          <form className=\"space-y-4\">\n            <div className=\"flex flex-col gap-3 sm:flex-row\">\n              <div className=\"flex h-12 min-w-0 flex-1 border bg-background focus-within:border-ring\">\n                <select\n                  aria-label=\"Country code\"\n                  defaultValue=\"+44\"\n                  className=\"border-e bg-transparent px-3 text-sm outline-none\"\n                >\n                  {codes.map((c) => (\n                    <option key={c.code} value={c.code}>\n                      {c.label} {c.code}\n                    </option>\n                  ))}\n                </select>\n                <input\n                  type=\"tel\"\n                  placeholder=\"7700 900 123\"\n                  className=\"min-w-0 flex-1 bg-transparent px-3 text-sm outline-none\"\n                />\n              </div>\n              <Button type=\"submit\" size=\"lg\" className=\"h-12\">\n                Request callback\n              </Button>\n            </div>\n            <div className=\"flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between\">\n              <div\n                className={cn(\n                  \"grid grid-cols-4 border bg-background transition-opacity\",\n                  asap && \"pointer-events-none opacity-40\"\n                )}\n              >\n                {windows.map((w) => (\n                  <button\n                    key={w}\n                    type=\"button\"\n                    onClick={() => setWhen(w)}\n                    className={cn(\n                      \"h-9 px-2 text-xs transition-colors not-last:border-e sm:px-3\",\n                      when === w ? \"bg-foreground text-background\" : \"hover:bg-muted\"\n                    )}\n                  >\n                    {w}\n                  </button>\n                ))}\n              </div>\n              <label className=\"flex items-center gap-2 text-sm\">\n                <input\n                  type=\"checkbox\"\n                  checked={asap}\n                  onChange={(event) => setAsap(event.target.checked)}\n                  className=\"size-4 accent-orange-500\"\n                />\n                Call me in the next 15 minutes\n              </label>\n            </div>\n          </form>\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "400px"
  },
  "categories": [
    "contact"
  ]
}