{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "popover-40",
  "type": "registry:example",
  "description": "Chat message where an @mention opens a profile card with status and message action.",
  "files": [
    {
      "path": "registry/designali/examples/popover/popover-40.tsx",
      "content": "import { ClockIcon, MessageCircleIcon } from \"lucide-react\"\n\nimport {\n  Avatar,\n  AvatarBadge,\n  AvatarFallback,\n} from \"@workspace/ui/components/avatar\"\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  Popover,\n  PopoverContent,\n  PopoverDescription,\n  PopoverTitle,\n  PopoverTrigger,\n} from \"@workspace/ui/components/popover\"\n\nexport default function MentionCardPopover() {\n  return (\n    <div className=\"flex w-full max-w-sm gap-2 border p-3\">\n      <Avatar size=\"sm\">\n        <AvatarFallback>LR</AvatarFallback>\n      </Avatar>\n      <p className=\"text-xs leading-relaxed\">\n        <span className=\"font-medium\">Lucia Romero</span>\n        <br />\n        Can{\" \"}\n        <Popover>\n          <PopoverTrigger\n            render={\n              <button\n                type=\"button\"\n                className=\"bg-primary/10 px-0.5 font-medium text-primary hover:bg-primary/20\"\n              />\n            }\n          >\n            @tomas\n          </PopoverTrigger>\n          <PopoverContent className=\"w-64\" align=\"start\">\n            <div className=\"flex items-center gap-2.5\">\n              <Avatar size=\"lg\">\n                <AvatarFallback>TL</AvatarFallback>\n                <AvatarBadge className=\"bg-emerald-500\" />\n              </Avatar>\n              <div className=\"flex flex-col\">\n                <PopoverTitle>Tomas Lind</PopoverTitle>\n                <PopoverDescription>\n                  Staff Engineer · Platform\n                </PopoverDescription>\n              </div>\n            </div>\n            <p className=\"flex items-center gap-1.5 text-xs text-muted-foreground\">\n              <ClockIcon className=\"size-3.5\" /> 4:12 PM local time\n            </p>\n            <Button size=\"sm\" variant=\"outline\">\n              <MessageCircleIcon data-icon=\"inline-start\" /> Message\n            </Button>\n          </PopoverContent>\n        </Popover>{\" \"}\n        take a look at the flaky deploy step before Friday?\n      </p>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}