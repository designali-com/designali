{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "table-44",
  "type": "registry:example",
  "description": "A table with grouped two-level column headers using colSpan and rowSpan.",
  "files": [
    {
      "path": "registry/designali/examples/table/table-44.tsx",
      "content": "import {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from \"@workspace/ui/components/table\"\nimport { cn } from \"@workspace/ui/lib/utils\"\n\nconst rows = [\n  { team: \"Platform\", openP1: 2, openP2: 7, closedP1: 11, closedP2: 34 },\n  { team: \"Mobile\", openP1: 0, openP2: 4, closedP1: 6, closedP2: 22 },\n  { team: \"Growth\", openP1: 1, openP2: 9, closedP1: 3, closedP2: 17 },\n]\n\nexport default function MultiLevelHeaderTable() {\n  return (\n    <div className=\"w-full max-w-lg border\">\n      <Table>\n        <TableHeader>\n          <TableRow>\n            <TableHead rowSpan={2} className=\"border-e align-bottom\">\n              Team\n            </TableHead>\n            <TableHead colSpan={2} className=\"h-8 border-e text-center\">\n              Open\n            </TableHead>\n            <TableHead colSpan={2} className=\"h-8 text-center\">\n              Closed (30d)\n            </TableHead>\n          </TableRow>\n          <TableRow>\n            <TableHead className=\"h-8 text-center text-muted-foreground\">\n              P1\n            </TableHead>\n            <TableHead className=\"h-8 border-e text-center text-muted-foreground\">\n              P2\n            </TableHead>\n            <TableHead className=\"h-8 text-center text-muted-foreground\">\n              P1\n            </TableHead>\n            <TableHead className=\"h-8 text-center text-muted-foreground\">\n              P2\n            </TableHead>\n          </TableRow>\n        </TableHeader>\n        <TableBody>\n          {rows.map((r) => (\n            <TableRow key={r.team}>\n              <TableCell className=\"border-e font-medium\">{r.team}</TableCell>\n              <TableCell\n                className={cn(\n                  \"text-center tabular-nums\",\n                  r.openP1 > 0 && \"font-semibold text-destructive\"\n                )}\n              >\n                {r.openP1}\n              </TableCell>\n              <TableCell className=\"border-e text-center tabular-nums\">\n                {r.openP2}\n              </TableCell>\n              <TableCell className=\"text-center tabular-nums\">\n                {r.closedP1}\n              </TableCell>\n              <TableCell className=\"text-center tabular-nums\">\n                {r.closedP2}\n              </TableCell>\n            </TableRow>\n          ))}\n        </TableBody>\n      </Table>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}