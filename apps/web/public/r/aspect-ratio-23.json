{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "aspect-ratio-23",
  "type": "registry:example",
  "description": "A property listing with a 4:3 gradient photo, favorite button and slide dots.",
  "files": [
    {
      "path": "registry/designali/examples/aspect-ratio/aspect-ratio-23.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  Heart as HeartIcon,\n} from \"@designali/icons\"\n\nimport { AspectRatio } from \"@workspace/ui/components/aspect-ratio\"\nimport { Badge } from \"@workspace/ui/components/badge\"\nimport { Button } from \"@workspace/ui/components/button\"\nimport { cn } from \"@workspace/ui/lib/utils\"\n\nexport default function RealEstateListing() {\n  const [saved, setSaved] = React.useState(false)\n\n  return (\n    <div className=\"w-full max-w-xs\">\n      <AspectRatio\n        ratio={4 / 3}\n        className=\"overflow-hidden bg-linear-to-t from-chart-3 via-chart-1 to-primary/10\"\n      >\n        <div className=\"absolute start-[15%] bottom-[20%] h-[40%] w-[45%] bg-muted dark:bg-muted-foreground\">\n          <div className=\"absolute start-0 -top-6 h-0 w-full border-x-[4.5rem] border-b-[1.5rem] border-x-transparent border-b-border\" />\n        </div>\n        <Badge className=\"absolute start-2 top-2\">New template</Badge>\n        <Button\n          size=\"icon-sm\"\n          variant=\"secondary\"\n          aria-label={saved ? \"Remove from saved\" : \"Save template\"}\n          className=\"absolute end-2 top-2 rounded-full\"\n          onClick={() => setSaved((value) => !value)}\n        >\n          <HeartIcon className={cn(saved && \"fill-destructive text-destructive\")} />\n        </Button>\n        <div className=\"absolute inset-x-0 bottom-2 flex justify-center gap-1\">\n          {[0, 1, 2, 3].map((i) => (\n            <span\n              key={i}\n              className={cn(\n                \"size-1.5 rounded-full bg-white/60\",\n                i === 0 && \"bg-white\"\n              )}\n            />\n          ))}\n        </div>\n      </AspectRatio>\n      <div className=\"mt-2 flex items-start justify-between gap-2\">\n        <div>\n          <p className=\"text-sm font-semibold\">Resort template - $59</p>\n          <p className=\"text-xs text-muted-foreground\">\n            12 pages - Next.js - Figma file\n          </p>\n          <p className=\"text-xs text-muted-foreground\">\n            designali.com/templates\n          </p>\n        </div>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}