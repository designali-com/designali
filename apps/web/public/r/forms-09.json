{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "forms-09",
  "type": "registry:block",
  "description": "Centered two-factor verification with six-digit OTP input and resend countdown.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "button",
    "input-otp"
  ],
  "files": [
    {
      "path": "registry/designali/blocks/forms/forms-09.tsx",
      "content": "\"use client\"\n\nimport { useEffect, useState } from \"react\"\nimport { ArrowLeft, ShieldCheck } from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  InputOTP,\n  InputOTPGroup,\n  InputOTPSeparator,\n  InputOTPSlot,\n} from \"@workspace/ui/components/input-otp\"\n\nexport default function Forms09() {\n  const [code, setCode] = useState(\"\")\n  const [seconds, setSeconds] = useState(45)\n\n  useEffect(() => {\n    if (seconds <= 0) return\n    const timer = setTimeout(() => setSeconds((s) => s - 1), 1000)\n    return () => clearTimeout(timer)\n  }, [seconds])\n\n  return (\n    <section className=\"w-full bg-background py-24\">\n      <div className=\"mx-auto flex max-w-lg flex-col items-center px-6 text-center\">\n        <div className=\"flex size-14 items-center justify-center border border-border bg-muted\">\n          <ShieldCheck className=\"size-6\" />\n        </div>\n        <h2 className=\"mt-8 text-3xl font-semibold tracking-tight\">Check your phone</h2>\n        <p className=\"mt-3 text-sm leading-6 text-muted-foreground\">\n          We sent a 6-digit code to{\" \"}\n          <span className=\"font-medium text-foreground\">+44 •••• ••• 318</span>.\n          It expires in 10 minutes.\n        </p>\n\n        <form className=\"mt-10 flex w-full flex-col items-center gap-8\">\n          <InputOTP maxLength={6} value={code} onChange={setCode} aria-label=\"Verification code\">\n            <InputOTPGroup>\n              {[0, 1, 2].map((index) => (\n                <InputOTPSlot key={index} index={index} className=\"size-11 text-base sm:size-12\" />\n              ))}\n            </InputOTPGroup>\n            <InputOTPSeparator />\n            <InputOTPGroup>\n              {[3, 4, 5].map((index) => (\n                <InputOTPSlot key={index} index={index} className=\"size-11 text-base sm:size-12\" />\n              ))}\n            </InputOTPGroup>\n          </InputOTP>\n\n          <Button type=\"submit\" size=\"lg\" className=\"w-full max-w-xs\" disabled={code.length < 6}>\n            Verify and continue\n          </Button>\n        </form>\n\n        <div className=\"mt-6 text-xs text-muted-foreground\">\n          {seconds > 0 ? (\n            <span>\n              Resend code in <span className=\"font-mono text-foreground\">0:{String(seconds).padStart(2, \"0\")}</span>\n            </span>\n          ) : (\n            <button\n              type=\"button\"\n              onClick={() => setSeconds(45)}\n              className=\"text-foreground underline underline-offset-4\"\n            >\n              Resend code\n            </button>\n          )}\n        </div>\n\n        <div className=\"mt-12 w-full border-t border-border pt-6\">\n          <a\n            href=\"#\"\n            className=\"inline-flex items-center gap-2 text-xs text-muted-foreground hover:text-foreground\"\n          >\n            <ArrowLeft className=\"size-3.5\" />\n            Use a different verification method\n          </a>\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "650px"
  },
  "categories": [
    "forms"
  ]
}