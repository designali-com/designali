{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "context-menu-09",
  "type": "registry:example",
  "description": "A design canvas shape with arrange, group, and lock controls in its context menu.",
  "files": [
    {
      "path": "registry/designali/examples/context-menu/context-menu-09.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport { LockIcon } from \"lucide-react\"\n\nimport {\n  ContextMenu,\n  ContextMenuCheckboxItem,\n  ContextMenuContent,\n  ContextMenuGroup,\n  ContextMenuItem,\n  ContextMenuSeparator,\n  ContextMenuShortcut,\n  ContextMenuTrigger,\n} from \"@workspace/ui/components/context-menu\"\nimport { cn } from \"@workspace/ui/lib/utils\"\n\nexport default function CanvasShapeMenu() {\n  const [locked, setLocked] = React.useState(false)\n  const [visible, setVisible] = React.useState(true)\n\n  return (\n    <div className=\"relative h-52 w-full max-w-sm border bg-[radial-gradient(circle,var(--color-border)_1px,transparent_1px)] bg-size-[16px_16px]\">\n      <ContextMenu>\n        <ContextMenuTrigger\n          className={cn(\n            \"absolute top-10 left-10 flex size-28 items-center justify-center bg-linear-to-br from-violet-500 to-indigo-500 text-xs font-medium text-white ring-offset-2 ring-offset-background data-popup-open:ring-2 data-popup-open:ring-primary\",\n            !visible && \"opacity-30\"\n          )}\n        >\n          {locked ? <LockIcon className=\"size-4\" /> : \"Hero card\"}\n        </ContextMenuTrigger>\n        <ContextMenuContent className=\"w-52\">\n          <ContextMenuGroup>\n            <ContextMenuItem disabled={locked}>\n              Bring to front\n              <ContextMenuShortcut>⇧⌘]</ContextMenuShortcut>\n            </ContextMenuItem>\n            <ContextMenuItem disabled={locked}>\n              Send to back\n              <ContextMenuShortcut>⇧⌘[</ContextMenuShortcut>\n            </ContextMenuItem>\n          </ContextMenuGroup>\n          <ContextMenuSeparator />\n          <ContextMenuGroup>\n            <ContextMenuItem disabled={locked}>\n              Group selection\n              <ContextMenuShortcut>⌘G</ContextMenuShortcut>\n            </ContextMenuItem>\n            <ContextMenuItem disabled={locked}>\n              Create component\n              <ContextMenuShortcut>⌥⌘K</ContextMenuShortcut>\n            </ContextMenuItem>\n          </ContextMenuGroup>\n          <ContextMenuSeparator />\n          <ContextMenuGroup>\n            <ContextMenuCheckboxItem\n              checked={locked}\n              onCheckedChange={setLocked}\n            >\n              Lock layer\n            </ContextMenuCheckboxItem>\n            <ContextMenuCheckboxItem\n              checked={visible}\n              onCheckedChange={setVisible}\n            >\n              Show layer\n            </ContextMenuCheckboxItem>\n          </ContextMenuGroup>\n        </ContextMenuContent>\n      </ContextMenu>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}