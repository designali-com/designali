{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "field-19",
  "type": "registry:example",
  "description": "Sign-in form using a labeled field separator between social login and email fields.",
  "files": [
    {
      "path": "registry/designali/examples/field/field-19.tsx",
      "content": "import { KeyRoundIcon } from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  Field,\n  FieldDescription,\n  FieldGroup,\n  FieldLabel,\n  FieldSeparator,\n} from \"@workspace/ui/components/field\"\nimport { Input } from \"@workspace/ui/components/input\"\n\nexport default function SignInWithSeparator() {\n  return (\n    <form className=\"w-full max-w-xs\">\n      <FieldGroup>\n        <Field>\n          <Button variant=\"outline\" type=\"button\">\n            <KeyRoundIcon data-icon=\"inline-start\" />\n            Continue with passkey\n          </Button>\n        </Field>\n        <FieldSeparator>Or continue with email</FieldSeparator>\n        <Field>\n          <FieldLabel htmlFor=\"signin-email\">Email</FieldLabel>\n          <Input id=\"signin-email\" type=\"email\" placeholder=\"you@studio.com\" />\n        </Field>\n        <Field>\n          <div className=\"flex items-center justify-between\">\n            <FieldLabel htmlFor=\"signin-password\">Password</FieldLabel>\n            <a\n              href=\"#\"\n              className=\"text-xs text-muted-foreground underline-offset-4 hover:underline\"\n            >\n              Forgot?\n            </a>\n          </div>\n          <Input id=\"signin-password\" type=\"password\" />\n        </Field>\n        <Field>\n          <Button type=\"submit\">Sign in</Button>\n          <FieldDescription className=\"text-center\">\n            No account? <a href=\"#\">Create one</a>\n          </FieldDescription>\n        </Field>\n      </FieldGroup>\n    </form>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}