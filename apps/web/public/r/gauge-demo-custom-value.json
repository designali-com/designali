{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "gauge-demo-custom-value",
  "type": "registry:component",
  "description": "Gauge with custom value text",
  "files": [
    {
      "path": "registry/designali/components/gauge/gauge-demo-custom-value.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\n\nimport {\n  Gauge,\n  GaugeIndicator,\n  GaugeRange,\n  GaugeTrack,\n  GaugeValueText,\n} from \"@/registry/designali/ui/gauge\"\n\nexport function GaugeDemoCustomValue() {\n  return (\n    <div className=\"flex flex-wrap items-center justify-center gap-10\">\n      <Gauge value={72} getValueText={(value) => `${value} BPM`}>\n        <GaugeIndicator>\n          <GaugeTrack />\n          <GaugeRange />\n        </GaugeIndicator>\n\n        <GaugeValueText />\n      </Gauge>\n\n      <Gauge value={4} min={0} max={10} getValueText={(value) => `${value}/10`}>\n        <GaugeIndicator>\n          <GaugeTrack />\n          <GaugeRange />\n        </GaugeIndicator>\n\n        <GaugeValueText />\n      </Gauge>\n\n      <Gauge\n        value={42}\n        min={0}\n        max={60}\n        getValueText={(value) => `${value} min`}\n      >\n        <GaugeIndicator>\n          <GaugeTrack />\n          <GaugeRange />\n        </GaugeIndicator>\n\n        <GaugeValueText />\n      </Gauge>\n    </div>\n  )\n}\n",
      "type": "registry:component"
    }
  ]
}