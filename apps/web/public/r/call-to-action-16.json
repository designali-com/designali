{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "call-to-action-16",
  "type": "registry:block",
  "description": "Floating dismissible promo banner with icon, offer copy, claim button and countdown progress strip.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "button"
  ],
  "files": [
    {
      "path": "registry/designali/blocks/call-to-action/call-to-action-16.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\nimport {\n  ArrowRight,\n  Gift,\n  X,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nexport default function CallToAction16() {\n  const [open, setOpen] = useState(true)\n\n  return (\n    <section className=\"relative flex min-h-[420px] w-full flex-col justify-end bg-muted/40 px-4 py-6 md:px-6\">\n      <div className=\"mx-auto mb-auto w-full max-w-6xl pt-10 text-center text-sm text-muted-foreground\">\n        {open ? \"Page content sits here. The banner floats above it.\" : (\n          <button\n            type=\"button\"\n            onClick={() => setOpen(true)}\n            className=\"underline underline-offset-4 hover:text-foreground\"\n          >\n            Show the offer banner again\n          </button>\n        )}\n      </div>\n      {open && (\n        <div className=\"mx-auto w-full max-w-4xl border border-border bg-background shadow-lg\">\n          <div className=\"flex flex-col gap-4 p-4 sm:flex-row sm:items-center md:p-5\">\n            <div className=\"flex items-start gap-3 sm:items-center\">\n              <span className=\"flex size-10 shrink-0 items-center justify-center bg-gradient-to-br from-primary to-primary text-white\">\n                <Gift className=\"size-5\" />\n              </span>\n              <div className=\"min-w-0\">\n                <p className=\"text-sm font-medium\">\n                  Winter release: 40% off Designali Pro annual plans\n                </p>\n                <p className=\"text-xs text-muted-foreground\">\n                  Ends Sunday at midnight. Applies to new and upgrading teams.\n                </p>\n              </div>\n            </div>\n            <div className=\"flex items-center gap-2 sm:ml-auto\">\n              <Button\n                className=\"flex-1 sm:flex-none\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Claim offer\n                <ArrowRight data-icon=\"inline-end\" />\n              </Button>\n              <Button\n                variant=\"ghost\"\n                size=\"icon-lg\"\n                aria-label=\"Dismiss\"\n                onClick={() => setOpen(false)}\n              >\n                <X />\n              </Button>\n            </div>\n          </div>\n          <div className=\"h-1 w-full bg-muted\">\n            <div className=\"h-full w-2/3 bg-gradient-to-r from-primary to-primary\" />\n          </div>\n        </div>\n      )}\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "420px"
  },
  "categories": [
    "call-to-action"
  ]
}