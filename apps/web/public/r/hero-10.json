{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "hero-10",
  "type": "registry:block",
  "description": "Developer hero with a tabbed package-manager install command, copy button and a terminal deploy preview.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "button"
  ],
  "files": [
    {
      "path": "registry/designali/blocks/hero/hero-10.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\nimport { ArrowRight, Check, Copy, Terminal } from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst managers = [\n  { id: \"npm\", command: \"npm install @relay/cli\" },\n  { id: \"pnpm\", command: \"pnpm add @relay/cli\" },\n  { id: \"bun\", command: \"bun add @relay/cli\" },\n  { id: \"brew\", command: \"brew install relay\" },\n]\n\nconst output = [\n  { text: \"$ relay deploy --prod\", tone: \"text-foreground\" },\n  { text: \"Bundling 214 modules in 0.8s\", tone: \"text-muted-foreground\" },\n  { text: \"Uploading to 31 edge regions\", tone: \"text-muted-foreground\" },\n  { text: \"Running health checks... passed\", tone: \"text-muted-foreground\" },\n  { text: \"Live at https://acme-shop.relay.run\", tone: \"text-emerald-600 dark:text-emerald-400\" },\n]\n\nexport default function Hero10() {\n  const [active, setActive] = useState(managers[0]!.id)\n  const [copied, setCopied] = useState(false)\n  const current = managers.find((manager) => manager.id === active) ?? managers[0]!\n\n  function copy() {\n    navigator.clipboard?.writeText(current.command).catch(() => {})\n    setCopied(true)\n    setTimeout(() => setCopied(false), 1600)\n  }\n\n  return (\n    <section className=\"w-full bg-background px-6 py-16 md:py-24\">\n      <div className=\"mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[1fr_1.1fr]\">\n        <div className=\"min-w-0\">\n          <p className=\"inline-flex items-center gap-2 font-mono text-xs text-muted-foreground\">\n            <Terminal className=\"size-3.5\" />\n            relay v4.2 / open source / MIT\n          </p>\n          <h1 className=\"mt-6 text-4xl font-medium tracking-tight md:text-6xl\">\n            Ship to the edge with one command.\n          </h1>\n          <p className=\"mt-6 max-w-lg text-base leading-7 text-muted-foreground\">\n            Relay turns any Node, Deno or static project into a globally\n            distributed deployment. No YAML, no dashboards, no cold starts.\n          </p>\n          <div className=\"mt-8 max-w-lg border border-border\">\n            <div className=\"flex overflow-x-auto border-b border-border\">\n              {managers.map((manager) => (\n                <button\n                  key={manager.id}\n                  type=\"button\"\n                  onClick={() => {\n                    setActive(manager.id)\n                    setCopied(false)\n                  }}\n                  className={\n                    manager.id === active\n                      ? \"border-b-2 border-foreground px-4 py-2 font-mono text-xs text-foreground\"\n                      : \"border-b-2 border-transparent px-4 py-2 font-mono text-xs text-muted-foreground hover:text-foreground\"\n                  }\n                >\n                  {manager.id}\n                </button>\n              ))}\n            </div>\n            <div className=\"flex items-center gap-3 bg-muted/40 px-4 py-3\">\n              <span className=\"font-mono text-sm text-muted-foreground\">$</span>\n              <code className=\"min-w-0 flex-1 truncate font-mono text-sm\">\n                {current.command}\n              </code>\n              <button\n                type=\"button\"\n                onClick={copy}\n                aria-label=\"Copy install command\"\n                className=\"text-muted-foreground transition-colors hover:text-foreground\"\n              >\n                {copied ? <Check className=\"size-4\" /> : <Copy className=\"size-4\" />}\n              </button>\n            </div>\n          </div>\n          <div className=\"mt-8 flex flex-wrap gap-3\">\n            <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n              Read the quickstart\n              <ArrowRight />\n            </Button>\n            <Button size=\"lg\" variant=\"outline\" nativeButton={false} render={<a href=\"#\" />}>\n              Browse the source\n            </Button>\n          </div>\n        </div>\n        <div className=\"min-w-0 border border-border bg-card\">\n          <div className=\"flex items-center gap-2 border-b border-border px-4 py-3\">\n            <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n            <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n            <span className=\"size-2.5 rounded-full bg-muted-foreground/30\" />\n            <span className=\"ms-3 font-mono text-xs text-muted-foreground\">\n              ~/projects/acme-shop\n            </span>\n          </div>\n          <div className=\"space-y-2 overflow-x-auto p-5 font-mono text-xs leading-6 sm:text-sm\">\n            {output.map((line) => (\n              <p key={line.text} className={`whitespace-nowrap ${line.tone}`}>\n                {line.text}\n              </p>\n            ))}\n            <p className=\"whitespace-nowrap text-foreground\">\n              $ <span className=\"inline-block h-4 w-2 translate-y-0.5 animate-pulse bg-foreground\" />\n            </p>\n          </div>\n          <div className=\"grid grid-cols-3 border-t border-border text-center\">\n            {[\n              [\"31\", \"regions\"],\n              [\"12ms\", \"p50 latency\"],\n              [\"0\", \"config files\"],\n            ].map(([value, label]) => (\n              <div key={label} className=\"border-e border-border px-2 py-4 last:border-e-0\">\n                <p className=\"text-lg font-medium\">{value}</p>\n                <p className=\"text-xs text-muted-foreground\">{label}</p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "720px"
  },
  "categories": [
    "hero"
  ]
}