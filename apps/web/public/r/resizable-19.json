{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "resizable-19",
  "type": "registry:example",
  "description": "Dashboard of nested resizable groups forming a 2x2 widget grid.",
  "files": [
    {
      "path": "registry/designali/examples/resizable/resizable-19.tsx",
      "content": "import {\n  ResizableHandle,\n  ResizablePanel,\n  ResizablePanelGroup,\n} from \"@workspace/ui/components/resizable\"\n\nfunction Stat({\n  label,\n  value,\n  delta,\n}: {\n  label: string\n  value: string\n  delta: string\n}) {\n  return (\n    <div className=\"flex h-full flex-col justify-between p-3\">\n      <span className=\"text-xs text-muted-foreground\">{label}</span>\n      <div className=\"flex items-end justify-between gap-2\">\n        <span className=\"text-xl font-semibold tabular-nums\">{value}</span>\n        <span className=\"text-xs text-primary dark:text-primary\">\n          {delta}\n        </span>\n      </div>\n    </div>\n  )\n}\n\nexport default function DashboardWidgetGrid() {\n  return (\n    <ResizablePanelGroup\n      orientation=\"vertical\"\n      className=\"h-72 w-full max-w-lg border\"\n    >\n      <ResizablePanel defaultSize=\"50%\" minSize=\"25%\">\n        <ResizablePanelGroup orientation=\"horizontal\">\n          <ResizablePanel defaultSize=\"50%\" minSize=\"25%\">\n            <Stat label=\"Revenue\" value=\"$48.2k\" delta=\"+12%\" />\n          </ResizablePanel>\n          <ResizableHandle />\n          <ResizablePanel defaultSize=\"50%\" minSize=\"25%\">\n            <Stat label=\"Active users\" value=\"3,912\" delta=\"+4%\" />\n          </ResizablePanel>\n        </ResizablePanelGroup>\n      </ResizablePanel>\n      <ResizableHandle withHandle />\n      <ResizablePanel defaultSize=\"50%\" minSize=\"25%\">\n        <ResizablePanelGroup orientation=\"horizontal\">\n          <ResizablePanel defaultSize=\"50%\" minSize=\"25%\">\n            <Stat label=\"Churn\" value=\"1.8%\" delta=\"-0.3%\" />\n          </ResizablePanel>\n          <ResizableHandle />\n          <ResizablePanel defaultSize=\"50%\" minSize=\"25%\">\n            <Stat label=\"NPS\" value=\"62\" delta=\"+5\" />\n          </ResizablePanel>\n        </ResizablePanelGroup>\n      </ResizablePanel>\n    </ResizablePanelGroup>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}