{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "menubar-03",
  "type": "registry:example",
  "description": "Word-processor menubar with File, Edit, Format and Insert menus and keyboard shortcuts.",
  "files": [
    {
      "path": "registry/designali/examples/menubar/menubar-03.tsx",
      "content": "import {\n  BoldIcon,\n  ItalicIcon,\n  LinkIcon,\n  MessageSquareIcon,\n  MinusIcon,\n  RemoveFormattingIcon,\n  TableIcon,\n  UnderlineIcon,\n} from \"lucide-react\"\n\nimport {\n  Menubar,\n  MenubarContent,\n  MenubarGroup,\n  MenubarItem,\n  MenubarMenu,\n  MenubarSeparator,\n  MenubarShortcut,\n  MenubarTrigger,\n} from \"@workspace/ui/components/menubar\"\n\nexport default function DocumentEditorMenubar() {\n  return (\n    <div className=\"w-full max-w-md\">\n      <Menubar>\n        <MenubarMenu>\n          <MenubarTrigger>File</MenubarTrigger>\n          <MenubarContent>\n            <MenubarGroup>\n              <MenubarItem>\n                New document <MenubarShortcut>⌘N</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>\n                Open... <MenubarShortcut>⌘O</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>Make a copy</MenubarItem>\n            </MenubarGroup>\n            <MenubarSeparator />\n            <MenubarGroup>\n              <MenubarItem>\n                Download as PDF <MenubarShortcut>⇧⌘D</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>Version history</MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>Edit</MenubarTrigger>\n          <MenubarContent>\n            <MenubarGroup>\n              <MenubarItem>\n                Undo typing <MenubarShortcut>⌘Z</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>\n                Find and replace <MenubarShortcut>⇧⌘H</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>\n                Select all <MenubarShortcut>⌘A</MenubarShortcut>\n              </MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>Format</MenubarTrigger>\n          <MenubarContent>\n            <MenubarGroup>\n              <MenubarItem>\n                <BoldIcon /> Bold <MenubarShortcut>⌘B</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>\n                <ItalicIcon /> Italic <MenubarShortcut>⌘I</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>\n                <UnderlineIcon /> Underline{\" \"}\n                <MenubarShortcut>⌘U</MenubarShortcut>\n              </MenubarItem>\n            </MenubarGroup>\n            <MenubarSeparator />\n            <MenubarGroup>\n              <MenubarItem>\n                <RemoveFormattingIcon /> Clear formatting\n              </MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>Insert</MenubarTrigger>\n          <MenubarContent>\n            <MenubarGroup>\n              <MenubarItem>\n                <TableIcon /> Table\n              </MenubarItem>\n              <MenubarItem>\n                <LinkIcon /> Link <MenubarShortcut>⌘K</MenubarShortcut>\n              </MenubarItem>\n              <MenubarItem>\n                <MinusIcon /> Horizontal line\n              </MenubarItem>\n              <MenubarItem>\n                <MessageSquareIcon /> Comment{\" \"}\n                <MenubarShortcut>⌥⌘M</MenubarShortcut>\n              </MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n      </Menubar>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}