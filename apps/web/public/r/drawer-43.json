{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "drawer-43",
  "type": "registry:example",
  "description": "Restaurant bill drawer with tip presets, split count and live per-person totals.",
  "files": [
    {
      "path": "registry/designali/examples/drawer/drawer-43.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  Minus as MinusIcon,\n  Plus as PlusIcon,\n  Receipt as ReceiptIcon,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  Drawer,\n  DrawerClose,\n  DrawerContent,\n  DrawerDescription,\n  DrawerFooter,\n  DrawerHeader,\n  DrawerTitle,\n  DrawerTrigger,\n} from \"@workspace/ui/components/drawer\"\nimport {\n  ToggleGroup,\n  ToggleGroupItem,\n} from \"@workspace/ui/components/toggle-group\"\n\nconst bill = 86.4\nconst tips = [\"10\", \"15\", \"18\", \"20\"]\n\nexport default function SplitBillDrawer() {\n  const [tip, setTip] = React.useState<string[]>([\"18\"])\n  const [people, setPeople] = React.useState(3)\n  const tipAmount = bill * (Number(tip[0] ?? 0) / 100)\n  const total = bill + tipAmount\n\n  return (\n    <Drawer>\n      <DrawerTrigger render={<Button />}>\n        <ReceiptIcon data-icon=\"inline-start\" />\n        Split the bill\n      </DrawerTrigger>\n      <DrawerContent>\n        <div className=\"mx-auto flex w-full max-w-sm flex-col\">\n          <DrawerHeader>\n            <DrawerTitle>Designali studio lunch</DrawerTitle>\n            <DrawerDescription>\n              Bill before tip: {\"$\" + bill.toFixed(2)}\n            </DrawerDescription>\n          </DrawerHeader>\n          <div className=\"flex flex-col gap-4 p-4\">\n            <div className=\"flex flex-col gap-2\">\n              <p className=\"font-medium\">Tip</p>\n              <ToggleGroup\n                variant=\"outline\"\n                value={tip}\n                onValueChange={(value) => setTip(value.map(String))}\n                className=\"grid w-full grid-cols-4\"\n              >\n                {tips.map((item) => (\n                  <ToggleGroupItem key={item} value={item}>\n                    {item}%\n                  </ToggleGroupItem>\n                ))}\n              </ToggleGroup>\n            </div>\n            <div className=\"flex items-center justify-between\">\n              <p className=\"font-medium\">Split between</p>\n              <div className=\"flex items-center gap-2\">\n                <Button\n                  variant=\"outline\"\n                  size=\"icon-sm\"\n                  aria-label=\"Fewer people\"\n                  disabled={people <= 1}\n                  onClick={() => setPeople(people - 1)}\n                >\n                  <MinusIcon />\n                </Button>\n                <span className=\"w-6 text-center tabular-nums\">{people}</span>\n                <Button\n                  variant=\"outline\"\n                  size=\"icon-sm\"\n                  aria-label=\"More people\"\n                  onClick={() => setPeople(people + 1)}\n                >\n                  <PlusIcon />\n                </Button>\n              </div>\n            </div>\n            <div className=\"flex flex-col gap-1 border bg-muted/40 p-3 tabular-nums\">\n              <div className=\"flex justify-between\">\n                <span className=\"text-muted-foreground\">Tip</span>\n                <span>{\"$\" + tipAmount.toFixed(2)}</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-muted-foreground\">Total</span>\n                <span>{\"$\" + total.toFixed(2)}</span>\n              </div>\n              <div className=\"flex justify-between font-heading text-base font-semibold\">\n                <span>Each pays</span>\n                <span>{\"$\" + (total / people).toFixed(2)}</span>\n              </div>\n            </div>\n          </div>\n          <DrawerFooter>\n            <DrawerClose render={<Button />}>Request payments</DrawerClose>\n          </DrawerFooter>\n        </div>\n      </DrawerContent>\n    </Drawer>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}