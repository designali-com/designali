{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "aspect-ratio-13",
  "type": "registry:example",
  "description": "A 16:9 dashboard panel holding a responsive SVG area chart.",
  "files": [
    {
      "path": "registry/designali/examples/aspect-ratio/aspect-ratio-13.tsx",
      "content": "import { AspectRatio } from \"@workspace/ui/components/aspect-ratio\"\nimport { Badge } from \"@workspace/ui/components/badge\"\n\nconst points = [32, 40, 36, 52, 48, 64, 58, 72, 70, 84, 78, 92]\n\nexport default function ChartPanelWide() {\n  const max = 100\n  const path = points\n    .map(\n      (value, index) =>\n        (index === 0 ? \"M\" : \"L\") +\n        (index / (points.length - 1)) * 100 +\n        \" \" +\n        (max - value)\n    )\n    .join(\" \")\n\n  return (\n    <div className=\"w-full max-w-md border p-4\">\n      <div className=\"mb-3 flex items-baseline justify-between\">\n        <div>\n          <p className=\"text-xs text-muted-foreground\">\n            Monthly recurring revenue\n          </p>\n          <p className=\"text-xl font-semibold tabular-nums\">$92.4k</p>\n        </div>\n        <Badge variant=\"secondary\">+12.6%</Badge>\n      </div>\n      <AspectRatio ratio={16 / 9}>\n        <svg\n          viewBox=\"0 0 100 100\"\n          preserveAspectRatio=\"none\"\n          className=\"absolute inset-0 size-full text-primary\"\n          aria-hidden=\"true\"\n        >\n          {[25, 50, 75].map((y) => (\n            <line\n              key={y}\n              x1=\"0\"\n              x2=\"100\"\n              y1={y}\n              y2={y}\n              className=\"stroke-border\"\n              strokeWidth=\"0.5\"\n              vectorEffect=\"non-scaling-stroke\"\n            />\n          ))}\n          <path d={path + \" L100 100 L0 100 Z\"} className=\"fill-primary/10\" />\n          <path\n            d={path}\n            fill=\"none\"\n            stroke=\"currentColor\"\n            strokeWidth=\"2\"\n            vectorEffect=\"non-scaling-stroke\"\n          />\n        </svg>\n      </AspectRatio>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}