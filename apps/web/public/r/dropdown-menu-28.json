{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dropdown-menu-28",
  "type": "registry:example",
  "description": "Project card with progress and a corner menu for favorite, settings, and leave actions.",
  "files": [
    {
      "path": "registry/designali/examples/dropdown-menu/dropdown-menu-28.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  LogOut as LogOutIcon,\n  Ellipsis as MoreHorizontalIcon,\n  Settings as SettingsIcon,\n  Star as StarIcon,\n  UserPlus as UserPlusIcon,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from \"@workspace/ui/components/dropdown-menu\"\n\nexport default function ProjectCardMenu() {\n  const [favorite, setFavorite] = React.useState(false)\n\n  return (\n    <div className=\"flex w-full max-w-xs flex-col gap-3 border p-4\">\n      <div className=\"flex items-start justify-between gap-2\">\n        <div className=\"flex items-center gap-2\">\n          <span className=\"size-8 bg-gradient-to-br from-primary to-primary\" />\n          <div>\n            <p className=\"flex items-center gap-1 text-xs font-medium\">\n              Designali website\n              {favorite && (\n                <StarIcon className=\"size-3 fill-primary text-primary\" />\n              )}\n            </p>\n            <p className=\"text-xs text-muted-foreground\">\n              12 tasks · 4 members\n            </p>\n          </div>\n        </div>\n        <DropdownMenu>\n          <DropdownMenuTrigger\n            render={\n              <Button\n                variant=\"ghost\"\n                size=\"icon-xs\"\n                aria-label=\"Project menu\"\n              />\n            }\n          >\n            <MoreHorizontalIcon />\n          </DropdownMenuTrigger>\n          <DropdownMenuContent align=\"end\" className=\"w-44\">\n            <DropdownMenuItem onClick={() => setFavorite(!favorite)}>\n              <StarIcon />\n              {favorite ? \"Remove favorite\" : \"Add to favorites\"}\n            </DropdownMenuItem>\n            <DropdownMenuItem>\n              <SettingsIcon />\n              Project settings\n            </DropdownMenuItem>\n            <DropdownMenuItem>\n              <UserPlusIcon />\n              Invite members\n            </DropdownMenuItem>\n            <DropdownMenuSeparator />\n            <DropdownMenuItem variant=\"destructive\">\n              <LogOutIcon />\n              Leave project\n            </DropdownMenuItem>\n          </DropdownMenuContent>\n        </DropdownMenu>\n      </div>\n      <div className=\"h-1.5 bg-muted\">\n        <div className=\"h-full w-2/3 bg-primary\" />\n      </div>\n      <p className=\"text-xs text-muted-foreground\">68% complete · Due Nov 28</p>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}