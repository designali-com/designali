{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "badge-47",
  "type": "registry:example",
  "description": "Badges placed inline with section headings and buttons to show totals.",
  "files": [
    {
      "path": "registry/designali/examples/badge/badge-47.tsx",
      "content": "import { FilterIcon } from \"lucide-react\"\n\nimport { Badge } from \"@workspace/ui/components/badge\"\nimport { Button } from \"@workspace/ui/components/button\"\n\nexport default function InlineHeadingCountBadges() {\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-4\">\n      <div className=\"flex items-center justify-between\">\n        <h3 className=\"flex items-center gap-2 text-base font-semibold\">\n          Pending approvals\n          <Badge variant=\"secondary\" className=\"tabular-nums\">\n            8\n          </Badge>\n        </h3>\n        <Button size=\"sm\" variant=\"outline\">\n          Review all\n          <Badge className=\"h-4 px-1 text-[10px]\">8</Badge>\n        </Button>\n      </div>\n      <div className=\"flex items-center gap-2\">\n        <Button size=\"sm\">\n          <FilterIcon data-icon=\"inline-start\" />\n          Filters\n          <Badge variant=\"secondary\" className=\"h-4 px-1 text-[10px]\">\n            3\n          </Badge>\n        </Button>\n        <Button size=\"sm\" variant=\"ghost\">\n          Archived\n          <Badge variant=\"outline\" className=\"h-4 px-1 text-[10px]\">\n            42\n          </Badge>\n        </Button>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}