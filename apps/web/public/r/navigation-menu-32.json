{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "navigation-menu-32",
  "type": "registry:example",
  "description": "Fitness app navigation with workout programs showing duration and intensity.",
  "files": [
    {
      "path": "registry/designali/examples/navigation-menu/navigation-menu-32.tsx",
      "content": "import { DumbbellIcon, FootprintsIcon, SunriseIcon } from \"lucide-react\"\n\nimport {\n  NavigationMenu,\n  NavigationMenuContent,\n  NavigationMenuItem,\n  NavigationMenuLink,\n  NavigationMenuList,\n  NavigationMenuTrigger,\n  navigationMenuTriggerStyle,\n} from \"@workspace/ui/components/navigation-menu\"\nimport { cn } from \"@workspace/ui/lib/utils\"\n\nconst programs = [\n  { title: \"Strength foundations\", weeks: 6, intensity: 2, icon: DumbbellIcon },\n  { title: \"Morning yoga flow\", weeks: 4, intensity: 1, icon: SunriseIcon },\n  { title: \"Couch to 10K\", weeks: 10, intensity: 3, icon: FootprintsIcon },\n]\n\nexport default function FitnessProgramsNav() {\n  return (\n    <NavigationMenu>\n      <NavigationMenuList>\n        <NavigationMenuItem>\n          <NavigationMenuTrigger>Programs</NavigationMenuTrigger>\n          <NavigationMenuContent>\n            <ul className=\"flex w-72 flex-col gap-1\">\n              {programs.map((p) => (\n                <li key={p.title}>\n                  <NavigationMenuLink href=\"#\" className=\"gap-3\">\n                    <span className=\"flex size-8 shrink-0 items-center justify-center bg-orange-500/10 text-orange-600 dark:text-orange-400\">\n                      <p.icon />\n                    </span>\n                    <span className=\"flex flex-1 flex-col\">\n                      <span className=\"font-medium\">{p.title}</span>\n                      <span className=\"text-muted-foreground\">\n                        {p.weeks} weeks\n                      </span>\n                    </span>\n                    <span\n                      className=\"flex gap-0.5\"\n                      aria-label={\"Intensity \" + p.intensity + \" of 3\"}\n                    >\n                      {[1, 2, 3].map((n) => (\n                        <span\n                          key={n}\n                          className={cn(\n                            \"h-3 w-1\",\n                            n <= p.intensity ? \"bg-orange-500\" : \"bg-muted\"\n                          )}\n                        />\n                      ))}\n                    </span>\n                  </NavigationMenuLink>\n                </li>\n              ))}\n            </ul>\n          </NavigationMenuContent>\n        </NavigationMenuItem>\n        <NavigationMenuItem>\n          <NavigationMenuLink href=\"#\" className={navigationMenuTriggerStyle()}>\n            Coaches\n          </NavigationMenuLink>\n        </NavigationMenuItem>\n      </NavigationMenuList>\n    </NavigationMenu>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}