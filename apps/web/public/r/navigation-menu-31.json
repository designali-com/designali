{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "navigation-menu-31",
  "type": "registry:example",
  "description": "Community menu with forum, events and a contributors row of stacked avatar initials.",
  "files": [
    {
      "path": "registry/designali/examples/navigation-menu/navigation-menu-31.tsx",
      "content": "import { AwardIcon, CalendarDaysIcon, MessagesSquareIcon } from \"lucide-react\"\n\nimport { Avatar, AvatarFallback } from \"@workspace/ui/components/avatar\"\nimport {\n  NavigationMenu,\n  NavigationMenuContent,\n  NavigationMenuItem,\n  NavigationMenuLink,\n  NavigationMenuList,\n  NavigationMenuTrigger,\n  navigationMenuTriggerStyle,\n} from \"@workspace/ui/components/navigation-menu\"\n\nconst contributors = [\"AK\", \"BM\", \"CS\", \"DL\", \"EF\"]\n\nexport default function CommunityNav() {\n  return (\n    <NavigationMenu>\n      <NavigationMenuList>\n        <NavigationMenuItem>\n          <NavigationMenuTrigger>Community</NavigationMenuTrigger>\n          <NavigationMenuContent>\n            <div className=\"flex w-64 flex-col gap-1\">\n              <NavigationMenuLink href=\"#\">\n                <MessagesSquareIcon /> Discussion forum\n              </NavigationMenuLink>\n              <NavigationMenuLink href=\"#\">\n                <CalendarDaysIcon /> Meetups & events\n              </NavigationMenuLink>\n              <NavigationMenuLink href=\"#\">\n                <AwardIcon /> Champions program\n              </NavigationMenuLink>\n              <NavigationMenuLink\n                href=\"#\"\n                className=\"mt-1 justify-between border-t pt-2.5\"\n              >\n                <span className=\"flex -space-x-1.5\">\n                  {contributors.map((c) => (\n                    <Avatar key={c} className=\"size-6 ring-2 ring-popover\">\n                      <AvatarFallback className=\"text-[9px]\">\n                        {c}\n                      </AvatarFallback>\n                    </Avatar>\n                  ))}\n                </span>\n                <span className=\"text-muted-foreground\">2.4k contributors</span>\n              </NavigationMenuLink>\n            </div>\n          </NavigationMenuContent>\n        </NavigationMenuItem>\n        <NavigationMenuItem>\n          <NavigationMenuLink href=\"#\" className={navigationMenuTriggerStyle()}>\n            Blog\n          </NavigationMenuLink>\n        </NavigationMenuItem>\n      </NavigationMenuList>\n    </NavigationMenu>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}