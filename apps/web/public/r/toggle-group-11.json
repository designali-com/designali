{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "toggle-group-11",
  "type": "registry:example",
  "description": "A whole group disabled while a document is locked by another editor.",
  "files": [
    {
      "path": "registry/designali/examples/toggle-group/toggle-group-11.tsx",
      "content": "import { EyeIcon, LockIcon, MessageSquareIcon, PencilIcon } from \"lucide-react\"\n\nimport {\n  ToggleGroup,\n  ToggleGroupItem,\n} from \"@workspace/ui/components/toggle-group\"\n\nexport default function DisabledToggleGroup() {\n  return (\n    <div className=\"flex w-full max-w-xs flex-col gap-2\">\n      <ToggleGroup\n        disabled\n        variant=\"outline\"\n        spacing={0}\n        defaultValue={[\"edit\"]}\n      >\n        <ToggleGroupItem value=\"view\">\n          <EyeIcon data-icon=\"inline-start\" />\n          View\n        </ToggleGroupItem>\n        <ToggleGroupItem value=\"edit\">\n          <PencilIcon data-icon=\"inline-start\" />\n          Edit\n        </ToggleGroupItem>\n        <ToggleGroupItem value=\"suggest\">\n          <MessageSquareIcon data-icon=\"inline-start\" />\n          Suggest\n        </ToggleGroupItem>\n      </ToggleGroup>\n      <p className=\"flex items-center gap-1.5 text-xs text-muted-foreground\">\n        <LockIcon className=\"size-3\" />\n        Locked while Priya Raman is editing.\n      </p>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}