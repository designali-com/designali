{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "aspect-ratio-45",
  "type": "registry:example",
  "description": "A podcast episode item with fixed square artwork beside flexible text.",
  "files": [
    {
      "path": "registry/designali/examples/aspect-ratio/aspect-ratio-45.tsx",
      "content": "import { MicIcon, PlayIcon } from \"lucide-react\"\n\nimport { AspectRatio } from \"@workspace/ui/components/aspect-ratio\"\nimport { Button } from \"@workspace/ui/components/button\"\n\nexport default function PodcastEpisodeRow() {\n  return (\n    <div className=\"flex w-full max-w-md items-center gap-3 border p-3\">\n      <div className=\"w-16 shrink-0\">\n        <AspectRatio\n          ratio={1}\n          className=\"bg-linear-to-br from-teal-400 to-indigo-700\"\n        >\n          <MicIcon className=\"absolute start-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 text-white rtl:translate-x-1/2\" />\n        </AspectRatio>\n      </div>\n      <div className=\"min-w-0 flex-1\">\n        <p className=\"text-[10px] text-muted-foreground uppercase\">\n          Ep. 112 - May 3\n        </p>\n        <p className=\"truncate text-sm font-medium\">\n          Pricing is a product decision\n        </p>\n        <p className=\"truncate text-xs text-muted-foreground\">\n          Small Batch with Ruth Adeyemi\n        </p>\n      </div>\n      <Button\n        size=\"icon-sm\"\n        variant=\"outline\"\n        aria-label=\"Play episode\"\n        className=\"rounded-full\"\n      >\n        <PlayIcon />\n      </Button>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}