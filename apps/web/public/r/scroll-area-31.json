{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "scroll-area-31",
  "type": "registry:example",
  "description": "Scroll area filled with skeleton rows while results load.",
  "files": [
    {
      "path": "registry/designali/examples/scroll-area/scroll-area-31.tsx",
      "content": "import { ScrollArea } from \"@workspace/ui/components/scroll-area\"\nimport { Skeleton } from \"@workspace/ui/components/skeleton\"\nimport { Spinner } from \"@workspace/ui/components/spinner\"\n\nexport default function SkeletonLoadingList() {\n  return (\n    <div className=\"w-full max-w-sm border\">\n      <div className=\"flex items-center gap-2 border-b px-3 py-2 text-xs text-muted-foreground\">\n        <Spinner />\n        Loading contacts...\n      </div>\n      <ScrollArea className=\"h-64\">\n        <div className=\"flex flex-col gap-4 p-3\">\n          {Array.from({ length: 9 }, (_, i) => (\n            <div key={i} className=\"flex items-center gap-3\">\n              <Skeleton className=\"size-8 shrink-0 rounded-full\" />\n              <div className=\"flex flex-1 flex-col gap-1.5\">\n                <Skeleton\n                  className=\"h-2.5\"\n                  style={{ width: 50 + ((i * 17) % 40) + \"%\" }}\n                />\n                <Skeleton className=\"h-2 w-1/3\" />\n              </div>\n            </div>\n          ))}\n        </div>\n      </ScrollArea>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}