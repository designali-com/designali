{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "context-menu-38",
  "type": "registry:example",
  "description": "A commit history list with copy SHA, checkout, cherry-pick, and revert actions.",
  "files": [
    {
      "path": "registry/designali/examples/context-menu/context-menu-38.tsx",
      "content": "import {\n  ArrowLeftRightIcon,\n  CherryIcon,\n  CopyIcon,\n  GitBranchPlusIcon,\n  GitCommitHorizontalIcon,\n  GitCompareIcon,\n  Undo2Icon,\n} from \"lucide-react\"\n\nimport {\n  ContextMenu,\n  ContextMenuContent,\n  ContextMenuGroup,\n  ContextMenuItem,\n  ContextMenuLabel,\n  ContextMenuSeparator,\n  ContextMenuTrigger,\n} from \"@workspace/ui/components/context-menu\"\nimport { cn } from \"@workspace/ui/lib/utils\"\n\nconst commits = [\n  {\n    sha: \"a41f9c2\",\n    message: \"Add usage-based billing tiers\",\n    author: \"MC\",\n    time: \"2h\",\n  },\n  {\n    sha: \"7be03d1\",\n    message: \"Fix race in webhook retries\",\n    author: \"JR\",\n    time: \"5h\",\n  },\n  {\n    sha: \"c9921aa\",\n    message: \"Bump date library to v4\",\n    author: \"EB\",\n    time: \"1d\",\n  },\n  {\n    sha: \"15e7f40\",\n    message: \"Refactor invoice PDF renderer\",\n    author: \"PN\",\n    time: \"2d\",\n  },\n]\n\nexport default function GitCommitHistoryMenu() {\n  return (\n    <div className=\"relative flex w-full max-w-sm flex-col border\">\n      {commits.map((commit, index) => (\n        <ContextMenu key={commit.sha}>\n          <ContextMenuTrigger className=\"flex items-center gap-3 px-3 py-2 text-xs data-popup-open:bg-muted\">\n            <div className=\"flex flex-col items-center self-stretch\">\n              <span\n                className={cn(\n                  \"w-px flex-1\",\n                  index === 0 ? \"bg-transparent\" : \"bg-border\"\n                )}\n              />\n              <GitCommitHorizontalIcon className=\"size-4 rotate-90 text-muted-foreground\" />\n              <span\n                className={cn(\n                  \"w-px flex-1\",\n                  index === commits.length - 1 ? \"bg-transparent\" : \"bg-border\"\n                )}\n              />\n            </div>\n            <div className=\"flex min-w-0 flex-1 flex-col\">\n              <span className=\"truncate\">{commit.message}</span>\n              <span className=\"text-muted-foreground\">\n                {commit.author} · {commit.time} ago\n              </span>\n            </div>\n            <code className=\"text-[11px] text-muted-foreground\">\n              {commit.sha}\n            </code>\n          </ContextMenuTrigger>\n          <ContextMenuContent className=\"w-52\">\n            <ContextMenuGroup>\n              <ContextMenuLabel className=\"font-mono\">\n                {commit.sha}\n              </ContextMenuLabel>\n              <ContextMenuItem>\n                <CopyIcon />\n                Copy SHA\n              </ContextMenuItem>\n              <ContextMenuItem>\n                <GitCompareIcon />\n                Compare with working tree\n              </ContextMenuItem>\n            </ContextMenuGroup>\n            <ContextMenuSeparator />\n            <ContextMenuGroup>\n              <ContextMenuItem>\n                <GitBranchPlusIcon />\n                Create branch from commit\n              </ContextMenuItem>\n              <ContextMenuItem>\n                <CherryIcon />\n                Cherry-pick\n              </ContextMenuItem>\n              <ContextMenuItem>\n                <ArrowLeftRightIcon />\n                Checkout commit\n              </ContextMenuItem>\n            </ContextMenuGroup>\n            <ContextMenuSeparator />\n            <ContextMenuGroup>\n              <ContextMenuItem variant=\"destructive\">\n                <Undo2Icon />\n                Revert commit\n              </ContextMenuItem>\n            </ContextMenuGroup>\n          </ContextMenuContent>\n        </ContextMenu>\n      ))}\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}