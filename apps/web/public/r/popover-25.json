{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "popover-25",
  "type": "registry:example",
  "description": "Rich text editor link popover with URL, display text, and new-tab option.",
  "files": [
    {
      "path": "registry/designali/examples/popover/popover-25.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  Bold as BoldIcon,\n  Italic as ItalicIcon,\n  Link as LinkIcon,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport { Checkbox } from \"@workspace/ui/components/checkbox\"\nimport { Input } from \"@workspace/ui/components/input\"\nimport { Label } from \"@workspace/ui/components/label\"\nimport {\n  Popover,\n  PopoverContent,\n  PopoverTrigger,\n} from \"@workspace/ui/components/popover\"\nimport { cn } from \"@workspace/ui/lib/utils\"\n\nexport default function LinkEditorPopover() {\n  const [open, setOpen] = React.useState(false)\n  const [href, setHref] = React.useState(\"\")\n  const [link, setLink] = React.useState<string | null>(null)\n\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-2 border\">\n      <div className=\"flex items-center gap-1 border-b p-1\">\n        <Button variant=\"ghost\" size=\"icon-sm\" aria-label=\"Bold\">\n          <BoldIcon />\n        </Button>\n        <Button variant=\"ghost\" size=\"icon-sm\" aria-label=\"Italic\">\n          <ItalicIcon />\n        </Button>\n        <Popover open={open} onOpenChange={setOpen}>\n          <PopoverTrigger\n            render={\n              <Button\n                variant={link ? \"secondary\" : \"ghost\"}\n                size=\"icon-sm\"\n                aria-label=\"Insert link\"\n              />\n            }\n          >\n            <LinkIcon />\n          </PopoverTrigger>\n          <PopoverContent className=\"w-72\" align=\"start\">\n            <form\n              className=\"flex flex-col gap-2.5\"\n              onSubmit={(event) => {\n                event.preventDefault()\n                setLink(href)\n                setOpen(false)\n              }}\n            >\n              <div className=\"flex flex-col gap-1.5\">\n                <Label htmlFor=\"link-url\">URL</Label>\n                <Input\n                  id=\"link-url\"\n                  type=\"url\"\n                  placeholder=\"https://\"\n                  value={href}\n                  onChange={(e) => setHref(e.target.value)}\n                  className=\"h-8\"\n                />\n              </div>\n              <div className=\"flex flex-col gap-1.5\">\n                <Label htmlFor=\"link-text\">Text</Label>\n                <Input\n                  id=\"link-text\"\n                  defaultValue=\"release notes\"\n                  className=\"h-8\"\n                />\n              </div>\n              <Label className=\"flex items-center gap-2 font-normal\">\n                <Checkbox defaultChecked /> Open in new tab\n              </Label>\n              <div className=\"flex justify-between\">\n                <Button\n                  type=\"button\"\n                  variant=\"ghost\"\n                  size=\"sm\"\n                  disabled={!link}\n                  onClick={() => (setLink(null), setHref(\"\"), setOpen(false))}\n                >\n                  Remove\n                </Button>\n                <Button type=\"submit\" size=\"sm\" disabled={!href}>\n                  Apply\n                </Button>\n              </div>\n            </form>\n          </PopoverContent>\n        </Popover>\n      </div>\n      <p className=\"px-3 pb-3 text-xs\">\n        Read the{\" \"}\n        <span className={cn(link && \"text-primary underline\")}>\n          release notes\n        </span>{\" \"}\n        before upgrading.\n      </p>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}