{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "location-19",
  "type": "registry:block",
  "description": "Visitor info bento with an illustrated campus map tile and cards for parking, transit, cycling, airport and access.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "registry/designali/blocks/location/location-19.tsx",
      "content": "import {\n  Accessibility,\n  Globe,\n  Mail,\n  MapPin,\n  MessageCircle,\n  Video,\n} from \"@designali/icons\"\n\nconst cards = [\n  {\n    icon: Mail,\n    title: \"Email\",\n    body: \"Write to hello@designali.com for new projects, support@designali.com for templates and billing@designali.com for invoices.\",\n    className: \"md:col-span-2\",\n  },\n  {\n    icon: MessageCircle,\n    title: \"Social\",\n    body: \"Say hi on X @designali_com or Instagram @designali.code.\",\n  },\n  {\n    icon: Video,\n    title: \"Calls\",\n    body: \"Book a free discovery call with Ali Imam from the contact page.\",\n  },\n  {\n    icon: Globe,\n    title: \"Website\",\n    body: \"Templates, blocks, UI designs and docs live on designali.com.\",\n  },\n  {\n    icon: Accessibility,\n    title: \"Accessibility\",\n    body: \"Every Designali block ships with semantic HTML, keyboard support and accessible colour tokens.\",\n    className: \"md:col-span-2\",\n  },\n]\n\nfunction CampusMap() {\n  return (\n    <svg viewBox=\"0 0 300 300\" className=\"absolute inset-0 h-full w-full\" aria-hidden>\n      <rect width=\"300\" height=\"300\" className=\"fill-chart-1 dark:fill-chart-5/40\" />\n      <path d=\"M0 210 C 80 190, 120 240, 300 200\" className=\"fill-none stroke-background\" strokeWidth=\"16\" />\n      <path d=\"M90 0 L110 300\" className=\"stroke-background\" strokeWidth=\"10\" />\n      <path d=\"M0 80 L300 70\" className=\"stroke-chart-1 dark:stroke-chart-3\" strokeWidth=\"3\" strokeDasharray=\"8 5\" />\n      <rect x=\"140\" y=\"100\" width=\"70\" height=\"50\" className=\"fill-primary\" />\n      <rect x=\"220\" y=\"110\" width=\"50\" height=\"40\" className=\"fill-chart-1 dark:fill-chart-3\" />\n      <rect x=\"150\" y=\"160\" width=\"40\" height=\"30\" className=\"fill-chart-1 dark:fill-chart-3\" />\n      <rect x=\"20\" y=\"110\" width=\"56\" height=\"60\" className=\"fill-background/80 stroke-chart-1 dark:stroke-chart-3\" strokeDasharray=\"3 3\" />\n      <text x=\"48\" y=\"144\" textAnchor=\"middle\" className=\"fill-primary text-[16px] font-bold dark:fill-chart-1\">D</text>\n      <circle cx=\"104\" cy=\"74\" r=\"6\" className=\"fill-background stroke-primary\" strokeWidth=\"3\" />\n    </svg>\n  )\n}\n\nexport default function Location19() {\n  return (\n    <section className=\"w-full bg-background py-20 md:py-28\">\n      <div className=\"mx-auto max-w-7xl px-6\">\n        <div className=\"max-w-2xl\">\n          <p className=\"text-xs font-medium tracking-widest text-muted-foreground uppercase\">\n            Contact information\n          </p>\n          <h2 className=\"mt-3 text-4xl font-semibold tracking-tight md:text-5xl\">\n            Getting in touch with Designali\n          </h2>\n        </div>\n\n        <div className=\"mt-12 grid gap-4 md:grid-cols-4 md:grid-rows-[auto_auto_auto]\">\n          <div className=\"relative min-h-80 overflow-hidden border md:col-span-2 md:row-span-2\">\n            <CampusMap />\n            <div className=\"absolute inset-x-4 bottom-4 flex items-start gap-3 border bg-background p-4\">\n              <MapPin className=\"mt-0.5 size-4 shrink-0\" />\n              <div className=\"text-sm\">\n                <p className=\"font-medium\">Designali studio</p>\n                <p className=\"text-muted-foreground\">Remote · Worldwide · hello@designali.com</p>\n              </div>\n            </div>\n          </div>\n          {cards.map((card) => (\n            <div key={card.title} className={`flex flex-col gap-4 border bg-card p-6 ${card.className ?? \"\"}`}>\n              <card.icon className=\"size-5\" />\n              <div>\n                <p className=\"font-medium\">{card.title}</p>\n                <p className=\"mt-1 text-sm text-muted-foreground\">{card.body}</p>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "760px"
  },
  "categories": [
    "location"
  ]
}