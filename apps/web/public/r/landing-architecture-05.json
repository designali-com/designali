  "files": [
    {
      "path": "registry/designali/pages/architecture/landing-architecture-05/page.tsx",
      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  Box,\n  Check,\n  Compass,\n  FileCheck,\n  HardHat,\n  Leaf,\n  Plus,\n  Sparkles,\n  Sun,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Projects\", \"Studio\", \"Services\", \"Process\", \"Journal\"]\n\nconst features = [\n  {\n    icon: FileCheck,\n    title: \"Planning expertise\",\n    description:\n      \"A 96% planning approval rate, including listed buildings and conservation areas.\",\n  },\n  {\n    icon: HardHat,\n    title: \"On site, every week\",\n    description:\n      \"We stay involved through construction, with weekly site visits and clear reporting.\",\n  },\n  {\n    icon: Box,\n    title: \"3D and VR walkthroughs\",\n    description:\n      \"Walk through your building in virtual reality before a single foundation is poured.\",\n  },\n  {\n    icon: Sun,\n    title: \"Daylight modelling\",\n    description:\n      \"Detailed sun-path and daylight studies to place every window where it matters most.\",\n  },\n  {\n    icon: Compass,\n    title: \"Site-led design\",\n    description:\n      \"Every project begins with weeks of study on the site: its light, its climate, its history and its neighbours.\",\n  },\n  {\n    icon: Leaf,\n    title: \"Low-carbon by default\",\n    description:\n      \"Timber structures, passive strategies and reclaimed materials to minimise embodied and operational carbon.\",\n  },\n]\n\nconst stats = [\n  { value: \"65%\", label: \"Lower embodied carbon\" },\n  { value: \"34\", label: \"Architects and designers\" },\n  { value: \"140+\", label: \"Projects completed\" },\n  { value: \"96%\", label: \"Planning approval rate\" },\n]\n\nconst steps = [\n  {\n    title: \"Brief and feasibility\",\n    description:\n      \"We study the site, test options and agree a clear brief, budget and programme.\",\n  },\n  {\n    title: \"Concept design\",\n    description:\n      \"Sketches, models and 3D views explore the big ideas before we refine one direction.\",\n  },\n  {\n    title: \"Planning and technical\",\n    description:\n      \"We prepare the planning application, then detailed drawings for tender and construction.\",\n  },\n  {\n    title: \"Construction and handover\",\n    description:\n      \"Weekly site visits, contractor coordination and a careful handover with a building manual.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Hillside House\",\n    meta: \"Residential · Cotswolds · 320 m²\",\n    tag: \"Award winner\",\n    price: \"2025\",\n    tile: \"bg-gradient-to-br from-emerald-200 via-green-300 to-lime-300 dark:from-emerald-700 dark:via-green-800 dark:to-lime-900\",\n  },\n  {\n    name: \"Nordform HQ\",\n    meta: \"Workplace · Copenhagen · 4,800 m²\",\n    tag: \"Workplace\",\n    price: \"2024\",\n    tile: \"bg-gradient-to-br from-stone-200 via-neutral-300 to-zinc-400 dark:from-stone-700 dark:via-neutral-800 dark:to-zinc-900\",\n  },\n  {\n    name: \"The Old Mill\",\n    meta: \"Heritage retrofit · Yorkshire\",\n    tag: \"Listed\",\n    price: \"2024\",\n    tile: \"bg-gradient-to-br from-rose-200 via-pink-300 to-purple-300 dark:from-rose-700 dark:via-pink-800 dark:to-purple-900\",\n  },\n  {\n    name: \"City Library\",\n    meta: \"Civic · 6,200 m² · CLT structure\",\n    tag: \"Public\",\n    price: \"2023\",\n    tile: \"bg-gradient-to-br from-blue-200 via-indigo-300 to-violet-400 dark:from-blue-700 dark:via-indigo-800 dark:to-violet-900\",\n  },\n  {\n    name: \"Garden Apartment\",\n    meta: \"Interiors · London · 140 m²\",\n    tag: \"Interiors\",\n    price: \"2025\",\n    tile: \"bg-gradient-to-br from-yellow-100 via-amber-200 to-orange-300 dark:from-yellow-700 dark:via-amber-800 dark:to-orange-900\",\n  },\n  {\n    name: \"Coastal Cabins\",\n    meta: \"Hospitality · 12 cabins\",\n    tag: \"Timber\",\n    price: \"2026\",\n    tile: \"bg-gradient-to-br from-amber-200 via-orange-300 to-rose-400 dark:from-amber-700 dark:via-orange-800 dark:to-rose-900\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"The interiors are calm, practical and full of thoughtful details. Every cupboard is exactly where it should be.\",\n    name: \"Lucia Romano\",\n    role: \"Client, Garden Apartment\",\n  },\n  {\n    quote:\n      \"A true collaborator. They challenged our brief in all the right ways and the library is better for it.\",\n    name: \"Dr. Alan Hughes\",\n    role: \"Director, City Library\",\n  },\n  {\n    quote:\n      \"They listened to how we actually live and designed a home around it. Five years later it still surprises us with the light.\",\n    name: \"Catherine and Paul Ashby\",\n    role: \"Clients, Hillside House\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Feasibility\",\n    price: \"$4,500\",\n    period: \"fixed fee\",\n    description: \"Understand what is possible on your site.\",\n    features: [\n      \"Site visit and analysis\",\n      \"Three design options\",\n      \"Planning appraisal\",\n      \"Cost guidance\",\n    ],\n    cta: \"Book a feasibility study\",\n  },\n  {\n    name: \"Full Service\",\n    price: \"12%\",\n    period: \"of build cost\",\n    description: \"Complete architecture from concept to handover.\",\n    features: [\n      \"Concept and planning\",\n      \"Technical drawings\",\n      \"Contractor tender\",\n      \"Weekly site visits\",\n      \"Interior design included\",\n    ],\n    cta: \"Start a project\",\n  },\n  {\n    name: \"Interiors\",\n    price: \"$180\",\n    period: \"/m²\",\n    description: \"Interior design for new or existing spaces.\",\n    features: [\n      \"Space planning\",\n      \"Joinery design\",\n      \"Lighting scheme\",\n      \"Furniture sourcing\",\n      \"Installation management\",\n    ],\n    cta: \"Discuss interiors\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"How do you approach sustainability?\",\n    a: \"We measure whole-life carbon on every project and target net zero operational energy wherever the brief allows.\",\n  },\n  {\n    q: \"What does the first meeting involve?\",\n    a: \"A free one-hour conversation on site or online to understand your goals, budget and timeline.\",\n  },\n  {\n    q: \"What size projects do you take on?\",\n    a: \"We work on everything from single-room extensions over $150,000 to civic buildings, with a dedicated team for each scale.\",\n  },\n  {\n    q: \"How long does a typical house project take?\",\n    a: \"A new home usually takes 18 to 30 months from first meeting to moving in, including planning and construction.\",\n  },\n  {\n    q: \"Do you work outside the country?\",\n    a: \"Yes. We have completed projects in nine countries and partner with local architects where required.\",\n  },\n]\n\nconst footer = [\n  { title: \"Studio\", links: [\"About\", \"Team\", \"Awards\", \"Careers\"] },\n  {\n    title: \"Work\",\n    links: [\"Residential\", \"Workplace\", \"Cultural\", \"Interiors\"],\n  },\n  {\n    title: \"Contact\",\n    links: [\"New projects\", \"Press\", \"Instagram\", \"Newsletter\"],\n  },\n]\n\nexport default function LandingArchitecture05() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <div className=\"border-b border-background/10 bg-foreground text-background/80 px-4 py-2 text-center text-xs sm:text-sm\">\n        <a\n          href=\"#\"\n          className=\"inline-flex items-center gap-1.5 hover:underline\"\n        >\n          Open studio evening: 18 March, all welcome\n          <ArrowRight className=\"size-3.5\" />\n        </a>\n      </div>\n      <header className=\"bg-foreground text-background sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-background text-foreground text-sm\">\n              H\n            </span>\n            <span className=\"\">Haus Studio</span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-background/70 hover:text-background transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex text-background hover:bg-background/10 hover:text-background\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Start a project\n            </Button>\n            <Button\n              size=\"sm\"\n              className=\"bg-background text-foreground hover:bg-background/90\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Start your home\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"relative overflow-hidden bg-foreground text-background\">\n        <div className=\"pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,currentColor_1px,transparent_1px),linear-gradient(to_bottom,currentColor_1px,transparent_1px)] bg-[size:64px_64px] opacity-[0.04]\" />\n        <div className=\"relative mx-auto max-w-7xl px-6 pt-16 pb-20 md:pt-28\">\n          <div className=\"max-w-4xl space-y-7\">\n            <span className=\"inline-flex items-center gap-2 rounded-full border border-background/20 text-background/80 px-3 py-1 text-xs font-medium\">\n              <Sparkles className=\"size-3.5 \" />\n              Custom homes\n            </span>\n            <h1 className=\"text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-7xl \">\n              {\"A house designed around \"}\n              <span className=\"text-background/60\">your life</span>\n            </h1>\n            <p className=\"max-w-2xl text-lg leading-8 text-background/65\">\n              From the first site walk to the day you move in, we design one-off\n              homes shaped by your routines, your land and your budget.\n            </p>\n            <div className=\"flex flex-wrap gap-3 \">\n              <Button\n                size=\"lg\"\n                className=\"bg-background text-foreground hover:bg-background/90\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                Start your home\n                <ArrowRight />\n              </Button>\n              <Button\n                size=\"lg\"\n                variant=\"outline\"\n                className=\"border-background/25 bg-transparent text-background hover:bg-background/10 hover:text-background\"\n                nativeButton={false}\n                render={<a href=\"#\" />}\n              >\n                See homes\n              </Button>\n            </div>\n          </div>\n          <div className=\"mt-16\">\n            <HeroVisual />\n          </div>\n        </div>\n      </section>\n      <section className=\"bg-foreground text-background\">\n        <div className=\"mx-auto grid max-w-7xl grid-cols-2 px-6 lg:grid-cols-4\">\n          {stats.slice(0, 4).map((stat, i) => (\n            <div\n              key={stat.label}\n              className={`py-12 ${i > 0 ? \"lg:border-l lg:pl-8\" : \"\"} ${i % 2 === 1 ? \"border-l pl-6 lg:pl-8\" : \"\"} border-background/10`}\n            >\n              <div className=\"text-4xl font-semibold tracking-tight md:text-5xl \">\n                {stat.value}\n              </div>\n              <div className=\"mt-2 text-sm text-background/60\">\n                {stat.label}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"max-w-2xl\">\n            <p className=\"text-sm font-medium text-amber-600 dark:text-amber-400\">\n              Practice\n            </p>\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl  mt-3\">\n              Buildings shaped by place, light and people\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              We design homes, workplaces and public spaces that respond to\n              their site, last for generations and are a pleasure to live in.\n            </p>\n          </div>\n          <div className=\"mt-14 grid overflow-hidden rounded-2xl border sm:grid-cols-2 lg:grid-cols-3\">\n            {features.map((feature) => (\n              <div\n                key={feature.title}\n                className=\"-mt-px -ml-px border-t border-l p-8\"\n              >\n                <feature.icon className=\"size-6 text-amber-600 dark:text-amber-400\" />\n                <h3 className=\"mt-5 font-semibold\">{feature.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {feature.description}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n                Selected projects\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                Residential, cultural and workplace projects completed over the\n                last decade, from small extensions to civic buildings.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a key={item.name} href=\"#\" className=\"group\">\n                <div\n                  className={`relative aspect-[4/3] overflow-hidden rounded-2xl ${item.tile}`}\n                >\n                  <div className=\"absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10\" />\n                  <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-zinc-900 backdrop-blur\">\n                    {item.tag}\n                  </span>\n                </div>\n                <div className=\"mt-4 flex items-start justify-between gap-4\">\n                  <div className=\"min-w-0\">\n                    <h3 className=\"font-medium \">{item.name}</h3>\n                    <p className=\"mt-1 text-sm text-muted-foreground\">\n                      {item.meta}\n                    </p>\n                  </div>\n                  <span className=\"shrink-0 text-sm font-semibold\">\n                    {item.price}\n                  </span>\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              From first sketch to handover\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-border pt-6\"\n              >\n                <span className=\"text-sm font-medium text-amber-600 dark:text-amber-400\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              What our clients say\n            </h2>\n          </div>\n          <div className=\"mt-14 grid gap-6 md:grid-cols-3\">\n            {testimonials.map((t) => (\n              <figure\n                key={t.name}\n                className=\"flex flex-col rounded-2xl border p-6\"\n              >\n                <blockquote className=\"flex-1 leading-7\">\n                  &ldquo;{t.quote}&rdquo;\n                </blockquote>\n                <figcaption className=\"mt-8 flex items-center gap-3 border-t pt-6 text-sm\">\n                  <span className=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold\">\n                    {t.name\n                      .split(\" \")\n                      .map((p) => p[0])\n                      .join(\"\")}\n                  </span>\n                  <span>\n                    <span className=\"block font-medium\">{t.name}</span>\n                    <span className=\"block text-muted-foreground\">\n                      {t.role}\n                    </span>\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Ways to work with us\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Fees are agreed upfront for each stage, so you always know what\n              comes next and what it costs.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"bg-foreground text-background border-foreground\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-background text-foreground px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p\n                    className={\n                      featured\n                        ? \"mt-2 text-sm text-background/65\"\n                        : \"mt-2 text-sm text-muted-foreground\"\n                    }\n                  >\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span\n                      className={\n                        featured\n                          ? \"text-sm text-background/65\"\n                          : \"text-sm text-muted-foreground\"\n                      }\n                    >\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check\n                          className={\n                            featured\n                              ? \"mt-0.5 size-4 shrink-0\"\n                              : \"mt-0.5 size-4 shrink-0 text-amber-600 dark:text-amber-400\"\n                          }\n                        />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className={\n                      featured\n                        ? \"mt-8 w-full bg-background text-foreground hover:bg-background/90\"\n                        : \"mt-8 w-full\"\n                    }\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl\">\n              Common questions\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Get in touch\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"bg-foreground text-background\">\n        <div className=\"mx-auto flex max-w-7xl flex-col gap-10 px-6 py-20 md:flex-row md:items-end md:justify-between md:py-28\">\n          <div className=\"max-w-2xl\">\n            <h2 className=\"text-4xl font-semibold tracking-tight text-balance md:text-6xl \">\n              Your next home starts with a conversation\n            </h2>\n            <p className=\"mt-5 text-lg text-background/65\">\n              Tell us about your site and plans, and we will arrange a visit.\n            </p>\n          </div>\n          <div className=\"flex flex-wrap gap-3 \">\n            <Button\n              size=\"lg\"\n              className=\"bg-background text-foreground hover:bg-background/90\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Start your home\n              <ArrowRight />\n            </Button>\n            <Button\n              size=\"lg\"\n              variant=\"outline\"\n              className=\"border-background/25 bg-transparent text-background hover:bg-background/10 hover:text-background\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              See homes\n            </Button>\n          </div>\n        </div>\n      </section>\n      <footer className=\"border-t border-background/10 bg-foreground text-background\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-background text-foreground text-sm\">\n                H\n              </span>\n              <span className=\"\">Haus Studio</span>\n            </a>\n            <p className=\"max-w-xs text-sm text-background/60\">\n              One-off homes, carefully made.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-background/60 transition-colors hover:text-background\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t border-background/10\">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-background/60 sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} Haus Studio. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-background\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-background\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-background\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  return (\n    <div className=\"grid grid-cols-2 gap-3 md:grid-cols-3\">\n      {showcase.slice(0, 3).map((item, i) => (\n        <div\n          key={item.name}\n          className={`relative overflow-hidden rounded-2xl ${item.tile} ${i === 0 ? \"col-span-2 aspect-[16/10] md:col-span-1 md:aspect-[3/4]\" : \"aspect-[3/4]\"}`}\n        >\n          <div className=\"absolute inset-0 bg-gradient-to-t from-black/50 via-black/0 to-black/0\" />\n          <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-zinc-900 backdrop-blur\">\n            {item.tag}\n          </span>\n          <div className=\"absolute inset-x-3 bottom-3 flex items-end justify-between gap-2 text-white\">\n            <div className=\"min-w-0\">\n              <div className=\"truncate text-sm font-medium\">{item.name}</div>\n              <div className=\"truncate text-xs text-white/75\">{item.meta}</div>\n            </div>\n            <div className=\"shrink-0 text-sm font-semibold\">{item.price}</div>\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n",
      "type": "registry:page",
      "target": "app/landing-architecture-05/page.tsx"
