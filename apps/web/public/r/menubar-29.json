{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "menubar-29",
  "type": "registry:example",
  "description": "E-commerce admin menubar covering orders, products and customers with status submenus.",
  "files": [
    {
      "path": "registry/designali/examples/menubar/menubar-29.tsx",
      "content": "import {\n  Boxes as BoxesIcon,\n  Download as DownloadIcon,\n  ListFilter as ListFilterIcon,\n  Package as PackageIcon,\n  Plus as PlusIcon,\n  ShoppingBag as ShoppingBagIcon,\n  Tags as TagsIcon,\n  TicketPercent as TicketPercentIcon,\n  Truck as TruckIcon,\n  UserPlus as UserPlusIcon,\n  Users as UsersIcon,\n} from \"@designali/icons\"\n\nimport {\n  Menubar,\n  MenubarContent,\n  MenubarGroup,\n  MenubarItem,\n  MenubarMenu,\n  MenubarSub,\n  MenubarSubContent,\n  MenubarSubTrigger,\n  MenubarTrigger,\n} from \"@workspace/ui/components/menubar\"\n\nexport default function StoreAdminMenubar() {\n  return (\n    <div className=\"w-full max-w-md\">\n      <Menubar>\n        <MenubarMenu>\n          <MenubarTrigger>\n            <ShoppingBagIcon className=\"me-1.5 size-3.5\" /> Orders\n          </MenubarTrigger>\n          <MenubarContent className=\"w-52\">\n            <MenubarGroup>\n              <MenubarItem>\n                <PlusIcon /> Create draft order\n              </MenubarItem>\n              <MenubarSub>\n                <MenubarSubTrigger>\n                  <ListFilterIcon /> View by status\n                </MenubarSubTrigger>\n                <MenubarSubContent>\n                  <MenubarGroup>\n                    <MenubarItem>Unfulfilled</MenubarItem>\n                    <MenubarItem>Awaiting payment</MenubarItem>\n                    <MenubarItem>Refund requested</MenubarItem>\n                    <MenubarItem>Completed</MenubarItem>\n                  </MenubarGroup>\n                </MenubarSubContent>\n              </MenubarSub>\n              <MenubarItem>\n                <TruckIcon /> Print shipping labels\n              </MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>\n            <PackageIcon className=\"me-1.5 size-3.5\" /> Products\n          </MenubarTrigger>\n          <MenubarContent className=\"w-52\">\n            <MenubarGroup>\n              <MenubarItem>\n                <PlusIcon /> Add product\n              </MenubarItem>\n              <MenubarItem>\n                <BoxesIcon /> Inventory\n              </MenubarItem>\n              <MenubarItem>\n                <TicketPercentIcon /> Discounts\n              </MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>\n            <UsersIcon className=\"me-1.5 size-3.5\" /> Customers\n          </MenubarTrigger>\n          <MenubarContent className=\"w-52\">\n            <MenubarGroup>\n              <MenubarItem>\n                <UserPlusIcon /> Add customer\n              </MenubarItem>\n              <MenubarItem>\n                <TagsIcon /> Segments\n              </MenubarItem>\n              <MenubarItem>\n                <DownloadIcon /> Export list\n              </MenubarItem>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n      </Menubar>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}