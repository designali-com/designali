    {
      "path": "registry/designali/pages/music/landing-music-10/page.tsx",
      "content": "import {\n  ArrowRight,\n  ArrowUpRight,\n  Check,\n  Mic,\n  Plus,\n  Radio,\n  ShoppingBag,\n  Ticket,\n  Users,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\n\nconst navLinks = [\"Services\", \"Process\", \"Work\", \"Pricing\", \"About\"]\n\nconst features = [\n  {\n    icon: Ticket,\n    title: \"Artist brand identity\",\n    description:\n      \"Logos, wordmarks, colour and type that work on a festival poster, a profile picture and a T-shirt.\",\n  },\n  {\n    icon: Radio,\n    title: \"Motion visualizers\",\n    description:\n      \"Looping canvases, lyric videos and visualizers made in motion and CGI to match each release.\",\n  },\n  {\n    icon: Mic,\n    title: \"Release websites\",\n    description:\n      \"Fast Next.js sites for releases and tours, with streaming links, store and newsletter in one place.\",\n  },\n  {\n    icon: Users,\n    title: \"Social campaign kits\",\n    description:\n      \"Templates for announcements, countdowns and tour posts, so every update looks on brand.\",\n  },\n  {\n    icon: ShoppingBag,\n    title: \"Merch & print graphics\",\n    description:\n      \"T-shirts, posters and tour graphics designed in the same visual language as the record.\",\n  },\n]\n\nconst stats = [\n  { value: \"4000+\", label: \"Icons and vectors to build with\" },\n  { value: \"2\", label: \"Revision rounds included\" },\n  { value: \"1.2M\", label: \"Followers reached by campaigns\" },\n  { value: \"120+\", label: \"Assets delivered per campaign\" },\n]\n\nconst steps = [\n  {\n    title: \"Listen to the record\",\n    description:\n      \"Every project starts with your demos, lyrics and references, so the visuals grow from the music.\",\n  },\n  {\n    title: \"Moodboards and concepts\",\n    description:\n      \"Ali Imam explores directions in Figma and 3D, and you choose the one that feels right.\",\n  },\n  {\n    title: \"Design and motion\",\n    description:\n      \"Cover art, visualizers and campaign assets are produced together as one system.\",\n  },\n  {\n    title: \"Launch everywhere\",\n    description:\n      \"Final files are exported for every platform, and the release site goes live in Next.js.\",\n  },\n]\n\nconst showcase = [\n  {\n    name: \"Album campaign\",\n    meta: \"Cover art · 12 assets\",\n    tag: \"New\",\n    price: \"4 wks\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Single artwork\",\n    meta: \"Cover · Canvas loop\",\n    tag: \"Single\",\n    price: \"1 wk\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Live album visuals\",\n    meta: \"Stage visuals · 18 loops\",\n    tag: \"Live\",\n    price: \"6 wks\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-chart-1 dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"EP identity\",\n    meta: \"Brand · 5 covers\",\n    tag: \"EP\",\n    price: \"3 wks\",\n    tile: \"bg-gradient-to-br from-muted via-border to-muted-foreground dark:from-muted dark:via-card dark:to-card\",\n  },\n  {\n    name: \"Label rebrand\",\n    meta: \"Identity · Release templates\",\n    tag: \"Brand\",\n    price: \"5 wks\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-chart-1 dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n  {\n    name: \"Acoustic sessions\",\n    meta: \"Motion · 7 lyric videos\",\n    tag: \"Motion\",\n    price: \"2 wks\",\n    tile: \"bg-gradient-to-br from-primary/20 via-chart-1 to-primary dark:from-chart-3 dark:via-chart-4 dark:to-chart-5\",\n  },\n]\n\nconst testimonials = [\n  {\n    quote:\n      \"The release site and merch graphics matched the cover perfectly. Fans kept asking who designed it all.\",\n    name: \"Ben\",\n    role: \"Singer-songwriter\",\n  },\n  {\n    quote:\n      \"Working with Ali felt like having a creative director in the band. The visuals made our community feel part of it.\",\n    name: \"Yuki\",\n    role: \"Designali client\",\n  },\n  {\n    quote:\n      \"The tour visuals were the best part of the show. Everyone wanted to know who made them.\",\n    name: \"Grace\",\n    role: \"Tour manager\",\n  },\n]\n\nconst tiers = [\n  {\n    name: \"Single\",\n    price: \"$900\",\n    period: \"/project\",\n    description: \"Artwork for one release.\",\n    features: [\n      \"Cover art and variations\",\n      \"Streaming platform exports\",\n      \"Canvas loop\",\n      \"Two rounds of revisions\",\n    ],\n    cta: \"Book Single\",\n  },\n  {\n    name: \"Release\",\n    price: \"$2,800\",\n    period: \"/project\",\n    description: \"A full campaign for an EP or album.\",\n    features: [\n      \"Everything in Single\",\n      \"Visualizer and lyric video\",\n      \"Social campaign kit\",\n      \"Release website\",\n      \"Merch graphics\",\n    ],\n    cta: \"Book Release\",\n  },\n  {\n    name: \"Artist Brand\",\n    price: \"$6,500\",\n    period: \"/project\",\n    description: \"A complete identity for artists and labels.\",\n    features: [\n      \"Logo and brand guidelines\",\n      \"CGI and 3D visuals\",\n      \"Tour and stage visuals\",\n      \"Release website included\",\n      \"Limited slots each quarter\",\n    ],\n    cta: \"Book Artist Brand\",\n  },\n]\n\nconst faqs = [\n  {\n    q: \"How long does a release campaign take?\",\n    a: \"A single usually takes one to two weeks. Full album campaigns take four to six weeks, depending on scope.\",\n  },\n  {\n    q: \"Can you work with my existing logo?\",\n    a: \"Yes. We can extend an existing identity or refresh it gently so it fits your new era.\",\n  },\n  {\n    q: \"What if my release date moves?\",\n    a: \"No problem. Timelines are planned with buffer, and we can adjust delivery dates as your plans change.\",\n  },\n  {\n    q: \"Do you only work with signed artists?\",\n    a: \"No. Designali works with independent artists, bands and small labels, from a first single to a full album campaign.\",\n  },\n  {\n    q: \"Can you create motion and 3D as well as static art?\",\n    a: \"Yes. Ali Imam designs cover art and produces motion, CGI and visualizers, so every asset shares one look.\",\n  },\n]\n\nconst footer = [\n  { title: \"Services\", links: [\"Work\", \"Work\", \"Services\", \"Process\"] },\n  {\n    title: \"Live\",\n    links: [\"Packages\", \"Pricing\", \"Templates\", \"Docs\"],\n  },\n  { title: \"More\", links: [\"Pricing\", \"Blog\", \"Instagram\", \"Contact\"] },\n]\n\nexport default function LandingMusic10() {\n  return (\n    <div className=\"min-h-screen bg-background text-foreground\">\n      <header className=\"border-b bg-background/80 backdrop-blur sticky top-0 z-40\">\n        <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6\">\n          <a\n            href=\"#\"\n            className=\"flex items-center gap-2 font-semibold tracking-tight\"\n          >\n            <span className=\"flex size-7 items-center justify-center rounded-md bg-chart-2 text-white text-sm\">\n              M\n            </span>\n            <span className=\"font-sans text-lg font-normal\">\n              designali\n            </span>\n          </a>\n          <nav className=\"hidden items-center gap-7 text-sm md:flex\">\n            {navLinks.map((link) => (\n              <a\n                key={link}\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                {link}\n              </a>\n            ))}\n          </nav>\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              className=\"hidden sm:inline-flex\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Start a project\n            </Button>\n            <Button size=\"sm\" nativeButton={false} render={<a href=\"#\" />}>\n              Book a call\n            </Button>\n          </div>\n        </div>\n      </header>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 pt-16 pb-12 md:pt-28\">\n          <div className=\"flex items-center justify-between border-b pb-4 text-xs tracking-widest text-muted-foreground uppercase\">\n            <span>Design for classical ensembles</span>\n            <span className=\"hidden sm:inline\">Classical music, beautifully presented.</span>\n          </div>\n          <h1 className=\"mt-12 max-w-5xl text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl md:text-8xl font-sans font-normal\">\n            {\"Four instruments, \"}\n            <span className=\"text-primary dark:text-primary\">\n              one shared visual language\n            </span>\n          </h1>\n          <div className=\"mt-12 grid gap-8 md:grid-cols-2 md:items-end\">\n            <p className=\"max-w-lg text-lg leading-8 text-muted-foreground\">\n              Designali designs season brochures, programme notes and ticketing sites\n              for ensembles and concert series, with calm typography and clear layouts.\n            </p>\n            <div className=\"md:justify-self-end\">\n              <div className=\"flex flex-wrap gap-3 \">\n                <Button size=\"lg\" nativeButton={false} render={<a href=\"#\" />}>\n                  Book a call\n                  <ArrowRight />\n                </Button>\n                <Button\n                  size=\"lg\"\n                  variant=\"outline\"\n                  nativeButton={false}\n                  render={<a href=\"#\" />}\n                >\n                  See projects\n                </Button>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div className=\"mx-auto max-w-7xl px-6 pb-16\">\n          <HeroVisual />\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl grid-cols-2 px-6 lg:grid-cols-4\">\n          {stats.slice(0, 4).map((stat, i) => (\n            <div\n              key={stat.label}\n              className={`py-12 ${i > 0 ? \"lg:border-l lg:pl-8\" : \"\"} ${i % 2 === 1 ? \"border-l pl-6 lg:pl-8\" : \"\"} `}\n            >\n              <div className=\"text-4xl font-semibold tracking-tight md:text-5xl font-sans font-normal\">\n                {stat.value}\n              </div>\n              <div className=\"mt-2 text-sm text-muted-foreground\">\n                {stat.label}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.4fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <div className=\"max-w-2xl\">\n              <p className=\"text-sm font-medium text-primary dark:text-primary\">\n                Inside\n              </p>\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-sans font-normal mt-3\">\n                Everything around the music\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                Artwork, motion, merch and a release site that works,\n                all designed and built by one studio.\n              </p>\n            </div>\n          </div>\n          <div className=\"divide-y border-y\">\n            {features.map((feature, i) => (\n              <div\n                key={feature.title}\n                className=\"grid gap-4 py-8 sm:grid-cols-[4rem_1fr]\"\n              >\n                <span className=\"font-sans text-sm text-muted-foreground\">\n                  {String(i + 1).padStart(2, \"0\")}\n                </span>\n                <div>\n                  <h3 className=\"font-sans text-2xl\">{feature.title}</h3>\n                  <p className=\"mt-2 leading-7 text-muted-foreground\">\n                    {feature.description}\n                  </p>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"flex flex-col justify-between gap-6 md:flex-row md:items-end\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-sans font-normal\">\n                Recent music projects\n              </h2>\n              <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n                Cover art, visualizers and campaigns designed for artists and labels.\n                Every one built as a system, not a one-off.\n              </p>\n            </div>\n            <Button\n              variant=\"outline\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              View all work\n              <ArrowUpRight />\n            </Button>\n          </div>\n          <div className=\"mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3\">\n            {showcase.map((item) => (\n              <a key={item.name} href=\"#\" className=\"group\">\n                <div\n                  className={`relative aspect-[4/3] overflow-hidden rounded-2xl ${item.tile}`}\n                >\n                  <div className=\"absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/10\" />\n                  <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-foreground backdrop-blur\">\n                    {item.tag}\n                  </span>\n                </div>\n                <div className=\"mt-4 flex items-start justify-between gap-4\">\n                  <div className=\"min-w-0\">\n                    <h3 className=\"font-medium font-sans text-lg\">\n                      {item.name}\n                    </h3>\n                    <p className=\"mt-1 text-sm text-muted-foreground\">\n                      {item.meta}\n                    </p>\n                  </div>\n                  <span className=\"shrink-0 text-sm font-semibold\">\n                    {item.price}\n                  </span>\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-5xl px-6 py-20 text-center md:py-28\">\n          <p className=\"text-sm tracking-widest text-muted-foreground uppercase\">\n            What artists say about Designali\n          </p>\n          {testimonials.slice(0, 1).map((t) => (\n            <figure key={t.name} className=\"mt-10\">\n              <blockquote className=\"font-sans text-3xl leading-snug text-balance md:text-5xl\">\n                &ldquo;{t.quote}&rdquo;\n              </blockquote>\n              <figcaption className=\"mt-10 text-sm\">\n                <span className=\"font-medium\">{t.name}</span>\n                <span className=\"text-muted-foreground\"> · {t.role}</span>\n              </figcaption>\n            </figure>\n          ))}\n          <div className=\"mt-16 grid gap-6 border-t pt-12 text-left md:grid-cols-2\">\n            {testimonials.slice(1).map((t) => (\n              <figure key={t.name}>\n                <blockquote className=\"leading-7 text-muted-foreground\">\n                  &ldquo;{t.quote}&rdquo;\n                </blockquote>\n                <figcaption className=\"mt-4 text-sm font-medium\">\n                  {t.name}{\" \"}\n                  <span className=\"font-normal text-muted-foreground\">\n                    · {t.role}\n                  </span>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"max-w-2xl\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-sans font-normal\">\n              From demo to release day\n            </h2>\n          </div>\n          <ol className=\"mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4\">\n            {steps.map((step, i) => (\n              <li\n                key={step.title}\n                className=\"relative border-t-2 border-foreground pt-6\"\n              >\n                <span className=\"text-sm font-medium text-primary dark:text-primary\">\n                  Step {i + 1}\n                </span>\n                <h3 className=\"mt-2 text-lg font-semibold\">{step.title}</h3>\n                <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                  {step.description}\n                </p>\n              </li>\n            ))}\n          </ol>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto max-w-7xl px-6 py-20 md:py-28\">\n          <div className=\"mx-auto max-w-2xl text-center\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-sans font-normal\">\n              Choose a package\n            </h2>\n            <p className=\"mt-4 text-lg leading-8 text-muted-foreground\">\n              Every package includes source files, platform-ready exports and\n              support from Ali Imam through release day.\n            </p>\n          </div>\n          <div className=\"mx-auto mt-14 grid max-w-6xl items-start gap-6 lg:grid-cols-3\">\n            {tiers.map((tier, i) => {\n              const featured = i === 1\n              return (\n                <div\n                  key={tier.name}\n                  className={`relative flex h-full flex-col rounded-2xl border p-8 ${featured ? \"border-transparent ring-2 ring-primary shadow-xl\" : \"\"}`}\n                >\n                  {featured && (\n                    <span className=\"absolute -top-3 left-8 rounded-full bg-chart-2 text-white px-3 py-1 text-xs font-medium\">\n                      Most popular\n                    </span>\n                  )}\n                  <h3 className=\"font-semibold\">{tier.name}</h3>\n                  <p className=\"mt-2 text-sm text-muted-foreground\">\n                    {tier.description}\n                  </p>\n                  <div className=\"mt-6 flex items-baseline gap-1\">\n                    <span className=\"text-4xl font-semibold tracking-tight\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {tier.period}\n                    </span>\n                  </div>\n                  <ul className=\"mt-8 flex-1 space-y-3 text-sm\">\n                    {tier.features.map((feature) => (\n                      <li key={feature} className=\"flex gap-3\">\n                        <Check className=\"mt-0.5 size-4 shrink-0 text-primary dark:text-primary\" />\n                        {feature}\n                      </li>\n                    ))}\n                  </ul>\n                  <Button\n                    className=\"mt-8 w-full\"\n                    variant={featured ? \"default\" : \"outline\"}\n                    nativeButton={false}\n                    render={<a href=\"#\" />}\n                  >\n                    {tier.cta}\n                  </Button>\n                </div>\n              )\n            })}\n          </div>\n        </div>\n      </section>\n      <section className=\"border-b\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-20 md:py-28 lg:grid-cols-[1fr_1.5fr]\">\n          <div className=\"lg:sticky lg:top-24 lg:self-start\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-balance md:text-5xl font-sans font-normal\">\n              Good to know\n            </h2>\n            <p className=\"mt-4 text-muted-foreground\">\n              Still curious?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4\"\n              >\n                Contact us\n              </a>\n              .\n            </p>\n          </div>\n          <div className=\"divide-y border-y\">\n            {faqs.map((faq, i) => (\n              <details key={faq.q} className=\"group py-5\" open={i === 0}>\n                <summary className=\"flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden\">\n                  {faq.q}\n                  <Plus className=\"size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45\" />\n                </summary>\n                <p className=\"mt-3 pr-10 leading-7 text-muted-foreground\">\n                  {faq.a}\n                </p>\n              </details>\n            ))}\n          </div>\n        </div>\n      </section>\n      <section className=\"bg-foreground text-background\">\n        <div className=\"mx-auto flex max-w-7xl flex-col gap-10 px-6 py-20 md:flex-row md:items-end md:justify-between md:py-28\">\n          <div className=\"max-w-2xl\">\n            <h2 className=\"text-4xl font-semibold tracking-tight text-balance md:text-6xl font-sans font-normal\">\n              Present your next season beautifully\n            </h2>\n            <p className=\"mt-5 text-lg text-background/65\">\n              Season packages cover print, socials and a website in one plan.\n            </p>\n          </div>\n          <div className=\"flex flex-wrap gap-3 \">\n            <Button\n              size=\"lg\"\n              className=\"bg-background text-foreground hover:bg-background/90\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              Book a call\n              <ArrowRight />\n            </Button>\n            <Button\n              size=\"lg\"\n              variant=\"outline\"\n              className=\"border-background/25 bg-transparent text-background hover:bg-background/10 hover:text-background\"\n              nativeButton={false}\n              render={<a href=\"#\" />}\n            >\n              See projects\n            </Button>\n          </div>\n        </div>\n      </section>\n      <footer className=\"\">\n        <div className=\"mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]\">\n          <div className=\"space-y-4\">\n            <a\n              href=\"#\"\n              className=\"flex items-center gap-2 font-semibold tracking-tight\"\n            >\n              <span className=\"flex size-7 items-center justify-center rounded-md bg-chart-2 text-white text-sm\">\n                M\n              </span>\n              <span className=\"font-sans text-lg font-normal\">\n                designali\n              </span>\n            </a>\n            <p className=\"max-w-xs text-sm text-muted-foreground\">\n              Classical music, beautifully presented.\n            </p>\n          </div>\n          {footer.map((column) => (\n            <div key={column.title}>\n              <h3 className=\"text-sm font-medium\">{column.title}</h3>\n              <ul className=\"mt-4 space-y-3 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a\n                      href=\"#\"\n                      className=\"text-muted-foreground transition-colors hover:text-foreground\"\n                    >\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"border-t \">\n          <div className=\"mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-6 text-xs text-muted-foreground sm:flex-row\">\n            <span>\n              © {new Date().getFullYear()} designali. All rights reserved.\n            </span>\n            <div className=\"flex gap-6\">\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Privacy\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Terms\n              </a>\n              <a href=\"#\" className=\"hover:text-foreground\">\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n\nfunction HeroVisual() {\n  return (\n    <div className=\"grid grid-cols-2 gap-3 md:grid-cols-3\">\n      {showcase.slice(0, 3).map((item, i) => (\n        <div\n          key={item.name}\n          className={`relative overflow-hidden rounded-2xl ${item.tile} ${i === 0 ? \"col-span-2 aspect-[16/10] md:col-span-1 md:aspect-[3/4]\" : \"aspect-[3/4]\"}`}\n        >\n          <div className=\"absolute inset-0 bg-gradient-to-t from-black/50 via-black/0 to-black/0\" />\n          <span className=\"absolute top-3 left-3 rounded-full bg-white/85 px-2.5 py-1 text-[11px] font-medium text-foreground backdrop-blur\">\n            {item.tag}\n          </span>\n          <div className=\"absolute inset-x-3 bottom-3 flex items-end justify-between gap-2 text-white\">\n            <div className=\"min-w-0\">\n              <div className=\"truncate text-sm font-medium\">{item.name}</div>\n              <div className=\"truncate text-xs text-white/75\">{item.meta}</div>\n            </div>\n            <div className=\"shrink-0 text-sm font-semibold\">{item.price}</div>\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n",
