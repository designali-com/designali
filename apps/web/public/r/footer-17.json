{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "footer-17",
  "type": "registry:block",
  "description": "Developer footer in monospace with an install snippet, live system status list and build metadata.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "registry/designali/blocks/footer/footer-17.tsx",
      "content": "import { Activity, BookOpen, Code2, GitCommitHorizontal, Rss, Terminal } from \"lucide-react\"\n\nconst columns = [\n  { title: \"Build\", icon: Code2, links: [\"Quickstart\", \"SDKs\", \"CLI\", \"Webhooks\"] },\n  { title: \"Reference\", icon: BookOpen, links: [\"REST API\", \"GraphQL\", \"Error codes\", \"Rate limits\"] },\n  { title: \"Stay current\", icon: Rss, links: [\"Changelog\", \"Deprecations\", \"RSS feed\", \"Status history\"] },\n]\n\nconst services = [\n  { name: \"API\", uptime: \"99.998%\", ok: true },\n  { name: \"Dashboard\", uptime: \"99.991%\", ok: true },\n  { name: \"Webhooks\", uptime: \"99.94%\", ok: false },\n]\n\nexport default function Footer17() {\n  return (\n    <footer className=\"w-full border-t bg-background font-mono\">\n      <div className=\"mx-auto grid max-w-7xl gap-10 px-6 py-14 lg:grid-cols-[1fr_1.4fr]\">\n        <div>\n          <p className=\"flex items-center gap-2 text-sm font-semibold\">\n            <Terminal className=\"size-4\" />\n            vectorbase\n          </p>\n          <div className=\"mt-6 border bg-muted/40 p-4 text-xs leading-6\">\n            <p className=\"text-muted-foreground\"># install the client</p>\n            <p className=\"truncate\">\n              <span className=\"text-muted-foreground\">$</span> pip install vectorbase\n            </p>\n          </div>\n          <div className=\"mt-6 border\">\n            <div className=\"flex items-center justify-between border-b px-4 py-2.5 text-xs\">\n              <span className=\"flex items-center gap-2\">\n                <Activity className=\"size-3.5\" />\n                System status\n              </span>\n              <a href=\"#\" className=\"text-muted-foreground hover:text-foreground\">\n                status.vectorbase.dev\n              </a>\n            </div>\n            <ul className=\"text-xs\">\n              {services.map((service) => (\n                <li key={service.name} className=\"flex items-center justify-between border-b px-4 py-2.5 last:border-b-0\">\n                  <span className=\"flex items-center gap-2\">\n                    <span className={`size-1.5 rounded-full ${service.ok ? \"bg-emerald-500\" : \"bg-amber-500\"}`} />\n                    {service.name}\n                  </span>\n                  <span className=\"text-muted-foreground\">\n                    {service.ok ? \"operational\" : \"degraded\"} / {service.uptime}\n                  </span>\n                </li>\n              ))}\n            </ul>\n          </div>\n        </div>\n        <div className=\"grid grid-cols-2 gap-8 sm:grid-cols-3\">\n          {columns.map((column) => (\n            <div key={column.title}>\n              <p className=\"flex items-center gap-2 text-xs text-muted-foreground\">\n                <column.icon className=\"size-3.5\" />\n                {column.title}\n              </p>\n              <ul className=\"mt-4 space-y-2.5 text-sm\">\n                {column.links.map((link) => (\n                  <li key={link}>\n                    <a href=\"#\" className=\"hover:underline\">\n                      {link}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n      </div>\n      <div className=\"border-t\">\n        <div className=\"mx-auto flex max-w-7xl flex-col gap-2 px-6 py-4 text-[11px] text-muted-foreground sm:flex-row sm:items-center sm:justify-between\">\n          <p>© 2026 Vectorbase, Inc. / Apache-2.0 SDKs</p>\n          <p className=\"flex items-center gap-1.5\">\n            <GitCommitHorizontal className=\"size-3.5\" />\n            api v2026-10-01 / build 8f3c2a1\n          </p>\n        </div>\n      </div>\n    </footer>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "520px"
  },
  "categories": [
    "footer"
  ]
}