{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sheet-43",
  "type": "registry:example",
  "description": "E-commerce quick view sheet with a gradient preview, size picker, and add-to-bag action.",
  "files": [
    {
      "path": "registry/designali/examples/sheet/sheet-43.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  Eye as EyeIcon,\n  Heart as HeartIcon,\n  Star as StarIcon,\n} from \"@designali/icons\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  Sheet,\n  SheetContent,\n  SheetDescription,\n  SheetFooter,\n  SheetHeader,\n  SheetTitle,\n  SheetTrigger,\n} from \"@workspace/ui/components/sheet\"\n\nconst sizes = [\"XS\", \"S\", \"M\", \"L\", \"XL\"]\nconst soldOut = new Set([\"XS\"])\n\nexport default function ProductQuickViewSheet() {\n  const [size, setSize] = React.useState<string | null>(null)\n  return (\n    <Sheet>\n      <SheetTrigger render={<Button variant=\"outline\" />}>\n        <EyeIcon data-icon=\"inline-start\" />\n        Quick view\n      </SheetTrigger>\n      <SheetContent className=\"sm:max-w-md\">\n        <div className=\"aspect-[4/3] bg-gradient-to-br from-border via-muted to-muted-foreground dark:from-muted dark:via-card dark:to-muted-foreground\" />\n        <SheetHeader>\n          <div className=\"flex items-start justify-between gap-2\">\n            <SheetTitle className=\"text-base\">Harbor wool overshirt</SheetTitle>\n            <span className=\"text-base font-semibold\">$148</span>\n          </div>\n          <SheetDescription className=\"flex items-center gap-1\">\n            <StarIcon className=\"size-3 fill-current\" /> 4.8 · 212 reviews\n          </SheetDescription>\n        </SheetHeader>\n        <div className=\"flex flex-col gap-2 px-4\">\n          <span className=\"font-medium\">Size</span>\n          <div className=\"grid grid-cols-5 gap-1\">\n            {sizes.map((s) => (\n              <Button\n                key={s}\n                variant={size === s ? \"default\" : \"outline\"}\n                disabled={soldOut.has(s)}\n                onClick={() => setSize(s)}\n              >\n                {s}\n              </Button>\n            ))}\n          </div>\n        </div>\n        <SheetFooter className=\"flex-row\">\n          <Button variant=\"outline\" size=\"icon\" aria-label=\"Add to wishlist\">\n            <HeartIcon />\n          </Button>\n          <Button className=\"flex-1\" disabled={!size}>\n            {size ? \"Add to bag\" : \"Select a size\"}\n          </Button>\n        </SheetFooter>\n      </SheetContent>\n    </Sheet>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}