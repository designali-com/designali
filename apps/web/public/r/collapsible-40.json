{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "collapsible-40",
  "type": "registry:example",
  "description": "Recipe card with ingredients open and method steps collapsed.",
  "files": [
    {
      "path": "registry/designali/examples/collapsible/collapsible-40.tsx",
      "content": "import {\n  CarrotIcon,\n  ChevronDownIcon,\n  ClockIcon,\n  CookingPotIcon,\n  UsersIcon,\n} from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@workspace/ui/components/card\"\nimport {\n  Collapsible,\n  CollapsibleContent,\n  CollapsibleTrigger,\n} from \"@workspace/ui/components/collapsible\"\n\nconst ingredients = [\n  \"2 cups arborio rice\",\n  \"1 litre vegetable stock\",\n  \"200 g chestnut mushrooms\",\n  \"1 shallot, diced\",\n  \"40 g parmesan\",\n]\nconst steps = [\n  \"Soften the shallot in butter over a low heat.\",\n  \"Toast the rice for two minutes, then add stock a ladle at a time.\",\n  \"Fold in the seared mushrooms and parmesan, rest for two minutes.\",\n]\n\nexport default function RecipeSections() {\n  return (\n    <Card className=\"w-full max-w-sm gap-3\">\n      <CardHeader>\n        <CardTitle>Mushroom risotto</CardTitle>\n        <CardDescription className=\"flex gap-3\">\n          <span className=\"flex items-center gap-1\">\n            <ClockIcon className=\"size-3.5\" /> 35 min\n          </span>\n          <span className=\"flex items-center gap-1\">\n            <UsersIcon className=\"size-3.5\" /> Serves 4\n          </span>\n        </CardDescription>\n      </CardHeader>\n      <CardContent className=\"flex flex-col gap-2\">\n        <Collapsible defaultOpen>\n          <CollapsibleTrigger\n            render={\n              <Button\n                variant=\"outline\"\n                size=\"sm\"\n                className=\"w-full justify-start\"\n              />\n            }\n          >\n            <CarrotIcon />\n            Ingredients\n            <ChevronDownIcon className=\"ml-auto transition-transform group-data-panel-open/button:rotate-180\" />\n          </CollapsibleTrigger>\n          <CollapsibleContent className=\"h-(--collapsible-panel-height) overflow-hidden transition-[height] duration-200 ease-out data-ending-style:h-0 data-starting-style:h-0\">\n            <ul className=\"list-disc space-y-1 py-2 pl-8 text-sm\">\n              {ingredients.map((item) => (\n                <li key={item}>{item}</li>\n              ))}\n            </ul>\n          </CollapsibleContent>\n        </Collapsible>\n        <Collapsible>\n          <CollapsibleTrigger\n            render={\n              <Button\n                variant=\"outline\"\n                size=\"sm\"\n                className=\"w-full justify-start\"\n              />\n            }\n          >\n            <CookingPotIcon />\n            Method\n            <ChevronDownIcon className=\"ml-auto transition-transform group-data-panel-open/button:rotate-180\" />\n          </CollapsibleTrigger>\n          <CollapsibleContent className=\"h-(--collapsible-panel-height) overflow-hidden transition-[height] duration-200 ease-out data-ending-style:h-0 data-starting-style:h-0\">\n            <ol className=\"list-decimal space-y-1 py-2 pl-8 text-sm\">\n              {steps.map((step) => (\n                <li key={step}>{step}</li>\n              ))}\n            </ol>\n          </CollapsibleContent>\n        </Collapsible>\n      </CardContent>\n    </Card>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}