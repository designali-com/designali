      "content": "import { AspectRatio } from \"@workspace/ui/components/aspect-ratio\"\nimport { Badge } from \"@workspace/ui/components/badge\"\n\nexport default function BlogPostCover() {\n  return (\n    <article className=\"w-full max-w-md\">\n      <AspectRatio ratio={2} className=\"overflow-hidden bg-foreground\">\n        <div className=\"absolute -start-10 -top-10 size-48 rounded-full bg-primary/60 blur-3xl\" />\n        <div className=\"absolute -end-10 -bottom-16 size-56 rounded-full bg-primary/50 blur-3xl\" />\n        <div className=\"absolute inset-0 flex flex-col justify-end p-4 text-white\">\n          <Badge variant=\"secondary\" className=\"mb-2\">\n            Engineering\n          </Badge>\n          <h3 className=\"text-lg leading-tight font-semibold text-balance\">\n            How Designali takes a design from Figma to Next.js\n          </h3>\n        </div>\n      </AspectRatio>\n      <p className=\"mt-2 text-xs text-muted-foreground\">\n        Ali Imam - 8 min read - Mar 18\n      </p>\n    </article>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
