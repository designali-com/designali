{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "navigation-menu-21",
  "type": "registry:example",
  "description": "News publication navigation with section links and a latest headlines column with timestamps.",
  "files": [
    {
      "path": "registry/designali/examples/navigation-menu/navigation-menu-21.tsx",
      "content": "import {\n  NavigationMenu,\n  NavigationMenuContent,\n  NavigationMenuItem,\n  NavigationMenuLink,\n  NavigationMenuList,\n  NavigationMenuTrigger,\n  navigationMenuTriggerStyle,\n} from \"@workspace/ui/components/navigation-menu\"\n\nconst sections = [\"Design\", \"Development\", \"Branding\", \"Motion\", \"AI\"]\nconst headlines = [\n  { title: \"From Figma to Next.js: design se code tak\", time: \"12 min ago\" },\n  { title: \"Building 460+ blocks with Tailwind CSS\", time: \"48 min ago\" },\n  { title: \"Designing the Designali icon set\", time: \"2 h ago\" },\n]\n\nexport default function NewsSectionsNav() {\n  return (\n    <NavigationMenu>\n      <NavigationMenuList>\n        <NavigationMenuItem>\n          <NavigationMenuTrigger>Sections</NavigationMenuTrigger>\n          <NavigationMenuContent>\n            <div className=\"grid w-72 gap-2 sm:w-[30rem] sm:grid-cols-[8rem_1fr]\">\n              <ul className=\"flex flex-wrap gap-0.5 sm:flex-col\">\n                {sections.map((s) => (\n                  <li key={s}>\n                    <NavigationMenuLink href=\"#\" className=\"font-medium\">\n                      {s}\n                    </NavigationMenuLink>\n                  </li>\n                ))}\n              </ul>\n              <div className=\"flex flex-col gap-0.5\">\n                <p className=\"px-2 py-1 text-[11px] font-semibold tracking-wide text-destructive uppercase dark:text-destructive\">\n                  Latest\n                </p>\n                {headlines.map((h) => (\n                  <NavigationMenuLink\n                    key={h.title}\n                    href=\"#\"\n                    className=\"flex-col items-start gap-0.5\"\n                  >\n                    <span className=\"font-medium\">{h.title}</span>\n                    <span className=\"text-muted-foreground\">{h.time}</span>\n                  </NavigationMenuLink>\n                ))}\n              </div>\n            </div>\n          </NavigationMenuContent>\n        </NavigationMenuItem>\n        <NavigationMenuItem>\n          <NavigationMenuLink href=\"#\" className={navigationMenuTriggerStyle()}>\n            Docs\n          </NavigationMenuLink>\n        </NavigationMenuItem>\n        <NavigationMenuItem>\n          <NavigationMenuLink href=\"#\" className={navigationMenuTriggerStyle()}>\n            Subscribe\n          </NavigationMenuLink>\n        </NavigationMenuItem>\n      </NavigationMenuList>\n    </NavigationMenu>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}