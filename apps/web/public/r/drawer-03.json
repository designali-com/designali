{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "drawer-03",
  "type": "registry:example",
  "description": "Non-modal drawer configuration with rightward swipe direction.",
  "registryDependencies": [
    "drawer",
    "button"
  ],
  "files": [
    {
      "path": "registry/designali/examples/drawer/drawer-03.tsx",
      "content": "import { Button } from \"@workspace/ui/components/button\"\nimport {\n  Drawer,\n  DrawerClose,\n  DrawerContent,\n  DrawerFooter,\n  DrawerHeader,\n  DrawerTitle,\n  DrawerTrigger,\n} from \"@workspace/ui/components/drawer\"\n\nexport function DrawerNonModal() {\n  return (\n    <Drawer modal={false} disablePointerDismissal swipeDirection=\"right\">\n      <DrawerTrigger render={<Button variant=\"outline\">Non Modal</Button>} />\n      <DrawerContent>\n        <DrawerHeader>\n          <DrawerTitle>Non Modal Drawer</DrawerTitle>\n        </DrawerHeader>\n        <div className=\"flex-1 p-4\">\n          <div className=\"rounded-2xl bg-muted group-data-[swipe-axis=x]/drawer-popup:size-full group-data-[swipe-axis=y]/drawer-popup:h-80 group-data-[swipe-axis=y]/drawer-popup:w-full\" />\n        </div>\n        <DrawerFooter>\n          <DrawerClose render={<Button>Close</Button>} />\n        </DrawerFooter>\n      </DrawerContent>\n    </Drawer>\n  )\n}",
      "type": "registry:example"
    }
  ]
}