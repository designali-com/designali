/**
 * Generates UI component examples into registry/designali/examples/<slug>/
 * and registers them in registry/registry-examples-new.ts.
 *
 * Usage (from apps/web):
 *   npx tsx scripts/generate/ui-examples.mts                 # all categories + registry file
 *   npx tsx scripts/generate/ui-examples.mts --only button,card  # just these (no registry write)
 *
 * Existing (git-tracked) example files are never overwritten: numbering for
 * each category continues after the highest tracked file.
 */
import { execSync } from "node:child_process"
import { existsSync, mkdirSync, readdirSync, rmSync, writeFileSync } from "node:fs"
import path from "node:path"
import { pathToFileURL } from "node:url"
import { parseArgs } from "node:util"

import prettier from "prettier"

import { APP_ROOT, buildFile, type Example } from "./ui/_lib.mjs"

const { values } = parseArgs({
  options: {
    only: { type: "string" },
    "no-format": { type: "boolean", default: false },
  },
})

const EXAMPLES_DIR = path.join(APP_ROOT, "registry/designali/examples")
const MODULES_DIR = path.join(APP_ROOT, "scripts/generate/ui")
const REGISTRY_FILE = path.join(APP_ROOT, "registry/registry-examples-new.ts")

const tracked = new Set(
  execSync("git ls-files registry/designali/examples", { cwd: APP_ROOT })
    .toString()
    .split("\n")
    .filter(Boolean)
    .map((p) => path.join(APP_ROOT, p))
)

const allSlugs = readdirSync(MODULES_DIR)
  .filter((f) => f.endsWith(".mts") && !f.startsWith("_"))
  .map((f) => f.replace(/\.mts$/, ""))
  .sort()

const only = values.only?.split(",").map((s) => s.trim())
const slugs = only ?? allSlugs

const prettierConfig =
  (await prettier.resolveConfig(path.join(APP_ROOT, "x.tsx"))) ?? {}

async function format(code: string, filepath: string) {
  if (values["no-format"]) return code
  try {
    return await prettier.format(code, { ...prettierConfig, filepath })
  } catch {
    // Fall back to formatting without plugins (e.g. tailwind plugin missing).
    const { plugins: _plugins, ...rest } = prettierConfig as Record<string, unknown>
    return await prettier.format(code, { ...rest, filepath } as prettier.Options)
  }
}

type Entry = { name: string; description: string; file: string }
const registry: Entry[] = []
const counts: Record<string, number> = {}

for (const slug of slugs) {
  const modPath = path.join(MODULES_DIR, `${slug}.mts`)
  if (!existsSync(modPath)) throw new Error(`No module for ${slug}`)
  const mod = (await import(pathToFileURL(modPath).href)) as {
    default: Example[]
  }
  const list = mod.default

  const dir = path.join(EXAMPLES_DIR, slug)
  mkdirSync(dir, { recursive: true })

  const re = new RegExp(`^${slug}-(\\d+)\\.tsx$`)
  let base = 0
  for (const f of readdirSync(dir)) {
    const m = f.match(re)
    if (m && tracked.has(path.join(dir, f))) base = Math.max(base, Number(m[1]))
  }
  // Remove stale untracked files from earlier generator runs.
  for (const f of readdirSync(dir)) {
    const m = f.match(re)
    if (m && !tracked.has(path.join(dir, f))) rmSync(path.join(dir, f))
  }

  const seen = new Set<string>()
  let n = base
  for (const ex of list) {
    if (seen.has(ex.name)) throw new Error(`[${slug}] duplicate name ${ex.name}`)
    seen.add(ex.name)
    n++
    const id = `${slug}-${String(n).padStart(2, "0")}`
    const file = path.join(dir, `${id}.tsx`)
    if (tracked.has(file)) throw new Error(`Refusing to overwrite ${file}`)
    const code = await format(buildFile(slug, ex), file)
    writeFileSync(file, code)
    registry.push({
      name: id,
      description: ex.description,
      file: `examples/${slug}/${id}.tsx`,
    })
  }
  counts[slug] = list.length
  console.log(`${slug.padEnd(18)} ${String(list.length).padStart(3)}  (${base + 1}-${n})`)
}

const total = Object.values(counts).reduce((a, b) => a + b, 0)
console.log(`total ${total}`)

if (!only) {
  const body = registry
    .map(
      (e) => `  {
    name: ${JSON.stringify(e.name)},
    type: "registry:example",
    description: ${JSON.stringify(e.description)},
    files: [
      {
        path: ${JSON.stringify(e.file)},
        type: "registry:example",
      },
    ],
  },`
    )
    .join("\n")
  const out = `// This file is generated by scripts/generate/ui-examples.mts. Do not edit by hand.
import type { Registry } from "shadcn/schema"

export const examplesNew: Registry["items"] = [
${body}
]
`
  writeFileSync(REGISTRY_FILE, await format(out, REGISTRY_FILE))
  console.log(`wrote ${path.relative(APP_ROOT, REGISTRY_FILE)}`)
}
