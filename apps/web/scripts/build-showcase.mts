/**
 * Generates src/components/home/icons-showcase-items.tsx.
 *
 * The homepage showcase shows 20 icons, 20 vectors and 20 logos. Picking them
 * at runtime meant importing allIcons/allLogos/allVectors (~5,500 components)
 * on the homepage. This script makes the same picks ahead of time and writes a
 * file that imports only the chosen components.
 *
 * Run after regenerating the icon packages:
 *   pnpm --filter web showcase:build
 */
import { promises as fs } from "node:fs"
import path from "node:path"

const root = path.resolve(import.meta.dirname, "..")
const pkg = (name: string) =>
  path.resolve(root, `../../packages/${name}/src/generated/all.tsx`)

const { allIcons } = await import(pkg("icons"))
const { allLogos } = await import(pkg("logos"))
const { allVectors } = await import(pkg("vectors"))

type Entry = {
  metadata: { id: string; baseId: string; variant?: string; viewBox: string }
}
type Source = Record<string, Record<string, Entry>>

// Same deterministic shuffle the showcase used at runtime.
function seededShuffle<T>(array: T[], seed = 42): T[] {
  const arr = [...array]
  let value = seed
  for (let i = arr.length - 1; i > 0; i--) {
    value = (value * 9301 + 49297) % 233280
    const j = Math.floor((value / 233280) * (i + 1))
    ;[arr[i], arr[j]] = [arr[j], arr[i]]
  }
  return arr
}

// firstOccurrence = true  → first entry per baseId
// firstOccurrence = false → only "default" (or unnamed) variants
function getUniqueBaseIds(source: Source, limit: number, firstOccurrence: boolean) {
  const seen = new Set<string>()
  const ids: string[] = []
  for (const group of Object.values(source)) {
    for (const entry of Object.values(group)) {
      const { baseId, variant } = entry.metadata ?? {}
      if (!baseId || seen.has(baseId)) continue
      if (firstOccurrence || !variant || variant === "default") {
        seen.add(baseId)
        ids.push(baseId)
      }
    }
  }
  return seededShuffle(ids).slice(0, limit)
}

// Same lookup order as the Icons/Logos/Vectors components with no variant:
// exact id, then baseId with the default variant, then any baseId.
function findEntry(source: Source, name: string, defaultAlias: string) {
  const all = Object.values(source).flatMap((group) => Object.entries(group))
  const byId = all.find(([, e]) => e.metadata.id === name)
  if (byId) return byId
  const byDefault = all.find(([, e]) => {
    const v = (e.metadata.variant ?? "").toLowerCase()
    return (
      e.metadata.baseId === name &&
      (v === "default" || v === defaultAlias || v === "")
    )
  })
  if (byDefault) return byDefault
  return all.find(([, e]) => e.metadata.baseId === name)
}

function pick(
  source: Source,
  firstOccurrence: boolean,
  defaultAlias: string,
  half: "first" | "second"
) {
  const ids = getUniqueBaseIds(source, 40, firstOccurrence)
  const mid = Math.ceil(ids.length / 2)
  const row = half === "first" ? ids.slice(0, mid) : ids.slice(mid)
  return row.map((id) => {
    const found = findEntry(source, id, defaultAlias)
    if (!found) throw new Error(`No entry found for ${id}`)
    const [componentName, entry] = found
    return { id, componentName, metadata: entry.metadata }
  })
}

const rows = {
  showcaseIcons: { pkg: "@designali/icons", items: pick(allIcons, false, "outline", "first") },
  showcaseVectors: { pkg: "@designali/vectors", items: pick(allVectors, true, "shapes", "first") },
  showcaseLogos: { pkg: "@designali/logos", items: pick(allLogos, false, "icon", "second") },
}

let out = `// This file is autogenerated by scripts/build-showcase.mts
// Do not edit this file directly.

`
// Alias imports per package (Icon_X, Logo_X…) so the same component name in
// two packages can't collide.
const alias = (pkg: string, name: string) =>
  `${pkg.split("/")[1].replace(/s$/, "").replace(/^./, (c) => c.toUpperCase())}_${name}`

for (const { pkg, items } of Object.values(rows)) {
  const names = [...new Set(items.map((i) => i.componentName))].sort()
  out += `import {\n${names.map((n) => `  ${n} as ${alias(pkg, n)},`).join("\n")}\n} from "${pkg}"\n`
}
out += "\n"
for (const [exportName, { pkg, items }] of Object.entries(rows)) {
  out += `export const ${exportName} = [\n`
  for (const { id, componentName, metadata } of items) {
    out += `  { id: ${JSON.stringify(id)}, entry: { Component: ${alias(pkg, componentName)}, metadata: ${JSON.stringify({ viewBox: metadata.viewBox, variant: metadata.variant ?? "" })} } },\n`
  }
  out += "]\n\n"
}

const outPath = path.join(root, "src/components/home/icons-showcase-items.tsx")
await fs.writeFile(outPath, out.trimEnd() + "\n")
console.log(
  `✅ Wrote ${path.relative(root, outPath)} (${Object.values(rows).reduce((n, r) => n + r.items.length, 0)} items)`
)
